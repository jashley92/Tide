<?xml version="1.0" encoding="utf-8"?>
<!--
  TIDE ships its own web.config so the published one has no <location path="." inheritInChildApplications="false">
  wrapper, which the SDK writes by default. The installer opens /health to anonymous requests with a
  <location path="Tide/health"> entry in applicationHost.config, and IIS doesn't carry settings inside that wrapper into
  such a path (the aspNetCore handler would be lost there). Publish adds the handler and <aspNetCore> element here.

  startupTimeLimit (seconds) is how long IIS waits for the app to start, migrations included, before answering 500.37.
  The default 120 can be too short for an upgrade with a large migration.

  The <remove> is for the optional install as an application under another site (/tide, docs/INSTALL.md): a parent
  ASP.NET Core site whose web.config has no wrapper either passes its "aspNetCore" handler down, and adding
  TIDE's own under the same name would fail with 500.19. On a site of its own there's nothing to remove, which IIS
  accepts.

  IIS adds "X-Powered-By: ASP.NET" (set server-wide) and its own Server header, which name the stack to anyone probing
  it; the app already drops Kestrel's. removeServerHeader needs IIS 10 from Windows Server 2019 (version 1809) on, the
  oldest server INSTALL.md supports; an older IIS answers 500.19 for the attribute.
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="aspNetCore" />
    </handlers>
    <aspNetCore startupTimeLimit="600" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
