@inject CardRuleService RuleSvc
@inject TeamService TeamSvc
@inject ICurrentUser CurrentUser
@inject ToastService Toasts

@* The administrators' card rules, read-only, for everyone who reads actions, a tab of the Library page (which checks who
   may open it): why a card on the board is red, what its label means, and which rules + Filter offers. Administrators
   change them on Administration › Card rules. *@

<PageTitle>Board rules · Library · TIDE</PageTitle>

<LibraryHead>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="actions"><span class="bi bi-kanban" aria-hidden="true"></span> Actions</a>
        @if (CurrentUser.Has(Permission.Administer))
        {
            <a class="btn btn-outline-secondary" href="admin/card-rules"><span class="bi bi-pencil" aria-hidden="true"></span> Edit card rules</a>
        }
    </div>
</LibraryHead>

@if (_rules is null)
{
    <LoadingBlock />
}
else if (_rules.Count == 0)
{
    <div class="tide-card">
        <EmptyState Icon="bi-palette" Title="No board rules yet.">Every card shows in its plain colour. An administrator can add rules.</EmptyState>
    </div>
}
else if (Shown.Count == 0)
{
    <div class="tide-card">
        <EmptyState Icon="bi-search" Title="No board rule matches these words." />
    </div>
}
else
{
    <section class="tide-card" aria-labelledby="br-list-h">
        <h2 id="br-list-h">Rules, in order <span class="tide-count tide-muted fw-normal">(@Shown.Count)</span></h2>
        <p class="small tide-muted">An action that matches all of a rule's conditions gets its label. Rules offered as a filter are under + Filter on the Actions page.</p>
        <table class="tide-table">
            <thead><tr><th scope="col">Label</th><th scope="col">Matches actions that are</th><th scope="col">Colour</th><th scope="col">Offered as a filter</th></tr></thead>
            <tbody>
                @foreach (var r in Shown)
                {
                    <tr @key="r.Id">
                        <CardRuleCells Rule="r" Teams="_teams" />
                        <td class="small">@r.Colour</td>
                        <td class="small">@(r.ShowAsFilter ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyList<ActionCardRule>? _rules;
    private IReadOnlyList<Team> _teams = [];

    /// <summary>The Library's search words (its ?q=): only the rules that match every one are listed.</summary>
    [Parameter] public string? Words { get; set; }

    /// <summary>The rules shown: those turned on, in order.</summary>
    internal IReadOnlyList<ActionCardRule>? Rules => _rules;

    // The rules the words leave, worked out once the rules are read and when the words change, not on each redraw.
    private IReadOnlyList<ActionCardRule> Shown { get; set; } = [];

    protected override void OnParametersSet() =>
        Shown = _rules is null ? [] : [.. _rules.Where(r => CardRuleService.Matches(r, TableView.Words(Words)))];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _teams = await TeamSvc.ListAsync(includeRetired: true);
            _rules = await RuleSvc.ListAsync();
        }
        catch (Exception ex)
        {
            _rules = [];
            Toasts.Error(UserFacingError.For(ex));
        }
    }
}
