@page "/metrics"
@attribute [Authorize(Policy = Policies.ReadTeamEdition)]
@using System.Globalization
@using Tide.Application.Metrics
@inject MetricsService MetricsSvc
@inject OrgClock Clock
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Metric history · TIDE</PageTitle>

<div class="tide-page-head">
    <div>
        <h1>Metric history</h1>
        <div class="tide-sub">By business day, including retired metrics.</div>
    </div>
    <a class="btn btn-outline-secondary" href="@CsvUrl" download><span class="bi bi-filetype-csv" aria-hidden="true"></span> Export CSV</a>
</div>

<div class="tide-card">
    <div class="d-flex gap-3 flex-wrap align-items-end">
        <div>
            <label class="tide-field-label" for="from">From</label>
            <input id="from" type="date" class="form-control form-control-sm" @bind="_from" @bind:after="Load" />
        </div>
        <div>
            <label class="tide-field-label" for="to">To</label>
            <input id="to" type="date" class="form-control form-control-sm" @bind="_to" @bind:after="Load" />
        </div>
        <div class="d-flex gap-1">
            @foreach (var (label, days) in new[] { ("30 days", 30), ("90 days", 90), ("1 year", 365) })
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => Range(days)">@label</button>
            }
        </div>
        @if (_history is { Metrics.Count: > 0 })
        {
            <div class="ms-auto">
                <label class="tide-field-label" for="chart-metric">Chart</label>
                <select id="chart-metric" class="form-select form-select-sm" @bind="_chartId">
                    @foreach (var m in _history.Metrics)
                    {
                        <option value="@m.Id">@m.Group?.Name: @m.Name@(m.IsRetired ? " (retired)" : "")</option>
                    }
                </select>
            </div>
        }
    </div>
</div>

@if (_history is null)
{
    <LoadingBlock />
}
else if (_history.Metrics.Count == 0)
{
    <div class="tide-card"><EmptyState Icon="bi-graph-up" Title="No metrics defined">An administrator adds them under Administration &gt; Metrics.</EmptyState></div>
}
else
{
    var chart = _history.Metrics.FirstOrDefault(m => m.Id == _chartId) ?? _history.Metrics[0];
    var series = _history.Values.Where(v => v.DefinitionId == chart.Id).OrderBy(v => v.BriefDate).ToList();
    <div class="tide-card">
        <h2>@chart.Group?.Name: @chart.Name <span class="tide-muted fw-normal small">@DirectionText(chart.Direction)</span></h2>
        @if (series.Count < 2)
        {
            <EmptyState Icon="bi-graph-up" Title="Not enough data in this range" Compact="true" />
        }
        else
        {
            var days = _days;
            var values = days.Select(d => series.FirstOrDefault(v => v.BriefDate == d)?.Value).ToList();
            var format = chart.Format;
            <LineChart Labels="@days.Select(Ui.ShortDay).ToList()" Lines="@([new LineChart.Line(chart.Name, values, v => MetricMath.Format(format, v))])"
                       Label="@($"{chart.Name} from {Ui.ShortDay(days[0])} to {Ui.ShortDay(days[^1])}")" />
        }
    </div>

    var columns = MetricHistoryColumns.Group(_history.Metrics);
    var shown = MetricHistoryColumns.Shown(columns, _chosen);
    var shownValues = MetricHistoryColumns.ShownValues(_history.Values, columns, shown);
    <div class="tide-card">
        <h2>Values <span class="tide-count tide-muted fw-normal">(@shownValues.Count)</span></h2>
        @if (columns.Count > 1)
        {
            @* Which groups' columns show; kept in the address, so a reload or a shared link shows the same ones. *@
            <div class="tide-mh-filter" role="group" aria-label="Groups shown">
                <button type="button" class="tide-chip tide-chip-pick @(shown.Count == columns.Count ? "selected" : "")" aria-pressed="@Ui.Aria(shown.Count == columns.Count)" @onclick="ShowAll">All groups</button>
                @foreach (var g in columns)
                {
                    var on = shown.Count != columns.Count && shown.Contains(g);
                    <button type="button" class="tide-chip tide-chip-pick @(on ? "selected" : "")" aria-pressed="@Ui.Aria(on)" @onclick="() => Pick(columns, g.Key)">@g.Name <span class="tide-muted">@g.Metrics.Count</span></button>
                }
            </div>
        }
        @{ var byDay = shownValues.ToLookup(v => v.BriefDate); var dates = byDay.Select(g => g.Key).OrderDescending().ToList(); }
        @if (dates.Count == 0)
        {
            <EmptyState Icon="bi-table" Title="No data in this range" Compact="true" />
        }
        else
        {
            @* Scrolls both ways inside its own box, so the group and metric headings stay above and the day stays beside. *@
            <div class="tide-mh-scroll" tabindex="0" role="region" aria-label="Metric values by day">
                <table class="tide-table tide-mh-table">
                    @foreach (var g in shown)
                    {
                        <colgroup span="@g.Metrics.Count"></colgroup>
                    }
                    <thead>
                        <tr class="tide-mh-groups">
                            <th scope="col" rowspan="2" class="tide-mh-day">Day</th>
                            @foreach (var g in shown)
                            {
                                <th scope="colgroup" colspan="@g.Metrics.Count" class="tide-mh-group"><span>@g.Name</span></th>
                            }
                        </tr>
                        <tr class="tide-mh-metrics">
                            @foreach (var g in shown)
                            {
                                @for (var i = 0; i < g.Metrics.Count; i++)
                                {
                                    var m = g.Metrics[i];
                                    <th scope="col" class="tide-table-num @(i == 0 ? "tide-mh-gstart" : "")" title="@(g.Name): @m.Name">@m.Name@(m.IsRetired ? " (retired)" : "")</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in dates)
                        {
                            var row = byDay[d].ToDictionary(v => v.DefinitionId);
                            <tr>
                                <th scope="row" class="tide-mh-day text-nowrap"><a href="@Ui.BriefUrl(d)">@Ui.ShortDay(d)</a></th>
                                @foreach (var g in shown)
                                {
                                    @for (var i = 0; i < g.Metrics.Count; i++)
                                    {
                                        var m = g.Metrics[i];
                                        var v = row.GetValueOrDefault(m.Id);
                                        <td class="tide-table-num @(i == 0 ? "tide-mh-gstart" : "") @(v is null ? "" : LevelClass(m, v.Value))">
                                            @(v is null ? "—" : MetricMath.Format(m.Format, v.Value))
                                            @if (!string.IsNullOrWhiteSpace(v?.Note))
                                            {
                                                @* The note: in a title for the pointer, and read out with the value. *@
                                                <span class="bi bi-chat-left-text tide-mh-note" title="@v.Note" aria-hidden="true"></span><span class="visually-hidden">Note: @v.Note</span>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    /// <summary>The groups whose columns show, by key (MetricHistoryColumns); none for all of them.</summary>
    [SupplyParameterFromQuery(Name = MetricHistoryColumns.Parameter)] public string? GroupsParam { get; set; }

    private IReadOnlySet<string> _chosen = new HashSet<string>();
    private DateOnly _from, _to;
    private MetricHistory? _history;
    private IReadOnlyList<DateOnly> _days = [];
    private Guid _chartId;

    private string CsvUrl => $"metrics/export.csv?from={Ui.IsoDay(_from)}&to={Ui.IsoDay(_to)}";

    protected override Task OnInitializedAsync()
    {
        _to = Clock.CurrentBriefDate;
        _from = _to.AddDays(-30);
        return Load();
    }

    protected override void OnParametersSet() => _chosen = MetricHistoryColumns.Parse(GroupsParam);

    // The choice goes in the address (replacing it, so Back leaves the page rather than stepping through the chips).
    internal void Pick(IReadOnlyList<MetricColumnGroup> columns, string key) => Choose(MetricHistoryColumns.Toggle(columns, _chosen, key));

    internal void ShowAll() => Choose(new HashSet<string>());

    private void Choose(IReadOnlySet<string> keys)
    {
        _chosen = keys;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter(MetricHistoryColumns.Parameter, MetricHistoryColumns.Query(keys)), replace: true);
    }

    private Task Range(int days)
    {
        _to = Clock.CurrentBriefDate;
        _from = _to.AddDays(-days);
        return Load();
    }

    // Each read is numbered: one that lands after a later change to the dates is dropped, so it can't put back the
    // dates it was asked for over the ones just chosen.
    private int _reading;

    private async Task Load()
    {
        var reading = ++_reading;
        try
        {
            var history = await MetricsSvc.HistoryAsync(_from, _to);
            if (reading != _reading) return;
            _history = history;
            (_from, _to) = (_history.From, _history.To);
            var days = new List<DateOnly>();
            // Working days, and a holiday someone entered numbers for anyway.
            var entered = _history.Values.Select(v => v.BriefDate).ToHashSet();
            for (var d = _from; d <= _to; d = d.AddDays(1))
                if (Clock.Days.IsWorkingDay(d) || (!WorkingDays.IsWeekend(d) && entered.Contains(d))) days.Add(d);
            _days = days.Count > 0 ? days : [_to];
            if (_history.Metrics.All(m => m.Id != _chartId)) _chartId = _history.Metrics.FirstOrDefault(m => !m.IsRetired)?.Id ?? Guid.Empty;
        }
        catch (Exception ex) when (reading == _reading) { Toasts.Error(UserFacingError.For(ex)); }
        catch (Exception) { /* a later read has the dates now */ }
    }

    private static string DirectionText(MetricDirection d) => d switch
    {
        MetricDirection.HigherIsBetter => "higher is better",
        MetricDirection.LowerIsBetter => "lower is better",
        _ => "neutral",
    };

    private static string LevelClass(MetricDefinition m, decimal v) => MetricMath.LevelOf(m, v) switch
    {
        MetricLevel.Critical => "tide-level-critical",
        MetricLevel.Warn => "tide-level-warn",
        _ => "",
    };
}
