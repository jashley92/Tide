@page "/metrics"
@attribute [Authorize(Policy = Policies.ReadTeamEdition)]
@using System.Globalization
@using Tide.Application.Metrics
@inject MetricsService MetricsSvc
@inject OrgClock Clock
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Metric history · TIDE</PageTitle>

@* A data page: it takes the whole window, so a wide table scrolls only when it's wider than that. *@
<div class="tide-page-head tide-page-wide">
    <div>
        <h1>Metric history</h1>
        <div class="tide-sub">By business day, including retired metrics.</div>
    </div>
    <a class="btn btn-outline-secondary" href="@CsvUrl" download><span class="bi bi-filetype-csv" aria-hidden="true"></span> Export CSV</a>
</div>

<div class="tide-card">
    <div class="d-flex gap-3 flex-wrap align-items-end">
        <div>
            <label class="tide-field-label" for="from">From</label>
            <input id="from" type="date" class="form-control form-control-sm" @bind="_from" @bind:after="Load" />
        </div>
        <div>
            <label class="tide-field-label" for="to">To</label>
            <input id="to" type="date" class="form-control form-control-sm" @bind="_to" @bind:after="Load" />
        </div>
        <div class="d-flex gap-1">
            @foreach (var (label, days) in new[] { ("30 days", 30), ("90 days", 90), ("1 year", 365) })
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => Range(days)">@label</button>
            }
        </div>
        @if (_history is { Metrics.Count: > 0 })
        {
            <div class="ms-auto">
                <MetricChartPicker Metrics="@_history.Metrics" Picked="@Picked" PickedChanged="Chart" />
            </div>
        }
    </div>
</div>

@if (_history is null)
{
    <LoadingBlock />
}
else if (_history.Metrics.Count == 0)
{
    <div class="tide-card"><EmptyState Icon="bi-graph-up" Title="No metrics defined">An administrator adds them under Administration &gt; Metrics.</EmptyState></div>
}
else
{
    var picked = Picked;
    var view = MetricChartPicks.ViewFor(picked, ViewParam);
    var labels = _days.Select(Ui.ShortDay).ToList();
    var span = $"from {labels[0]} to {labels[^1]}";
    var charted = picked.Select(Series).ToList();
    <div class="tide-card">
        <div class="d-flex justify-content-between align-items-baseline gap-2 flex-wrap">
            <h2 class="tide-card-title">
                @if (picked is [var only])
                {
                    @only.Group?.Name<text>: </text>@only.Name <span class="tide-muted fw-normal small">@DirectionText(only.Direction)</span>
                }
                else
                {
                    @picked.Count<text> metrics</text>
                }
            </h2>
            @if (picked.Count > 1)
            {
                @* Overlay only for a few metrics in one unit: otherwise the grid is the only honest way to draw them. *@
                var canOverlay = MetricChartPicks.CanOverlay(picked);
                <div class="btn-group btn-group-sm" role="group" aria-label="Chart layout">
                    <button type="button" class="btn btn-outline-secondary @(view == MetricChartView.Overlay ? "active" : "")" aria-pressed="@Ui.Aria(view == MetricChartView.Overlay)"
                            disabled="@(!canOverlay)" title="@(canOverlay ? "Every line on one chart" : $"One chart takes up to {MetricChartPicks.MaxOverlay} metrics in the same unit")"
                            @onclick="() => SetView(MetricChartView.Overlay)"><span class="bi bi-graph-up" aria-hidden="true"></span> One chart</button>
                    <button type="button" class="btn btn-outline-secondary @(view == MetricChartView.Grid ? "active" : "")" aria-pressed="@Ui.Aria(view == MetricChartView.Grid)"
                            @onclick="() => SetView(MetricChartView.Grid)"><span class="bi bi-grid" aria-hidden="true"></span> A chart each</button>
                </div>
            }
        </div>
        @if (view == MetricChartView.Overlay)
        {
            @if (charted.All(c => c.Points < 2))
            {
                <EmptyState Icon="bi-graph-up" Title="Not enough data in this range" Compact="true" />
            }
            else
            {
                <LineChart Labels="@labels" Label="@($"{string.Join(", ", picked.Select(m => m.Name))} {span}")"
                           Lines="@charted.Select(c => c.Line).ToList()" BandsFor="@(picked is [var one] ? r => MetricBands.Of(one, r) : null)"
                           OnTakeOff="@(picked.Count > 1 ? EventCallback.Factory.Create<int>(this, i => Chart(MetricChartPicks.Toggle(_history.Metrics, picked, picked[i]))) : default)" />
                @if (picked.Count == 1)
                {
                    <div class="small mt-1"><MetricChange Tile="@charted[0].Latest" /></div>
                }
            }
        }
        else
        {
            <div class="tide-mc-grid">
                @foreach (var c in charted)
                {
                    var m = c.Metric;
                    <section class="tide-mc-cell" aria-label="@m.Name">
                        <header class="tide-mc-cell-head">
                            <h3 title="@m.Group?.Name: @m.Name, @DirectionText(m.Direction)">@m.Name@(m.IsRetired ? " (retired)" : "")</h3>
                            <button type="button" class="btn btn-sm tide-mc-remove" title="Take off the chart" aria-label="Take @m.Name off the chart"
                                    @onclick="() => Chart(MetricChartPicks.Toggle(_history.Metrics, picked, m))"><span class="bi bi-x" aria-hidden="true"></span></button>
                        </header>
                        <div class="tide-mc-cell-now">
                            @if (c.Latest.Value is { } latest)
                            {
                                <strong class="@LevelClass(m, latest)">@MetricMath.Format(m.Format, latest)</strong> <MetricChange Tile="@c.Latest" ShowDate="false" />
                            }
                        </div>
                        @if (c.Points < 2)
                        {
                            <div class="tide-muted small">Not enough data in this range</div>
                        }
                        else
                        {
                            <LineChart Labels="@labels" Lines="@([c.Line])" Compact="true" BandsFor="@(r => MetricBands.Of(m, r))" Label="@($"{m.Name} {span}")" />
                        }
                    </section>
                }
            </div>
        }
    </div>

    var columns = MetricHistoryColumns.Group(_history.Metrics);
    var shown = MetricHistoryColumns.Shown(columns, _chosen);
    var shownValues = MetricHistoryColumns.ShownValues(_history.Values, columns, shown);
    <div class="tide-card">
        <h2>Values <span class="tide-count tide-muted fw-normal">(@shownValues.Count)</span></h2>
        @if (columns.Count > 1)
        {
            @* Which groups' columns show: a pill per group (none on is every group), Clear for all of them again. Kept in the
               address, so a reload or a shared link shows the same ones. *@
            <FilterBar PillsLabel="Groups shown" Active="@(shown.Count != columns.Count)" OnChanged="StateHasChanged" OnClear="ShowAll"
                       Pills="@([.. columns.Select(g => new FilterPill(g.Key, $"{g.Name} ({g.Metrics.Count})", g.Key, FilterValues.Of(true)))])"
                       Filters="@([.. columns.Select(g => new FilterDef(g.Key, g.Name, FilterKind.Single, _ => Pick(columns, g.Key)) { InMenu = false, Values = FilterValues.Of(shown.Count != columns.Count && shown.Contains(g)) })])" />
            @if (shown.Count != columns.Count)
            {
                <button type="button" class="btn btn-link btn-sm p-0 mb-2" @onclick="() => ChartGroups(shown)"><span class="bi bi-graph-up" aria-hidden="true"></span> Chart the groups shown</button>
            }
        }
        @{ var byDay = shownValues.ToLookup(v => v.BriefDate); var dates = byDay.Select(g => g.Key).OrderDescending().ToList(); }
        @if (dates.Count == 0)
        {
            <EmptyState Icon="bi-table" Title="No data in this range" Compact="true" />
        }
        else
        {
            @* Scrolls both ways inside its own box, so the group and metric headings stay above and the day stays beside. *@
            <div class="tide-mh-scroll" tabindex="0" role="region" aria-label="Metric values by day">
                <table class="tide-table tide-mh-table">
                    @foreach (var g in shown)
                    {
                        <colgroup span="@g.Metrics.Count"></colgroup>
                    }
                    <thead>
                        <tr class="tide-mh-groups">
                            <th scope="col" rowspan="2" class="tide-mh-day">Day</th>
                            @foreach (var g in shown)
                            {
                                <th scope="colgroup" colspan="@g.Metrics.Count" class="tide-mh-group"><span>@g.Name</span></th>
                            }
                        </tr>
                        <tr class="tide-mh-metrics">
                            @foreach (var g in shown)
                            {
                                @for (var i = 0; i < g.Metrics.Count; i++)
                                {
                                    var m = g.Metrics[i];
                                    <th scope="col" class="tide-table-num @(i == 0 ? "tide-mh-gstart" : "")" title="@(g.Name): @m.Name">@m.Name@(m.IsRetired ? " (retired)" : "")</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in dates)
                        {
                            var row = byDay[d].ToDictionary(v => v.DefinitionId);
                            <tr>
                                <th scope="row" class="tide-mh-day text-nowrap"><a href="@Ui.BriefUrl(d)">@Ui.ShortDay(d)</a></th>
                                @foreach (var g in shown)
                                {
                                    @for (var i = 0; i < g.Metrics.Count; i++)
                                    {
                                        var m = g.Metrics[i];
                                        var v = row.GetValueOrDefault(m.Id);
                                        <td class="tide-table-num @(i == 0 ? "tide-mh-gstart" : "") @(v is null ? "" : LevelClass(m, v.Value))">
                                            @(v is null ? "—" : MetricMath.Format(m.Format, v.Value))
                                            @if (!string.IsNullOrWhiteSpace(v?.Note))
                                            {
                                                @* The note: in a title for the pointer, and read out with the value. *@
                                                <span class="bi bi-chat-left-text tide-mh-note" title="@v.Note" aria-hidden="true"></span><span class="visually-hidden">Note: @v.Note</span>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    /// <summary>The groups whose columns show, by key (MetricHistoryColumns); none for all of them.</summary>
    [SupplyParameterFromQuery(Name = MetricHistoryColumns.Parameter)] public string? GroupsParam { get; set; }

    /// <summary>The metrics charted, and how (MetricChartPicks).</summary>
    [SupplyParameterFromQuery(Name = MetricChartPicks.Parameter)] public string? ChartParam { get; set; }
    [SupplyParameterFromQuery(Name = MetricChartPicks.ViewParameter)] public string? ViewParam { get; set; }

    private IReadOnlySet<string> _chosen = new HashSet<string>();
    private DateOnly _from, _to;
    private MetricHistory? _history;
    private IReadOnlyList<DateOnly> _days = [];

    private IReadOnlyList<MetricDefinition> Picked => MetricChartPicks.Resolve(_history?.Metrics ?? [], ChartParam);

    // A metric's line over the days shown, how many days have a value, and its latest value and change for its heading.
    private sealed record Charted(MetricDefinition Metric, LineChart.Line Line, int Points, MetricTile Latest);

    private Charted Series(MetricDefinition m)
    {
        var mine = _history!.Values.Where(v => v.DefinitionId == m.Id).ToDictionary(v => v.BriefDate, v => v.Value);
        var values = _days.Select(d => mine.TryGetValue(d, out var v) ? v : (decimal?)null).ToList();
        var points = mine.Select(kv => (Date: kv.Key, Value: kv.Value)).ToList();
        (DateOnly Date, decimal Value)? last = points.Count == 0 ? null : points.MaxBy(p => p.Date);
        var compared = last is { } l ? MetricMath.Compare(m.Direction, l.Value, MetricMath.PreviousWithValue(points, l.Date)) : null;
        var latest = new MetricTile(m, last?.Value, null, compared, MetricMath.LevelOf(m, last?.Value), []);
        var format = m.Format;
        var line = new LineChart.Line(m.Name, values, v => MetricMath.Format(format, v)) { After = @<MetricChange Tile="@latest" ShowDate="false" /> };
        return new Charted(m, line, values.Count(v => v is not null), latest);
    }

    private void Chart(IReadOnlyList<MetricDefinition> picked) => Go(MetricChartPicks.Parameter, MetricChartPicks.Query(_history!.Metrics, picked));

    private void SetView(MetricChartView view) => Go(MetricChartPicks.ViewParameter, MetricChartPicks.ViewQuery(view));

    // Every current metric of the groups the table shows.
    private void ChartGroups(IReadOnlyList<MetricColumnGroup> shown) =>
        Chart([.. _history!.Metrics.Where(m => !m.IsRetired && shown.Any(g => g.GroupId == m.GroupId))]);

    private void Go(string name, string? value) => Nav.NavigateTo(Nav.GetUriWithQueryParameter(name, value), replace: true);

    private string CsvUrl => $"metrics/export.csv?from={Ui.IsoDay(_from)}&to={Ui.IsoDay(_to)}";

    protected override Task OnInitializedAsync()
    {
        _to = Clock.CurrentBriefDate;
        _from = _to.AddDays(-30);
        return Load();
    }

    protected override void OnParametersSet() => _chosen = MetricHistoryColumns.Parse(GroupsParam);

    // The choice goes in the address (replacing it, so Back leaves the page rather than stepping through the chips).
    internal void Pick(IReadOnlyList<MetricColumnGroup> columns, string key) => Choose(MetricHistoryColumns.Toggle(columns, _chosen, key));

    internal void ShowAll() => Choose(new HashSet<string>());

    private void Choose(IReadOnlySet<string> keys)
    {
        _chosen = keys;
        Go(MetricHistoryColumns.Parameter, MetricHistoryColumns.Query(keys));
    }

    private Task Range(int days)
    {
        _to = Clock.CurrentBriefDate;
        _from = _to.AddDays(-days);
        return Load();
    }

    // Each read is numbered: one that lands after a later change to the dates is dropped, so it can't put back the
    // dates it was asked for over the ones just chosen.
    private int _reading;

    private async Task Load()
    {
        var reading = ++_reading;
        try
        {
            var history = await MetricsSvc.HistoryAsync(_from, _to);
            if (reading != _reading) return;
            _history = history;
            (_from, _to) = (_history.From, _history.To);
            var days = new List<DateOnly>();
            // Working days, and a holiday someone entered numbers for anyway.
            var entered = _history.Values.Select(v => v.BriefDate).ToHashSet();
            for (var d = _from; d <= _to; d = d.AddDays(1))
                if (Clock.Days.IsWorkingDay(d) || (!WorkingDays.IsWeekend(d) && entered.Contains(d))) days.Add(d);
            _days = days.Count > 0 ? days : [_to];
        }
        catch (Exception ex) when (reading == _reading) { Toasts.Error(UserFacingError.For(ex)); }
        catch (Exception) { /* a later read has the dates now */ }
    }

    private static string DirectionText(MetricDirection d) => d switch
    {
        MetricDirection.HigherIsBetter => "higher is better",
        MetricDirection.LowerIsBetter => "lower is better",
        _ => "neutral",
    };

    private static string LevelClass(MetricDefinition m, decimal v) => MetricMath.LevelOf(m, v) switch
    {
        MetricLevel.Critical => "tide-level-critical",
        MetricLevel.Warn => "tide-level-warn",
        _ => "",
    };
}
