    private string ReadingDaysText => Math.Clamp(IntakeOpts.CurrentValue.ReadingDays, 1, 30) is var d && d == 7 ? "a week" : $"{d} day{(d == 1 ? "" : "s")}";

    /// <summary>"Found here: 2 CVEs · 3 indicators · Our stack: GitLab".</summary>
    internal static string Found(ReadingText text)
    {
        var parts = new List<string>();
        if (text.Cves.Count > 0) parts.Add($"{text.Cves.Count} CVE{(text.Cves.Count == 1 ? "" : "s")}");
        if (text.Indicators.Count > 0) parts.Add($"{text.Indicators.Count} indicator{(text.Indicators.Count == 1 ? "" : "s")}");
        if (text.WeRun.Count > 0) parts.Add("Our stack: " + string.Join(", ", text.WeRun));
        return parts.Count == 0 ? "No CVEs, indicators or products we run found in it." : "Found here: " + string.Join(" · ", parts);
    }

