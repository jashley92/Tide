    // X or S on a group's line: every report in it, once confirmed (a group can hide what one report adds).
    internal async Task ActOnGroup(Line line, TriageStep what)
    {
        if (_busy || line.Members.Count == 0 || _status != FeedItemStatus.New) return;
        var n = line.Members.Count;
        var dismiss = what == TriageStep.Dismiss;
        if (!await _confirm.Ask(dismiss ? $"Dismiss the {n} reports?" : $"Shortlist the {n} reports?",
                $"Every report in \u201C{Short(line.Members[0].Item.Title)}\u201D goes{(dismiss ? ", for everyone: the inbox is shared" : " to Shortlisted")}. To keep one, open the group and act on it alone.",
                dismiss ? $"Dismiss {n}" : $"Shortlist {n}")) return;
        _busy = true;
        try
        {
            var ids = line.Members.Select(m => m.Item.Id).ToList();
            // The count done, not the group's size: a colleague may have acted on some of them first.
            var done = dismiss ? await Intake.DismissManyAsync(ids, _itemReason) : await Intake.ShortlistManyAsync(ids);
            Announce();
            Toasts.Show(done == 0 ? "Nothing changed: a colleague got to those reports first."
                : $"{(dismiss ? "Dismissed" : "Shortlisted")} {done} report{(done == 1 ? "" : "s")}.");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
    private IReadOnlyDictionary<string, CveRecord> _cves = new Dictionary<string, CveRecord>();
