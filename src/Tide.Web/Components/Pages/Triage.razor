    // The product from Our stack that a line names: its own, or (a group's line) any of its reports'.
    private static Tide.Application.Stack.StackEntry? WeRunOf(Line line) => line.Row?.WeRun ?? line.Members.Select(m => m.WeRun).FirstOrDefault(w => w is not null);
    private bool AnyWeRun => !_older && _rows.Any(r => r.WeRun is not null);

    // "Add to what we run…" in the rail: the product's name, added to Our stack (or found there), and the list read again.
    // True when it was added.
    internal async Task<bool> AddToStack(string name)
    {
        if (_busy || string.IsNullOrWhiteSpace(name)) return false;
        _busy = true;
        try
        {
            name = name.Trim();
            await Stack.AddByNameAsync(name);
            Toasts.Show($"{name} added to Our stack.");
            await Load();
            _focus = "tideTriage.focusRow";   // the button went with the add: the row keeps the keyboard's place
            return true;
        }
        catch (Exception ex) when (ex is ArgumentException or ForbiddenException) { Toasts.Error(UserFacingError.For(ex)); return false; }
        finally
        {
            _busy = false;
            StateHasChanged();   // called from the rail's own handler: the page draws the list read again
        }
    }

    // The New tab's fold of items that aged out (IntakeOptions.AgeDays), and whether it's what's shown.
    private bool _older;
    private int _olderCount;
    private string AgeText => IntakeOpts.CurrentValue.AgeDays is var d && d == 7 ? "a week" : $"{d} day{(d == 1 ? "" : "s")}";

    // EP-81: the order, kept in this browser.
    private async Task SetSort(InboxSort sort)
    {
        if (_sort == sort) return;
        _sort = sort;
        try { await JS.InvokeVoidAsync("tideTriage.pref", "sort", sort == InboxSort.Likely ? nameof(InboxSort.Likely) : null); }
        catch (JSDisconnectedException) { }
        await Refilter();
    }

    // How many missed stories the notice lists at once; the rest follow as these are dealt with.
    private const int MissedShown = 5;

    // "Right to dismiss": one click, no dialog. The check stops asking about them for everyone, colleagues' pages hear it,
    // and the toast's Undo asks again. Only the notice changes, so it's not read again.
    private async Task KeepDismissed(IReadOnlyList<MissedItem> items)
    {
        if (_busy) return;
        _busy = true;
        var ids = items.Select(m => m.Item.Id).ToList();
        try
        {
            var (n, at) = await Intake.KeepDismissedAsync(ids);
            _missed = [.. _missed.Where(m => !ids.Contains(m.Item.Id))];
            Announce();
            if (n == 0) Toasts.Show("Nothing changed: a colleague got to those first.");
            else Toasts.Show(items is [var one] ? $"Kept dismissed: {Short(one.Item.Title)}" : $"Kept {n} dismissed.", async () =>
            {
                // From the toast: this page re-renders itself, as the click wasn't on it.
                await UndoKeepDismissed(ids, at);
                StateHasChanged();
            });
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    private async Task UndoKeepDismissed(IReadOnlyCollection<Guid> ids, DateTimeOffset at)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (await Intake.UndoKeepDismissedAsync(ids, at) == 0) Toasts.Show("Nothing to undo: a colleague already changed them.");
            Announce();
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    private async Task PutBack(MissedItem missed)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Intake.RestoreAsync(missed.Item.Id);
            Announce();
            Toasts.Show($"Put back in New: {Short(missed.Item.Title)}");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
        await Load();
    }

    private async Task ShowOlder(bool on)
    {
        _older = on;
        await Refilter();
    }

    // X or S on a group's line: every report in it, once confirmed (a group can hide what one report adds).
    internal async Task ActOnGroup(Line line, TriageStep what)
    {
        if (_busy || line.Members.Count == 0 || _status != FeedItemStatus.New) return;
        var n = line.Members.Count;
        var dismiss = what == TriageStep.Dismiss;
        if (!await _confirm.Ask(dismiss ? $"Dismiss the {n} reports?" : $"Shortlist the {n} reports?",
                $"Every report in \u201C{Short(line.Members[0].Item.Title)}\u201D goes{(dismiss ? ", for everyone: the inbox is shared" : " to Shortlisted")}. To keep one, open the group and act on it alone.",
                dismiss ? $"Dismiss {n}" : $"Shortlist {n}")) return;
        _busy = true;
        try
        {
            var ids = line.Members.Select(m => m.Item.Id).ToList();
            // The count done, not the group's size: a colleague may have acted on some of them first.
            var done = dismiss ? await Intake.DismissManyAsync(ids, _itemReason) : await Intake.ShortlistManyAsync(ids);
            Announce();
            Toasts.Show(done == 0 ? "Nothing changed: a colleague got to those reports first."
                : $"{(dismiss ? "Dismissed" : "Shortlisted")} {done} report{(done == 1 ? "" : "s")}.");
            await Load();
            _focus = "tideTriage.focusRow";
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
    private IReadOnlyDictionary<string, CveRecord> _cves = new Dictionary<string, CveRecord>();
    private int _selected;
    private bool _loaded, _busy, _failed;   // _failed: the last read threw, so there's no list for a prerender to keep
    private DotNetObjectReference<Triage>? _ref;

