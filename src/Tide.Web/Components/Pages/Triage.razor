    private static string Short(string s) => s.Length > 60 ? s[..60] + "…" : s;

    /// <summary>
    /// A line of the list: an item's row (<see cref="Row"/>); a suggested group's own line (no row; its reports, newest
    /// first, in <see cref="Members"/>); or a report shown under its open group (both a row and the group).
    /// </summary>
    internal sealed record Line(InboxRow? Row, TriageGroup? Group, IReadOnlyList<InboxRow> Members);

    private Line? Current => _selected < _lines.Count ? _lines[_selected] : null;

    private bool IsOpen(TriageGroup group) => group.Ids.Any(_open.Contains);

    private static string GroupLabel(Line line) =>
        $"Looks like one event: {line.Members.Count} reports from {line.Group!.Sources} feeds. Newest: {line.Members[0].Item.Title}";

    // A group's article starts at the most restrictive of its sources' TLPs.
    private static TlpLevel GroupTlp(Line line) => line.Members.Max(m => m.Source.DefaultTlp);

    // The list as shown: each group the inbox suggests (and nobody split) where its newest report would be, with its
    // reports under it while it's open; every other item as its own row.
    private void BuildLines()
    {
        var byId = _rows.ToDictionary(r => r.Item.Id);
        var placed = new HashSet<Guid>();
        var lines = new List<Line>();
        foreach (var row in _rows)
        {
            if (!placed.Add(row.Item.Id)) continue;
            if (row.Group is { } group && !group.Ids.Any(_apart.Contains))
            {
                var members = group.Ids.Select(byId.GetValueOrDefault).OfType<InboxRow>().ToList();
                placed.UnionWith(group.Ids);
                lines.Add(new Line(null, group, members));
                if (IsOpen(group)) lines.AddRange(members.Select(m => new Line(m, group, [])));
            }
            else lines.Add(new Line(row, null, []));
        }
        _lines = lines;
    }

    // Selects an item's line: its own row (or its row under an open group), or else its closed group's line; with
    // head, its group's line first. False when it isn't shown.
    private bool SelectItem(Guid id, bool head = false)
    {
        var at = head ? -1 : _lines.FindIndex(l => l.Row?.Item.Id == id);
        if (at < 0) at = _lines.FindIndex(l => l.Row is null && l.Group!.Ids.Contains(id));
        if (at < 0) return false;
        _selected = at;
        return true;
    }

    // Opens or closes the group the line belongs to (its own line or a report under it), selecting the group's line.
    internal void Toggle(int i)
    {
        if (i >= _lines.Count || _lines[i].Group is not { } group) return;
        if (IsOpen(group)) _open.ExceptWith(group.Ids);
        else _open.UnionWith(group.Ids);
        if (_promotingGroup is null && _promoting is { } p && group.Ids.Contains(p)) _promoting = null;
        BuildLines();
        SelectItem(group.Newest, head: true);
    }

    // "Not the same": the group's reports go back to rows of their own, until the page is left (nothing is stored).
    internal void Split(int i)
    {
        if (i >= _lines.Count || _lines[i] is not { Row: null, Group: { } group }) return;
        _apart.UnionWith(group.Ids);
        _open.ExceptWith(group.Ids);
        if (_promotingGroup is not null && group.Ids.Contains(_promotingGroup.Newest)) CancelPromote();
        BuildLines();
        SelectItem(group.Newest);
        _focus = "tideTriage.focusRow";
        Toasts.Show($"Split into {group.Ids.Count} rows, until you leave this page.");
    }

    // The address Back returns to after "Promote and write" (Address), and the brief's "Promote" on a shortlisted item:
    // the tab, the filters, the row (by id, or by place when the item has left the tab), and whether its promote form opens.
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public Guid? SourceParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchParam { get; set; }
    [SupplyParameterFromQuery(Name = "since")] public bool? SinceParam { get; set; }
    [SupplyParameterFromQuery(Name = "at")] public Guid? AtParam { get; set; }
    [SupplyParameterFromQuery(Name = "row")] public int? RowParam { get; set; }
    [SupplyParameterFromQuery(Name = "promote")] public bool? PromoteParam { get; set; }

    /// <summary>Triage's address at a tab, filters and row, for Back to return to.</summary>
    internal static string Address(FeedItemStatus status, Guid? sourceId, string? search, bool sinceLast, Guid? at, int row)
    {
        var query = new List<string> { "tab=" + status.ToString().ToLowerInvariant() };
        if (sourceId is { } s) query.Add("source=" + s);
        if (!string.IsNullOrWhiteSpace(search)) query.Add("q=" + Uri.EscapeDataString(search.Trim()));
        if (sinceLast) query.Add("since=true");
        if (at is { } id) query.Add("at=" + id);
        if (row > 0) query.Add("row=" + row);
        return "triage?" + string.Join("&", query);
    }

    protected override async Task OnInitializedAsync()
    {
        // First, so a page closed during the loads below has already stopped listening.
        _live = new LiveChanges(Changes, Origin, c => c.Topic == ChangeFeed.Triage, InvokeAsync, Heard);
        _marks = new LiveMarks<Guid>(InvokeAsync, StateHasChanged);
        _tabMarks = new LiveMarks<FeedItemStatus>(InvokeAsync, StateHasChanged);
        // The first interactive draw starts from what the prerender read, for the same address, so a reload doesn't
        // flash "Loading" over the list; it's then read again below, quietly, for anything changed in between.
        var adopted = Handoff.Take<Triage>(PrerenderedState, Me.UserId) is { } prerendered && prerendered.SameAddress(this)
            && Adopt(prerendered);
        PrerenderedState = null;
        _sources = await Intake.SourcesAsync(includeRetired: true);
        _lastBriefAt = await Intake.LastBriefAtAsync();
        if (string.Equals(TabParam, SourcesKey, StringComparison.OrdinalIgnoreCase)) _sourcesTab = true;
        else if (Enum.TryParse<FeedItemStatus>(TabParam, ignoreCase: true, out var tab) && Enum.IsDefined(tab)) _status = tab;
        _ticking = Time.CreateTimer(_ => { if (_sourcesTab && !_disposed) _ = InvokeAsync(StateHasChanged); }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        _sourceId = SourceParam is { } sid && _sources.Any(s => s.Id == sid) ? sid : null;
        _search = string.IsNullOrWhiteSpace(SearchParam) ? null : SearchParam.Trim();
        _sinceLast = SinceParam == true && _lastBriefAt is not null;
        if (!adopted) _selected = Math.Max(0, RowParam ?? 0);   // adopted, the row Arrive selected stays while it's read again
        await Load();
        Arrive();
        if (!RendererInfo.IsInteractive && !_failed) PrerenderedState = Handoff.Keep(Me.UserId, this);
    }

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
    public string? PrerenderedState { get; set; }

    // The query shapes what's read and selected, so only a prerender of the same address is the page to keep.
    private bool SameAddress(Triage p) =>
        (p.TabParam, p.SourceParam, p.SearchParam, p.SinceParam, p.AtParam, p.RowParam, p.PromoteParam)
        == (TabParam, SourceParam, SearchParam, SinceParam, AtParam, RowParam, PromoteParam);

    // Takes what the prerendered page read and what its arrival selected or opened: everything the list draws from, so
    // the first interactive draw is the prerendered page again. True, to say there's a page on screen to keep.
    private bool Adopt(Triage p)
    {
        (_sources, _lastBriefAt, _status, _sourcesTab, _sourceId, _search, _sinceLast) = (p._sources, p._lastBriefAt, p._status, p._sourcesTab, p._sourceId, p._search, p._sinceLast);
        (_rows, _lines, _missed, _counts, _cves, _polled) = (p._rows, p._lines, p._missed, p._counts, p._cves, p._polled);
        (_olderCount, _readAt, _selected) = (p._olderCount, p._readAt, p._selected);
        (_promoting, _promotingGroup, _pf, _suggested) = (p._promoting, p._promotingGroup, p._pf, p._suggested);
        _open.UnionWith(p._open);
        _loaded = true;
        return true;
    }

    // Arriving at a row from the address: it's selected (Load found it by id, or kept its place), focused and scrolled
    // into view, with its promote form open when asked for. A report in a group opens the group to it.
    private void Arrive()
    {
        if (AtParam is not { } at || _lines.Count == 0) return;
        if (_rows.FirstOrDefault(r => r.Item.Id == at)?.Group is { } group && !group.Ids.Any(_apart.Contains) && !IsOpen(group))
        {
            _open.UnionWith(group.Ids);
            BuildLines();
        }
        SelectItem(at);
        if (PromoteParam == true && Current?.Row is { } row && row.Item.Id == at && Promotable(row.Item.Status)) OpenPromote(row);
        else _focus = "tideTriage.focusSelected";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _ref = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("tideTriage.start", _ref);
                // This browser's choices: the order, and the missed-stories notice hidden for this week.
                _missedHidden = await JS.InvokeAsync<string?>("tideTriage.pref", "missed-hidden") == ThisWeek;
                if (await JS.InvokeAsync<string?>("tideTriage.pref", "sort") == nameof(InboxSort.Likely))
                {
                    _sort = InboxSort.Likely;
                    await Load();
                }
                StateHasChanged();
            }
            // The promote form just opened (its title takes focus) or closed (the row gets it back).
            if (_focus is { } focus)
            {
                _focus = null;
                await JS.InvokeVoidAsync(focus);
            }
            // The form or the picker that held a colleague's changes back has closed: they show now.
            if (_waiting.Count > 0 && !Deferring && !_applying)
            {
                await ApplyWaiting();
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
    }

    // Selecting another row closes a promote form (or the attach picker) left open on this one. A row that arrived live
    // has been seen once it's selected: its "New" marker goes.
    private void Select(int i)
    {
        if (i != _selected)
        {
            _promoting = null;
            _promotingGroup = null;
            _attaching = false;
        }
        _selected = i;
        if (Current is not { } line) return;
        if (line.Row is { } row) _marks.Seen(row.Item.Id);
        else foreach (var m in line.Members) _marks.Seen(m.Item.Id);
    }

    /// <summary>Whether an item's title opens its promote form: in the inboxes still to decide (New, Shortlisted).</summary>
    internal static bool Promotable(FeedItemStatus status) => status is FeedItemStatus.New or FeedItemStatus.Shortlisted;

    // A click on a title: selects its row and opens the row's promote form, or puts focus back in a form already open.
    internal void PromoteFromTitle(int i)
    {
        if (i >= _lines.Count || _busy || _lines[i].Row is not { } row || !Promotable(row.Item.Status)) return;
        Select(i);
        if (_promoting == row.Item.Id && _promotingGroup is null) _focus = "tideTriage.focusPromote";
        else OpenPromote(row);
    }

    internal async Task SetStatus(FeedItemStatus status)
    {
        _sourcesTab = false;
        _status = status;
        _older = false;
        _selected = 0;
        _promoting = null;
        _promotingGroup = null;
        _attaching = false;
        _marks.Clear();
        // Every tab switch, not only one from Sources: a reload (or a link copied) after New → Shortlisted opened New.
        await RememberTab();
        await Load();
    }

    // Someone else triaged, or a poll brought items: re-read the list once per burst (LiveChanges skips this tab's own
    // changes), keeping the selected item selected and showing what changed: rows that arrive slide in highlighted,
    // rows that changed are highlighted, rows that left fade out saying who sent them where, the tab counts tick, and
    // one toast says what the colleague (or the feeds) did. Never under a promote form or the attach picker: there the
    // changes wait, and a pill says so, until it closes or the pill is chosen.
    private LiveChanges? _live;
    private LiveMarks<Guid> _marks = default!;
    private LiveMarks<FeedItemStatus>? _tabMarks;
    private readonly List<Change> _waiting = [];
    private bool _applying, _attaching, _disposed;
    private string? _said;               // the polite announcement of what the last live change did here
    private DateTimeOffset _readAt;      // when the rows were last read: an item fetched since came from the feeds

    private const string NewNote = " (new)";

    private bool Deferring => _busy || _promoting is not null || _attaching;

    private async Task Heard(IReadOnlyList<Change> heard)
    {
        if (_disposed) return;
        _waiting.AddRange(heard);
        if (Deferring)
        {
            _said = "Updates waiting. They show when you close this, or choose Updates waiting.";
            StateHasChanged();
            return;
        }
        await ApplyWaiting();
        StateHasChanged();
    }

    /// <summary>The "Updates waiting" pill: shows the changes held back now, the form left open.</summary>
    internal async Task ShowWaiting()
    {
        await ApplyWaiting();
        StateHasChanged();
    }

    // Shows the changes heard and held back.
    private async Task ApplyWaiting()
    {
        if (_waiting.Count == 0 || _applying) return;
        _applying = true;
        try
        {
            var heard = _waiting.ToList();
            _waiting.Clear();
            await Load(heard);
        }
        finally { _applying = false; }
    }

    // What this tab did, for the others: who, from which circuit (so this one skips it).
    private void Announce() => Changes.Publish(new Change(ChangeFeed.Triage, Me.UserId, Me.IsAuthenticated ? Me.DisplayName : "", Origin.Id));

    private static (Guid Id, bool Head) KeyOf(Line line) => (line.Row?.Item.Id ?? line.Group!.Newest, line.Row is null);

    private Task Load() => Load(null);

    // Counts the reads started, so only the latest one's rows are shown.
    private int _loads;

    // Reads the list. Live (with what was heard), it's compared with what was shown, and the differences are marked.
    private async Task Load(IReadOnlyList<Change>? heard)
    {
        // The selected line stays selected: the same item's row, or the same group's line (which a new report may have
        // joined). If a colleague took it away, the next line that's still there is selected instead.
        var reading = Time.GetUtcNow();
        var load = ++_loads;
        try
        {
            var status = _status;
            var sourcesTab = _sourcesTab;
            // The Sources tab shows no items: only the tab counts and the polled sources are read for it.
            var rows = sourcesTab ? [] : await Intake.InboxAsync(new InboxFilter(status, _sourceId, _search, Since: _sinceLast ? _lastBriefAt : null, Older: _older && status == FeedItemStatus.New, Sort: _sort));
            var missed = !sourcesTab && status == FeedItemStatus.New ? await Intake.MissedAsync() : [];
            var (counts, older) = await Intake.TallyAsync();
            var cves = await Cves.GetAsync(rows.SelectMany(r => r.Item.CveList));
            var polled = await Intake.PolledSourcesAsync();
            // A later read started meanwhile (more typing in the search box, another tab or filter, a colleague's change):
            // it shows the list as it's asked for now. These rows, read for what was asked before, would replace it if
            // they came back last.
            if (load != _loads) return;
            _failed = false;
            // What was shown, compared from here: a read that was dropped changed nothing on screen.
            var keep = Current is { } current ? KeyOf(current) : ((Guid Id, bool Head)?)null;
            var (rowsWere, linesWere, selectedWas, countsWere, readWas) = (_rows, _lines, _selected, _counts, _readAt);
            (_rows, _missed, _counts, _cves, _polled) = (rows, missed, counts, cves, polled);
            _olderCount = !sourcesTab && status == FeedItemStatus.New ? older : 0;
            _readAt = reading;
            BuildLines();
            var kept = keep is { } k && SelectItem(k.Id, k.Head);
            if (!kept && (keep is null || !SelectNextOf(linesWere, selectedWas))) _selected = Math.Clamp(_selected, 0, Math.Max(0, _lines.Count - 1));
            if (heard is null) _waiting.Clear();   // read afresh: whatever was waiting is in it
            else await ShowChanges(heard, rowsWere, countsWere, readWas, kept ? null : keep?.Id);
            // Someone else promoted or set aside the item being promoted, or one of the group's reports: its form goes,
            // and focus back to the list.
            if (_promoting is { } p && !StillPromoting(p))
            {
                _promoting = null;
                _promotingGroup = null;
                _focus = "tideTriage.focusRow";
            }
        }
        catch (Exception ex)
        {
            _failed = true;
            Toasts.Error(UserFacingError.For(ex));
        }
        _loaded = true;
    }

    // The line after the one that was selected (or else before it) that's still shown, selected; false when none is.
    private bool SelectNextOf(List<Line> was, int at)
    {
        for (var j = at + 1; j < was.Count; j++)
            if (SelectItem(KeyOf(was[j]).Id, KeyOf(was[j]).Head)) return true;
        for (var j = Math.Min(at, was.Count) - 1; j >= 0; j--)
            if (SelectItem(KeyOf(was[j]).Id, KeyOf(was[j]).Head)) return true;
        return false;
    }

    // A live reload's differences: marked on the rows and tabs, told in one toast (unless it was all this person's own
    // doing, in another tab) and announced. lostId is the item that was selected, if it's no longer shown.
    private async Task ShowChanges(IReadOnlyList<Change> heard, IReadOnlyList<InboxRow> was, IReadOnlyDictionary<FeedItemStatus, int> countsWere,
        DateTimeOffset readWas, Guid? lostId)
    {
        var diff = LiveDiff.Of(was, _rows, r => r.Item.Id, TriageNews.Signature);
        _tabMarks?.Mark(Tabs.Select(t => t.Item1).Where(s => countsWere.GetValueOrDefault(s) != _counts.GetValueOrDefault(s)), LiveMark.Changed);
        if (diff.IsEmpty) return;
        var colleagues = LiveChanges.Who(heard.Where(c => c.ActorId != "system"));
        var now = diff.Left.Count == 0 ? new Dictionary<Guid, FeedItem>() : (await Intake.ItemsAsync(diff.Left)).ToDictionary(i => i.Id);
        var titles = was.GroupBy(r => r.Item.Id).ToDictionary(g => g.Key, g => g.First().Item.Title);
        string Gone(Guid id) => TriageNews.Left(_status, titles[id], now.GetValueOrDefault(id), colleagues);
        _marks.Apply(diff, Gone, unseen: true);

        var polled = heard.Any(c => c.ActorId == "system");
        var newElsewhere = polled && _status != FeedItemStatus.New
            ? _counts.GetValueOrDefault(FeedItemStatus.New) - countsWere.GetValueOrDefault(FeedItemStatus.New) : 0;
        var arrived = diff.Arrived.Select(id => _rows.First(r => r.Item.Id == id).Item).ToList();
        var leftNow = diff.Left.Select(id => now.GetValueOrDefault(id)).ToList();
        var entered = _counts.GetValueOrDefault(_status) - countsWere.GetValueOrDefault(_status) + leftNow.Count(i => i is not null && i.Status != _status);
        var summary = TriageNews.Summary(_status, leftNow, arrived, readWas, colleagues, newElsewhere, entered);
        if (summary is not null && !heard.All(c => c.ActorId == Me.UserId)) Toasts.Show(summary);

        var said = new List<string>();
        if (diff.Arrived.Count > 0) said.Add($"{Items(diff.Arrived.Count)} arrived.");
        if (diff.Left.Count > 0) said.Add($"{Items(diff.Left.Count)} left this list.");
        if (diff.Changed.Count > 0) said.Add($"{Items(diff.Changed.Count)} changed.");
        if (lostId is { } lost && diff.Left.Contains(lost))
        {
            said.Add($"{Gone(lost)}. {(Current is null ? "The list is empty." : "The next item is selected.")}");
            _focus ??= "tideTriage.focusRow";   // its row went with focus in it: the next one takes focus (unless focus is elsewhere)
        }
        _said = string.Join(" ", said);
    }

    private static string Items(int n) => n == 1 ? "1 item" : $"{n} items";

    // The ghosts of rows that left, by the line they stand before (the list's length: at the end).
    private Dictionary<int, List<LiveGhost<Guid>>> GhostsByLine()
    {
        var at = new Dictionary<int, List<LiveGhost<Guid>>>();
        if (_marks is null) return at;
        foreach (var g in _marks.Ghosts)
        {
            var i = g.AtEnd ? -1 : _lines.FindIndex(l => l.Row?.Item.Id == g.Before || (l.Row is null && l.Group!.Ids.Contains(g.Before)));
            if (i < 0) i = _lines.Count;
            if (!at.TryGetValue(i, out var list)) at[i] = list = [];
            list.Add(g);
        }
        return at;
    }

    // A group's line is marked as its reports are: arrived if one arrived, else changed if one changed.
    private string GroupCss(Line line)
    {
        var css = line.Members.Select(m => _marks.Css(m.Item.Id)).Where(c => c.Length > 0).ToList();
        return css.Contains("tide-live-arrived") ? "tide-live-arrived" : css.FirstOrDefault() ?? "";
    }

    // A row that left: a line saying who sent it where, which fades and collapses (screen readers hear it from the
    // status line instead).
    private static RenderFragment Ghost(LiveGhost<Guid> g) =>
        @<li class="tide-live-ghost" @key="@("ghost-" + g.Key)" aria-hidden="true"><span class="bi bi-arrow-right-circle" aria-hidden="true"></span> @g.Text</li>;

    // Whether the form open on the selected line can stay: the item is still there to promote, or the group still holds
    // every report it held (it may have gained one, which the form then takes too).
    private bool StillPromoting(Guid id)
    {
        if (_promotingGroup is { } was)
        {
            if (Current is not { Row: null, Group: { } now } || !was.Ids.All(now.Ids.Contains)) return false;
            _promotingGroup = now;
            _promoting = now.Newest;
            return true;
        }
        return Current?.Row is { } row && row.Item.Id == id && row.Item.Status != FeedItemStatus.Promoted;
    }

    [JSInvokable]
    public async Task OnTriageKey(string action)
    {
        if (_sourcesTab)
        {
            StateHasChanged();   // no items there: the letters and arrows have nothing to act on
            return;
        }
        if (_promoting is not null)
        {
            // The form has the keys (triage.js sends only Esc while it's open).
            if (action == "cancel") CancelPromote();
            StateHasChanged();
            return;
        }
        switch (action)
        {
            case "next": _selected = Math.Min(_selected + 1, Math.Max(0, _lines.Count - 1)); await Follow(); break;
            case "prev": _selected = Math.Max(_selected - 1, 0); await Follow(); break;
            case "read": await Read(); break;
            case "close-reading": _reading = false; break;
            // On a group's line, Enter opens or closes it and → opens it; ← closes the group a line is in.
            case "toggle": if (Current is { Row: null }) Toggle(_selected); break;
            case "expand": if (Current is { Row: null, Group: { } g } && !IsOpen(g)) Toggle(_selected); break;
            case "collapse": if (Current is { Group: { } open } && IsOpen(open)) Toggle(_selected); break;
            case "shortlist": await Act(TriageStep.Shortlist); break;
            case "dismiss": await Act(TriageStep.Dismiss); break;
            case "duplicate": await Act(TriageStep.Duplicate); break;
            case "promote": await Act(TriageStep.Promote); break;
            case "restore": await Act(TriageStep.Restore); break;
        }
        StateHasChanged();
    }

    private async Task Act(TriageStep what)
    {
        if (Current is not { } line || _busy) return;
        // A group's line promotes as one (P), and shortlists or dismisses all its reports (S, X) once confirmed; the
        // other letters act on one report at a time, in the open group.
        if (line.Row is not { } row)
        {
            if (what == TriageStep.Promote) OpenGroupPromote(line);
            else if (what is TriageStep.Shortlist or TriageStep.Dismiss && _status == FeedItemStatus.New) await ActOnGroup(line, what);
            return;
        }
        if (row.Item.Status == FeedItemStatus.Promoted) return;
        if (what == TriageStep.Duplicate && row.Similar is null) return;
        if (what == TriageStep.Promote)
        {
            OpenPromote(row);
            return;
        }
        _busy = true;
        try
        {
            switch (what)
            {
                case TriageStep.Shortlist: await Intake.ShortlistAsync(row.Item.Id); break;
                case TriageStep.Dismiss: await Intake.DismissAsync(row.Item.Id, _itemReason); break;
                case TriageStep.Duplicate: await Intake.MarkDuplicateAsync(row.Item.Id); break;
                case TriageStep.Restore: await Intake.RestoreAsync(row.Item.Id); break;
            }
            Announce();
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // Prefilled as most items go: the item's title, a threat when it names a CVE (informational otherwise), and the
    // source's TLP. A threat's priority is what its CVE data suggests (KEV, EPSS, CVSS), with the reason shown, or P3.
    private void OpenPromote(InboxRow row)
    {
        var item = row.Item;
        var threat = item.CveList.Any();
        _suggested = threat
            ? CveService.SuggestedPriority(item.CveList.Select(c => _cves.GetValueOrDefault(c)).OfType<CveRecord>(), item.Title, Clock.Today)
            : null;
        _pf = new PromoteForm
        {
            Title = item.Title.Length > ArticleService.MaxTitle ? item.Title[..(ArticleService.MaxTitle - 1)] + "…" : item.Title,
            Classification = threat ? Classification.Threat : Classification.Informational,
            Priority = threat ? _suggested?.Priority ?? Priority.P3 : null,
            Tlp = row.Source.DefaultTlp,
        };
        _promoting = item.Id;
        _promotingGroup = null;
        _focus = "tideTriage.focusPromote";
    }

    // "Promote as one article": the form prefilled from the newest report, a threat when any report names a CVE (the
    // priority suggested from all their CVEs), at the most restrictive of the sources' TLPs.
    internal void OpenGroupPromote(Line line)
    {
        if (line is not { Row: null, Group: { } group } || _busy) return;
        var lead = line.Members[0].Item;
        var cves = line.Members.SelectMany(m => m.Item.CveList).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var threat = cves.Count > 0;
        _suggested = threat
            ? CveService.SuggestedPriority(cves.Select(c => _cves.GetValueOrDefault(c)).OfType<CveRecord>(), lead.Title, Clock.Today)
            : null;
        _pf = new PromoteForm
        {
            Title = lead.Title.Length > ArticleService.MaxTitle ? lead.Title[..(ArticleService.MaxTitle - 1)] + "…" : lead.Title,
            Classification = threat ? Classification.Threat : Classification.Informational,
            Priority = threat ? _suggested?.Priority ?? Priority.P3 : null,
            Tlp = GroupTlp(line),
        };
        _promoting = group.Newest;
        _promotingGroup = group;
        _focus = "tideTriage.focusPromote";
    }

    private void SetPromotePriority(ChangeEventArgs e) =>
        _pf.Priority = Enum.TryParse<Priority>(e.Value?.ToString(), out var p) ? p : null;

    private void CancelPromote()
    {
        _promoting = null;
        _promotingGroup = null;
        _focus = "tideTriage.focusRow";
    }

    internal async Task SubmitPromote()
    {
        if (_promoting is not { } id || _busy) return;
        var group = _promotingGroup;
        _busy = true;
        try
        {
            var articleId = group is null ? await Intake.PromoteAsync(id, _pf) : await Intake.PromoteAsOneAsync(group.Ids, _pf);
            Announce();
            Toasts.Show(group is null ? "Promoted to a draft article." : $"Promoted {group.Ids.Count} reports as one draft article.");
            // The browser's Back comes back here, to this tab, these filters and this row (or the one that took its place).
            try { await JS.InvokeVoidAsync("tideTriage.remember", Address(_status, _sourceId, _search, _sinceLast, id, _selected)); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }   // rendered without a browser (prerendering, tests)
            Nav.NavigateTo($"articles/{articleId}");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // "Same CVE as 1 other new item": the inbox searched for that CVE, so the items sit together to compare. Clearing the
    // search box brings the rest back.
    internal async Task ShowSameCve(InboxRow row)
    {
        if (row.SharedCve is not { } cve) return;
        _search = cve;
        await Load();
        StateHasChanged();
    }

    // Search as you type, once typing pauses.
    private async Task SearchChanged()
    {
        if (await _typing.Settled()) await Load();
    }

    /// <summary>
    /// "Follow-up to Thu Oct 22: A-13, A-14 open": for an item covered before, the first brief that covered it and the
    /// actions still open on the articles that did. Null when no covering article has been briefed.
    /// </summary>
    internal static string? FollowUp(InboxRow row)
    {
        if (row.Coverage.Where(c => c.BriefDate is not null).MinBy(c => c.BriefDate) is not { BriefDate: { } first }) return null;
        var open = row.Coverage.SelectMany(c => c.OpenActions).Distinct().Order().Select(Ui.ActionLabel).ToList();
        return $"Follow-up to {Ui.ShortDay(first)}: " + (open.Count == 0 ? "no actions open" : string.Join(", ", open) + " open");
    }

    private async Task Attach(InboxRow row, Guid articleId, string title)
    {
        _busy = true;
        try
        {
            await Intake.AttachAsync(row.Item.Id, articleId);
            Announce();
            Toasts.Show($"Added as a source of “{Short(title)}”.");
            _focus = "tideTriage.focusRow";
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    private async Task DismissSameCve(InboxRow row)
    {
        if (!await _confirm.Ask("Dismiss the items with this CVE?", $"The {row.SameCve.Count} other new item(s) with this item's CVE are dismissed as already covered. The inbox is shared, so they go for everyone.", "Dismiss them")) return;
        _busy = true;
        try
        {
            var n = await Intake.DismissSameCveAsync(row.Item.Id, row.SameCve);
            Announce();
            Toasts.Show($"Dismissed {n} item{(n == 1 ? "" : "s")} as already covered.");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // The items the question counted: the list can reload while it's open (a poll, a colleague), and only what was
    // shown when it was asked goes.
    internal async Task AskDismissAll()
    {
        var shown = _rows.Select(r => r.Item.Id).ToList();
        var n = shown.Count;
        if (!await _dismissAll.Ask($"Dismiss all {n} shown?", "The inbox is shared.", $"Dismiss {n}")) return;
        await DismissAll(shown);
    }

    private async Task DismissAll(IReadOnlyList<Guid> ids)
    {
        _busy = true;
        try
        {
            var n = await Intake.DismissManyAsync(ids, _reason);
            Announce();
            Toasts.Show($"Dismissed {n} item{(n == 1 ? "" : "s")}.");
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _live?.Dispose();
        _marks?.Dispose();
        _tabMarks?.Dispose();
        if (_ticking is not null) await _ticking.DisposeAsync();
        await JS.StopAsync("tideTriage.stop");
        _ref?.Dispose();
    }
}
