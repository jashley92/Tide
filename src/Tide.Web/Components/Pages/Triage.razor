@page "/triage"
@attribute [Authorize(Policy = Policies.WriteArticles)]
@inject IntakeService Intake
@inject CveService Cves
@inject NavigationManager Nav
@inject ToastService Toasts
@inject OrgClock Clock
@inject IJSRuntime JS
@inject ChangeFeed Changes
@inject ChangeOrigin Origin
@inject ICurrentUser Me
@inject TimeProvider Time
@inject Microsoft.Extensions.Options.IOptionsMonitor<IntakeOptions> IntakeOpts
@inject Tide.Application.Stack.StackService Stack
@inject ReadingService Reading
@inject PrerenderHandoff Handoff
@implements IAsyncDisposable

<PageTitle>Triage · TIDE</PageTitle>

<div class="tide-page-head">
    <div>
        <h1>Triage</h1>
        <div class="tide-sub"><span class="tide-kbd">J</span>/<span class="tide-kbd">K</span> move,
            <span class="tide-kbd">S</span> shortlist, <span class="tide-kbd">X</span> dismiss, <span class="tide-kbd">D</span> duplicate,
            <span class="tide-kbd">P</span> promote to an article, <span class="tide-kbd">O</span> open the source, <span class="tide-kbd">V</span> read it here, <span class="tide-kbd">R</span> put back,
            <span class="tide-kbd">Enter</span> or <span class="tide-kbd">&rarr;</span> open a group.
            Times are @ZoneLabel.</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-outline-secondary" href="articles?new=1"><span class="bi bi-plus-lg" aria-hidden="true"></span> Write one by hand</a>
    </div>
</div>

<TabBar Label="Inbox" Items="@TabItems()" Active="@(_sourcesTab ? SourcesKey : _status.ToString())" OnSelect="SelectTab" />

@if (_sourcesTab)
{
    @* The polled sources in place of the list: when each was last pulled, and Pull now (held to the pull-now window). *@
    <div class="tide-card p-0">
        @if (!_loaded) { <LoadingBlock /> }
        else
        {
            <PolledSourcesTable Sources="_polled" Now="Time.GetUtcNow()" PollingOn="IntakeOpts.CurrentValue.Enabled" Window="Intake.PullWindow"
                                Pulling="_pulling" OnPull="Pull" />
        }
    </div>
}
else
{
<div class="tide-inbox-view">
<div class="tide-filters">
    <select class="tide-maxw-sm form-select form-select-sm" aria-label="Source" @bind="_sourceId" @bind:after="Load">
        <option value="">All sources</option>
        @foreach (var s in _sources) { <option value="@s.Id">@s.Name</option> }
    </select>
    <input class="tide-maxw-sm form-control form-control-sm" placeholder="Search titles and CVEs" aria-label="Search" @bind="_search" @bind:event="oninput" @bind:after="SearchChanged" />
    <div class="form-check mb-0">
        <input class="form-check-input" type="checkbox" id="since-last" @bind="_sinceLast" @bind:after="Load" disabled="@(_lastBriefAt is null)" />
        <label class="form-check-label small" for="since-last">Since the last brief@(_lastBriefAt is { } at ? $" ({Ui.When(Clock, at)})" : "")</label>
    </div>
    @if (_status is FeedItemStatus.New or FeedItemStatus.Shortlisted)
    {
        @* EP-81: newest first stays the default; "Likely used" is a choice this browser remembers. *@
        <div class="btn-group btn-group-sm" role="group" aria-label="Order">
            <button type="button" class="btn @(_sort == InboxSort.Newest ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@Ui.Aria(_sort == InboxSort.Newest)"
                    @onclick="() => SetSort(InboxSort.Newest)">Newest</button>
            <button type="button" class="btn @(_sort == InboxSort.Likely ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@Ui.Aria(_sort == InboxSort.Likely)"
                    title="By how many items like each one the team promoted. What we run, watched adversaries and KEV stay on top." @onclick="() => SetSort(InboxSort.Likely)">Likely used</button>
        </div>
    }
    @if (_status == FeedItemStatus.New && _rows.Count > 0)
    {
        <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="AskDismissAll">Dismiss all @_rows.Count shown…</button>
    }
    @* A colleague's change heard while a promote form or the attach picker is open waits, so the row being worked on
       doesn't move; it shows when the form closes, or now from here. *@
    @if (_waiting.Count > 0 && Deferring)
    {
        <button type="button" class="tide-live-pill" @onclick="ShowWaiting">
            <span class="tide-live-pill-dot" aria-hidden="true"></span> Updates waiting<span class="visually-hidden">: show them now</span>
        </button>
    }
    <span class="tide-muted small ms-auto">@(_sources.Count == 0 ? "No sources yet: an administrator adds them under Administration > Sources." : "")</span>
</div>

@if (_status == FeedItemStatus.New && !_older && _missed.Count > 0 && !_missedHidden)
{
    @* EP-81: a story dismissed this week that names a KEV-listed CVE or a watched adversary, and reached no brief. *@
    <div class="alert alert-warning tide-missed" role="status">
        <div><strong>Missed this week?</strong> @_missed.Count dismissed item@(_missed.Count == 1 ? "" : "s") name@(_missed.Count == 1 ? "s" : "") something we track, and no brief covered @(_missed.Count == 1 ? "it" : "them").</div>
        <ul class="tide-missed-list">
            @foreach (var m in _missed.Take(5))
            {
                <li><span class="fw-semibold">@m.Item.Title</span> <span class="tide-muted">· @m.SourceName · @m.Why.</span>
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" disabled="@_busy" @onclick="() => PutBack(m)">Put back in New</button></li>
            }
        </ul>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="HideMissed">Hide until next week</button>
    </div>
}

<div class="tide-triage-layout@(_reading ? " reading" : "")">
<div class="tide-card p-0">
    @if (_rows.Count == 0)
    {
        @if (_loaded)
        {
            <EmptyState Icon="@(_status == FeedItemStatus.New ? "bi-check2-circle" : "bi-inbox")" Title="@EmptyText" />
        }
        else
        {
            <LoadingBlock />
        }
    }
    @{ var ghosts = GhostsByLine(); }
    <ol class="tide-triage">
        @if (_older)
        {
            <li class="tide-triage-section">Older: new items untouched for @AgeText. KEV-listed ones, those with a high EPSS score and those naming a product on Our stack stay in New.
                <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="() => ShowOlder(false)">Back to New</button></li>
        }
        @foreach (var (line, i) in _lines.Select((l, i) => (l, i)))
        {
            foreach (var g in ghosts.GetValueOrDefault(i) ?? []) { @Ghost(g) }
            @* What names a product on Our stack comes first, under its own heading. *@
            @if (AnyWeRun && i == 0 && WeRunOf(line) is not null) { <li class="tide-triage-section" aria-hidden="true">Matches what we run</li> }
            @if (AnyWeRun && i > 0 && WeRunOf(line) is null && WeRunOf(_lines[i - 1]) is not null && line.Group is null) { <li class="tide-triage-section" aria-hidden="true">Everything else</li> }
            var selected = i == _selected;
            if (line.Row is null && line.Group is { } group)
            {
                var lead = line.Members[0];
                var open = IsOpen(group);
                @* A suggested group: one line for the event, the newest headline on it. It opens (its toggle, Enter or →)
                   to the reports themselves, each a row with all its actions. X and S (or their buttons) dismiss or
                   shortlist all its reports after a confirmation; nothing is merged or set aside without a click. *@
                var groupNew = line.Members.Any(m => _marks.IsUnseen(m.Item.Id));
                <li class="tide-triage-row tide-triage-group @(selected ? "selected" : "") @GroupCss(line)" aria-current="@(selected ? "true" : null)"
                    aria-label="@(GroupLabel(line) + (groupNew ? NewNote : ""))" tabindex="@(selected ? "0" : "-1")" @key="@("group-" + group.Newest)"
                    @onclick="() => Pick(i)" @onfocus="() => Pick(i)">
                    <div class="tide-triage-head">
                        <button type="button" class="tide-group-toggle" aria-expanded="@Ui.Aria(open)"
                                aria-label="@(open ? "Hide" : "Show") the @line.Members.Count reports" @onclick:stopPropagation="true" @onclick="() => Toggle(i)">
                            <span class="bi @(open ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                        </button>
                        <span class="tide-group-label"><span class="bi bi-collection" aria-hidden="true"></span> Looks like one event: @line.Members.Count reports · @group.Sources feeds</span>
                        @if (groupNew) { <span class="tide-live-new">New</span> }
                    </div>
                    <div class="tide-group-newest">Newest: <span class="tide-triage-title">“@lead.Item.Title”</span></div>
                    <div class="tide-triage-meta">
                        <span>@lead.Source.Name</span>
                        <span>@Ui.When(Clock, lead.Item.PublishedAtUtc ?? lead.Item.FetchedAtUtc)</span>
                        @if (WeRunOf(line) is { } groupRuns) { @WeRunChip(groupRuns) }
                        @if (group.Shared.Count > 0) { <span>In common: @string.Join(", ", group.Shared)</span> }
                        @foreach (var cve in group.Cves.Take(6)) { <CveChip CveId="@cve" Record="@_cves.GetValueOrDefault(cve)" /> }
                        @if (group.Cves.Count > 6) { <span>+@(group.Cves.Count - 6) more CVEs</span> }
                    </div>
                    @if (selected)
                    {
                        @if (_promoting == group.Newest && _promotingGroup is not null)
                        {
                            @PromoteFields(GroupTlp(line), $"From the sources: {Tlp.Label(GroupTlp(line))}, the most restrictive", $"Promote {line.Members.Count} as one and write")
                        }
                        else
                        {
                            <div class="d-flex gap-2 flex-wrap mt-2">
                                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => OpenGroupPromote(line)">
                                    <span class="bi bi-file-earmark-plus" aria-hidden="true"></span> Promote as one article (@line.Members.Count sources) <span class="tide-kbd">P</span></button>
                                @* Only new reports are shortlisted or dismissed as a group, as the S and X keys are. *@
                                @if (_status == FeedItemStatus.New)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => ActOnGroup(line, TriageStep.Shortlist)">Shortlist the @line.Members.Count <span class="tide-kbd">S</span></button>
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => ActOnGroup(line, TriageStep.Dismiss)">Dismiss the @line.Members.Count <span class="tide-kbd">X</span></button>
                                }
                                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Split(i)">Not the same: split</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick:stopPropagation="true" @onclick="() => Toggle(i)">@(open ? "Hide" : "Show") the @line.Members.Count reports</button>
                            </div>
                        }
                    }
                </li>
                continue;
            }
            var row = line.Row!;
            var item = row.Item;
            @* The rows are one tab stop, the selected one (triage.js moves focus with the selection); focusing a row,
               by Tab or a click, selects it. A report in an open group is indented under it, its excerpt always shown. *@
            var unseen = _marks.IsUnseen(item.Id);
            <li class="tide-triage-row@(line.Group is not null ? " tide-triage-member" : "") @(selected ? "selected" : "") @_marks.Css(item.Id)" aria-current="@(selected ? "true" : null)" aria-label="@(item.Title + (unseen ? NewNote : ""))"
                tabindex="@(selected ? "0" : "-1")" @key="item.Id" @onclick="() => Pick(i)" @onfocus="() => Pick(i)">
                <div class="d-flex gap-2 align-items-start">
                    <div class="flex-grow-1">
                        @* The title does what the tab is for: in New and Shortlisted it opens the row's promote form (as P
                           does); a promoted item's goes to its article; a dismissed or duplicate one's just selects the row.
                           The source opens from its own icon (or O), in a new tab. *@
                        <div class="tide-triage-head">
                            @if (Promotable(item.Status))
                            {
                                <button type="button" class="tide-triage-title tide-triage-title-btn" title="Promote to an article" disabled="@_busy"
                                        @onclick:stopPropagation="true" @onclick="() => PromoteFromTitle(i)">@item.Title</button>
                            }
                            else if (item.Status == FeedItemStatus.Promoted && item.ArticleId is { } articleId)
                            {
                                <a class="tide-triage-title" href="articles/@articleId" title="Open the article" @onclick:stopPropagation="true">@item.Title</a>
                            }
                            else
                            {
                                <span class="tide-triage-title">@item.Title</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <a class="tide-triage-link tide-triage-source" href="@item.Url" target="_blank" rel="noopener noreferrer"
                                   title="Open the source in a new tab" aria-label="Open the source in a new tab" @onclick:stopPropagation="true"><span class="bi bi-box-arrow-up-right" aria-hidden="true"></span></a>
                            }
                            @if (unseen) { <span class="tide-live-new">New</span> }
                            @* Who else has this item selected; selecting it here joins them. *@
                            <PresenceNote Place="@($"triage:{item.Id}")" Join="selected" Compact="true" />
                        </div>
                        <div class="tide-triage-meta">
                            <span>@row.Source.Name</span>
                            <span class="tide-reliability" title="Source reliability (Admiralty scale)">@row.Source.Reliability</span>
                            <TlpBadge Level="row.Source.DefaultTlp" />
                            @if (row.WeRun is { } runs) { @WeRunChip(runs) }
                            @if (row.Watching is { } watching)
                            {
                                <a class="tide-badge tide-badge-warn tide-werun-chip" href="@($"adversaries/{watching.Id}")" title="A watched adversary: open its profile" @onclick:stopPropagation="true">Watching: @watching.Name</a>
                            }
                            <span>@Ui.When(Clock, item.PublishedAtUtc ?? item.FetchedAtUtc)</span>
                            @foreach (var cve in item.CveList.Take(6)) { <CveChip CveId="@cve" Record="@_cves.GetValueOrDefault(cve)" /> }
                            @if (row.Similar is { } sim) { <Badge Tone="BadgeTone.Warn" Title="@sim.Title" Class="tide-badge-wrap">Looks like: @Short(sim.Title)</Badge> }
                            @if (row.SameCve.Count > 0)
                            {
                                <button type="button" class="tide-badge tide-badge-warn tide-badge-wrap tide-chip-button" title="@($"Show the items with {row.SharedCve}")"
                                        @onclick:stopPropagation="true" @onclick="() => ShowSameCve(row)">Same CVE as @row.SameCve.Count other new item@(row.SameCve.Count == 1 ? "" : "s")</button>
                            }
                            @foreach (var c in row.Coverage)
                            {
                                <Badge Tone="BadgeTone.Info" Class="tide-badge-wrap">@c.Why covered@(c.BriefDate is { } d ? $" {Ui.ShortDay(d)}" : ""): <a href="articles/@c.ArticleId" @onclick:stopPropagation="true">@Short(c.ArticleTitle)</a></Badge>
                            }
                            @if (item.Status == FeedItemStatus.Dismissed && item.DismissReason is not null) { <span>Dismissed: @item.DismissReason</span> }
                            @if (item.Status != FeedItemStatus.New && item.StatusByName is not null)
                            {
                                <span>by @item.StatusByName@(item.StatusAtUtc is { } decidedAt ? ", " + Ui.When(Clock, decidedAt) : "")</span>
                            }
                            @if (item.Status == FeedItemStatus.Promoted && item.ArticleId is { } aid) { <a href="articles/@aid" @onclick:stopPropagation="true">Open the article</a> }
                        </div>
                        @if (item.Status != FeedItemStatus.Promoted && FollowUp(row) is { } followUp) { <div class="tide-triage-follow">@followUp</div> }
                        @if (row.Likely is { } likely) { <div class="tide-triage-likely"><span class="tide-likely-count">@likely.Promoted/@likely.Decided</span> @likely.Why</div> }
                    </div>
                </div>
                @if (!selected && line.Group is not null && !string.IsNullOrWhiteSpace(item.Excerpt)) { <div class="tide-triage-excerpt">@item.Excerpt</div> }
                @if (selected)
                {
                    @if (!string.IsNullOrWhiteSpace(item.Excerpt)) { <div class="tide-triage-excerpt">@item.Excerpt</div> }
                    @if (!string.IsNullOrWhiteSpace(row.Source.LicenseNote)) { <div class="small text-danger mb-2"><span class="bi bi-shield-exclamation" aria-hidden="true"></span> @row.Source.LicenseNote</div> }
                    @if (item.Status != FeedItemStatus.Promoted && (row.Coverage.Any(c => c.Attachable) || (item.Status == FeedItemStatus.New && row.SameCve.Count > 0)))
                    {
                        @* One story, many reports: keep a follow-up's link on the article that covers it, and set the rest aside. *@
                        <div class="d-flex gap-2 flex-wrap mb-2">
                            @foreach (var c in row.Coverage.Where(c => c.Attachable).DistinctBy(c => c.ArticleId).Take(3))
                            {
                                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Attach(row, c.ArticleId, c.ArticleTitle)">
                                    <span class="bi bi-link-45deg" aria-hidden="true"></span> Add as a source of “@Short(c.ArticleTitle)”</button>
                            }
                            @if (item.Status == FeedItemStatus.New && row.SameCve.Count > 0)
                            {
                                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => DismissSameCve(row)">
                                    Dismiss the @row.SameCve.Count other@(row.SameCve.Count == 1 ? "" : "s") with its CVE as covered</button>
                            }
                        </div>
                    }
                    @if (_promoting == item.Id && _promotingGroup is null && item.Status != FeedItemStatus.Promoted)
                    {
                        @PromoteFields(row.Source.DefaultTlp, $"From the source: {Tlp.Label(row.Source.DefaultTlp)}", "Promote and write")
                    }
                    else
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            @if (item.Status != FeedItemStatus.Promoted)
                            {
                                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Promote)"><span class="bi bi-file-earmark-plus" aria-hidden="true"></span> Promote <span class="tide-kbd">P</span></button>
                                @if (item.Status != FeedItemStatus.Shortlisted) { <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Shortlist)">Shortlist <span class="tide-kbd">S</span></button> }
                                @if (item.Status != FeedItemStatus.Dismissed)
                                {
                                    <select class="form-select form-select-sm w-auto" aria-label="Reason for dismissing it" @bind="_itemReason" @onclick:stopPropagation="true">
                                        @foreach (var r in IntakeService.DismissReasons) { <option value="@r">@r</option> }
                                    </select>
                                }
                                @if (item.Status != FeedItemStatus.Dismissed) { <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Dismiss)">Dismiss <span class="tide-kbd">X</span></button> }
                                @if (row.Similar is not null && item.Status != FeedItemStatus.Duplicate) { <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Duplicate)">Duplicate <span class="tide-kbd">D</span></button> }
                                @if (item.Status != FeedItemStatus.New) { <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Restore)">Put back <span class="tide-kbd">R</span></button> }
                                @if (Promotable(item.Status)) { <AttachPicker Disabled="_busy" OnPick="t => Attach(row, t.Id, t.Title)" OpenChanged="open => _attaching = open" /> }
                                @if (row.WeRun is null)
                                {
                                    @if (_addingStack == item.Id)
                                    {
                                        <span class="d-inline-flex gap-1 align-items-center" @onclick:stopPropagation="true">
                                            <label class="visually-hidden" for="stack-add-@item.Id">Product we run</label>
                                            <input id="stack-add-@item.Id" class="form-control form-control-sm w-auto" maxlength="100" placeholder="Product, e.g. GitLab"
                                                   @bind="_stackName" @bind:event="oninput" @onkeydown="StackKey" />
                                            <button type="button" class="btn btn-primary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_stackName))" @onclick="AddToStack">Add</button>
                                            <button type="button" class="btn btn-link btn-sm" @onclick="() => _addingStack = null">Cancel</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => { _addingStack = item.Id; _stackName = null; }">Add to what we run…</button>
                                    }
                                }
                            }
                        </div>
                    }
                }
            </li>
        }
        @foreach (var g in ghosts.GetValueOrDefault(_lines.Count) ?? []) { @Ghost(g) }
    </ol>
    @if (_status == FeedItemStatus.New && !_older && _olderCount > 0)
    {
        @* Untouched items fold away rather than pile up: kept, searchable, and a click away. *@
        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="() => ShowOlder(true)">
            <span class="bi bi-archive" aria-hidden="true"></span> Older: @_olderCount new item@(_olderCount == 1 ? "" : "s") untouched for @AgeText</button>
    }
    @* The list holds the newest InboxFilter.Take items; say so when there are more, rather than end as if that's all. *@
    @if (_rows.Count >= ShownAtMost && _counts.GetValueOrDefault(_status) > _rows.Count)
    {
        <p class="small tide-muted mt-2 mb-0">Showing the newest @_rows.Count of @_counts.GetValueOrDefault(_status). Choose a source or search to reach older ones.</p>
    }
</div>
@if (_reading) { @ReadingPane() }
</div>
</div>
}
@* What changed live, in words: the toast says what a colleague did; this says what it did to the list here. *@
<div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@_said</div>

<ConfirmDialog @ref="_confirm" />
@* "Dismiss all": the reason goes with every one of them, so it's chosen in the confirmation. *@
<ConfirmDialog @ref="_dismissAll">
    <label class="tide-field-label" for="dismiss-all-reason">Dismiss them as</label>
    <select id="dismiss-all-reason" class="form-select form-select-sm mb-2" @bind="_reason">
        @foreach (var r in IntakeService.DismissReasons) { <option value="@r">@r</option> }
    </select>
</ConfirmDialog>

@code {
    private ConfirmDialog _confirm = default!, _dismissAll = default!;

    // The reading pane (EP-76): the selected item's article, fetched from its page on V (or "Read it here") and kept for
    // colleagues and the editor. While it's open it follows the selection, showing a report's text when it's kept and
    // offering to read it when it isn't; nothing is fetched without a keypress or a click. A group's line reads its
    // newest report.
    private bool _reading;
    private Guid? _fetching;   // the item being fetched, one at a time
    private ReadingText? _read;
    private InboxRow? _readRow;
    private IReadOnlyDictionary<string, CveRecord> _readCves = new Dictionary<string, CveRecord>();

    // Whether the item the pane shows is the one being fetched.
    private bool ReadingBusy => _fetching is { } f && f == _readRow?.Item.Id;

    private InboxRow? ReadableRow => Current is { } line ? line.Row ?? line.Members.FirstOrDefault() : null;

    // Selecting a line by click or focus: the pane follows it.
    private async Task Pick(int i)
    {
        var was = _selected;
        Select(i);
        if (i != was) await Follow();
    }

    // The pane shows the newly selected item's kept text, or offers to read it.
    private async Task Follow()
    {
        if (!_reading) return;
        var row = ReadableRow;
        if (row?.Item.Id == _readRow?.Item.Id) return;
        _readRow = row;
        _read = null;
        if (row is null) return;
        try { await Show(await Reading.KeptAsync(row.Item.Id)); }
        catch (Exception ex) when (ex is ArgumentException or ForbiddenException) { Toasts.Error(UserFacingError.For(ex)); }
    }

    /// <summary>V or "Read it here": opens the pane on the selected item and fetches its text when it isn't kept.</summary>
    internal async Task Read(bool again = false)
    {
        if (ReadableRow is not { } row || _fetching is not null) return;
        _reading = true;
        if (!again && _readRow?.Item.Id == row.Item.Id && _read is { HasText: true }) return;
        _readRow = row;
        _read = null;
        _fetching = row.Item.Id;
        StateHasChanged();
        try { await Show(await Reading.ReadAsync(row.Item.Id, again)); }
        catch (Exception ex) when (ex is ArgumentException or ForbiddenException) { await Show(ReadingText.Failed(row.Item.Id, UserFacingError.For(ex))); }
        finally { _fetching = null; }
    }

    // A slow fetch can finish after the selection moved on: its text is dropped unless its item is still the one shown.
    private async Task Show(ReadingText? text)
    {
        if (text is not null && text.ItemId != _readRow?.Item.Id) return;
        _read = text;
        _readCves = text is { Cves.Count: > 0 } ? await Cves.GetAsync(text.Cves) : new Dictionary<string, CveRecord>();
    }

    private static string MarkCss(ReadingMark m) => m switch
    {
        ReadingMark.Cve => "tide-read-cve",
        ReadingMark.Indicator => "tide-read-ioc",
        ReadingMark.WeRun => "tide-read-werun",
        _ => "",
    };

    private RenderFragment ReadingPane() => __builder =>
    {
        var row = _readRow;
        <aside class="tide-card tide-reading" aria-label="The article" aria-busy="@Ui.Aria(ReadingBusy)">
