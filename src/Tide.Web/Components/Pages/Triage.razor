@page "/triage"
@attribute [Authorize(Policy = Policies.WriteArticles)]
@inject IntakeService Intake
@inject SourcePollGuard Polls
@inject CveService Cves
@inject NavigationManager Nav
@inject ToastService Toasts
@inject OrgClock Clock
@inject IJSRuntime JS
@inject ChangeFeed Changes
@inject ChangeOrigin Origin
@inject ICurrentUser Me
@inject TimeProvider Time
@inject Microsoft.Extensions.Options.IOptionsMonitor<IntakeOptions> IntakeOpts
@inject Tide.Application.Stack.StackService Stack
@inject ReadingService Reading
@inject PrerenderHandoff Handoff
@inject UserPreferenceService Prefs
@using Tide.Application.Preferences
@using Tide.Web.Components.TriageRail
@implements IAsyncDisposable

<PageTitle>Triage · TIDE</PageTitle>

<div class="tide-page-head">
    <div>
        <h1>Triage</h1>
        @* The keys in one line: the ones used most. Every other key (S, X, D, O, R, Esc, Enter and the arrows) is on its
           button and in the shortcuts list that ? opens (Shortcuts.Triage). *@
        <div class="tide-sub tide-triage-keys"><span class="tide-kbd">J</span>/<span class="tide-kbd">K</span> move, <span class="tide-kbd">P</span> promote,
            <span class="tide-kbd">V</span> read it here or close it, <span class="tide-kbd">?</span> every key. Times are @ZoneLabel.</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-outline-secondary" href="articles?new=1"><span class="bi bi-plus-lg" aria-hidden="true"></span> Write one by hand</a>
    </div>
</div>

<TabBar Label="Inbox" Items="@TabItems()" Active="@(_sourcesTab ? SourcesKey : _status.ToString())" OnSelect="SelectTab" />

@if (_sourcesTab)
{
    @* The polled sources in place of the list: when each was last pulled, and Pull now (held to the pull-now window). *@
    <div class="tide-card p-0">
        @if (!_loaded) { <LoadingBlock /> }
        else
        {
            <PolledSourcesTable Sources="_polled" Now="Time.GetUtcNow()" PollingOn="IntakeOpts.CurrentValue.Enabled" Window="Intake.PullWindow"
                                Pulling="_pulling" OnPull="Pull">
                <Actions><PullAllButton @ref="_pullAll" Disabled="@(_pulling is not null)" OnStep="s => _pulling = s.Id" OnDone="AfterPull" /></Actions>
            </PolledSourcesTable>
        }
    </div>
}
else
{
<div class="tide-inbox-view">
@* The filter bar (FilterBar): the words, the pills, the source under + Filter. What we'd act on first: items naming a CVE
   (or one on CISA's KEV list, as TIDE's CVE records say), or a product on Our stack. Names a CVE and KEV are one filter
   (cve=), so they take turns. *@
<FilterBar Pills="Pills" Filters="Defs" Active="Narrowed" OnChanged="Refilter" OnClear="ClearFilters"
           Count="@(_loaded && _rows.Count > 0 ? CountText : null)">
    <Search>
        <input class="tide-maxw-sm form-control form-control-sm" placeholder="Search titles and CVEs" aria-label="Search" @bind="_search" @bind:event="oninput" @bind:after="SearchChanged" />
    </Search>
    <ChildContent>
    @if (_status is FeedItemStatus.New or FeedItemStatus.Shortlisted)
    {
        @* EP-81: newest first stays the default; "Likely used" is a choice this browser remembers. *@
        <div class="btn-group btn-group-sm" role="group" aria-label="Order">
            <button type="button" class="btn @(_sort == InboxSort.Newest ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@Ui.Aria(_sort == InboxSort.Newest)"
                    @onclick="() => SetSort(InboxSort.Newest)">Newest</button>
            <button type="button" class="btn @(_sort == InboxSort.Likely ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@Ui.Aria(_sort == InboxSort.Likely)"
                    title="By how many items like each one the team promoted. What we run, watched adversaries and KEV stay on top." @onclick="() => SetSort(InboxSort.Likely)">Likely used</button>
        </div>
    }
    @if (_status == FeedItemStatus.New && _rows.Count > 0)
    {
        <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="AskDismissAll">Dismiss all @_rows.Count shown…</button>
    }
    @* A colleague's change heard while a promote form or the attach picker is open waits, so the row being worked on
       doesn't move; it shows when the form closes, or now from here. *@
    @if (_waiting.Count > 0 && Deferring)
    {
        <button type="button" class="tide-live-pill" @onclick="ShowWaiting">
            <span class="tide-live-pill-dot" aria-hidden="true"></span> Updates waiting<span class="visually-hidden">: show them now</span>
        </button>
    }
    @if (_sources.Count == 0)
    {
        <span class="tide-muted small">No sources yet: an administrator adds them under Administration > Sources.</span>
    }
    </ChildContent>
</FilterBar>

@if (_status == FeedItemStatus.New && !_older && _missed.Count > 0)
{
    @* EP-81: a story dismissed this week that names a KEV-listed CVE or a watched adversary, and reached no brief. *@
    var shown = _missed.Take(MissedShown).ToList();
    <div class="alert alert-warning tide-missed" role="status">
        <div><strong>Missed this week?</strong> @_missed.Count dismissed item@(_missed.Count == 1 ? "" : "s") name@(_missed.Count == 1 ? "s" : "") something we track, and no brief covered @(_missed.Count == 1 ? "it" : "them").</div>
        <ul class="tide-missed-list">
            @foreach (var m in shown)
            {
                <li><span class="fw-semibold">@m.Item.Title</span> <span class="tide-muted">· @m.SourceName · @m.Why.</span>
                    <span class="tide-missed-acts">
                        <button type="button" class="btn btn-link btn-sm p-0" disabled="@_busy" @onclick="() => PutBack(m)">Put back in New</button>
                        <button type="button" class="btn btn-link btn-sm p-0" disabled="@_busy" @onclick="() => KeepDismissed([m])">Right to dismiss</button>
                    </span></li>
            }
        </ul>
        @if (shown.Count > 1)
        {
            <button type="button" class="btn btn-link btn-sm p-0" disabled="@_busy" @onclick="() => KeepDismissed(shown)">@(shown.Count == _missed.Count ? $"All {shown.Count} were right to dismiss" : $"These {shown.Count} were right to dismiss")</button>
        }
    </div>
}

@* The reading pane, until the person opens or closes it: there only where the window is 1400px or wider (app.css,
   "Triage 2.4"), so it's drawn from the first render, with no flash, whatever the width. *@
<div class="tide-triage-layout@(ReadingCss)">
<div class="tide-card p-0">
    @if (_rows.Count == 0)
    {
        @if (_loaded)
        {
            <EmptyState Icon="@(_status == FeedItemStatus.New ? "bi-check2-circle" : "bi-inbox")" Title="@EmptyText" />
        }
        else
        {
            <LoadingBlock />
        }
    }
    @{ var ghosts = GhostsByLine(); }
    <ol class="tide-triage">
        @if (_older)
        {
            <li class="tide-triage-section">Older: new items untouched for @AgeText. KEV-listed ones, those with a high EPSS score and those naming a product on Our stack stay in New.
                <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="() => ShowOlder(false)">Back to New</button></li>
        }
        @foreach (var (line, i) in _lines.Select((l, i) => (l, i)))
        {
            foreach (var g in ghosts.GetValueOrDefault(i) ?? []) { @Ghost(g) }
            @* What names a product on Our stack comes first, under its own heading. *@
            @if (AnyWeRun && i == 0 && WeRunOf(line) is not null) { <li class="tide-triage-section" aria-hidden="true">Matches what we run</li> }
            @if (AnyWeRun && i > 0 && WeRunOf(line) is null && WeRunOf(_lines[i - 1]) is not null && line.Group is null) { <li class="tide-triage-section" aria-hidden="true">Everything else</li> }
            var selected = i == _selected;
            if (line.Row is null && line.Group is { } group)
            {
                var lead = line.Members[0];
                var open = IsOpen(group);
                @* A suggested group: one line for the event, the newest headline on it. It opens (its toggle, Enter or →)
                   to the reports themselves, each a row with all its actions. X and S (or their buttons) dismiss or
                   shortlist all its reports after a confirmation; nothing is merged or set aside without a click. *@
                var groupNew = line.Members.Any(m => _marks.IsUnseen(m.Item.Id));
                var attachAll = AttachTo(line);
                <li class="tide-triage-row tide-triage-group @RowSelection.Css(selected) @GroupCss(line)" aria-current="@RowSelection.Current(selected)"
                    aria-label="@(GroupLabel(line) + (groupNew ? NewNote : ""))" tabindex="@RowSelection.TabIndex(selected)" @key="@("group-" + group.Newest)"
                    @onclick="() => Pick(i)" @onfocus="() => Pick(i)">
                    <div class="tide-triage-head">
                        <button type="button" class="tide-group-toggle" aria-expanded="@Ui.Aria(open)"
                                aria-label="@(open ? "Hide" : "Show") the @line.Members.Count reports" @onclick:stopPropagation="true" @onclick="() => Toggle(i)">
                            <span class="bi @(open ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                        </button>
                        <span class="tide-group-label"><span class="bi bi-collection" aria-hidden="true"></span> Looks like one event: @line.Members.Count reports · @group.Sources feeds</span>
                        @if (groupNew) { <span class="tide-live-new">New</span> }
                    </div>
                    <div class="tide-group-newest">Newest: <span class="tide-triage-title">“@lead.Item.Title”</span></div>
                    <div class="tide-triage-meta">
                        <span>@lead.Source.Name</span>
                        <span>@Ui.When(Clock, lead.Item.PublishedAtUtc ?? lead.Item.FetchedAtUtc)</span>
                        @if (group.Shared.Count > 0) { <span>In common: @string.Join(", ", group.Shared)</span> }
                        @foreach (var cve in group.Cves.Take(6)) { <CveChip CveId="@cve" Record="@_cves.GetValueOrDefault(cve)" /> }
                        @if (group.Cves.Count > 6) { <span>+@(group.Cves.Count - 6) more CVEs</span> }
                        @* The group's flags, in the rows' order (see a row's flags). *@
                        <span class="tide-triage-flags">
                            @if (WeRunOf(line) is { } groupRuns) { @TriageNamed.WeRunChip(groupRuns) }
                        </span>
                        @if (attachAll is not null) { <div class="tide-triage-covers">@CoveredFlag(attachAll, group.Cves.Count)</div> }
                    </div>
                    @if (selected && !DecisionInBar) { @Decision(line, i) }
                </li>
                continue;
            }
            var row = line.Row!;
            var item = row.Item;
            @* The rows are one tab stop, the selected one (rows.js moves focus with the selection); focusing a row,
               by Tab or a click, selects it. A report in an open group is indented under it, its excerpt always shown. *@
            var unseen = _marks.IsUnseen(item.Id);
            <li class="tide-triage-row@(line.Group is not null ? " tide-triage-member" : "") @RowSelection.Css(selected) @_marks.Css(item.Id)" aria-current="@RowSelection.Current(selected)" aria-label="@(item.Title + (unseen ? NewNote : ""))"
                tabindex="@RowSelection.TabIndex(selected)" @key="item.Id" @onclick="() => Pick(i)" @onfocus="() => Pick(i)">
                <div class="d-flex gap-2 align-items-start">
                    <div class="flex-grow-1 tide-triage-body">
                        @* The title does what the tab is for: in New and Shortlisted it opens the row's promote form (as P
                           does); a promoted item's goes to its article; a dismissed or duplicate one's just selects the row.
                           The source opens from its own icon (or O), in a new tab. *@
                        <div class="tide-triage-head">
                            @if (Promotable(item.Status))
                            {
                                <button type="button" class="tide-triage-title tide-triage-title-btn" title="Promote to an article" disabled="@_busy"
                                        @onclick:stopPropagation="true" @onclick="() => PromoteFromTitle(i)">@item.Title</button>
                            }
                            else if (item.Status == FeedItemStatus.Promoted && item.ArticleId is { } articleId)
                            {
                                <a class="tide-triage-title" href="articles/@articleId" title="Open the article" @onclick:stopPropagation="true">@item.Title</a>
                            }
                            else
                            {
                                <span class="tide-triage-title">@item.Title</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <a class="tide-triage-link tide-triage-source" href="@item.Url" target="_blank" rel="noopener noreferrer"
                                   title="Open the source in a new tab" aria-label="Open the source in a new tab" @onclick:stopPropagation="true"><span class="bi bi-box-arrow-up-right" aria-hidden="true"></span></a>
                            }
                            @if (unseen) { <span class="tide-live-new">New</span> }
                            @* Who else has this item selected; selecting it here joins them. *@
                            <PresenceNote Place="@($"triage:{item.Id}")" Join="selected" Compact="true" />
                        </div>
                        <div class="tide-triage-meta">
                            <span>@row.Source.Name</span>
                            <span class="tide-reliability" title="Source reliability (Admiralty scale)">@row.Source.Reliability</span>
                            <TlpBadge Level="row.Source.DefaultTlp" />
                            <span>@Ui.When(Clock, item.PublishedAtUtc ?? item.FetchedAtUtc)</span>
                            @foreach (var cve in item.CveList.Take(6)) { <CveChip CveId="@cve" Record="@_cves.GetValueOrDefault(cve)" /> }
                            @if (item.Status == FeedItemStatus.Dismissed && item.DismissReason is not null) { <span>Dismissed: @item.DismissReason</span> }
                            @if (item.DismissKept)
                            {
                                <span title="Said right to dismiss when Missed this week? asked">kept by @item.DismissKeptByName, @Ui.When(Clock, item.DismissKeptAtUtc!.Value)</span>
                            }
                            @if (item.Status != FeedItemStatus.New && item.StatusByName is not null)
                            {
                                <span>by @item.StatusByName@(item.StatusAtUtc is { } decidedAt ? ", " + Ui.When(Clock, decidedAt) : "")</span>
                            }
                            @* Where a split group's line was (its newest report): who said its reports aren't one event, and Undo. *@
                            @if (row.Split is { } split)
                            {
                                <span><span class="bi bi-scissors" aria-hidden="true"></span> Split by @split.ByName, @Ui.When(Clock, split.AtUtc)
                                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" disabled="@_busy" aria-label="@($"Undo the split of {split.Reports} reports")"
                                            @onclick:stopPropagation="true" @onclick="() => UndoSplit(split.Batch)">Undo</button></span>
                            }
                            @if (item.Status == FeedItemStatus.Promoted && item.ArticleId is { } aid) { <a href="articles/@aid" @onclick:stopPropagation="true">Open the article</a> }
                            @* The flags: after what the item is (source, TLP, date, CVEs), at the end of the line, always in this
                               order, from what most changes the decision to what least: we run it (we're exposed), a watched
                               adversary, already covered (attach rather than promote), the same CVE as other new items (decide
                               them together), and looks like an earlier item (maybe a duplicate). The short chips we run and
                               watching stay on the CVEs' line; each coverage is a line of its own, then the rest. *@
                            <span class="tide-triage-flags">
                                @if (row.WeRun is { } runs) { @TriageNamed.WeRunChip(runs) }
                                @if (row.Watching is { } watching) { @TriageNamed.WatchingChip(watching) }
                            </span>
                            @if (row.Coverage.Count > 0)
                            {
                                var cves = item.CveList.Count();
                                <div class="tide-triage-covers">
                                    @foreach (var c in row.Coverage) { @CoveredFlag(c, cves) }
                                </div>
                            }
                            <span class="tide-triage-flags">
                                @if (row.SameCve.Count > 0)
                                {
                                    <button type="button" class="tide-badge tide-badge-warn tide-badge-wrap tide-chip-button" title="@($"Show the items with {row.SharedCve}")"
                                            @onclick:stopPropagation="true" @onclick="() => ShowSameCve(row)">Same CVE as @row.SameCve.Count other new item@(row.SameCve.Count == 1 ? "" : "s")</button>
                                }
                                @* Not inside an open group when it names a report of the same group: the group says so already. *@
                                @if (row.Similar is { } sim && row.Group?.Ids.Contains(sim.Id) != true) { <Badge Tone="BadgeTone.Warn" Title="@sim.Title" Class="tide-badge-wrap">Looks like: @Short(sim.Title)</Badge> }
                            </span>
                        </div>
                        @if (item.Status != FeedItemStatus.Promoted && FollowUp(row) is { } followUp) { <div class="tide-triage-follow">@followUp</div> }
                        @if (row.Likely is { } likely) { <div class="tide-triage-likely"><span class="tide-likely-count">@likely.Promoted/@likely.Decided</span> @likely.Why</div> }
                    </div>
                </div>
                @if (!selected && line.Group is not null && !string.IsNullOrWhiteSpace(item.Excerpt)) { <div class="tide-triage-excerpt">@item.Excerpt</div> }
                @if (selected)
                {
                    @* With the reading pane shown the item's text is there, and its buttons are in the bar under it. *@
                    @if (!DecisionInBar && !string.IsNullOrWhiteSpace(item.Excerpt)) { <div class="tide-triage-excerpt">@item.Excerpt</div> }
                    @if (!string.IsNullOrWhiteSpace(row.Source.LicenseNote)) { <div class="small text-danger mb-2"><span class="bi bi-shield-exclamation" aria-hidden="true"></span> @row.Source.LicenseNote</div> }
                    @if (!DecisionInBar) { @Decision(line, i) }
                }
            </li>
        }
        @foreach (var g in ghosts.GetValueOrDefault(_lines.Count) ?? []) { @Ghost(g) }
    </ol>
    @if (_status == FeedItemStatus.New && !_older && _olderCount > 0)
    {
        @* Untouched items fold away rather than pile up: kept, searchable, and a click away. *@
        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="() => ShowOlder(true)">
            <span class="bi bi-archive" aria-hidden="true"></span> Older: @_olderCount new item@(_olderCount == 1 ? "" : "s") untouched for @AgeText</button>
    }
    @* A page at a time, every page a link (the address is the page's); J on the last row and K on the first go on to the
       next and back to the previous one. *@
    <Pager Page="_page" Pages="Pages" Many="items" Href="PageHref" />
</div>
@if (_reading) { @ReadingPane() }
</div>
</div>
@* What TIDE knows about the selected line, in the context rail (MainLayout draws it after the content). *@
<ContextRail Title="What TIDE knows">@Rail()</ContextRail>
}
@* What changed live, in words: the toast says what a colleague did; this says what it did to the list here. *@
<div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@_said</div>

<ConfirmDialog @ref="_confirm" />
@* "Dismiss all": the reason goes with every one of them, so it's chosen in the confirmation. *@
<ConfirmDialog @ref="_dismissAll">
    <label class="tide-field-label" for="dismiss-all-reason">Dismiss them as</label>
    <select id="dismiss-all-reason" class="form-select form-select-sm mb-2" @bind="_reason">
        @foreach (var r in IntakeService.DismissReasons) { <option value="@r">@r</option> }
    </select>
</ConfirmDialog>

@code {
    private ConfirmDialog _confirm = default!, _dismissAll = default!;

    // The reading pane (EP-76): the selected item's article, fetched from its page on V (or "Read it here") and kept for
    // colleagues and the editor. While it's open it follows the selection, showing a report's text when it's kept and
    // offering to read it when it isn't; nothing is fetched without a keypress or a click. A group's line reads its
    // newest report.
    // Whether it's open is the person's (UserPreferences.TriageReading), kept on the server rather than in the browser:
    // the prerender reads it, so the first paint already has the pane or not, with no flash. Until they choose, it's open
    // by itself where the window is wide (reading-auto, by width in app.css); V opens it at every width, and Esc or its
    // close button closes it, each remembered.
    private string _readingPref = UserPreferences.ReadingAuto;
    private bool _reading => _readingPref != UserPreferences.ReadingClosed;

    private string ReadingCss => !_reading ? "" : _readingPref == UserPreferences.ReadingAuto ? " reading reading-auto" : " reading";
    private Guid? _fetching;   // the item being fetched, one at a time
    private ReadingText? _read;
    private InboxRow? _readRow;
    private IReadOnlyDictionary<string, CveRecord> _readCves = new Dictionary<string, CveRecord>();

    // Whether the item the pane shows is the one being fetched.
    private bool ReadingBusy => _fetching is { } f && f == _readRow?.Item.Id;

    private InboxRow? ReadableRow => Current is { } line ? line.Row ?? line.Members.FirstOrDefault() : null;

    // Selecting a line by click or focus: the pane follows it.
    private async Task Pick(int i)
    {
        var was = _selected;
        Select(i);
        if (i != was) await Follow();
    }

    // The pane shows the newly selected item's kept text, or offers to read it. Hidden (opened by itself on a window too
    // narrow for it), it reads nothing until it's shown (OnReadingRoom).
    private async Task Follow()
    {
        if (!PaneShown) return;
        var row = ReadableRow;
        if (row?.Item.Id == _readRow?.Item.Id) return;
        _readRow = row;
        _read = null;
        if (row is null) return;
        try { await Show(await Reading.KeptAsync(row.Item.Id)); }
        catch (Exception ex) when (ex is ArgumentException or ForbiddenException) { Toasts.Error(UserFacingError.For(ex)); }
    }

    // Whether the window is wide enough for the pane that opened by itself (app.css shows it from 1400px), as triage.js
    // reports it: null until it has.
    private bool? _roomForPane;

    /// <summary>triage.js: the window became wide enough for the pane that opened by itself, or too narrow for it.</summary>
    [JSInvokable]
    public async Task OnReadingRoom(bool room)
    {
        if (_roomForPane == room) return;
        _roomForPane = room;
        await Follow();   // shown now: it catches up with the selection
        StateHasChanged();
    }

    // The pane is on screen: open, and either chosen (it shows at every width) or with the room to show by itself.
    private bool PaneShown => _reading && (_readingPref != UserPreferences.ReadingAuto || _roomForPane != false);

    /// <summary>V or "Read it here": opens the pane on the selected item and fetches its text when it isn't kept.</summary>
    internal async Task Read(bool again = false)
    {
        if (ReadableRow is not { } row || _fetching is not null) return;
        // Open from here on (kept for the next visit while the text is read, not before it).
        var kept = KeepReading(UserPreferences.ReadingOpen);
        try
        {
            // One fetch per item from V: once it has been tried (its text, or why it failed, shown), V doesn't fetch it again;
            // "Read again" and the pane's "Read it here" after a failure do.
            if (!again && _readRow?.Item.Id == row.Item.Id && _read is not null) return;
            _readRow = row;
            _read = null;
            _fetching = row.Item.Id;
            StateHasChanged();
            try { await Show(await Reading.ReadAsync(row.Item.Id, again)); }
            catch (Exception ex) when (ex is ArgumentException or ForbiddenException) { await Show(ReadingText.Failed(row.Item.Id, UserFacingError.For(ex))); }
            finally { _fetching = null; }
        }
        finally { await kept; }
    }

    /// <summary>V with the pane shown (triage.js knows; below 1400px one open by itself isn't): it reads the item when
    /// it hasn't been read, and otherwise closes, so V opens and closes the pane in turn.</summary>
    internal Task ToggleReading()
    {
        if (_fetching is not null) return Task.CompletedTask;
        return _read is null && ReadableRow is not null ? Read() : CloseReading();
    }

    /// <summary>Esc or the pane's close button: closed, and kept closed.</summary>
    internal Task CloseReading() => KeepReading(UserPreferences.ReadingClosed);

    // The person's choice: shown at once, and kept for their next visit (a failure to keep it changes nothing on screen).
    private async Task KeepReading(string pref)
    {
        if (_readingPref == pref) return;
        _readingPref = pref;
        try { await Prefs.SetAsync(UserPreferences.TriageReading, pref); }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    // A slow fetch can finish after the selection moved on: its text is dropped unless its item is still the one shown.
    private async Task Show(ReadingText? text)
    {
        if (text is not null && text.ItemId != _readRow?.Item.Id) return;
        _read = text;
        _readCves = text is { Cves.Count: > 0 } ? await Cves.GetAsync(text.Cves) : new Dictionary<string, CveRecord>();
    }

    private static string MarkCss(ReadingMark m) => m switch
    {
        ReadingMark.Cve => "tide-read-cve",
        ReadingMark.Indicator => "tide-read-ioc",
        ReadingMark.WeRun => "tide-read-werun",
        _ => "",
    };

    private RenderFragment ReadingPane() => __builder =>
    {
        var row = _readRow;
        <aside class="tide-card tide-reading" aria-label="The article" aria-busy="@Ui.Aria(ReadingBusy)">
            <div class="tide-reading-head">
                <h2 class="tide-reading-title">@(row?.Item.Title ?? "Choose an item to read")</h2>
                @* Reading it here, again, or on its site, beside its title; the bar at the foot is for deciding. *@
                @if (row is not null)
                {
                    <span class="tide-reading-tools">
                        @if (_read is { HasText: true })
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@ReadingBusy" @onclick="() => Read(again: true)"><span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Read again</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_fetching is not null)" @onclick="() => Read(again: _read is not null)"><span class="bi bi-book" aria-hidden="true"></span> Read it here <span class="tide-kbd">V</span></button>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.Item.Url))
                        {
                            <a class="btn btn-outline-secondary btn-sm" href="@row.Item.Url" target="_blank" rel="noopener noreferrer"><span class="bi bi-box-arrow-up-right" aria-hidden="true"></span> Open the site <span class="tide-kbd">O</span></a>
                        }
                    </span>
                }
                <button type="button" class="btn-close" aria-label="Close the article" title="Close (Esc)" @onclick="CloseReading"></button>
            </div>
            @if (row is not null)
            {
                <div class="tide-triage-meta mb-2">
                    <span>@row.Source.Name</span>
                    @if (_read is { HasText: true } r)
                    {
                        <span>@r.Length.ToString("N0") characters</span>
                        @if (r.FetchedAtUtc is { } at) { <span>read @Ui.When(Clock, at)</span> }
                        @if (r.How is { Length: > 0 } how) { <span>body found by @how</span> }
                    }
                </div>
                @if (ReadingBusy)
                {
                    <LoadingBlock />
                }
                else if (_read is { HasText: true } text)
                {
                    <div class="tide-reading-text" tabindex="0" aria-label="The article's text">
                        @foreach (var span in text.Spans)
                        {
                            if (span.Mark == ReadingMark.None) { @span.Text }
                            else { <mark class="@MarkCss(span.Mark)">@span.Text</mark> }
                        }
                    </div>
                    <div class="tide-reading-found small">
                        @foreach (var cve in text.Cves.Take(8)) { <CveChip CveId="@cve" Record="@_readCves.GetValueOrDefault(cve)" /> }
                        <span>@Found(text)</span>
                    </div>
                }
                else if (_read is { Problem: { } problem })
                {
                    <div class="alert alert-warning small" role="status">@problem</div>
                    @if (!string.IsNullOrWhiteSpace(row.Item.Excerpt)) { <div class="tide-triage-excerpt">@row.Item.Excerpt</div> }
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(row.Item.Excerpt)) { <div class="tide-triage-excerpt">@row.Item.Excerpt</div> }
                    <p class="small tide-muted">Not read yet.</p>
                }
            }
            @if (DecisionInBar && Current is { } line) { @Decision(line, _selected) }
        </aside>
    };

    // The selected line's buttons are in the bar at the foot of the reading pane while it's on screen; with the pane
    // closed, or hidden on a window too narrow for it, they stay in the selected row.
    private bool DecisionInBar => PaneShown;

    // The selected line's decision: why its main button is the main one, then the buttons, the main one first (or its
    // promote form). In the bar, the buttons are one row and the article's title in Attach gives way; in a row they
    // are one row while there's room, and wrap where there isn't.
    private RenderFragment Decision(Line line, int i) =>
        @<section class="tide-triage-decide" aria-label="Decide on this item">@DecisionBody(line, i)</section>;

    private RenderFragment DecisionBody(Line line, int i) => __builder =>
    {
        var attachTo = AttachTo(line);
        if (line.Row is not { } row)
        {
            var group = line.Group!;
            var n = line.Members.Count;
            <p class="tide-triage-why">@Suggestion(attachTo, line.Members.SelectMany(m => m.Coverage).FirstOrDefault(), n, Clock.Today)</p>
            if (_promoting == group.Newest && _promotingGroup is not null)
            {
                @PromoteFields(GroupTlp(line), $"From the sources: {Tlp.Label(GroupTlp(line))}, the most restrictive", $"Promote {n} as one and write")
                return;
            }
            <div class="tide-triage-acts">
                @* Covered by an article that can still take reports: attaching them all is the main button, one step. *@
                <span class="tide-triage-main">
                @if (attachTo is not null)
                {
                    <button class="btn btn-primary btn-sm tide-triage-attach" disabled="@_busy" title="@($"Attach all {n} to “{attachTo.ArticleTitle}”")"
                            @onclick:stopPropagation="true" @onclick="() => AttachLine(line, attachTo)">
                        <span class="bi bi-link-45deg" aria-hidden="true"></span> Attach all @n to <span class="tide-triage-attach-title text-truncate">“@attachTo.ArticleTitle”</span></button>
                }
                @* The other buttons' words after the first (tide-triage-long) give way in the bar, so the main button keeps
                   its own; each says them in full to a screen reader and on hover. *@
                <button class="btn @(attachTo is null ? "btn-primary" : "btn-outline-secondary") btn-sm tide-triage-promote" disabled="@_busy" aria-keyshortcuts="P"
                        aria-label="@($"Promote as one article ({n} sources)")" title="@($"Promote as one article ({n} sources)")" @onclick:stopPropagation="true" @onclick="() => OpenGroupPromote(line)">
                    <span class="bi bi-file-earmark-plus" aria-hidden="true"></span> Promote as one<span class="tide-triage-long"> article (@n sources)</span> <span class="tide-kbd">P</span></button>
                </span>
                @* Only new reports are shortlisted or dismissed as a group, as the S and X keys are. *@
                @if (_status == FeedItemStatus.New)
                {
                    <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" aria-keyshortcuts="S" aria-label="@($"Shortlist the {n}")" title="@($"Shortlist the {n}")"
                            @onclick:stopPropagation="true" @onclick="() => ActOnGroup(line, TriageStep.Shortlist)">Shortlist<span class="tide-triage-long"> the @n</span> <span class="tide-kbd">S</span></button>
                    <span class="tide-triage-end">
                        <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" aria-keyshortcuts="X" aria-label="@($"Dismiss the {n}")" title="@($"Dismiss the {n}")"
                                @onclick:stopPropagation="true" @onclick="() => ActOnGroup(line, TriageStep.Dismiss)">Dismiss<span class="tide-triage-long"> the @n</span> <span class="tide-kbd">X</span></button>
                    </span>
                }
            </div>
            <div class="tide-triage-more">
                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" title="For everyone: these reports won't be grouped together again"
                        @onclick:stopPropagation="true" @onclick="() => Split(i)">Not the same: split</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick:stopPropagation="true" @onclick="() => Toggle(i)">@(IsOpen(group) ? "Hide" : "Show") the @n reports</button>
            </div>
            return;
        }
        var item = row.Item;
        if (item.Status == FeedItemStatus.Promoted)
        {
            <p class="tide-triage-why">Promoted already: its article opens from the row.</p>
            return;
        }
        <p class="tide-triage-why">@Suggestion(attachTo, row.Coverage.FirstOrDefault(), 1, Clock.Today)</p>
        if (_promoting == item.Id && _promotingGroup is null)
        {
            @PromoteFields(row.Source.DefaultTlp, $"From the source: {Tlp.Label(row.Source.DefaultTlp)}", "Promote and write")
            return;
        }
        <div class="tide-triage-acts">
            @* Covered by an article that can still take it: attaching it there is the main button; P still promotes. *@
            <span class="tide-triage-main">
            @if (attachTo is not null)
            {
                <button class="btn btn-primary btn-sm tide-triage-attach" disabled="@_busy" title="@($"Attach to “{attachTo.ArticleTitle}”")"
                        @onclick:stopPropagation="true" @onclick="() => AttachLine(line, attachTo)">
                    <span class="bi bi-link-45deg" aria-hidden="true"></span> Attach to <span class="tide-triage-attach-title text-truncate">“@attachTo.ArticleTitle”</span></button>
            }
            <button class="btn @(attachTo is null ? "btn-primary" : "btn-outline-secondary") btn-sm tide-triage-promote" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Promote)"><span class="bi bi-file-earmark-plus" aria-hidden="true"></span> Promote <span class="tide-kbd">P</span></button>
            </span>
            @if (item.Status != FeedItemStatus.Shortlisted) { <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Shortlist)">Shortlist <span class="tide-kbd">S</span></button> }
            @if (row.Similar is not null && item.Status != FeedItemStatus.Duplicate) { <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Duplicate)">Duplicate <span class="tide-kbd">D</span></button> }
            @if (item.Status != FeedItemStatus.New) { <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Restore)">Put back <span class="tide-kbd">R</span></button> }
            @* Attach to… with the other ways to take it on: an article being written, rather than a new one. *@
            @if (Promotable(item.Status)) { <AttachPicker Disabled="_busy" OnPick="t => Attach([row.Item.Id], t.Id, t.Title)" OpenChanged="open => _attaching = open" /> }
            @if (item.Status != FeedItemStatus.Dismissed)
            {
                <span class="tide-triage-end">
                    <select class="form-select form-select-sm tide-triage-reason" aria-label="Reason for dismissing it" @bind="_itemReason" @onclick:stopPropagation="true">
                        @foreach (var r in IntakeService.DismissReasons) { <option value="@r">@r</option> }
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Act(TriageStep.Dismiss)">Dismiss <span class="tide-kbd">X</span></button>
                </span>
            }
        </div>
        @* One story, many reports: keep a follow-up's link on another article that covers it, or set the rest aside. (What
           we run is named from the context rail.) *@
        List<Coverage> otherArticles = attachTo is null ? [] : row.Coverage.Where(c => c.Attachable && c.ArticleId != attachTo.ArticleId).DistinctBy(c => c.ArticleId).Take(2).ToList();
        <div class="tide-triage-more">
            @foreach (var c in otherArticles)
            {
                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => Attach([row.Item.Id], c.ArticleId, c.ArticleTitle)">
                    <span class="bi bi-link-45deg" aria-hidden="true"></span> Add as a source of “@Short(c.ArticleTitle)”</button>
            }
            @if (item.Status == FeedItemStatus.New && row.SameCve.Count > 0)
            {
                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick:stopPropagation="true" @onclick="() => DismissSameCve(row)">
                    Dismiss the @row.SameCve.Count other@(row.SameCve.Count == 1 ? "" : "s") with its CVE as covered</button>
            }
        </div>
    };

    /// <summary>
    /// The decision's first line: why its main button is the main one, from what the line's coverage says. Attach when an
    /// article that can still take a report covers it (<paramref name="attachTo"/>); otherwise promote, saying whether
    /// something covers it (<paramref name="covered"/>) that can't take it. Only what the row's flags already show is named.
    /// </summary>
    internal static string Suggestion(Coverage? attachTo, Coverage? covered, int reports, DateOnly today = default)
    {
        var one = reports == 1;
        if (attachTo is { } to)
            return $"Already covered by “{Short(to.ArticleTitle)}”{(TriageNews.BriefedSaid(to, today) is { } when ? $" ({when})" : "")}, so the suggested step is to "
                + (one ? "attach it as another report." : $"attach all {reports} as more reports of it.");
        if (covered is { } c)
            return $"Covered by “{Short(c.ArticleTitle)}”, which cannot take another report now, so the suggested step is to "
                + (one ? "promote it as a new article." : $"promote the {reports} as one new article.");
        return one ? "Nothing TIDE has covers it yet, so the suggested step is to promote it."
            : $"Nothing TIDE has covers them yet, so the suggested step is to promote the {reports} as one article.";
    }

    // The context rail: what TIDE already keeps about the selected line (a report, or every report of a group's line). It
    // reads only what's stored, never a source: the CVE records the list read, the coverage the list's flags show (and,
    // through their services, that article's open actions and story), the group, and what it names of Our stack and the
    // watched adversaries. Its buttons are the page's own paths.
    private RenderFragment Rail() => __builder =>
    {
        if (Current is not { } line)
        {
            <section class="tide-card"><p class="small tide-muted mb-0">Choose an item to see what TIDE knows about it.</p></section>
            return;
        }
        IReadOnlyList<InboxRow> reports = line.Row is { } one ? [one] : line.Members;
        var first = reports[0].Item;
        <TriageCveFacts Cves="@([.. reports.SelectMany(r => r.Item.CveList).Distinct(StringComparer.OrdinalIgnoreCase)])" Records="_cves" Title="@first.Title" Today="Clock.Today" />
        <TriageCovered Coverage="@Covering(line, reports)">
            <Then>
                @if (SameEventLine is { } head)
                {
                    <TriageSameEvent Members="head.Members" Selected="line.Row?.Item.Id" AttachTo="AttachTo(head)" Busy="_busy"
                                     OnAttach="AttachSameEvent" OnSplit="SplitSameEvent" OnPick="PickReport" />
                }
            </Then>
        </TriageCovered>
        <TriageNamed @key="KeyOf(line)" WeRun="WeRunOf(line)" Watching="reports.Select(r => r.Watching).FirstOrDefault(w => w is not null)" Busy="_busy"
                     Add="@(first.Status == FeedItemStatus.Promoted && line.Row is not null ? null : AddToStack)" />
    };

    // The articles covering a line, one each: the one its main button attaches it to first, then the rest as its flags
    // list them.
    private static List<Coverage> Covering(Line line, IReadOnlyList<InboxRow> reports)
    {
        var all = reports.SelectMany(r => r.Coverage);
        if (AttachTo(line) is { } to) all = all.Prepend(to);
        return [.. all.DistinctBy(c => c.ArticleId)];
    }

    // The group's line for the selected line (itself, or the group a report under it is in): what the rail's Same event acts on.
    private Line? SameEventLine => Current is { Group: { } g } ? _lines.Find(l => l.Row is null && l.Group!.Newest == g.Newest) : null;

    /// <summary>The rail's Attach both (all N): the group's own all-or-none attach, as its main button.</summary>
    internal Task AttachSameEvent() => SameEventLine is { } head && AttachTo(head) is { } to ? AttachLine(head, to) : Task.CompletedTask;

    /// <summary>The rail's Not the same: the group split for everyone, as its bar's button does.</summary>
    internal Task SplitSameEvent() => SameEventLine is { } head ? Split(_lines.IndexOf(head)) : Task.CompletedTask;

    /// <summary>A report chosen in the rail's Same event: its group opens to it, and it's selected (the pane follows).</summary>
    internal async Task PickReport(Guid id)
    {
        if (_rows.FirstOrDefault(r => r.Item.Id == id)?.Group is { } group && !IsOpen(group))
        {
            _open.UnionWith(group.Ids);
            BuildLines();
        }
        if (_lines.FindIndex(l => l.Row?.Item.Id == id) is >= 0 and var at)
        {
            await Pick(at);
            _focus = "tideTriage.focusRow";   // the link picked may go with the selection: its row takes focus
        }
    }

    /// <summary>"Found here: 2 CVEs · 3 indicators · Our stack: GitLab".</summary>
    internal static string Found(ReadingText text)
    {
        var parts = new List<string>();
        if (text.Cves.Count > 0) parts.Add($"{text.Cves.Count} CVE{(text.Cves.Count == 1 ? "" : "s")}");
        if (text.Indicators.Count > 0) parts.Add($"{text.Indicators.Count} indicator{(text.Indicators.Count == 1 ? "" : "s")}");
        if (text.WeRun.Count > 0) parts.Add("Our stack: " + string.Join(", ", text.WeRun));
        return parts.Count == 0 ? "No CVEs, indicators or products we run found in it." : "Found here: " + string.Join(" · ", parts);
    }

    internal enum TriageStep { Shortlist, Dismiss, Duplicate, Promote, Restore }

    private static readonly (FeedItemStatus, string)[] Tabs =
    [
        (FeedItemStatus.New, "New"), (FeedItemStatus.Shortlisted, "Shortlisted"), (FeedItemStatus.Promoted, "Promoted"),
        (FeedItemStatus.Dismissed, "Dismissed"), (FeedItemStatus.Duplicate, "Duplicates"),
    ];

    private FeedItemStatus _status = FeedItemStatus.New;

    // The Sources tab (?tab=sources): the polled sources in place of an inbox, last of the tabs and set apart from them.
    internal const string SourcesKey = "Sources";
    private bool _sourcesTab;
    private IReadOnlyList<PolledSource> _polled = [];
    private Guid? _pulling;          // the source this tab is pulling now
    private ITimer? _ticking;        // re-renders the Sources tab's times ("12 min ago") as they pass

    /// <summary>How many polled sources' last poll failed: the Sources tab's count, a warning (none: no count).</summary>
    internal static int? FailingCount(IEnumerable<PolledSource> sources) => sources.Count(s => s.Failing) is > 0 and var n ? n : null;

    private List<TabBarItem> TabItems() =>
    [
        .. Tabs.Select(t => new TabBarItem(t.Item2, "", Key: t.Item1.ToString(), Count: _counts.GetValueOrDefault(t.Item1), Ticked: _tabMarks?.IsMarked(t.Item1) == true)),
        new TabBarItem("Sources", "", Icon: "bi-rss", Key: SourcesKey, Count: FailingCount(_polled), Warning: "failing", Apart: true),
    ];

    private Task SelectTab(string? key) => key == SourcesKey ? ShowSources() : SetStatus(Enum.Parse<FeedItemStatus>(key!));

    /// <summary>Shows the Sources tab.</summary>
    internal async Task ShowSources()
    {
        _sourcesTab = true;
        _older = false;
        _promoting = null;
        _promotingGroup = null;
        _attaching = false;
        _marks.Clear();
        await RememberTab();
        await Load();
    }

    // The tab, filters and page go in the address (?tab=sources), so a reload or a copied link opens them.
    private async Task RememberTab()
    {
        var address = _sourcesTab ? "triage?tab=sources" : PageHref(_page);
        _addressPage = _sourcesTab ? 1 : _page;
        try { await JS.InvokeVoidAsync("tideRows.remember", address); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }   // rendered without a browser (prerendering, tests)
    }

    // A page of this tab, with its filters: the pager's links, and the address a filter change writes.
    private string PageHref(int page) => Address(_status, _sourceId, _search, _sinceLast, null, 0, page, _cveFilter, _named, _older && _status == FeedItemStatus.New);

    // The filter bar's pills, each a preset of a filter: Names a CVE and KEV are both cve=, so they take turns. The
    // source is under + Filter (a chip while one is chosen); its options are built as the sources are read.
    internal IReadOnlyList<FilterPill> Pills =>
    [
        new("since", "Since last brief", "since", FilterValues.Of(true))
        {
            Disabled = _lastBriefAt is null, Title = _lastBriefAt is { } at ? $"Since the last brief ({Ui.When(Clock, at)})" : "No brief has been sent yet",
        },
        new("cve", "Names a CVE", "cve", [nameof(InboxCves.Any)]),
        new("kev", "KEV", "cve", [nameof(InboxCves.Kev)]) { Title = "Names a CVE on CISA's Known Exploited Vulnerabilities list" },
        new("named", "We run it", "named", FilterValues.Of(true)) { Title = "Names a product on Our stack" },
    ];

    private IReadOnlyList<FilterOption> _sourceOptions = [];

    internal IReadOnlyList<FilterDef> Defs =>
    [
        new("source", "Source", FilterKind.Single, v => _sourceId = Guid.TryParse(FilterValues.First(v), out var id) && _sources.Any(s => s.Id == id) ? id : null)
        {
            Options = _sourceOptions, Values = FilterValues.Of(_sourceId?.ToString()),
        },
        new("since", "Since last brief", FilterKind.Single, v => _sinceLast = v.Count > 0 && _lastBriefAt is not null) { InMenu = false, Values = FilterValues.Of(_sinceLast) },
        new("cve", "CVEs", FilterKind.Single, v => _cveFilter = FilterValues.Enum<InboxCves>(v) ?? InboxCves.All)
        {
            InMenu = false, Values = _cveFilter == InboxCves.All ? [] : [_cveFilter.ToString()],
        },
        new("named", "We run it", FilterKind.Single, v => _named = v.Count > 0) { InMenu = false, Values = FilterValues.Of(_named) },
    ];

    private bool Narrowed => _sourceId is not null || !string.IsNullOrWhiteSpace(_search) || _sinceLast || _cveFilter != InboxCves.All || _named;

    // Clear: the words and every filter; the tab and the order stay.
    internal Task ClearFilters()
    {
        (_sourceId, _search, _sinceLast, _cveFilter, _named) = (null, null, false, InboxCves.All, false);
        return Refilter();
    }

    /// <summary>A filter changed: its first page, and the address says so.</summary>
    internal async Task Refilter()
    {
        _page = 1;
        _selected = 0;
        _marks.Clear();
        await Load();
        await RememberTab();
    }

    /// <summary>Shows another page of the list (the pager's links come here through the address; J and K at its ends
    /// directly), selecting its first row, or with <paramref name="last"/> its last.</summary>
    internal async Task GoToPage(int page, bool last = false)
    {
        if (_sourcesTab) return;
        _page = Math.Max(1, page);
        _selected = 0;
        _promoting = null;
        _promotingGroup = null;
        _attaching = false;
        _marks.Clear();
        await Load();
        if (last) _selected = RowSelection.Last(_lines.Count);
        Select(_selected);
        _said = $"Page {_page} of {Pages}.";
        _focus = "tideRows.focusSelected";
        await RememberTab();
        await Follow();
    }

    /// <summary>Pull now on the Sources tab: the source is polled (unless it was within the pull-now window, or is being
    /// pulled), the row and the tab counts are read again, and the other open pages hear of it as of a poll.</summary>
    internal async Task Pull(Guid id)
    {
        if (_pulling is not null) return;
        var name = _polled.FirstOrDefault(s => s.Id == id)?.Name ?? "the source";
        _pulling = id;
        try
        {
            var result = await Intake.PullNowAsync(id);
            if (result.Error is null) Toasts.Show($"Pulled {name}: {PullTimes.NewItems(result.New)}.");
            else Toasts.Error($"Pulled {name}, but it failed: {result.Error}");
            Changes.Publish(new Change(ChangeFeed.Triage, "system", "", Origin.Id));
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        await AfterPull();
    }

    // A pull, or Pull all, ended: the rows and the tab counts are read again.
    private async Task AfterPull()
    {
        _pulling = null;
        await Load();
        StateHasChanged();
    }

    private PullAllButton? _pullAll;

    // A source's poll or someone's Pull all started or ended, anywhere: the Sources tab's rows say which are being pulled,
    // so they're read again (a reload during someone's run, or a page watching it, isn't left showing "Pulling…").
    private void PollsChanged() => _ = InvokeAsync(async () =>
    {
        if (!_sourcesTab || !_loaded || _disposed) return;
        _polled = await Intake.PolledSourcesAsync();
        StateHasChanged();
    });

    /// <summary>Pull all on the Sources tab: each source due a pull, one at a time, its row showing it as it's pulled.</summary>
    internal Task PullAll() => _pullAll?.RunAsync() ?? Task.CompletedTask;

    private Guid? _sourceId;
    private string? _search;
    private string _reason = IntakeService.DismissReasons[0];       // for "dismiss all"
    private string _itemReason = IntakeService.DismissReasons[0];   // for one item (X)
    private bool _sinceLast;
    private InboxSort _sort;
    private IReadOnlyList<MissedItem> _missed = [];
    private DateTimeOffset? _lastBriefAt;
