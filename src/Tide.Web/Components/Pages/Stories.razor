@page "/stories"
@page "/stories/{Id:guid}"
@attribute [Authorize(Policy = Policies.ReadTeamEdition)]
@inject StoryService StorySvc
@inject StoryArticleService StoryArticles
@inject CveService Cves
@inject ActionService ActionSvc
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject ToastService Toasts
@inject OrgClock Clock
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@implements IDisposable

<PageTitle>@(_detail?.Story.Name ?? "Stories") · TIDE</PageTitle>

@if (Id is null)
{
    <div class="tide-page-head">
        <div>
            <h1>Threat stories</h1>
            <GuideLink />
        </div>
    </div>
    @if (_canWrite)
    {
        <div class="tide-card-form tide-card">
            <h2>New story</h2>
            <div class="row g-2">
                <div class="col-md-5"><input class="form-control form-control-sm" maxlength="200" placeholder="Name (e.g. Edge VPN exploitation, autumn 2026)" aria-label="Story name" @bind="_name" /></div>
                <div class="col-md-5"><input class="form-control form-control-sm" maxlength="4000" placeholder="One line on what it is (optional)" aria-label="Story summary" @bind="_summary" /></div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" disabled="@_busy" @onclick="Create">Add story</button></div>
            </div>
        </div>
    }
    <div class="tide-card">
        <DataTable TItem="StoryRow" Items="_list" Columns="Columns" Key="r => r.Id" One="story" Many="stories" Caption="Threat stories" PageInAddress="true"
                   FilterLabel="Filter stories" FilterPlaceholder="Filter by name or status" Filter="@Q" DefaultSort="ByStatus">
            <Empty><EmptyState Icon="bi-bezier2" Title="No stories yet">Start one from an article.</EmptyState></Empty>
            <RowTemplate Context="r">
                <td><a href="stories/@r.Id">@r.Name</a></td>
                <td><Badge Tone="@(r.Status == StoryStatus.Active ? BadgeTone.Ok : BadgeTone.Neutral)">@r.Status</Badge></td>
                <td class="tide-table-num">@r.Articles</td>
                <td class="small tide-muted">@(r.LastArticleAtUtc is { } at ? Ui.When(Clock, at) : "")</td>
            </RowTemplate>
        </DataTable>
    </div>
}
else if (_detail is null)
{
    @if (_loaded) { <EmptyState Icon="bi-question-circle" Title="Story not found"><a href="stories">All stories</a></EmptyState> } else { <LoadingBlock /> }
}
else
{
    var s = _detail.Story;
    <div class="tide-page-head">
        <div>
            <Breadcrumbs Items="@([new("Stories", "stories"), new(Ui.Clip(s.Name))])" />
            <h1>@s.Name</h1>
            <div class="tide-sub"><Badge Tone="@(s.Status == StoryStatus.Active ? BadgeTone.Ok : BadgeTone.Neutral)">@s.Status</Badge> &middot; @_detail.Articles.Count article@(_detail.Articles.Count == 1 ? "" : "s")</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (_detail.Articles.Count > 0)
            {
                <ExportIndicators Scope="ExportScope.Story" Key="@s.Id.ToString()" />
            }
            @if (_canWrite && !_editing)
            {
                <button @ref="_newToggle" class="btn btn-primary" aria-expanded="@Ui.Aria(_adding == Adding.New)" aria-controls="story-new" @onclick="StartNew"><span class="bi bi-plus-lg" aria-hidden="true"></span> New article on this story</button>
                <button @ref="_attachToggle" class="btn btn-outline-secondary" aria-expanded="@Ui.Aria(_adding == Adding.Existing)" aria-controls="story-attach" @onclick="StartAttach"><span class="bi bi-link-45deg" aria-hidden="true"></span> Add an existing article</button>
                <button class="btn btn-outline-secondary" @onclick="StartEdit"><span class="bi bi-pencil" aria-hidden="true"></span> Edit</button>
            }
        </div>
    </div>
    <div class="row g-3">
        <div class="col-lg-8">
            @if (_editing)
            {
                <div class="tide-card" data-submit-scope>
                    <ChangedElsewhere By="@_changedBy" What="story" OnReload="ReloadTheirs" />
                    <div class="row g-2">
                        <div class="col-md-8"><label class="tide-field-label" for="st-name">Name</label><input id="st-name" class="form-control form-control-sm" maxlength="200" @bind="_name" /></div>
                        <div class="col-md-4">
                            <label class="tide-field-label" for="st-status">Status</label>
                            <select id="st-status" class="form-select form-select-sm" @bind="_status">
                                @foreach (var st in Enum.GetValues<StoryStatus>()) { <option value="@st">@st</option> }
                            </select>
                        </div>
                        <div class="col-12"><label class="tide-field-label" for="st-sum">Summary (Markdown)</label>
                            <MarkdownToolbar For="st-sum" Label="Summary" BindsOnChange="true" />
                            <textarea id="st-sum" class="form-control form-control-sm tide-autogrow tide-grow-3" rows="4" maxlength="4000" @bind="_summary"></textarea></div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-primary btn-sm" disabled="@_busy" data-submit @onclick="Save">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editing = false">Cancel</button>
                        @if (_detail.Articles.Count == 0) { <button class="btn btn-link btn-sm ms-auto text-danger" disabled="@_busy" @onclick="Delete">Delete the story</button> }
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(s.Summary))
            {
                <div class="tide-card"><Md Text="@s.Summary" /></div>
            }
            @if (_adding == Adding.New)
            {
                <form id="story-new" class="tide-card tide-story-new" data-submit-scope @onsubmit="CreateNew" @onsubmit:preventDefault="true" @onkeydown="PanelKey">
                    <h2>New article on this story</h2>
                    <div class="row g-2">
                        <div class="col-12 col-sm">
                            <label class="tide-field-label" for="sn-title">Title</label>
                            <input @ref="_newTitleBox" id="sn-title" class="form-control form-control-sm" maxlength="300" placeholder="What happened, in a headline" @bind="NewTitle" />
                        </div>
                        <div class="col-12 col-sm-auto">
                            <label class="tide-field-label" for="sn-tlp">TLP</label>
                            <TlpSelect Id="sn-tlp" Value="_newTlp" ValueChanged="NewTlpChanged" Label="The new article's TLP" DescribedBy="sn-copies" />
                        </div>
                    </div>
                    <div id="sn-copies" class="form-text">@Copies</div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@_busy" data-submit>Create and edit</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseAdding">Cancel</button>
                    </div>
                </form>
            }
            else if (_adding == Adding.Existing)
            {
                <div id="story-attach" class="tide-card tide-story-attach" @onkeydown="PanelKey">
                    <h2><label for="sa-find">Add an existing article</label></h2>
                    <SearchCombobox @ref="_findBox" TItem="StoryCandidate" Id="sa-find" Type="search" Open="true" Placeholder="Titles, sources, CVEs, indicators" ListLabel="Articles"
                                    Help="Articles not on this story are listed below. Choose one to add it." Disabled="_busy"
                                    @bind-Text="_find" @bind-Text:after="Typed" Items="Candidates" Key="c => c.Id" OnPick="Attach" Empty="@NoCandidates">
                        <ItemTemplate Context="c">
                            <span class="tide-story-result-name">@c.Title</span>
                            <span class="tide-story-result-meta">@CandidateMeta(c)</span>
                        </ItemTemplate>
                    </SearchCombobox>
                    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="CloseAdding">Done</button>
                </div>
            }
            <div class="tide-card">
                <h2>Timeline</h2>
                @if (_detail.Articles.Count == 0) { <EmptyState Icon="bi-journal-text" Title="No articles yet." Compact="true">@(_canWrite ? "Start a new article on it, or add an existing one." : "None is linked to it yet.")</EmptyState> }
                <ol class="tide-story-timeline">
                    @foreach (var a in _detail.Articles)
                    {
                        <li>
                            <div class="small tide-muted">@Ui.When(Clock, a.PublishedAtUtc ?? a.CreatedAtUtc)@(_detail.BriefedOn.TryGetValue(a.Id, out var d) ? $" · briefed {Ui.ShortDay(d)}" : "")</div>
                            <a class="fw-semibold" href="articles/@a.Id">@a.Title</a> <ClassBadge Classification="a.Classification" Priority="a.Priority" /> <TlpBadge Level="a.Tlp" />
                            @if (!string.IsNullOrWhiteSpace(a.Bluf)) { <div class="small">@a.Bluf</div> }
                        </li>
                    }
                </ol>
            </div>
        </div>
        <div class="col-lg-4">
            @if (_detail.Cves.Count > 0)
            {
                <div class="tide-card"><h2>CVEs</h2>@foreach (var c in _detail.Cves) { <CveChip CveId="@c" Record="@_cveRecords.GetValueOrDefault(c)" /> }</div>
            }
            @if (_detail.Actors.Count > 0)
            {
                <div class="tide-card"><h2>Actors</h2>@foreach (var a in _detail.Actors) { <span class="tide-chip">@a</span> }</div>
            }
            @if (_detail.Techniques.Count > 0)
            {
                <div class="tide-card"><h2>ATT&amp;CK</h2>@foreach (var t in _detail.Techniques.Select(AttackCatalog.Find).OfType<AttackTechnique>()) { <span class="tide-chip tide-chip-technique" title="@t.Name">@t.Id @t.Name</span> }</div>
            }
            @if (_actions.Count > 0)
            {
                <div class="tide-card">
                    <h2>Actions <span class="tide-count">(@_actions.Count)</span></h2>
                    @foreach (var r in _actions)
                    {
                        <div class="d-flex gap-2 align-items-start py-1 border-bottom small">
                            <span class="flex-grow-1"><ActionRef Number="r.Number" Title="@r.Title" /> <span class="tide-muted">&middot; @r.TeamName</span></span>
                            <ActionStatusBadge Status="r.Status" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    // Active stories first, as the list comes (the newest article first within a status).
    private static readonly TableSort ByStatus = new("status", false);

    private static readonly IReadOnlyList<TableColumn<StoryRow>> Columns =
    [
        new("name", "Story") { SortBy = r => r.Name, FilterBy = r => r.Name },
        new("status", "Status") { SortBy = r => r.Status, FilterBy = r => r.Status.ToString() },
        new("articles", "Articles") { SortBy = r => r.Articles, DescendingFirst = true, Class = "tide-table-num" },
        new("latest", "Latest") { SortBy = r => r.LastArticleAtUtc, DescendingFirst = true },
    ];

    private IReadOnlyList<StoryRow>? _list;
    private StoryDetail? _detail;
    internal StoryDetail? Detail => _detail;
    private IReadOnlyDictionary<string, CveRecord> _cveRecords = new Dictionary<string, CveRecord>();
    private IReadOnlyList<ActionRow> _actions = [];
    private bool _loaded, _canWrite, _editing, _busy;
    private string? _name, _summary;
    internal string? TypedName { get => _name; set => _name = value; }
    private StoryStatus _status;
    // The story's edit version when Edit opened (its save is refused if a colleague's came since), and who saved it
    // meanwhile, for the banner over the form.
    private Guid _editVersion;
    private string? _changedBy;
    internal string? ChangedBy => _changedBy;
    private ConfirmDialog _confirm = default!;
    private Guid? _shownId;

    // Re-read in place when a colleague changes what's shown. The list: any story, or any article (its counts). A story's
    // page: the story itself, an article linked to it, taken off it or saved while on it (Story), or its articles' CVEs,
    // techniques and threat actors (ArticleSummary); their bullets, screenshots, indicators and links, which it doesn't
    // show, and other articles stay silent. An open Edit form keeps what's typed in it. While Add an existing article is
    // open, any article's change (Articles) reads its list again too, quietly, so the story each is on stays true.
    private LiveChanges? _live;

    // The shown story's topic, set with Id, and its articles' summary topics, swapped whole when the story is read, and
    // whether the picker is open: the feed's filter reads them on the publisher's thread.
    private volatile string? _storyTopic;
    private volatile IReadOnlySet<string> _articleTopics = new HashSet<string>();
    private volatile bool _picking;

    protected override void OnInitialized() =>
        _live = new LiveChanges(Feed, Origin, Wanted, InvokeAsync, OnChangedElsewhere);

    internal bool Wanted(Change c) => _storyTopic is { } story
        ? c.Topic == story || _articleTopics.Contains(c.Topic) || (_picking && c.Topic == ChangeFeed.Articles)
        : c.Topic == ChangeFeed.Stories || c.Topic == ChangeFeed.Articles;

    internal async Task OnChangedElsewhere(IReadOnlyList<Change> heard)
    {
        if (_busy || !_loaded) return;   // a read or a step is under way, and it will show theirs
        // Only another article changed: the picker's list is read again, and the story, which it doesn't touch, isn't.
        if (Id is not null && heard.All(c => c.Topic == ChangeFeed.Articles))
        {
            if (_adding == Adding.Existing)
            {
                try { await Find(); }
                catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
                StateHasChanged();
            }
            return;
        }
        try
        {
            if (_adding == Adding.Existing && Id is not null) await Find();
            if (Id is null) _list = await StorySvc.ListAsync();
            else
            {
                await LoadStory();
                // An open form keeps what's typed, and says who saved the story meanwhile: saving it now is refused.
                if (_editing && _detail is { } now && now.Story.EditVersion != _editVersion) _changedBy = LiveChanges.Who(heard);
            }
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        Toasts.Show($"{LiveChanges.Who(heard)} updated {(Id is null ? "the stories" : "this story")}.");
        StateHasChanged();
    }

    public void Dispose() => _live?.Dispose();

    protected override async Task OnParametersSetAsync()
    {
        _canWrite = CurrentUser.Has(Permission.WriteArticles);
        _loaded = false;
        // The list and every story share this page, and so its fields: another story (or the list) starts with the edit
        // form closed and empty, so one story's edit can't be saved onto another.
        var listShown = _shownId == Id;   // the list was shown already (this is another of its pages)
        if (_shownId != Id)
        {
            (_shownId, _editing, _name, _summary, _changedBy) = (Id, false, null, null, null);
            StopAdding();
            _detail = null;
            _storyTopic = Id is { } shown ? ChangeFeed.Story(shown) : null;
            _articleTopics = new HashSet<string>();
        }
        var id = Id;
        if (id is null)
        {
            // Another page of the list (?page=) is the same list: it's read again only when coming to it.
            if (_list is not null && listShown) { _loaded = true; return; }
            var list = await StorySvc.ListAsync();
            if (Id is null) _list = list;
        }
        else await LoadStory();
        if (Id == id) _loaded = true;
    }

    // Read whole, then shown: a read that lands after the address moved to another story is dropped, so one story's
    // details (and its Edit form, which copies them) never show under another's address.
    private async Task LoadStory()
    {
        var id = Id!.Value;
        var detail = await StorySvc.GetAsync(id);
        if (detail is null)
        {
            if (Id == id) _detail = null;
            return;
        }
        var cves = await Cves.GetAsync(detail.Cves);
        var byArticle = await ActionSvc.ForArticlesAsync(detail.Articles.Select(a => a.Id).ToList());
        if (Id != id) return;
        (_detail, _cveRecords, _actions) = (detail, cves, detail.Articles.SelectMany(a => byArticle[a.Id]).ToList());
        _articleTopics = detail.Articles.Select(a => ChangeFeed.ArticleSummary(a.Id)).ToHashSet(StringComparer.Ordinal);
    }

    internal void StartEdit()
    {
        StopAdding();
        _editing = true;
        _name = _detail!.Story.Name;
        _summary = _detail.Story.Summary;
        _status = _detail.Story.Status;
        _editVersion = _detail.Story.EditVersion;
        _changedBy = null;
    }

    // The banner's Reload: their version in the form, and what was typed goes.
    internal async Task ReloadTheirs()
    {
        await LoadStory();
        if (_detail is null) _editing = false;
        else StartEdit();
        Toasts.Show("Reloaded. Your unsaved changes were dropped.");
    }

    internal Task Create() => Run(async () =>
    {
        var id = await StorySvc.CreateAsync(_name ?? "", _summary);
        _name = _summary = null;
        Toasts.Show("Story added.");   // which also clears an error left from an earlier try
        Nav.NavigateTo($"stories/{id}");
    });

    internal Task Save() => Run(async () =>
    {
        await StorySvc.UpdateAsync(Id!.Value, _name ?? "", _summary, _status, _editVersion);
        (_editing, _changedBy) = (false, null);
        await LoadStory();
    });

    // Deleting can't be taken back, so it asks first.
    private async Task Delete()
    {
        // The story the question was asked about: one left open while the address moved to another deletes nothing.
        var id = Id;
        if (!await _confirm.Ask("Delete this story?", "The story is deleted. This can't be undone.", "Delete story") || id != Id || id is null) return;
        await Run(async () =>
        {
            await StorySvc.DeleteAsync(id.Value);
            Nav.NavigateTo("stories");
        });
    }

    // Adding an article: New article on this story (a title and a marking, and what it will copy at that marking), or
    // Add an existing article (a search over the articles not on the story). One at a time, and never beside Edit.
    private enum Adding { None, New, Existing }
    private Adding _adding;
    internal string? NewTitle { get; set; }
    private TlpLevel _newTlp = TlpLevel.Clear;
    private StoryPrefill? _prefill;
    private string? _find;
    internal IReadOnlyList<StoryCandidate> Candidates { get; private set; } = [];
    private readonly TypingPause _pause = new();

    private static readonly RenderFragment NoCandidates = @<text>No other articles match.</text>;

    // Focus follows the panels: into one as it opens (its Title box, its search box), back to its button as it closes.
    private ElementReference _newToggle, _attachToggle, _newTitleBox;
    private SearchCombobox<StoryCandidate>? _findBox;
    private Func<Task>? _focusNext;

    private void StopAdding()
    {
        (_adding, NewTitle, _newTlp, _prefill, _find, Candidates) = (Adding.None, null, TlpLevel.Clear, null, null, []);
        _picking = false;
    }

    /// <summary>Cancel, Done or Escape: the panel closes and focus goes back to the button that opened it.</summary>
    internal void CloseAdding()
    {
        var toggle = _adding == Adding.Existing ? _attachToggle : _newToggle;
        if (_adding != Adding.None) _focusNext = () => toggle.TryFocusAsync();
        StopAdding();
    }

    internal void PanelKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseAdding();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNext is not { } focus) return;
        _focusNext = null;
        await focus();
    }

    internal Task StartNew() => Run(async () =>
    {
        StopAdding();
        _adding = Adding.New;
        _focusNext = () => _newTitleBox.TryFocusAsync();
        _prefill = await StoryArticles.PrefillAsync(Id!.Value, _newTlp);
    });

    // Another marking: what the article would copy is read again for it.
    internal Task NewTlpChanged(TlpLevel tlp) => Run(async () =>
    {
        _newTlp = tlp;
        _prefill = await StoryArticles.PrefillAsync(Id!.Value, tlp);
    });

    // What the new article starts with at the marking chosen, and what's left out above it.
    private string Copies
    {
        get
        {
            if (_prefill is not { } p) return "";
            var at = Tlp.Label(_newTlp);
            var parts = new List<string>();
            if (p.Cves.Count > 0) parts.Add(p.Cves.Count <= 4 ? string.Join(", ", p.Cves) : $"{string.Join(", ", p.Cves.Take(3))} and {p.Cves.Count - 3} more CVEs");
            if (p.TagIds.Count > 0) parts.Add(Ui.Plural(p.TagIds.Count, "scorecard tag"));
            if (p.ProductIds.Count > 0) parts.Add(Ui.Plural(p.ProductIds.Count, "product we run", "products we run"));
            var copies = parts.Count == 0
                ? $"Starts empty: the story's articles at or below {at} name no CVEs, scorecard tags or products we run."
                : $"Starts with {string.Join("; ", parts)}, from the story's articles at or below {at}. Threat actors and techniques aren't copied.";
            return p.LeftOut == 0 ? copies
                : $"{copies} {Ui.Plural(p.LeftOut, "article")} above {at} {(p.LeftOut == 1 ? "is" : "are")} left out: raise the TLP to bring in what {(p.LeftOut == 1 ? "it names" : "they name")}.";
        }
    }

    // Starts the draft on the story and opens it in the editor; putting it on a brief stays the editor's choice.
    internal Task CreateNew() => Run(async () =>
    {
        var id = await StoryArticles.NewArticleAsync(Id!.Value, NewTitle ?? "", _newTlp);
        StopAdding();
        Nav.NavigateTo($"articles/{id}");
    });

    internal Task StartAttach() => Run(async () =>
    {
        StopAdding();
        (_adding, _picking) = (Adding.Existing, true);
        _focusNext = () => _findBox?.FocusAsync() ?? Task.CompletedTask;
        await Find();
    });

    // Typed in the search: it runs once typing pauses, as the other pickers' do.
    private async Task Typed()
    {
        if (await _pause.Settled()) await Find();
    }

    /// <summary>The search for <paramref name="text"/>, as typing it would run.</summary>
    internal Task FindCandidates(string? text)
    {
        _find = text;
        return Find();
    }

    // The articles for what's typed now; a slower answer for words typed before, or for another story, is dropped.
    private async Task Find()
    {
        var mine = _pause.Now();
        var id = Id!.Value;
        var found = await StoryArticles.CandidatesAsync(id, _find);
        if (_pause.IsLatest(mine) && Id == id) Candidates = found;
    }

    private string CandidateMeta(StoryCandidate c) =>
        $"{Tlp.Label(c.Tlp)} · {c.Status} · by {c.AuthorName} · {Ui.When(Clock, c.CreatedAtUtc)}" + (c.OnStory is { } other ? $" · on {other}, moves here" : "");

    // Adds the article picked, saying the story it left if it was on one as it was added (whatever the list showed); the
    // search stays open for another.
    internal Task Attach(StoryCandidate c) => Run(async () =>
    {
        var left = await StorySvc.LinkAsync(c.Id, Id!.Value);
        await LoadStory();
        await Find();
        Toasts.Show(left is null ? $"Added {Ui.Clip(c.Title)} to the story." : $"Moved {Ui.Clip(c.Title)} from {Ui.Clip(left)} to this story.");
    });

    // One step at a time: a second click while one runs does nothing (the buttons are disabled meanwhile).
    private async Task Run(Func<Task> step)
    {
        if (_busy) return;
        _busy = true;
        try { await step(); }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
}
