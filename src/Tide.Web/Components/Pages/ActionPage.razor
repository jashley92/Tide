    // Takes what the prerendered page read: the action, or the new one's form and where it's from, and the teams and
    // people its editor offers.
    private void Adopt(ActionPage p)
    {
        (_teams, _people, _detail, _topic, _shownNumber) = (p._teams, p._people, p._detail, p._topic, p._shownNumber);
        Derive();
        (_form, _parent, _articleTitle) = (p._form, p._parent, p._articleTitle);
        _loaded = true;
    }

    private async Task PrepareNew()
    {
        _shownNumber = null;
        (_parent, _articleTitle) = (null, null);   // a new action from elsewhere isn't a part of the last one's parent
        _created = false;
        _newFiles.Clear();
        // No team to start with: the person chooses one (the first in the list was too easy to keep by mistake).
        _form = new ActionForm();
        if (FilterValues.Id(ParentParam) is { } parentId)
        {
            _parent = await ActionSvc.RowAsync(parentId);
            if (_parent is not null) await FromParent(_parent);
        }
        if (FilterValues.Id(ArticleParam) is { } articleId && await ArticleSvc.GetAsync(articleId) is { } article)
        {
            _form.ArticleId = article.Id;
            _articleTitle = article.Title;
            _form.Title = article.Indicators.Count > 0 ? $"Sweep for the indicators in \"{article.Title}\"" : "";
            _form.Kind = article.Indicators.Count > 0 ? ActionKind.IocSweep : ActionKind.Other;
            _form.Priority = article.Priority ?? Priority.P3;
            _form.Description = article.RecommendedActions;
        }
