    internal async Task OnChangedElsewhere(IReadOnlyList<Change> changes)
    {
        if (_busy || _detail is null) return;   // this page's own action reloads when it's done, and reads theirs with it
        var who = LiveChanges.Who(changes);
        var status = _detail.Action.Status;
        var editing = _editingComment;
        await Reload();
        var edited = _detail?.Action.Comments.FirstOrDefault(c => c.Id == _editingComment);
        if (_detail is not null && ((_editing is not null && _detail.Action.EditVersion != _editing.EditVersion) || (_prompting && _detail.Action.Status != status)))
            _changedBy = who;
        else if (editing is not null && _editingComment is null)
            Toasts.Show($"{who} deleted the comment you were editing.");
        else if (edited is not null && edited.EditVersion != _commentEditVersion)
        {
            ShowTheirs(edited);
            Toasts.Show($"{who} changed the comment you're editing. Their text is shown above yours.");
        }
        else Toasts.Show($"{who} updated this action.");
        StateHasChanged();
    }

