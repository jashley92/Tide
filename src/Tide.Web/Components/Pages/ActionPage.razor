    /// <summary>The new-comment box once <paramref name="posted"/> has gone: empty when it still holds just that, what was
    /// typed after it when it starts with it, and all of it when it was changed some other way while it was sent.</summary>
    internal static string? Unposted(string? box, string posted)
    {
        if (box is null || box == posted) return null;
        if (posted.Length == 0 || !box.StartsWith(posted, StringComparison.Ordinal)) return box;
        var rest = box[posted.Length..].TrimStart();
        return rest.Length == 0 ? null : rest;
    }

