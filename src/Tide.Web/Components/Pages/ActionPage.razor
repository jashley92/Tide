    internal async Task EditComment(ActionComment c)
    {
        // Only one comment is edited at a time: unsaved changes to another aren't dropped without asking.
        if (_editingComment is { } other && other != c.Id && CommentEditUnsaved
            && !await _confirm.Ask("Discard your changes to the other comment?", null, "Discard", cancelLabel: "Keep editing", focusOnCancel: _commentBox))
            return;
        _editingComment = c.Id;
        _commentEdit = _commentEditBase = c.Text;
        _commentEditVersion = c.EditVersion;
        (_commentTheirs, _commentTheirsBy) = (null, null);
    }

    internal void CancelComment(ActionComment c)
    {
        (_editingComment, _commentEdit, _commentEditBase, _commentTheirs, _commentTheirsBy) = (null, null, null, null, null);
        _focusEditOf = c.Id;
    }

    internal Task SaveComment(ActionComment c) => Run(async () =>
    {
        var text = _commentEdit ?? "";
        Guid version;
        try { version = await ActionSvc.EditCommentAsync(c.Id, text, _commentEditVersion); }
        catch (StaleEditException ex)
        {
            // Someone changed it since: theirs is shown, and what was typed stays in the box to redo on top of it.
            await Reload();
            if (_editingComment == c.Id && _detail?.Action.Comments.FirstOrDefault(x => x.Id == c.Id) is { } now) ShowTheirs(now);
            Toasts.Error(ex.Message);
            return;
        }
        // Closed only while it's still this comment's box holding what was saved: text typed on since stays in it, unsaved,
        // and another comment's edit opened meanwhile stays open.
        if (_editingComment == c.Id && (_commentEdit ?? "") == text) CancelComment(c);
        else if (_editingComment == c.Id) (_commentEditBase, _commentEditVersion, _commentTheirs, _commentTheirsBy) = (text, version, null, null);
        await Reload();
    });

