    // The action as read, turned into what the page shows first: its primary button, More, the Next line and the feed.
    private void Derive()
    {
        if (_detail is not { Action: var a } d)
        {
            (_openParts, _primary, _next, _moreItems, _feed, _offered) = (0, ActionFlow.None, null, [], [], []);
            return;
        }
        _openParts = d.Children.Count(c => c.IsOpen);
        var facts = new ActionFacts(a.Status, a.Kind, d.CanWork, a.AssigneeId is not null, a.Team?.IsExternal == true, _openParts,
            d.Emails, d.Waiting is not null, a.AssigneeId == CurrentUser.UserId, d.CanEditAll, a.ParentId is null);
        _primary = ActionGuide.Primary(facts);
        var more = ActionGuide.More(facts);
        _moreItems = [.. more.Select(f => f == ActionFlow.SplitOffPart
            ? new MenuButton.Item(ActionGuide.Label(f), ActionGuide.Icon(f), Href: SplitOffHref(a))
            : new MenuButton.Item(ActionGuide.Label(f), ActionGuide.Icon(f), EventCallback.Factory.Create(this, () => Run(f))))];
        var waiting = d.Waiting is { } m ? new WaitingEmail(m.To, OutreachDates.SentOn(m.SentAtUtc, Clock), OutreachSvc.FollowUpOn(m)) : null;
        _next = ActionGuide.Next(new NextFacts(a.Status, ActionSla.StateOf(a, ActionSvc.Today, Clock.Days), a.DueDate, ActionSvc.Today, d.CanWork,
            d.Lineage is { } l && l.Parent.Id == a.Id ? l.Parts : null, waiting, a.EscalatedSince is { } at ? Clock.DayOf(at) : null));
        _feed = ActionFeed.Of(a.Comments, a.Events);
        // What runs: the primary button, More's flows, and the Next line's own (not those on another action).
        _offered = [.. more, _primary, .. (_next?.Links ?? []).Where(l => l.On is null).Select(l => l.Flow)];
        _offered.Remove(ActionFlow.None);
    }

    private static string SplitOffHref(ActionItem a) => $"actions/new?parent={a.Id}";

