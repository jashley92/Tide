@page "/actions/new"
@page "/actions/{Number:int}"
@attribute [Authorize(Policy = Policies.ReadActions)]
@inject ActionService ActionSvc
@inject HandoffService HandoffSvc
@inject TeamService TeamSvc
@inject ArticleService ArticleSvc
@inject IUserDirectory Users
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ScreenshotService Shots
@inject ActionFileService FileSvc
@inject OutreachService OutreachSvc
@inject OrgClock Clock
@inject IJSRuntime JS
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@inject PrerenderHandoff Handoff
@implements IDisposable

<PageTitle>@(Number is { } n ? Ui.ActionLabel(n) : "New action") · TIDE</PageTitle>

@if (Number is null)
{
    @* --- a new action --- *@
    <div class="tide-page-head">
        <div>
            <Breadcrumbs Items="@([new("Actions", "actions"), new("New action")])" />
            <h1>New action</h1>
            @if (_parent is not null) { <div class="tide-sub">A part of <a href="@Ui.ActionUrl(_parent.Number)">@Ui.ActionLabel(_parent.Number) @_parent.Title</a></div> }
            else if (_articleTitle is not null) { <div class="tide-sub">From the article <a href="articles/@_form.ArticleId">@_articleTitle</a></div> }
        </div>
    </div>
    @if (!CurrentUser.Has(Permission.WriteArticles))
    {
        <div class="tide-card">Only analysts create actions.</div>
    }
    else if (_teams.Count == 0 && _loaded)
    {
        <div class="tide-card"><EmptyState Icon="bi-people" Title="No teams yet">An administrator adds them under Administration &gt; Teams &amp; SLA.</EmptyState></div>
    }
    else if (_loaded)
    {
        <div class="tide-card-form tide-card">
            <ActionEditor @key="_form" Form="_form" Teams="_teams" People="_people" IsNew="true" ParentDue="_parent?.DueDate" />
            <div class="mt-3">
                <span class="tide-field-label">Files <span class="fw-normal">(optional)</span></span>
                <FilePicker Files="_newFiles" ZoneId="new-files-zone" InputId="new-files-input" Label="Files for the new action" PickLabel="Attach files" Changed="StateHasChanged" />
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" disabled="@_busy" @onclick="Create">Create action</button>
                <a class="btn btn-outline-secondary" href="@(_form.ArticleId is { } a ? $"articles/{a}" : "actions")">Cancel</a>
            </div>
        </div>
    }
}
else if (_detail is null)
{
    @if (_loaded) { <EmptyState Icon="bi-question-circle" Title="Action not found"><a href="actions">All actions</a></EmptyState> } else { <LoadingBlock /> }
}
else
{
    var a = _detail.Action;
    var state = ActionSla.StateOf(a, ActionSvc.Today, Clock.Days);
    var primary = _primary;
    var more = _moreItems;
    var next = _next;
    @* The header: what it is, how it stands (the status badge changes it, for whoever may work it), who has it, and the
       one thing to do first, with everything else under More. *@
    <div class="tide-page-head tide-action-head">
        <div class="tide-action-title">
            <Breadcrumbs Items="@([new("Actions", "actions"), new(Ui.ActionLabel(a.Number))])" />
            <ChangedElsewhere By="@_changedBy" What="action" OnReload="ReloadTheirs" />
            <h1><span class="tide-action-num">@Ui.ActionLabel(a.Number)</span> @a.Title</h1>
            <div class="tide-action-badges">
                @if (_detail.CanWork)
                {
                    <ActionStatusControl @key="a.Id" @ref="_statusControl" Action="a" AsBadge="true" OpenParts="@_openParts" Changed="Reload" Prompting="OnPrompting" Stale="OnStatusStale" />
                }
                else
                {
                    <ActionStatusBadge Status="a.Status" />
                }
                <PriorityBadge Priority="a.Priority" />
                @if (a.DueDate is { } dueOn) { <span class="tide-action-due">Due @Ui.ShortDay(dueOn)</span> }
                <SlaBadge State="state" Due="a.DueDate" Today="ActionSvc.Today" />
                <EscalatedBadge At="a.EscalatedSince" />
                @if (a.Outcome != ActionOutcome.None) { <span>@ActionService.OutcomeName(a.Outcome)</span> }
                @if (_detail.Parent is { } parentRow)
                {
                    <a class="tide-kcard-parent" href="@Ui.ActionUrl(parentRow.Number)"><span class="bi bi-arrow-return-right" aria-hidden="true"></span> Part of @Ui.ActionLabel(parentRow.Number)</a>
                }
                <PresenceNote Place="@ActionPlace(a.Number)" Editing="Editing" />
            </div>
            <div class="tide-sub tide-action-who">
                <span>@a.Team?.Name</span> &middot; <span>@(a.AssigneeName ?? "Unassigned")</span>
                @if (_detail.HandedFrom is { } handedFrom)
                {
                    <span class="tide-handoff">&middot; <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span>
                        handed from @handedFrom by @a.HandedByName@(a.HandedAtUtc is { } at ? $" ({Ui.When(Clock, at)})" : ""): @a.HandoffReason</span>
                }
            </div>
        </div>
        @if (primary != ActionFlow.None || more.Count > 0)
        {
            <div class="tide-action-do">
                @if (primary != ActionFlow.None)
                {
                    <button type="button" class="btn btn-primary" data-primary="@primary" disabled="@_busy" @onclick="RunPrimary"><span class="bi @ActionGuide.Icon(primary)" aria-hidden="true"></span> @ActionGuide.Label(primary)</button>
                }
                @if (more.Count > 0)
                {
                    <MenuButton @ref="_more" Label="More" Items="more" />
                }
            </div>
        }
    </div>

    @if (_detail.CanWork)
    {
        <RecordUpdateDialog @key="@($"update-{a.Id}")" @ref="_update" Action="a" OpenParts="@_openParts" Done="Reload" />
    }

    @* Two columns: the work (Next, details, lineage, what's happened) and beside it the facts, the tools, the article and
       files. Under lg the columns open into one (display: contents), reordered by the tide-ord-N classes so the tools
       come straight after the details on a phone. *@
    <div class="tide-action-layout">
        <div class="tide-action-main">
            @if (next is not null)
            {
                <div class="tide-ord-1"><ActionNextStrip Step="next" Do="Run" /></div>
            }

            @if (_editing is not null)
            {
                <div class="tide-card tide-ord-2">
                    <h2>Edit</h2>
                    <ActionEditor Form="_editing" Teams="_teams" People="@(CurrentUser.Has(Permission.WriteArticles) ? _people : null)" RemindersOff="a.NoReminders" />
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveEdit">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editing = null">Cancel</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(a.Description))
            {
                <div class="tide-card tide-ord-2"><h2>Details</h2><Md Text="@a.Description" /></div>
            }

            @if (!a.IsOpen && (a.Outcome != ActionOutcome.None || a.OutcomeNote is not null))
            {
                <div class="tide-card tide-ord-2">
                    <h2>Outcome</h2>
                    <p class="mb-0"><strong>@ActionService.OutcomeName(a.Outcome)</strong>@if (a.OutcomeNote is not null) { <span>: @a.OutcomeNote</span> }</p>
                </div>
            }

            @* A split action's lineage, from its article to each part. On the parent it is the Parts card too, with the
               board link and splitting off more under it; its parts' timeline is a tool in the drawer. *@
            @if (_detail.Lineage is { } lineage)
            {
                <div class="tide-ord-4">
                    <ActionLineageFlow Lineage="lineage" Today="ActionSvc.Today">
                        @if (lineage.Parent.Id == a.Id)
                        {
                            <div class="d-flex gap-2 flex-wrap align-items-center mt-3">
                                <a class="small me-auto" href="@($"actions?view=open&layout=board&parent={a.Number}")">Open its @_detail.Children.Count action@(_detail.Children.Count == 1 ? "" : "s") on the board</a>
                                @if (_detail.CanEditAll)
                                {
                                    <a class="btn btn-outline-secondary btn-sm" href="@($"actions/new?parent={a.Id}")"><span class="bi bi-plus-lg" aria-hidden="true"></span> Split off a part for a team</a>
                                    @if (a.IsOpen)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenSplit"><span class="bi bi-diagram-3" aria-hidden="true"></span> Split to teams</button>
                                    }
                                }
                            </div>
                        }
                    </ActionLineageFlow>
                </div>
            }

            @* What's happened: its comments and its history in one feed, oldest first, so the newest is by the comment box.
               A comment carries its author's initials; a history line TIDE's mark. The latest few show, the rest under
               "Show N earlier"; one being edited is never folded away. *@
            @{ var feed = ActionFeed.Window(_feed, _feedAll, _editingComment); }
            <section class="tide-card tide-feed tide-ord-5" aria-labelledby="feed-h">
                <div class="tide-feed-head">
                    <h2 id="feed-h" class="tide-card-title">What's happened <span class="tide-count tide-muted fw-normal">(@a.Comments.Count comment@(a.Comments.Count == 1 ? "" : "s"))</span></h2>
                    @if (feed.Earlier > 0)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 ms-auto" @onclick="ShowAll">Show @feed.Earlier earlier</button>
                    }
                </div>
                @if (feed.Shown.Count == 0)
                {
                    <p class="small tide-muted mb-0">Nothing yet.</p>
                }
                <ol class="tide-feed-list">
                    @foreach (var entry in feed.Shown)
                    {
                        @if (entry.Comment is { } c)
                        {
                            var liveFiles = LiveFiles(c);
                            <li class="tide-feed-item tide-comment" id="comment-@c.Id" tabindex="-1" @key="c.Id" @ref="_commentItems[c.Id]">
                                <span class="tide-avatar tide-feed-mark" aria-hidden="true" title="@c.AuthorName">@MainLayout.Initials(c.AuthorName)</span>
                                <div class="tide-feed-body">
                                    <div class="small tide-muted d-flex gap-2 align-items-center">
                                        <span><strong>@c.AuthorName</strong> &middot; @Ui.When(Clock, c.AtUtc)@(c.EditedAtUtc is not null ? " (edited)" : "")</span>
                                        @if (_detail.CanComment && (c.AuthorId == CurrentUser.UserId || CurrentUser.Has(Permission.Administer)) && _editingComment != c.Id)
                                        {
                                            <button class="btn btn-link btn-sm p-0 ms-auto" aria-label="Edit your comment from @Ui.When(Clock, c.AtUtc)" @ref="_editButtons[c.Id]" @onclick="() => EditComment(c)">Edit</button>
                                            <button class="btn btn-link btn-sm p-0" aria-label="Delete the comment from @Ui.When(Clock, c.AtUtc)" disabled="@_busy" @onclick="() => DeleteComment(c)">Delete</button>
                                        }
                                    </div>
                                    @if (_editingComment == c.Id)
                                    {
                                        <div data-submit-scope>
                                            @if (_commentTheirs is { } theirs)
                                            {
                                                <div class="tide-source-excerpt small mt-1" role="status">
                                                    <div>@(_commentTheirsBy ?? "Someone else") changed it to this. Your text is still in the box; saving puts it in place.</div>
                                                    <Md Text="@theirs" />
                                                </div>
                                            }
                                            <MarkdownToolbar For="comment-edit" Label="Edit the comment" Class="mt-1" />
                                            <textarea id="comment-edit" class="form-control form-control-sm tide-autogrow tide-grow-3" rows="3" maxlength="8000" aria-label="Edit the comment" @ref="_commentBox"
                                                      @bind:get="_commentEdit" @bind:set="v => _commentEdit = v" @bind:event="oninput"></textarea>
                                            <div class="d-flex gap-2 mt-1">
                                                <button class="btn btn-primary btn-sm" data-submit disabled="@(_busy || (string.IsNullOrWhiteSpace(_commentEdit) && liveFiles.Count == 0))" @onclick="() => SaveComment(c)">Save</button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => CancelComment(c)">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                    else if (c.Text.Length > 0)
                                    {
                                        <Md Text="@c.Text" />
                                    }
                                    @if (liveFiles.Count > 0)
                                    {
                                        var shots = liveFiles.Where(f => f.IsImage).ToList();
                                        var evidence = liveFiles.Where(f => !f.IsImage).ToList();
                                        @if (shots.Count > 0)
                                        {
                                            <div class="tide-comment-shots">
                                                @foreach (var f in shots)
                                                {
                                                    <button type="button" class="tide-zoom" aria-label="Open @f.FileName" @onclick="() => OpenShot(shots, f)">
                                                        <img src="@Ui.ImageUrl(f.FileId)" alt="Screenshot: @f.FileName" loading="lazy" />
                                                    </button>
                                                }
                                            </div>
                                        }
                                        @if (evidence.Count > 0)
                                        {
                                            <ul class="tide-comment-files">
                                                @foreach (var f in evidence)
                                                {
                                                    <li>
                                                        <span class="bi bi-paperclip" aria-hidden="true"></span>
                                                        <a href="@Ui.DownloadUrl(f.FileId)" download="@f.FileName">@f.FileName</a>
                                                        <span class="tide-muted">@Ui.Size(f.SizeBytes)</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    }
                                </div>
                            </li>
                        }
                        else if (entry.Event is { } e)
                        {
                            <li class="tide-feed-item tide-feed-line" @key="e.Id">
                                <span class="tide-avatar tide-feed-mark tide-feed-sys" aria-hidden="true" title="From its history">T</span>
                                <div class="tide-feed-body">
                                    <div class="small tide-muted">@e.ByName &middot; @Ui.When(Clock, e.AtUtc)</div>
                                    <div>@e.Text</div>
                                </div>
                            </li>
                        }
                    }
                </ol>
                @if (_detail.CanComment)
                {
                    <div id="comment-zone" class="tide-comment-compose mt-2" data-submit-scope>
                        <MarkdownToolbar For="comment-new" Label="New comment" />
                        <textarea id="comment-new" class="form-control form-control-sm tide-autogrow tide-grow-2" rows="2" maxlength="8000" aria-label="New comment" aria-describedby="comment-new-help"
                                  placeholder="Add a comment (Markdown). Ctrl+Enter to post" @ref="_newCommentBox"
                                  @bind:get="_comment" @bind:set="v => _comment = v" @bind:event="oninput"></textarea>
                        @if (_attachments.Count > 0)
                        {
                            <ul class="tide-comment-files mt-1">
                                @foreach (var f in _attachments)
                                {
                                    <li>
                                        <span class="bi @(f.IsImage ? "bi-image" : "bi-paperclip")" aria-hidden="true"></span> @f.Upload.FileName
                                        <span class="tide-muted">@Ui.Size(f.Upload.Bytes.Length)</span>
                                        <button type="button" class="btn btn-link btn-sm p-0" aria-label="Don't attach @f.Upload.FileName" @onclick="() => _attachments.Remove(f)"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                                    </li>
                                }
                            </ul>
                        }
                        <div class="d-flex gap-2 align-items-center mt-2 flex-wrap">
                            <button class="btn btn-outline-secondary btn-sm" data-submit disabled="@(_busy || (string.IsNullOrWhiteSpace(_comment) && _attachments.Count == 0))" @onclick="Comment">Comment</button>
                            @if (_detail.CanWork)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0" disabled="@_busy" @onclick="StartUpdate">Record a team's update</button>
                                <label for="comment-files" class="btn btn-link btn-sm p-0"><span class="bi bi-paperclip" aria-hidden="true"></span> Attach screenshots or evidence</label>
                                <span class="small tide-muted" id="comment-new-help">Ctrl+Enter posts. Paste a screenshot, or drop files here. @FileSvc.LimitsText@(_reading ? " Reading…" : "")</span>
                                <InputFile id="comment-files" class="d-none" multiple OnChange="OnAttach" />
                            }
                            else
                            {
                                <span class="small tide-muted" id="comment-new-help">Ctrl+Enter posts. Owned by @a.Team?.Name</span>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>

        <div class="tide-action-side">
            @* The facts someone opening an action looks for, beside the work; the edit form changes them. *@
            <section class="tide-card tide-ord-6" aria-label="Facts">
                <dl class="tide-facts tide-facts-side">
                    <div class="tide-fact"><dt>Team</dt><dd>@a.Team?.Name</dd></div>
                    <div class="tide-fact"><dt>Assignee</dt><dd>@(a.AssigneeName ?? "Unassigned")</dd></div>
                    <div class="tide-fact"><dt>Kind</dt><dd>@ActionService.KindName(a.Kind)</dd></div>
                    <div class="tide-fact">
                        <dt>Ticket</dt>
                        <dd>
                            @if (a.TicketUrl is not null) { <a href="@a.TicketUrl" target="_blank" rel="noopener noreferrer">@(a.TicketRef ?? "Open the ticket")</a> }
                            else { @(a.TicketRef ?? "None") }
                        </dd>
                    </div>
                    <div class="tide-fact"><dt>Created</dt><dd>@Ui.When(Clock, a.CreatedAtUtc)</dd></div>
                    <div class="tide-fact"><dt>Due</dt><dd>@(a.DueDate is { } due ? Ui.ShortDay(due) : "No due date") <SlaBadge State="state" Due="a.DueDate" Today="ActionSvc.Today" /></dd></div>
                    @if (a.RaisedOn is { } raised)
                    {
                        <div class="tide-fact tide-fact-wide"><dt>Raised for</dt><dd>@Ui.Day(raised)'s brief</dd></div>
                    }
                    @if (a.ClosedDate is { } closed) { <div class="tide-fact"><dt>Closed</dt><dd>@Ui.ShortDay(closed)</dd></div> }
                    @if (_detail.Parent is { } p)
                    {
                        <div class="tide-fact tide-fact-wide"><dt>Part of</dt><dd><a href="@Ui.ActionUrl(p.Number)">@Ui.ActionLabel(p.Number)</a> @p.Title</dd></div>
                    }
                </dl>
            </section>

            <div class="tide-ord-3">
                <ActionToolDrawer @key="a.Id" @ref="_drawer" Detail="_detail" Asked="@ToolParam" Today="ActionSvc.Today"
                                  Changed="Reload" ToolChanged="KeepTool" />
            </div>

            @if (a.Article is { } article)
            {
                <section class="tide-card tide-ord-7" aria-labelledby="from-article-h">
                    <h2 id="from-article-h">From the article</h2>
                    <a href="articles/@article.Id">@article.Title</a>
                    @if (article.Cves.Count > 0)
                    {
                        <div class="small tide-muted tide-data mt-1">@string.Join(", ", article.Cves.Select(c => c.CveId).Order(StringComparer.OrdinalIgnoreCase))</div>
                    }
                </section>
            }

            @if (a.Team is { IsExternal: true } external)
            {
                @* The team works outside TIDE: who to ask and how, and whether this action is in its reminder emails. *@
                <div class="tide-card tide-ord-7">
                    <h2>@external.Name <Badge Class="ms-1">External</Badge></h2>
                    <dl class="tide-meta-grid">
                        @if (external.ContactName is not null) { <dt>Contact</dt><dd>@external.ContactName</dd> }
                        @if (external.ContactEmail is not null) { <dt>Email</dt><dd class="tide-data">@external.ContactEmail</dd> }
                        @if (external.Engage is not null) { <dt>How to engage</dt><dd class="tide-pre-line">@external.Engage</dd> }
                    </dl>
                    @if (_detail.CanWork)
                    {
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="no-remind" checked="@a.NoReminders" disabled="@_busy" @onchange="e => SetNoReminders(e.Value is true)" />
                            <label class="form-check-label" for="no-remind">Don't remind @external.Name about this one</label>
                        </div>
                    }
                    <NotEmailedNote Team="external" Changed="Reload" />
                </div>
            }

            @* Files are the action's working material, last in the side column, and last of all on a phone. *@
            <div class="tide-ord-8">
                <ActionFilesPanel @key="@($"files-{a.Id}")" Files="_detail.Files" ActionId="a.Id" Number="a.Number" CanWork="_detail.CanWork" Changed="Reload" OnComment="ShowComment" />
            </div>

            @if (a.ParentId is null && a.IsOpen && _detail.CanEditAll)
            {
                <SplitDialog @ref="_split" Parent="a" Done="Reload" />
            }
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm" />
@* A comment typed (or files attached) and not posted, or a comment's edit not saved: leaving asks first. Record an
   update and the outreach email guard their own. *@
<UnsavedGuard Dirty="CommentUnsaved" Message="@CommentUnsavedMessage" Discard="DiscardComments" />
<ScreenshotDialog Set="_shotSet" @bind-Open="_shot" />
<OverLimitDialog @ref="_overLimit" />

@* Hand it to another team: which, and why (kept in its history and shown on it). *@
<ConfirmDialog @ref="_handoffDialog" Form="true" Confirming="HandOff" ConfirmDisabled="@(_handTo == Guid.Empty || string.IsNullOrWhiteSpace(_handWhy))" ConfirmIcon="bi-box-arrow-right">
    @if (_detail is { } d)
    {
        <label class="tide-field-label" for="handoff-team">Hand it to</label>
        <select id="handoff-team" class="form-select form-select-sm" @bind="_handTo">
            <option value="@Guid.Empty">Choose a team</option>
            @foreach (var t in _teams.Where(t => !t.IsRetired && t.Id != d.Action.TeamId))
            {
                <option value="@t.Id">@t.Name@(t.IsExternal ? " (external)" : "")</option>
            }
        </select>
        <NotEmailedNote Team="@_teams.FirstOrDefault(t => t.Id == _handTo)" />
        <label class="tide-field-label mt-2" for="handoff-why">Why</label>
        <textarea id="handoff-why" class="form-control form-control-sm tide-autogrow tide-grow-2" rows="2" maxlength="@ActionItem.MaxHandoffReason" @bind="_handWhy" @bind:event="oninput"
                  placeholder="The fix is theirs: a firewall change."></textarea>
        <div class="form-text">Kept in its history and shown on it. Its assignee stays only if they're on that team.</div>
        @if (d.Action.NoReminders)
        {
            @* "Don't remind" was chosen for the team it's leaving: asked, not carried over unseen. *@
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="handoff-keep-off" @bind:get="!_turnRemindersOn" @bind:set="v => _turnRemindersOn = !v" />
                <label class="form-check-label" for="handoff-keep-off">Keep reminders off</label>
            </div>
            <div class="form-text">Its reminders are off. Untick to turn them back on for the team it goes to.</div>
        }
        @if (_handError is not null) { <div class="text-danger small mt-2" role="alert">@_handError</div> }
    }
</ConfirmDialog>

@code {
    private ConfirmDialog _confirm = default!;
    [Parameter] public int? Number { get; set; }
    // Text, parsed (FilterValues), so an id cut short ("?article=12ab") is ignored rather than failing the page.
    [SupplyParameterFromQuery(Name = "article")] public string? ArticleParam { get; set; }
    [SupplyParameterFromQuery(Name = "parent")] public string? ParentParam { get; set; }

    /// <summary>The drawer's tool to open (<c>?tool=hunt</c>), so a link can open it.</summary>
    [SupplyParameterFromQuery(Name = "tool")] public string? ToolParam { get; set; }

    /// <summary><c>?do=update</c> opens Record an update once the action is shown (a parent's Next line links a late part so).</summary>
    [SupplyParameterFromQuery(Name = "do")] public string? DoParam { get; set; }

    private bool _loaded, _busy;
    private ActionDetail? _detail;
    private IReadOnlyList<Team> _teams = [];
    private IReadOnlyList<AppUser>? _people;
    private ActionForm _form = new();
    private ActionForm? _editing;
    private ActionRow? _parent;
    private string? _articleTitle, _comment;
    private ActionStatusControl? _statusControl;
    private ActionToolDrawer? _drawer;
    private MenuButton? _more;
    private bool _prompting, _feedAll;
    private int? _shownNumber;

    // The address's tool and do as last taken, and the flow ?do= asked for, to run once the page is drawn.
    private (string? Tool, string? Do) _address;
    private ActionFlow? _do;

    // The drawer reads ?tool= itself; a new ?do= is a flow to run once.
    private void TakeAddress()
    {
        if (DoParam is not null && DoParam != _address.Do) _do = ActionGuide.Parse<ActionFlow>(DoParam);
        _address = (ToolParam, DoParam);
    }

    protected override async Task OnParametersSetAsync()
    {
        // The same action with only its address's tool or do changed (a tab chosen, ?do= taken off): nothing to read again.
        var addressOnly = Number is not null && _detail is not null && _shownNumber == Number && (ToolParam, DoParam) != _address;
        TakeAddress();
        if (addressOnly) return;
        // The first interactive draw starts from what the prerender read, so a reload doesn't flash "Loading" over the
        // page; it's read again below, quietly, only if something was saved in between.
        var adopted = false;
        if (Handoff.Take<ActionPage>(RendererInfo, PrerenderedState, out var current) is { } prerendered && prerendered.Number == Number
            && prerendered.ArticleParam == ArticleParam && prerendered.ParentParam == ParentParam)
        {
            Adopt(prerendered);
            adopted = true;
        }
        else _loaded = false;
        if (adopted && current) return;
        _teams = await TeamSvc.ListAsync(includeRetired: true);
        if (CurrentUser.Has(Permission.WriteArticles)) _people = await Users.ListAsync();
        // A new action's form is kept as the prerender left it: built again, the editor would start over in front of them.
        if (Number is null)
        {
            if (!adopted) await PrepareNew();
        }
        else
        {
            // Another action: its feed starts folded, and an edit form, comment draft or outcome prompt left open on the
            // last one goes, so it can't be saved, posted or confirmed on this one. The status control and the tool drawer
            // (its checklist, hunt and outreach panels) are keyed by the action, so they start afresh too (a half-written
            // step, query or email included).
            if (_shownNumber != Number)
            {
                _feedAll = false;
                (_editing, _editingComment, _commentEdit, _comment, _prompting, _shot) = (null, null, null, null, false, null);
                (_commentTheirs, _commentTheirsBy, _focusEditOf) = (null, null, null);
                _attachments.Clear();
            }
            _shownNumber = Number;
            await Reload();
        }
        _loaded = true;
        PrerenderedState = Handoff.Keep(RendererInfo, this, PrerenderedState);
    }

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
