    internal Task Comment() => Run(async () =>
    {
        // The box stays open while it's sent: only what went is cleared, and anything typed or attached since stays.
        var text = _comment ?? "";
        var sent = _attachments.ToList();
        await ActionSvc.AddCommentAsync(_detail!.Action.Id, text, sent.Select(f => f.Upload).ToList());
