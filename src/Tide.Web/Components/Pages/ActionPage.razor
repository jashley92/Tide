    /// <summary>
    /// Runs a flow, from the primary button, More, the Next line or the address's <c>?do=</c>: each is one the page has
    /// anyway. Only a flow the page offers whoever is looking runs.
    /// </summary>
    internal Task Run(ActionFlow flow)
    {
        if (!_offered.Contains(flow)) return Task.CompletedTask;
        return flow switch
        {
            ActionFlow.WriteEmail => WithOutreach(p => p.Writing ? Task.CompletedTask : p.ToggleWriter()),
            ActionFlow.RecordReply => WithOutreach(p => p.State.Oldest is { } oldest ? p.StartReply(oldest) : Task.CompletedTask),
            ActionFlow.RecordUpdate => StartUpdate(),
            ActionFlow.TakeIt => Take(),
            ActionFlow.StartWork or ActionFlow.Unblock => _statusControl?.Pick(ActionStatus.InProgress) ?? Task.CompletedTask,
            ActionFlow.CloseWithOutcome => _statusControl?.Pick(ActionStatus.Done) ?? Task.CompletedTask,
            ActionFlow.HandOff => StartHandoff(),
            ActionFlow.SplitToTeams => OpenSplit(),
            ActionFlow.SplitOffPart => GoSplitOff(),
            ActionFlow.Edit => Edit(),
            ActionFlow.ChangeStatus => ChangeStatus(),
            ActionFlow.Comment => _newCommentBox.TryFocusAsync(orGone: true),
            _ => Task.CompletedTask,
        };
    }

