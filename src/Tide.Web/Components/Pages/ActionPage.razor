    // Worked out once each time the action is read (Derive), not on every redraw.
    private int _openParts;
    private ActionFlow _primary;
    private NextStep? _next;
    private IReadOnlyList<MenuButton.Item> _moreItems = [];
    private IReadOnlyList<FeedEntry> _feed = [];
    private HashSet<ActionFlow> _offered = [];

    /// <summary>The header's primary button (ActionGuide.Primary, business rule A27).</summary>
    internal ActionFlow Primary => _primary;

    /// <summary>The Next line (ActionGuide.Next, business rule A28), or null when nothing needs doing.</summary>
