@page "/actions"
@attribute [Authorize(Policy = Policies.ReadActions)]
@using Tide.Domain.Common
@using Tide.Application.Preferences
@inject ActionService ActionSvc
@inject TeamService Teams
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@implements IDisposable
@inject CardRuleService RuleSvc
@inject UserPreferenceService Prefs
@inject PrerenderHandoff Handoff

<PageTitle>Actions · TIDE</PageTitle>

<div class="tide-page-head">
    <div>
        <h1>Actions</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="workload"><span class="bi bi-people" aria-hidden="true"></span> Workload</a>
        <a class="btn btn-outline-secondary" href="board-rules"><span class="bi bi-palette" aria-hidden="true"></span> Board rules</a>
        @if (Teams.CanManageExternal)
        {
            <a class="btn btn-outline-secondary" href="teams/external"><span class="bi bi-building" aria-hidden="true"></span> External teams</a>
        }
        @if (CurrentUser.Has(Permission.WriteArticles))
        {
            <a class="btn btn-primary" href="actions/new"><span class="bi bi-plus-lg" aria-hidden="true"></span> New action</a>
        }
    </div>
</div>

<div class="d-flex flex-wrap align-items-end gap-2">
    <TabBar Label="Views" Class="flex-grow-1" Items="@(Views.Where(v => !_asBoard || OnBoard(v.Item1)).Select(v => new TabBarItem(v.Item2, "", Key: v.Item1.ToString())).ToList())"
            Active="@_view.ToString()" OnSelect="k => SetView(Enum.Parse<ActionView>(k!))" />
    <TabBar Label="Layout" Level="TabLevel.Sub" Class="mb-2" Active="@(_asBoard ? "board" : "list")" OnSelect="SetLayout"
            Items="@([new TabBarItem("List", "", "bi-list-ul", "list"), new TabBarItem("Board", "", "bi-kanban", "board")])" />
</div>

@* One bar for the list and the board (FilterBar): the words, the pills used most, a chip for each other filter and
   + Filter for the rest. They combine, go in the address as before, and a change starts the list again from its first
   page. Two pills on one parameter take turns (Overdue or Due this week, Blocked or Tracking); P1–P2 is the priority
   filter holding exactly those two. The board counts its cards here; the list counts its rows under its search. *@
<FilterBar Pills="Pills" Filters="Defs" Active="AnyFilter" OnChanged="Refilter" OnClear="ClearFilters"
           Count="@(_asBoard ? $"{Count} action{(Count == 1 ? "" : "s")}" : null)">
    <Search>
        <input type="search" class="tide-maxw-sm form-control form-control-sm" placeholder="Title, A-number or article" aria-label="Search actions" maxlength="200"
               @bind="_search" @bind:event="oninput" @bind:after="SearchChanged" />
    </Search>
    <ChildContent>
        @if (_active is { } active)
        {
            <span class="tide-chip @(active.Over ? "tide-chip-over" : "")" title="Open, in progress and blocked actions owned by @active.Team, against its limit">@active.Text</span>
        }
        @if (!_asBoard)
        {
            <div class="form-check form-switch ms-2 mb-0">
                <input class="form-check-input" type="checkbox" id="group-kind" @bind="_groupByKind" @bind:after="Regroup" />
                <label class="form-check-label small" for="group-kind">Group by kind</label>
            </div>
        }
    </ChildContent>
</FilterBar>

@if (_asBoard)
{
    @if (_board is null)
    {
        <LoadingBlock />
    }
    else
    {
        <ActionKanban Board="@(_board with { Cards = Matching(_board.Cards) })" Today="ActionSvc.Today" Rules="_rules" MovedBy="_movedBy" OnChanged="Load" OnShowOlder="ShowOlder" />
    }
}
else
{
<div class="tide-card">
    @* The server filters, sorts, groups and pages the list, 50 rows a page; the page is ?page=, its pager links. *@
    <ActionTable PageInAddress="true" ServerSide="true" Total="_total" GroupTotals="_groups" PageSize="ActionService.ListPageSize" OnQuery="Query" Filtered="Filtered"
                 Rows="@(_loading ? null : _rows)" Today="ActionSvc.Today" Live="_marks" Rules="_rules" Filter="@_search" GroupByKind="_groupByKind" GroupByUrgency="ByUrgency"
                 DefaultSort="@DefaultSort(_view)" Caption="@(ViewName + (_view == ActionView.Closed ? ", most recently closed first" : ByUrgency ? ", grouped by when they're due" : ""))">
        <Empty><EmptyState Icon="@(_view == ActionView.Overdue ? "bi-check2-circle" : "bi-list-check")" Title="@Empty" /></Empty>
    </ActionTable>
</div>
}

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }
    [SupplyParameterFromQuery(Name = "team")] public string? TeamParam { get; set; }
    [SupplyParameterFromQuery(Name = "assignee")] public string? AssigneeParam { get; set; }
    [SupplyParameterFromQuery(Name = "layout")] public string? LayoutParam { get; set; }
    [SupplyParameterFromQuery(Name = "rule")] public string? RuleParam { get; set; }
    [SupplyParameterFromQuery(Name = "group")] public string? GroupParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? KindParam { get; set; }
    [SupplyParameterFromQuery(Name = "priority")] public string? PriorityParam { get; set; }
    [SupplyParameterFromQuery(Name = "due")] public string? DueParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "parent")] public string? ParentParam { get; set; }

    /// <summary>The list's page, from 1 (text, so "?page=abc" is the first page, not a broken one).</summary>
    [SupplyParameterFromQuery(Name = DataTable<ActionRow>.PageParameter)] public string? PageParam { get; set; }

    /// <summary>
    /// The layout this person last chose with the List / Board tab (the board until they choose), kept on the server so
    /// it follows them. Read once when the page opens (and carried from the prerender to the interactive render, so not
    /// read twice); it's what an address without <c>layout</c> shows. A link's own <c>layout</c> wins for that visit
    /// without changing it.
    /// </summary>
    [PersistentState]
    public string? SavedLayout { get; set; }

    private bool SavedBoard => SavedLayout == UserPreferences.Board;

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
    public string? PrerenderedState { get; set; }

    // The first interactive draw is the prerendered page: its first read keeps the page on screen while it's done again.
    private bool _adopted;

    // The address didn't say which layout: once drawn, it's made to say the one shown.
    private bool _sayLayout;

    private static readonly (ActionView, string)[] Views =
    [
        (ActionView.Mine, "Mine"), (ActionView.MyTeams, "My teams"), (ActionView.Open, "All open"), (ActionView.Overdue, "Overdue"), (ActionView.Closed, "Recently closed"),
    ];

    // The status filter's choices: the open columns (closed actions are the Recently closed view's).
    private static readonly ActionStatus[] OpenStatuses = [.. ActionItem.StatusOrder.Where(s => !ActionItem.IsClosedStatus(s))];

    private bool _loading = true, _groupByKind, _asBoard;
    private ActionBoard? _board;

    // The board's views are whose actions; Overdue and Recently closed are the list's (the board shows both by column and SLA).
    private static bool OnBoard(ActionView v) => v is ActionView.Mine or ActionView.MyTeams or ActionView.Open;
    private IReadOnlyList<ActionRow> Unfiltered => _asBoard ? _board?.Cards ?? [] : _rows;
    private IReadOnlyList<ActionRow> Shown => _asBoard ? Matching(Unfiltered) : _rows;
    private int Count => Shown.Count;
    // Mine is grouped by when it's due, unless it's asked to be by kind.
    private bool ByUrgency => _view == ActionView.Mine && !_groupByKind;
    private string ViewName => Views.First(v => v.Item1 == _view).Item2 + " actions";

    // The administrators' card rules, and the one chosen as a filter (?rule=), with how many each matches: the list's are
    // counted by the server, the board's from its cards, once each time it's read.
    private IReadOnlyList<ActionCardRule> _rules = [];
    private Guid? _ruleId;
    private IReadOnlyDictionary<Guid, int> _ruleCounts = new Dictionary<Guid, int>();

    private IReadOnlyList<ActionRow> Matching(IReadOnlyList<ActionRow> rows) =>
        _rules.FirstOrDefault(r => r.Id == _ruleId) is { } rule ? rows.Where(c => ActionRules.Matches(rule, c, ActionSvc.Today, ActionSvc.Days)).ToList() : rows;
    private ActionView _view = ActionView.Open;
    private Guid? _teamId;
    private ActionKind? _kind;
    private string? _assignee;   // from Workload: one holder's open actions
    private string? _search;
    private IReadOnlyList<Priority> _priorities = [];
    private ActionDue? _due;
    private ActionStatus? _status;

    // The parts of one action (?parent=12), and the team filtered to's active count against its limit, if it has one.
    private int? _parentNumber;
    private TeamActive? _active;
    private IReadOnlyList<Team> _teams = [];

    // The list: this page's rows, how many match in all, and in each group; its page and sort. The board: how far back
    // its closed columns reach (Show older takes them to 30 days, for this visit).
    private IReadOnlyList<ActionRow> _rows = [];
    private int _total, _page = 1, _closedDays = ActionService.BoardClosedDays;
    private IReadOnlyDictionary<string, int>? _groups;
    private TableSort? _sort = ActionTable.SoonestDue;

    // How long typing in the search box pauses before the actions are searched.
    private readonly TypingPause _typing = new(300);

    private bool Filtered => _search is not null || _priorities.Count > 0 || _due is not null || _status is not null || _ruleId is not null || _parentNumber is not null;

    private string Empty => _view switch
    {
        _ when _priorities.Count > 0 || _due is not null || _status is not null || _parentNumber is not null || (_ruleId is not null && !_asBoard) => "No actions match these filters.",
        ActionView.Mine => "Nothing assigned to you.",
        ActionView.MyTeams => "Your teams have no open actions (or you're on no team).",
        ActionView.Overdue => "Nothing is overdue.",
        ActionView.Closed => "Nothing closed in the last 90 days.",
        _ => "No open actions.",
    };

    // A view's own order: soonest due first, or for Recently closed, most recently closed first.
    private static TableSort? DefaultSort(ActionView view) => view == ActionView.Closed ? null : ActionTable.SoonestDue;

    // A colleague created, took, moved or closed an action: re-read the list in place (no loading flash), once per burst.
    // Each save is heard as the action's own topic too, which says whose card it was and who moved it (the board says so).
    // In the list the rows it brought or changed are highlighted a moment.
    private LiveChanges? _live;
    private LiveMarks<Guid>? _marks;
    private IReadOnlyDictionary<Guid, string> _movedBy = new Dictionary<Guid, string>();

    private static Guid? ActionOf(Change c) =>
        c.Topic.StartsWith("action:", StringComparison.Ordinal) && Guid.TryParse(c.Topic.AsSpan("action:".Length), out var id) ? id : null;

    protected override async Task OnInitializedAsync()
    {
        _marks = new LiveMarks<Guid>(InvokeAsync, StateHasChanged);
        _live = new LiveChanges(Feed, Origin, c => c.Topic == ChangeFeed.Actions || ActionOf(c) is not null, InvokeAsync, async heard =>
        {
            if (!heard.Any(c => c.Topic == ChangeFeed.Actions)) return;   // only a comment or a hunt: nothing on the list changed
            _movedBy = heard.Select(c => (Id: ActionOf(c), c.ActorName)).Where(x => x.Id is not null)
                .GroupBy(x => x.Id!.Value).ToDictionary(g => g.Key, g => g.Last().ActorName);
            try
            {
                var was = _rows;
                await Fetch();
                if (!_asBoard) _marks?.Apply(LiveDiff.Of(was, _rows, r => r.Id, r => r));
            }
            catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
            StateHasChanged();
        });
        // Taken before the first await, which is when the interactive render first draws: from the same address only.
        if (Handoff.Take<ActionsBoard>(RendererInfo, PrerenderedState) is { } prerendered && prerendered._applied == FromAddress())
            Adopt(prerendered);
        _teams = await Teams.ListAsync();
        _teamOptions = TeamOptions(_teams);
        _rules = await RuleSvc.ListAsync();
        SavedLayout ??= await Prefs.GetAsync(UserPreferences.ActionsLayout);
    }

    // What the address says: compared, so the page knows when a link has changed it. The team, rule and parent are read as
    // text and parsed here (FilterValues), so a value that isn't one ("?team=network") is ignored rather than failing the page.
    private sealed record Address(string? View, Guid? Team, string? Assignee, string? Layout, Guid? Rule, string? Group,
        string? Q, string? Kind, string? Priority, string? Due, string? Status, string? Page, int? Parent = null);

    private Address FromAddress() =>
        new(ViewParam, FilterValues.Id(TeamParam), AssigneeParam, LayoutParam, FilterValues.Id(RuleParam), GroupParam, Q, KindParam, PriorityParam, DueParam, StatusParam, PageParam,
            FilterValues.Number(ParentParam));

    // The address as last applied. The page stays open when a link changes only the query (the sidebar's Actions from
    // ?view=closed, a link to ?view=overdue, a pager link), so the address is read whenever it changes, not only when the
    // page opens. The page's own address updates (Remember) record what they write first, so they don't re-read it.
    private Address? _applied;

    protected override async Task OnParametersSetAsync()
    {
        var query = FromAddress();
        if (_applied == query) return;
        var was = _applied;
        _applied = query;
        _view = EnumNames.OrNull<ActionView>(ViewParam, ignoreCase: true) ?? ActionView.Mine;
        _groupByKind = string.Equals(GroupParam, "kind", StringComparison.OrdinalIgnoreCase);
        // No layout in the address: the person's own. A link to a view the board doesn't have (Overdue, Recently
        // closed) or to the list grouped by kind asks for the list, so it opens as the list.
        _asBoard = LayoutParam is not null ? string.Equals(LayoutParam, "board", StringComparison.OrdinalIgnoreCase)
            : SavedBoard && OnBoard(_view) && !_groupByKind;
        _sayLayout = LayoutParam is null;
        if (_asBoard && !OnBoard(_view)) _view = ActionView.Open;
        _ruleId = _rules.Any(r => r.Id == query.Rule && r.ShowAsFilter) ? query.Rule : null;
        _teamId = query.Team;
        _assignee = string.IsNullOrWhiteSpace(AssigneeParam) ? null : AssigneeParam;
        _search = string.IsNullOrWhiteSpace(Q) ? null : Q.Trim();
        _kind = EnumNames.OrNull<ActionKind>(KindParam, ignoreCase: true);
        _priorities = PrioritiesOf(FilterValues.Split(PriorityParam));
        _due = DueFrom(DueParam);
        _status = EnumNames.OrNull<ActionStatus>(StatusParam, ignoreCase: true) is { } st && OpenStatuses.Contains(st) ? st : null;
        _page = TableView.PageFrom(PageParam);
        _parentNumber = query.Parent is > 0 ? query.Parent : null;
        // Only another view resets the sort: another page (or filter) keeps the one chosen.
        if (was is null || !string.Equals(was.View, query.View, StringComparison.OrdinalIgnoreCase)) _sort = DefaultSort(_view);
        var quiet = _adopted;
        _adopted = false;
        if (await Read(quiet)) PrerenderedState = Handoff.Keep(RendererInfo, this, PrerenderedState);
    }

    private static ActionDue? DueFrom(string? text) => text?.Trim().ToLowerInvariant() switch
    {
        "overdue" => ActionDue.Overdue,
        "week" => ActionDue.ThisWeek,
        "none" => ActionDue.None,
        _ => null,
    };

    private static string? DueKey(ActionDue? due) => due switch
    {
        ActionDue.Overdue => "overdue",
        ActionDue.ThisWeek => "week",
        ActionDue.None => "none",
        _ => null,
    };

    // Takes what the prerendered page read and chose from its address, so the first interactive draw is the same page.
    private void Adopt(ActionsBoard p)
    {
        (_teams, _teamOptions, _rules, _board, _rows) = (p._teams, p._teamOptions, p._rules, p._board, p._rows);
        (_view, _asBoard, _groupByKind, _ruleId, _teamId, _assignee) = (p._view, p._asBoard, p._groupByKind, p._ruleId, p._teamId, p._assignee);
        (_search, _kind, _priorities, _due, _status) = (p._search, p._kind, p._priorities, p._due, p._status);
        (_parentNumber, _active) = (p._parentNumber, p._active);
        (_total, _page, _groups, _sort, _ruleCounts) = (p._total, p._page, p._groups, p._sort, p._ruleCounts);
        (_loading, _adopted) = (false, true);
    }

    // The priorities in the address ("p1,p2"), each once, in order; a name that isn't one is dropped.
    private static IReadOnlyList<Priority> PrioritiesOf(IEnumerable<string> values) =>
        [.. values.Select(v => EnumNames.OrNull<Priority>(v, ignoreCase: true)).OfType<Priority>().Distinct().Order()];

    // The options that don't change: built once. The teams' when they're read.
    private static readonly IReadOnlyList<FilterOption> KindOptions = FilterOption.ForEnum<ActionKind>(ActionService.KindName);
    private static readonly IReadOnlyList<FilterOption> PriorityOptions = FilterOption.ForEnum<Priority>();
    private static readonly IReadOnlyList<FilterOption> DueOptions =
        [new(nameof(ActionDue.Overdue), "Overdue"), new(nameof(ActionDue.ThisWeek), "This week"), new(nameof(ActionDue.None), "No due date")];
    private static readonly IReadOnlyList<FilterOption> StatusOptions = [.. OpenStatuses.Select(s => new FilterOption(s.ToString(), ActionService.StatusName(s)))];
    private IReadOnlyList<FilterOption> _teamOptions = [];

    private static IReadOnlyList<FilterOption> TeamOptions(IEnumerable<Team> teams) => [.. teams.Select(t => new FilterOption(t.Id.ToString(), t.Name))];

    // The pills: presets of the filters used most. Overdue and Due this week are both due=, so they take turns, as do
    // Blocked and Tracking; P1–P2 is the priority filter holding exactly those two.
    internal static readonly IReadOnlyList<FilterPill> Pills =
    [
        new("overdue", "Overdue", "due", [nameof(ActionDue.Overdue)]),
        // This week is the organization's business week, its holidays included: today to its last working day.
        new("week", "Due this week", "due", [nameof(ActionDue.ThisWeek)]) { Title = "Due from today to the last working day of this week" },
        new("p1p2", "P1–P2", "priority", [nameof(Priority.P1), nameof(Priority.P2)]),
        new("blocked", "Blocked", "status", [nameof(ActionStatus.Blocked)]),
        new("tracking", "Tracking", "status", [nameof(ActionStatus.Tracking)]) { Title = "Handed to others and followed until it's done" },
    ];

    // Every filter, under + Filter. A holder (from Workload) and the parts of one action (from its page) are set by
    // links, so they're chips to remove, not in the menu.
    internal IReadOnlyList<FilterDef> Defs
    {
        get
        {
            var defs = new List<FilterDef>
            {
                new("team", "Team", FilterKind.Single, v => _teamId = Guid.TryParse(FilterValues.First(v), out var team) ? team : null)
                {
                    Options = _teamOptions, Values = FilterValues.Of(_teamId?.ToString()),
                },
                new("kind", "Kind", FilterKind.Single, v => _kind = FilterValues.Enum<ActionKind>(v)) { Options = KindOptions, Values = FilterValues.Of(_kind?.ToString()) },
                new("priority", "Priority", FilterKind.Multi, v => _priorities = PrioritiesOf(v)) { Options = PriorityOptions, Values = [.. _priorities.Select(p => p.ToString())] },
                new("due", "Due", FilterKind.Single, v => _due = FilterValues.Enum<ActionDue>(v)) { Options = DueOptions, Values = FilterValues.Of(_due?.ToString()) },
                new("status", "Status", FilterKind.Single, v => _status = FilterValues.Enum<ActionStatus>(v) is { } st && OpenStatuses.Contains(st) ? st : null)
                {
                    Options = StatusOptions, Values = FilterValues.Of(_status?.ToString()),
                },
            };
            // An administrator's card rules shown as filters, each with how many it matches (counted as the list or board is read).
            var rules = _rules.Where(r => r.ShowAsFilter).ToList();
            if (rules.Count > 0)
                defs.Add(new("rule", "Rule", FilterKind.Single, v => _ruleId = Guid.TryParse(FilterValues.First(v), out var id) && rules.Any(r => r.Id == id) ? id : null)
                {
                    Options = [.. rules.Select(r => new FilterOption(r.Id.ToString(), $"{r.Name} ({_ruleCounts.GetValueOrDefault(r.Id)})"))],
                    Values = FilterValues.Of(_ruleId?.ToString()),
                    ChipText = rules.FirstOrDefault(r => r.Id == _ruleId) is { } rule ? "Rule: " + rule.Name : null,
                });
            if (_assignee is { } holder)
                defs.Add(new("assignee", "Held by", FilterKind.Single, _ => _assignee = null)
                {
                    InMenu = false, Values = [holder],
                    ChipText = "Held by " + (holder == ActionFilter.Unassigned ? "nobody (the team's)" : Shown.FirstOrDefault()?.AssigneeName ?? "one person"),
                });
            if (_parentNumber is { } parent)
                defs.Add(new("parent", "Part of", FilterKind.Single, _ => _parentNumber = null) { InMenu = false, Values = [parent.ToString()], ChipText = "Part of " + Ui.ActionLabel(parent) });
            return defs;
        }
    }

    // Clear shows while anything narrows the list: a pill, a filter, the words.
    private bool AnyFilter => Filtered || _teamId is not null || _kind is not null || _assignee is not null;

    // Clear: every filter and the words; the view, layout and grouping stay.
    internal Task ClearFilters()
    {
        (_search, _teamId, _kind, _assignee, _due, _status, _ruleId, _parentNumber) = (null, null, null, null, null, null, null, null);
        _priorities = [];
        return Refilter();
    }

    // A filter changed (the bar, Clear, the words): read from the list's first page, and the address says so.
    internal async Task Refilter()
    {
        _page = 1;
        await Load();
        Remember();
    }

    // Grouping by kind is the list's own order: from its first page too.
    private Task Regroup() => Refilter();

    // Search as you type, once typing pauses.
    private async Task SearchChanged()
    {
        if (await _typing.Settled()) await Refilter();
    }

    private async Task SetView(ActionView view)
    {
        _view = view;
        _assignee = null;
        _page = 1;
        _sort = DefaultSort(view);
        Remember();
        await Load();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!_sayLayout) return;
        _sayLayout = false;
        // Only the layout is added (the team, holder and the rest stay as they were), and recorded first so it isn't re-read.
        var layout = _asBoard ? UserPreferences.Board : UserPreferences.List;
        _applied = FromAddress() with { Layout = layout };
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("layout", layout), replace: true);
    }

    // The tab is the one place the preference changes; a link's layout only applies to its visit.
    private async Task SetLayout(string? layout)
    {
        _asBoard = layout == "board";
        if (_asBoard && !OnBoard(_view)) _view = ActionView.Open;
        _page = 1;
        SavedLayout = _asBoard ? UserPreferences.Board : UserPreferences.List;
        try { await Prefs.SetAsync(UserPreferences.ActionsLayout, SavedLayout); }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        Remember();
        await Load();
    }

    // The address of what's shown: every filter, and the page when it isn't the first. Recorded first, so writing it
    // doesn't read it again.
    private void Remember()
    {
        // The address always says which layout it is, so a reload or a copy of it opens what's shown.
        var layout = _asBoard ? UserPreferences.Board : UserPreferences.List;
        var view = _view.ToString().ToLowerInvariant();
        var group = !_asBoard && _groupByKind ? "kind" : null;
        var (kind, priority, status) = (_kind?.ToString().ToLowerInvariant(), FilterValues.Join(_priorities.Select(p => p.ToString().ToLowerInvariant())), _status?.ToString().ToLowerInvariant());
        var page = !_asBoard && _page > 1 ? _page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;
        _applied = new Address(view, _teamId, _assignee, layout, _ruleId, group, _search, kind, priority, DueKey(_due), status, page, _parentNumber);
        Nav.NavigateTo(Nav.GetUriWithQueryParameters("actions", new Dictionary<string, object?>
        {
            ["view"] = view, ["layout"] = layout, ["group"] = group, ["rule"] = _ruleId, ["team"] = _teamId, ["assignee"] = _assignee,
            ["q"] = _search, ["kind"] = kind, ["priority"] = priority, ["due"] = DueKey(_due), ["status"] = status, ["page"] = page, ["parent"] = _parentNumber,
        }), replace: true);
    }

    // A new sort from the list's headings, or "Clear the filter" from its empty state: from the first page.
    private async Task Query(TableQuery q)
    {
        _sort = q.Sort;
        _search = string.IsNullOrWhiteSpace(q.Filter) ? null : q.Filter.Trim();
        _page = 1;
        await Load();
        Remember();
    }

    // Show older under the board's Done: the closed columns reach back 30 days, for this visit.
    private async Task ShowOlder()
    {
        _closedDays = ActionService.BoardOlderDays;
        await Load();
    }

    private Task Load() => Read(quiet: false);

    private ActionFilter Filter() => new ActionFilter(_view, _teamId, _kind, AssigneeId: _assignee)
    {
        Search = _search, Priorities = _priorities, Due = _due, Status = _status, ParentNumber = _parentNumber,
    };

    private ActionSort SortOf(TableSort? sort) => sort?.Key switch
    {
        "number" => ActionSort.Number,
        "title" => ActionSort.Title,
        "kind" => ActionSort.Kind,
        "team" => ActionSort.Team,
        "status" => ActionSort.Status,
        "due" => ActionSort.Due,
        _ => _view == ActionView.Closed ? ActionSort.Closed : ActionSort.Due,
    };

    // Reads the board, or the list's page (with each rule filter's count).
    private async Task Fetch()
    {
        var filter = Filter();
        // The team's count against its limit is read alongside, on its own context.
        var active = _teamId is { } team ? ActionSvc.TeamActiveAsync(team) : Task.FromResult<TeamActive?>(null);
        if (_asBoard)
        {
            var board = ActionSvc.BoardAsync(filter, _closedDays);
            await Task.WhenAll(active, board);
            (_board, _active) = (board.Result, active.Result);
            _ruleCounts = _rules.Where(r => r.ShowAsFilter).ToDictionary(r => r.Id, r => _board.Cards.Count(c => ActionRules.Matches(r, c, ActionSvc.Today, ActionSvc.Days)));
            return;
        }
        var grouping = _groupByKind ? ActionGrouping.Kind : ByUrgency ? ActionGrouping.Urgency : ActionGrouping.None;
        var read = ActionSvc.PageAsync(filter with { RuleId = _ruleId }, SortOf(_sort), _sort?.Descending ?? false, grouping, _page);
        await Task.WhenAll(active, read);
        var page = read.Result;
        _active = active.Result;
        // A page past the end (an old link, or the list shrank) shows the last one; the pager says which, and so does the
        // address (in place, recorded first so it isn't read again; a prerender can't move it, and the live page does).
        var asked = _page;
        (_rows, _total, _page, _groups) = (page.Rows, page.Total, page.Page, page.Groups);
        if (_page != asked && _applied is { } applied)
        {
            _applied = applied with { Page = _page > 1 ? _page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null };
            TableView.SayPage(Nav, RendererInfo, _page);
        }
        _ruleCounts = _rules.Any(r => r.ShowAsFilter) ? await ActionSvc.RuleCountsAsync(filter, _rules.Where(r => r.ShowAsFilter)) : new Dictionary<Guid, int>();
    }

    // Quiet, the list stays as it is while it's read (it's the prerendered one); otherwise it shows "Loading". False when
    // the read failed.
    private async Task<bool> Read(bool quiet)
    {
        if (!quiet) _loading = true;
        _movedBy = new Dictionary<Guid, string>();   // what's shown next is this person's choice, not a colleague's news
        _marks?.Clear();
        try
        {
            await Fetch();
            return true;
        }
        catch (Exception ex)
        {
            Toasts.Error(UserFacingError.For(ex));
            return false;
        }
        finally { _loading = false; }
    }

    public void Dispose()
    {
        _typing.Now();   // a search typed just before is dropped
        _live?.Dispose();
        _marks?.Dispose();
    }
}
