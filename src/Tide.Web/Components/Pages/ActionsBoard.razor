@page "/actions"
@attribute [Authorize(Policy = Policies.ReadActions)]
@using Tide.Domain.Common
@using Tide.Application.Preferences
@inject ActionService ActionSvc
@inject TeamService Teams
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@implements IDisposable
@inject CardRuleService RuleSvc
@inject UserPreferenceService Prefs
@inject SavedViewService SavedViews
@inject PrerenderHandoff Handoff
@inject IJSRuntime JS

<PageTitle>Actions · TIDE</PageTitle>

<div class="tide-page-head">
    <div>
        <h1 @ref="_heading" tabindex="-1">Actions</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="workload"><span class="bi bi-people" aria-hidden="true"></span> Workload</a>
        <a class="btn btn-outline-secondary" href="library/board-rules"><span class="bi bi-palette" aria-hidden="true"></span> Board rules</a>
        @if (Teams.CanManageExternal)
        {
            <a class="btn btn-outline-secondary" href="teams/external"><span class="bi bi-building" aria-hidden="true"></span> External teams</a>
        }
        @if (CurrentUser.Has(Permission.WriteArticles))
        {
            <a class="btn btn-primary" href="actions/new"><span class="bi bi-plus-lg" aria-hidden="true"></span> New action</a>
        }
    </div>
</div>

<div class="d-flex flex-wrap align-items-end gap-2">
    @* Each tab says how many open actions it shows under the filters set (one grouped count, ActionService.ViewCountsAsync),
       the same on the list and the board. *@
    <TabBar Label="Views" Items="@(Views.Where(v => !_asBoard || OnBoard(v.Item1)).Select(v => new TabBarItem(v.Item2, "", Key: v.Item1.ToString(), Count: _counts?.For(v.Item1))).ToList())"
            Active="@_view.ToString()" OnSelect="k => SetView(Enum.Parse<ActionView>(k!))" Class="tide-actions-views" />
    @if (DefaultFor(_view) is { } shown)
    {
        @* The tab this page opens on when a link doesn't say: the person's own, set here. *@
        <div class="mb-2 small">
            @if (shown == SavedView)
            {
                <span class="tide-muted" id="view-default"><span class="bi bi-star-fill" aria-hidden="true"></span> Opens here</span>
            }
            else
            {
                <button type="button" class="btn btn-link btn-sm p-0" id="view-default" disabled="@_busyDefault" @onclick="() => SetDefaultView(shown)"
                        title="Open Actions on @ViewLabel(_view) when a link doesn't say which tab"><span class="bi bi-star" aria-hidden="true"></span> Open here by default</button>
            }
        </div>
    }
    @* The person's own saved views: a link each to the tab, layout and filters it keeps, the one shown marked, with a
       menu to rename, move or delete it; Save view keeps what's shown now. *@
    <div class="tide-savedviews flex-grow-1 mb-2">
        @if (_saved.Count > 0)
        {
            var current = ActiveSaved;
            <nav class="tide-savedviews-list" aria-label="Saved views">
                @foreach (var v in _saved)
                {
                    var on = v.Id == current?.Id;
                    <span class="tide-savedview" @key="v.Id">
                        <a class="tide-chip tide-chip-pick @(on ? "selected" : "")" href="@("actions?" + v.Query)" aria-current="@(on ? "page" : null)">@v.Name</a>
                        <MenuButton Label="@($"{v.Name}: rename, move or delete")" IconOnly="true" Icon="bi-three-dots-vertical" ButtonClass="tide-savedview-menu"
                                    Items="@SavedMenu(v)" />
                    </span>
                }
            </nav>
        }
        <button type="button" class="tide-filter-add" id="save-view" disabled="@(_saved.Count >= SavedViewService.MaxViews)" @onclick="StartSave"
                title="@(_saved.Count >= SavedViewService.MaxViews ? $"You can keep up to {SavedViewService.MaxViews} views: delete one to save another" : "Keep this tab, layout and filters as a view of your own, beside the tabs")">
            <span class="bi bi-bookmark-plus" aria-hidden="true"></span> Save view
        </button>
    </div>
    <TabBar Label="Layout" Level="TabLevel.Sub" Class="mb-2" Active="@(_asBoard ? "board" : "list")" OnSelect="SetLayout"
            Items="@([new TabBarItem("List", "", "bi-list-ul", "list"), new TabBarItem("Board", "", "bi-kanban", "board")])" />
</div>

@* One bar for the list and the board (FilterBar): the words, the pills used most, a chip for each other filter and
   + Filter for the rest. They combine, go in the address as before, and a change starts the list again from its first
   page. Two pills on one parameter take turns (Overdue or Due this week, Blocked or Tracking); P1–P2 is the priority
   filter holding exactly those two. The board counts its cards here; the list counts its rows under its search. *@
<FilterBar Pills="PillsCounted" Filters="Defs" Active="AnyFilter" OnChanged="Refilter" OnClear="ClearFilters"
           Count="@(_asBoard ? $"{Count} action{(Count == 1 ? "" : "s")}" : null)">
    <Search>
        <input type="search" class="tide-maxw-sm form-control form-control-sm" placeholder="Title, A-number or article" aria-label="Search actions" maxlength="200"
               @bind="_search" @bind:event="oninput" @bind:after="SearchChanged" />
    </Search>
    <ChildContent>
        @if (_active is { } active)
        {
            <span class="tide-chip @(active.Over ? "tide-chip-over" : "")" title="Open, in progress and blocked actions owned by @active.Team, against its limit">@active.Text</span>
        }
        @if (!_asBoard)
        {
            <div class="form-check form-switch ms-2 mb-0">
                <input class="form-check-input" type="checkbox" id="group-kind" @bind="_groupByKind" @bind:after="Regroup" />
                <label class="form-check-label small" for="group-kind">Group by kind</label>
            </div>
        }
    </ChildContent>
</FilterBar>

@if (UnownedInMyTeams is { } unowned)
{
    @* Mine is empty, but work in the person's teams has nobody: say so, with the way to it. *@
    <p class="tide-actions-unowned" id="mine-unowned">
        <span class="bi bi-person-dash" aria-hidden="true"></span>
        Nothing open is assigned to you. Your teams have @unowned action@(unowned == 1 ? "" : "s") with no owner.
        <a href="@NoOwnerLink" @onclick="ShowThemClicked">Show them</a>
    </p>
}

@if (_asBoard)
{
    @if (_board is null)
    {
        <LoadingBlock />
    }
    else
    {
        <ActionKanban Board="@(_board with { Cards = Matching(_board.Cards) })" Today="ActionSvc.Today" Rules="_rules" MovedBy="_movedBy" OnChanged="Load" OnShowOlder="ShowOlder"
                      Counts="@(_counts ?? ActionViewCounts.None)" ClosedDays="_closedDays" />
    }
}
else
{
<div class="tide-card">
    @* The server filters, sorts, groups and pages the list, 50 rows a page; the page is ?page=, its pager links. *@
    <ActionTable @ref="_table" PageInAddress="true" ServerSide="true" Total="_total" GroupTotals="_groups" PageSize="ActionService.ListPageSize" OnQuery="Query" Filtered="AnyFilter"
                 Rows="@(_loading ? null : _rows)" Today="ActionSvc.Today" Live="_marks" Rules="_rules" Filter="@Words" GroupByKind="_groupByKind" GroupByUrgency="ByUrgency"
                 CanTake="_workers.CanTake" OnTake="Take" Busy="_taking"
                 DefaultSort="@DefaultSort(_view)" Caption="@(ViewName + (_view == ActionView.Closed ? ", most recently closed first" : ByUrgency ? ", grouped by when they're due" : ""))">
        <Empty><EmptyState Icon="@(_view == ActionView.Overdue ? "bi-check2-circle" : "bi-list-check")" Title="@Empty" /></Empty>
    </ActionTable>
</div>
}

@* Save view and Rename: the view's name. Kept open, saying why, when it's refused (a name already used, the 12th view). *@
<ConfirmDialog @ref="_nameDialog" Form="true" Confirming="SaveName" ConfirmDisabled="@string.IsNullOrWhiteSpace(_newName)" ConfirmIcon="bi-bookmark-check">
    <label class="tide-field-label" for="saved-view-name">Name</label>
    <input id="saved-view-name" class="form-control form-control-sm" maxlength="@SavedActionView.MaxName" @bind="_newName" @bind:event="oninput"
           placeholder="My team's P1s" autocomplete="off" />
    <div class="form-text">@(_renaming is null ? "Keeps this tab, layout and filters beside the tabs. Only you see your views." : "Only the name changes: the view still opens the same filters.")</div>
    @if (_nameError is not null) { <div class="text-danger small mt-2" role="alert">@_nameError</div> }
</ConfirmDialog>
<ConfirmDialog @ref="_confirm" />

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }
    [SupplyParameterFromQuery(Name = "team")] public string? TeamParam { get; set; }
    [SupplyParameterFromQuery(Name = "assignee")] public string? AssigneeParam { get; set; }
    [SupplyParameterFromQuery(Name = "layout")] public string? LayoutParam { get; set; }
    [SupplyParameterFromQuery(Name = "rule")] public string? RuleParam { get; set; }
    [SupplyParameterFromQuery(Name = "group")] public string? GroupParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? KindParam { get; set; }
    [SupplyParameterFromQuery(Name = "priority")] public string? PriorityParam { get; set; }
    [SupplyParameterFromQuery(Name = "due")] public string? DueParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "parent")] public string? ParentParam { get; set; }
    [SupplyParameterFromQuery(Name = "teams")] public string? TeamsParam { get; set; }
    [SupplyParameterFromQuery(Name = "raised")] public string? RaisedParam { get; set; }

    /// <summary>The list's page, from 1 (text, so "?page=abc" is the first page, not a broken one).</summary>
    [SupplyParameterFromQuery(Name = DataTable<ActionRow>.PageParameter)] public string? PageParam { get; set; }

    /// <summary>
    /// The layout this person last chose with the List / Board tab (the board until they choose), kept on the server so
    /// it follows them. Read once when the page opens (and carried from the prerender to the interactive render, so not
    /// read twice); it's what an address without <c>layout</c> shows. A link's own <c>layout</c> wins for that visit
    /// without changing it.
    /// </summary>
    [PersistentState]
    public string? SavedLayout { get; set; }

    private bool SavedBoard => SavedLayout == UserPreferences.Board;

    /// <summary>
    /// The tab this person opens Actions on (Mine until they choose; My teams or All open), kept on the server like the
    /// layout and read with it. An address with <c>view</c> (the sidebar's Recently closed, Today's links) wins.
    /// </summary>
    [PersistentState]
    public string? SavedView { get; set; }

    private bool _busyDefault;

    // The preference's value for a tab that can be a default; null for Overdue and Recently closed.
    private static string? DefaultFor(ActionView v) => v switch
    {
        ActionView.Mine => UserPreferences.Mine,
        ActionView.MyTeams => UserPreferences.MyTeams,
        ActionView.Open => UserPreferences.AllOpen,
        _ => null,
    };

    private static string ViewLabel(ActionView v) => Views.First(x => x.Item1 == v).Item2;

    /// <summary>
    /// The tab an address without <c>view</c> opens: the person's default, unless it would always be empty for them:
    /// Mine for someone who can't be given actions (a Viewer), My teams for someone on no team. Those open All open instead.
    /// </summary>
    internal ActionView OpeningView()
    {
        var chosen = SavedView switch { UserPreferences.MyTeams => ActionView.MyTeams, UserPreferences.AllOpen => ActionView.Open, _ => ActionView.Mine };
        return chosen switch
        {
            ActionView.Mine when !CanHold => ActionView.Open,
            ActionView.MyTeams when !_teams.Any(t => t.Members.Any(m => m.UserId == Me_)) => ActionView.Open,
            _ => chosen,
        };
    }

    // Whether actions can be given to this person: whoever works them, on a team (WorkActions) or all of them (WriteArticles).
    // Read once as the page opens, with who they are, so a later address change reads the same person.
    private bool CanHold => _canHold ??= CurrentUser.Has(Permission.WorkActions) || CurrentUser.Has(Permission.WriteArticles);
    private bool? _canHold;
    private string? _me;
    private string Me_ => _me ??= CurrentUser.UserId;

    // "Open here by default": this tab, from now on, wherever they sign in.
    internal async Task SetDefaultView(string value)
    {
        if (_busyDefault) return;
        _busyDefault = true;
        try
        {
            await Prefs.SetAsync(UserPreferences.ActionsView, value);
            SavedView = value;
            Toasts.Show($"Actions opens on {ViewLabel(_view)} from now on.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busyDefault = false; }
    }

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
    public string? PrerenderedState { get; set; }

    // The first interactive draw is the prerendered page: its first read keeps the page on screen while it's done again.
    private bool _adopted;

    // The address didn't say which layout: once drawn, it's made to say the one shown.
    private bool _sayLayout;

    private static readonly (ActionView, string)[] Views =
    [
        (ActionView.Mine, "Mine"), (ActionView.MyTeams, "My teams"), (ActionView.Open, "All open"), (ActionView.Overdue, "Overdue"), (ActionView.Closed, "Recently closed"),
    ];

    // The status filter's choices: the open columns (closed actions are the Recently closed view's).
    private static readonly ActionStatus[] OpenStatuses = [.. ActionItem.StatusOrder.Where(s => !ActionItem.IsClosedStatus(s))];

    private bool _loading = true, _groupByKind, _asBoard;
    private ActionBoard? _board;

    // The board's views are whose actions; Overdue and Recently closed are the list's (the board shows both by column and SLA).
    private static bool OnBoard(ActionView v) => v is ActionView.Mine or ActionView.MyTeams or ActionView.Open;
    private IReadOnlyList<ActionRow> Unfiltered => _asBoard ? _board?.Cards ?? [] : _rows;
    private IReadOnlyList<ActionRow> Shown => _asBoard ? Matching(Unfiltered) : _rows;
    private int Count => Shown.Count;
    // Mine is grouped by when it's due, unless it's asked to be by kind.
    private bool ByUrgency => _view == ActionView.Mine && !_groupByKind;
    private string ViewName => Views.First(v => v.Item1 == _view).Item2 + " actions";

    // The administrators' card rules, and the one chosen as a filter (?rule=), with how many each matches: the list's are
    // counted by the server, the board's from its cards, once each time it's read.
    private IReadOnlyList<ActionCardRule> _rules = [];
    private Guid? _ruleId;
    private IReadOnlyDictionary<Guid, int> _ruleCounts = new Dictionary<Guid, int>();

    private IReadOnlyList<ActionRow> Matching(IReadOnlyList<ActionRow> rows) =>
        _rules.FirstOrDefault(r => r.Id == _ruleId) is { } rule ? rows.Where(c => ActionRules.Matches(rule, c, ActionSvc.Today, ActionSvc.Days)).ToList() : rows;
    private ActionView _view = ActionView.Open;
    private Guid? _teamId;
    private ActionKind? _kind;
    private string? _assignee;   // Held by: one person's actions (or nobody's), from the menu or a Workload link
    private ActionTeams? _side;   // only internal teams' actions, or only external teams'
    private bool _raised;   // only the ones this person raised
    private IReadOnlyList<ActionHolder> _holders = [];
    private string? _search;

    // The words searched for: none for an empty box or spaces (_search is the box as typed, so it isn't trimmed under the
    // cursor). What filters, what the address says and what counts as a filter all read this.
    private string? Words => string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
    private IReadOnlyList<Priority> _priorities = [];
    private ActionDue? _due;
    private ActionStatus? _status;

    // The parts of one action (?parent=12), and the team filtered to's active count against its limit, if it has one.
    private int? _parentNumber;
    private TeamActive? _active;
    private IReadOnlyList<Team> _teams = [];

    // The list: this page's rows, how many match in all, and in each group; its page and sort. The board: how far back
    // its closed strip counts ("Show the last 30 days" takes it to 30, for this visit).
    private IReadOnlyList<ActionRow> _rows = [];
    private int _total, _page = 1, _closedDays = ActionService.BoardClosedDays;
    private IReadOnlyDictionary<string, int>? _groups;
    private TableSort? _sort = ActionTable.SoonestDue;

    // How long typing in the search box pauses before the actions are searched.
    private readonly TypingPause _typing = new(300);

    // The filters besides the card rule and the bar's Team, Kind and Held by.
    private bool Narrowed => Words is not null || _priorities.Count > 0 || _due is not null || _status is not null || _parentNumber is not null
        || _side is not null || _raised;

    // Every filter but the card rule, which the empty message counts only off the board. AnyFilter is these or the rule.
    private bool FilteredBesidesRule => Narrowed || _teamId is not null || _kind is not null || _assignee is not null;

    private string Empty => _view switch
    {
        _ when FilteredBesidesRule || (_ruleId is not null && !_asBoard) => "No actions match these filters.",
        ActionView.Mine => "Nothing assigned to you.",
        ActionView.MyTeams => "Your teams have no open actions (or you're on no team).",
        ActionView.Overdue => "Nothing is overdue.",
        ActionView.Closed => "Nothing closed in the last 90 days.",
        _ => "No open actions.",
    };

    // A view's own order: soonest due first, or for Recently closed, most recently closed first.
    private static TableSort? DefaultSort(ActionView view) => view == ActionView.Closed ? null : ActionTable.SoonestDue;

    // A colleague created, took, moved or closed an action: re-read the list in place (no loading flash), once per burst.
    // Each save is heard as the action's own topic too, which says whose card it was and who moved it (the board says so).
    // In the list the rows it brought or changed are highlighted a moment.
    private LiveChanges? _live;
    private LiveMarks<Guid>? _marks;
    private IReadOnlyDictionary<Guid, string> _movedBy = new Dictionary<Guid, string>();

    private static Guid? ActionOf(Change c) =>
        c.Topic.StartsWith("action:", StringComparison.Ordinal) && Guid.TryParse(c.Topic.AsSpan("action:".Length), out var id) ? id : null;

    protected override async Task OnInitializedAsync()
    {
        _marks = new LiveMarks<Guid>(InvokeAsync, StateHasChanged);
        _live = new LiveChanges(Feed, Origin, c => c.Topic == ChangeFeed.Actions || ActionOf(c) is not null, InvokeAsync, async heard =>
        {
            if (!heard.Any(c => c.Topic == ChangeFeed.Actions)) return;   // only a comment or a hunt: nothing on the list changed
            _movedBy = heard.Select(c => (Id: ActionOf(c), c.ActorName)).Where(x => x.Id is not null)
                .GroupBy(x => x.Id!.Value).ToDictionary(g => g.Key, g => g.Last().ActorName);
            try
            {
                var was = _rows;
                _holders = await ActionSvc.HoldersAsync();
                await Fetch();
                if (!_asBoard) _marks?.Apply(LiveDiff.Of(was, _rows, r => r.Id, r => r));
            }
            catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
            StateHasChanged();
        });
        // Taken before the first await, which is when the interactive render first draws: from the same address only.
        if (Handoff.Take<ActionsBoard>(RendererInfo, PrerenderedState) is { } prerendered && prerendered._applied == FromAddress())
            Adopt(prerendered);
        _teams = await Teams.ListAsync();
        _teamOptions = TeamOptions(_teams);
        _holders = await ActionSvc.HoldersAsync();
        _rules = await RuleSvc.ListAsync();
        (_canHold, _me) = (CanHold, Me_);
        if (SavedLayout is null || SavedView is null)
        {
            var saved = await Prefs.GetAsync([UserPreferences.ActionsLayout, UserPreferences.ActionsView]);
            SavedLayout ??= saved[UserPreferences.ActionsLayout];
            SavedView ??= saved[UserPreferences.ActionsView];
        }
        _saved = await SavedViews.ListAsync();
    }

    // What the address says: compared, so the page knows when a link has changed it. The team, rule and parent are read as
    // text and parsed here (FilterValues), so a value that isn't one ("?team=network") is ignored rather than failing the page.
    private sealed record Address(string? View, Guid? Team, string? Assignee, string? Layout, Guid? Rule, string? Group,
        string? Q, string? Kind, string? Priority, string? Due, string? Status, string? Page, int? Parent = null, string? Teams = null, string? Raised = null);

    private Address FromAddress() =>
        new(ViewParam, FilterValues.Id(TeamParam), AssigneeParam, LayoutParam, FilterValues.Id(RuleParam), GroupParam, Q, KindParam, PriorityParam, DueParam, StatusParam, PageParam,
            FilterValues.Number(ParentParam), TeamsParam, RaisedParam);

    // The address as last applied. The page stays open when a link changes only the query (the sidebar's Actions from
    // ?view=closed, a link to ?view=overdue, a pager link), so the address is read whenever it changes, not only when the
    // page opens. The page's own address updates (Remember) record what they write first, so they don't re-read it.
    private Address? _applied;

    protected override async Task OnParametersSetAsync()
    {
        var query = FromAddress();
        if (_applied == query) return;
        var was = _applied;
        _applied = query;
        _view = EnumNames.OrNull<ActionView>(ViewParam, ignoreCase: true) ?? OpeningView();
        _groupByKind = string.Equals(GroupParam, "kind", StringComparison.OrdinalIgnoreCase);
        // No layout in the address: the person's own. A link to a view the board doesn't have (Overdue, Recently
        // closed) or to the list grouped by kind asks for the list, so it opens as the list.
        _asBoard = LayoutParam is not null ? string.Equals(LayoutParam, "board", StringComparison.OrdinalIgnoreCase)
            : SavedBoard && OnBoard(_view) && !_groupByKind;
        _sayLayout = LayoutParam is null;
        if (_asBoard && !OnBoard(_view)) _view = ActionView.Open;
        _ruleId = _rules.Any(r => r.Id == query.Rule && r.ShowAsFilter) ? query.Rule : null;
        _teamId = query.Team;
        _assignee = string.IsNullOrWhiteSpace(AssigneeParam) ? null : AssigneeParam;
        _search = string.IsNullOrWhiteSpace(Q) ? null : Q.Trim();
        _kind = EnumNames.OrNull<ActionKind>(KindParam, ignoreCase: true);
        _priorities = PrioritiesOf(FilterValues.Split(PriorityParam));
        _due = DueFrom(DueParam);
        _status = EnumNames.OrNull<ActionStatus>(StatusParam, ignoreCase: true) is { } st && OpenStatuses.Contains(st) ? st : null;
        _page = TableView.PageFrom(PageParam);
        _parentNumber = query.Parent is > 0 ? query.Parent : null;
        _side = EnumNames.OrNull<ActionTeams>(TeamsParam, ignoreCase: true);
        _raised = string.Equals(RaisedParam, Me, StringComparison.OrdinalIgnoreCase);
        var heldToMine = HoldMine();
        // Only another view resets the sort: another page (or filter) keeps the one chosen.
        if (was is null || heldToMine || !string.Equals(was.View, query.View, StringComparison.OrdinalIgnoreCase)) _sort = DefaultSort(_view);
        // The address then says what's shown, in place (a prerender shows it, and the circuit that follows writes it).
        if (heldToMine && RendererInfo.IsInteractive) Remember();
        var quiet = _adopted;
        _adopted = false;
        if (await Read(quiet)) PrerenderedState = Handoff.Keep(RendererInfo, this, PrerenderedState);
        FocusIfArrived();
    }

    private static ActionDue? DueFrom(string? text) => text?.Trim().ToLowerInvariant() switch
    {
        "overdue" => ActionDue.Overdue,
        "week" => ActionDue.ThisWeek,
        "none" => ActionDue.None,
        _ => null,
    };

    private static string? DueKey(ActionDue? due) => due switch
    {
        ActionDue.Overdue => "overdue",
        ActionDue.ThisWeek => "week",
        ActionDue.None => "none",
        _ => null,
    };

    // Takes what the prerendered page read and chose from its address, so the first interactive draw is the same page.
    private void Adopt(ActionsBoard p)
    {
        (_teams, _teamOptions, _rules, _board, _rows) = (p._teams, p._teamOptions, p._rules, p._board, p._rows);
        (_view, _asBoard, _groupByKind, _ruleId, _teamId, _assignee) = (p._view, p._asBoard, p._groupByKind, p._ruleId, p._teamId, p._assignee);
        (_search, _kind, _priorities, _due, _status) = (p._search, p._kind, p._priorities, p._due, p._status);
        (_parentNumber, _active, _side, _raised, _holders) = (p._parentNumber, p._active, p._side, p._raised, p._holders);
        (_total, _page, _groups, _sort, _ruleCounts) = (p._total, p._page, p._groups, p._sort, p._ruleCounts);
        (_saved, _loading, _adopted, _counts, _workers) = (p._saved, false, true, p._counts, p._workers);
    }

    // The priorities in the address ("p1,p2"), each once, in order; a name that isn't one is dropped.
    private static IReadOnlyList<Priority> PrioritiesOf(IEnumerable<string> values) =>
        [.. values.Select(v => EnumNames.OrNull<Priority>(v, ignoreCase: true)).OfType<Priority>().Distinct().Order()];

    // The options that don't change: built once. The teams' when they're read.
    private static readonly IReadOnlyList<FilterOption> KindOptions = FilterOption.ForEnum<ActionKind>(ActionService.KindName);
    private static readonly IReadOnlyList<FilterOption> PriorityOptions = FilterOption.ForEnum<Priority>();
    private static readonly IReadOnlyList<FilterOption> DueOptions =
        [new(nameof(ActionDue.Overdue), "Overdue"), new(nameof(ActionDue.ThisWeek), "This week"), new(nameof(ActionDue.None), "No due date")];
    private static readonly IReadOnlyList<FilterOption> StatusOptions = [.. OpenStatuses.Select(s => new FilterOption(s.ToString(), ActionService.StatusName(s)))];
    private IReadOnlyList<FilterOption> _teamOptions = [];

    private static IReadOnlyList<FilterOption> TeamOptions(IEnumerable<Team> teams) => [.. teams.Select(t => new FilterOption(t.Id.ToString(), t.Name))];

    // The pills: presets of the filters used most. Overdue and Due this week are both due=, so they take turns, as do
    // Blocked and Tracking; P1–P2 is the priority filter holding exactly those two.
    internal static readonly IReadOnlyList<FilterPill> Pills =
    [
        new("overdue", "Overdue", "due", [nameof(ActionDue.Overdue)]),
        // This week is the organization's business week, its holidays included: today to its last working day.
        new("week", "Due this week", "due", [nameof(ActionDue.ThisWeek)]) { Title = "Due from today to the last working day of this week" },
        new("p1p2", "P1–P2", "priority", [nameof(Priority.P1), nameof(Priority.P2)]),
        new("blocked", "Blocked", "status", [nameof(ActionStatus.Blocked)]),
        new("tracking", "Tracking", "status", [nameof(ActionStatus.Tracking)]) { Title = "Handed to others and followed until it's done" },
        new("raised", "Raised by me", "raised", [Me]) { Title = "The actions you raised, wherever they are now: what you asked others for" },
        // Held by: nobody, as a pill. From Mine (the person's own) it shows their teams' instead (Refilter).
        new("noowner", "No owner", "assignee", [ActionFilter.Unassigned]) { Title = "Open work nobody has taken on yet" },
    ];

    // The pills as drawn: No owner says how many it would show (counted with the tabs).
    private IReadOnlyList<FilterPill> PillsCounted => _counts is not { } counts ? Pills
        : [.. Pills.Select(p => p.Key == "noowner" ? p with { Count = counts.NoOwner(_view) } : p)];

    // raised=me: the only value the Raised by filter takes.
    private const string Me = "me";

    private static readonly IReadOnlyList<FilterOption> SideOptions =
        [new(nameof(ActionTeams.Internal), "Internal teams"), new(nameof(ActionTeams.External), "External teams")];

    // Held by's choices: you, nobody (the team's), then everyone holding an open action, with how many.
    private IReadOnlyList<FilterOption> HolderOptions()
    {
        var me = CurrentUser.UserId;
        List<FilterOption> options = [new(me, "You"), new(ActionFilter.Unassigned, "Nobody (the team's)")];
        options.AddRange(_holders.Where(h => h.Id != me).Select(h => new FilterOption(h.Id, $"{h.Name} ({h.Open})", "People")));
        // A holder from a link who holds nothing open now (a Workload link, the closed view) is still shown as chosen.
        if (_assignee is { } held && options.All(o => o.Value != held))
            options.Add(new(held, Shown.FirstOrDefault(r => r.AssigneeId == held)?.AssigneeName ?? "One person", "People"));
        return options;
    }

    private string HolderText(string held) =>
        held == CurrentUser.UserId ? "Held by you"
        : held == ActionFilter.Unassigned ? "Held by nobody (the team's)"
        : "Held by " + (_holders.FirstOrDefault(h => h.Id == held)?.Name ?? Shown.FirstOrDefault(r => r.AssigneeId == held)?.AssigneeName ?? "one person");

    // Every filter, under + Filter. The parts of one action (from its page) are set by a link, so that's a chip to
    // remove, not in the menu. Held by is in the menu too, and a Workload link sets it.
    internal IReadOnlyList<FilterDef> Defs
    {
        get
        {
            var defs = new List<FilterDef>
            {
                new("assignee", "Held by", FilterKind.Single, v => _assignee = FilterValues.First(v) is { Length: > 0 } held ? held : null)
                {
                    Options = HolderOptions(), Values = FilterValues.Of(_assignee), ChipText = _assignee is { } held ? HolderText(held) : null, Section = "Who",
                },
                new("team", "Team", FilterKind.Single, v => _teamId = Guid.TryParse(FilterValues.First(v), out var team) ? team : null)
                {
                    Options = _teamOptions, Values = FilterValues.Of(_teamId?.ToString()), Section = "Where",
                },
                new("teams", "Internal or external", FilterKind.Single, v => _side = FilterValues.Enum<ActionTeams>(v))
                {
                    Options = SideOptions, Values = FilterValues.Of(_side?.ToString()),
                    ChipText = _side switch { ActionTeams.Internal => "Only internal teams", ActionTeams.External => "Only external teams", _ => null },
                    Section = "Where",
                },
                new("raised", "Raised by", FilterKind.Single, v => _raised = FilterValues.First(v) == Me)
                {
                    Options = [new(Me, "You")], Values = _raised ? [Me] : [], ChipText = _raised ? "Raised by you" : null, Section = "Who",
                },
                new("kind", "Kind", FilterKind.Single, v => _kind = FilterValues.Enum<ActionKind>(v)) { Options = KindOptions, Values = FilterValues.Of(_kind?.ToString()), Section = "What" },
                new("priority", "Priority", FilterKind.Multi, v => _priorities = PrioritiesOf(v)) { Options = PriorityOptions, Values = [.. _priorities.Select(p => p.ToString())], Section = "What" },
                new("due", "Due", FilterKind.Single, v => _due = FilterValues.Enum<ActionDue>(v)) { Options = DueOptions, Values = FilterValues.Of(_due?.ToString()), Section = "When" },
                new("status", "Status", FilterKind.Single, v => _status = FilterValues.Enum<ActionStatus>(v) is { } st && OpenStatuses.Contains(st) ? st : null)
                {
                    Options = StatusOptions, Values = FilterValues.Of(_status?.ToString()), Section = "What",
                },
            };
            // An administrator's card rules shown as filters, each with how many it matches (counted as the list or board is read).
            var rules = _rules.Where(r => r.ShowAsFilter).ToList();
            if (rules.Count > 0)
                defs.Add(new("rule", "Rule", FilterKind.Single, v => _ruleId = Guid.TryParse(FilterValues.First(v), out var id) && rules.Any(r => r.Id == id) ? id : null)
                {
                    Options = [.. rules.Select(r => new FilterOption(r.Id.ToString(), $"{r.Name} ({_ruleCounts.GetValueOrDefault(r.Id)})"))],
                    Values = FilterValues.Of(_ruleId?.ToString()), Section = "What",
                    ChipText = rules.FirstOrDefault(r => r.Id == _ruleId) is { } rule ? "Rule: " + rule.Name : null,
                });
            if (_parentNumber is { } parent)
                defs.Add(new("parent", "Part of", FilterKind.Single, _ => _parentNumber = null) { InMenu = false, Values = [parent.ToString()], ChipText = "Part of " + Ui.ActionLabel(parent) });
            return defs;
        }
    }

    // Clear shows while anything narrows the list: a pill, a filter, the words. The list's count then says "matching".
    private bool AnyFilter => FilteredBesidesRule || _ruleId is not null;

    // Clear: every filter and the words; the view, layout and grouping stay.
    internal Task ClearFilters()
    {
        (_search, _teamId, _kind, _assignee, _due, _status, _ruleId, _parentNumber, _side, _raised) = (null, null, null, null, null, null, null, null, null, false);
        _priorities = [];
        return Refilter();
    }

    // Mine from an address, held to the rule choosing it keeps (Refilter, SetView): nobody's is the person's teams' work
    // nobody has (My teams), and another holder is let go. Whether it changed anything.
    private bool HoldMine()
    {
        if (_view != ActionView.Mine || _assignee is null) return false;
        if (_assignee == ActionFilter.Unassigned) _view = ActionView.MyTeams;
        else _assignee = null;
        return true;
    }

    // A filter changed (the bar, Clear, the words): read from the list's first page, and the address says so. Nobody's
    // actions are never Mine: No owner chosen on Mine shows the person's teams' work nobody has.
    internal async Task Refilter()
    {
        if (_view == ActionView.Mine && _assignee == ActionFilter.Unassigned) (_view, _sort) = (ActionView.MyTeams, DefaultSort(ActionView.MyTeams));
        _page = 1;
        await Load();
        Remember();
    }

    // Grouping by kind is the list's own order: from its first page too.
    private Task Regroup() => Refilter();

    // Search as you type, once typing pauses.
    private async Task SearchChanged()
    {
        if (await _typing.Settled()) await Refilter();
    }

    private async Task SetView(ActionView view)
    {
        _view = view;
        if (view == ActionView.Mine) _assignee = null;   // Mine is held by you: another holder would show nothing
        _page = 1;
        _sort = DefaultSort(view);
        Remember();
        await Load();
    }

    // The view whose tab was last brought into view (the tab row scrolls sideways inside itself when it doesn't fit).
    private ActionView? _revealed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealed != _view)
        {
            _revealed = _view;
            try { await JS.InvokeVoidAsync("tideTabs.revealCurrent"); }
            catch (JSDisconnectedException) { /* the tab has gone */ }
            catch (JSException) { /* an older tabs.js still cached: the row just doesn't scroll to it */ }
        }
        if (_refocus && !_loading)
        {
            var row = FocusRow;
            _refocus = false;
            if (row is null || _table is null || !await _table.FocusRowAsync(row.Id)) await _heading.TryFocusAsync(orGone: true);
        }
        if (!_sayLayout) return;
        _sayLayout = false;
        // Only the layout is added (the team, holder and the rest stay as they were), and recorded first so it isn't re-read.
        var layout = _asBoard ? UserPreferences.Board : UserPreferences.List;
        _applied = FromAddress() with { Layout = layout };
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("layout", layout), replace: true);
    }

    // The tab is the one place the preference changes; a link's layout only applies to its visit.
    private async Task SetLayout(string? layout)
    {
        _asBoard = layout == "board";
        if (_asBoard && !OnBoard(_view)) _view = ActionView.Open;
        _page = 1;
        SavedLayout = _asBoard ? UserPreferences.Board : UserPreferences.List;
        try { await Prefs.SetAsync(UserPreferences.ActionsLayout, SavedLayout); }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        Remember();
        await Load();
    }

    // The address of what's shown: every filter, and the page when it isn't the first. Recorded first, so writing it
    // doesn't read it again.
    private void Remember()
    {
        var shown = ShownParameters();
        _applied = new Address(Text("view"), _teamId, _assignee, Text("layout"), _ruleId, Text("group"), Words, Text("kind"), Text("priority"), Text("due"),
            Text("status"), Text("page"), _parentNumber, Text("teams"), Text("raised"));
        Nav.NavigateTo(Nav.GetUriWithQueryParameters("actions", shown), replace: true);

        string? Text(string name) => (string?)shown[name];
    }

    // What's shown as the address says it: the tab, every filter, and the page when it isn't the first. The address always
    // says which layout it is, so a reload or a copy of it opens what's shown.
    private Dictionary<string, object?> ShownParameters()
    {
        var layout = _asBoard ? UserPreferences.Board : UserPreferences.List;
        var view = _view.ToString().ToLowerInvariant();
        var group = !_asBoard && _groupByKind ? "kind" : null;
        var (kind, priority, status) = (_kind?.ToString().ToLowerInvariant(), FilterValues.Join(_priorities.Select(p => p.ToString().ToLowerInvariant())), _status?.ToString().ToLowerInvariant());
        var page = !_asBoard && _page > 1 ? _page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;
        var (teams, raised) = (_side?.ToString().ToLowerInvariant(), _raised ? Me : null);
        return new()
        {
            ["view"] = view, ["layout"] = layout, ["group"] = group, ["rule"] = _ruleId, ["team"] = _teamId, ["assignee"] = _assignee,
            ["q"] = Words, ["kind"] = kind, ["priority"] = priority, ["due"] = DueKey(_due), ["status"] = status, ["page"] = page, ["parent"] = _parentNumber,
            ["teams"] = teams, ["raised"] = raised,
        };
    }

    // --- Saved views (SavedViewService): the person's own, beside the tabs --------------------------------------------

    private IReadOnlyList<ActionsSavedView> _saved = [];
    private ConfirmDialog _nameDialog = default!;
    private Guid? _renaming;
    private string? _newName, _nameError;

    internal IReadOnlyList<ActionsSavedView> Saved => _saved;
    internal string? NewName { get => _newName; set => _newName = value; }
    internal string? NameError => _nameError;

    /// <summary>The query a view of what's shown keeps (what the address says, but never the list's page), in the order a
    /// stored one has; null when it's more than a view can hold (a link's very long search).</summary>
    internal string? ShownQuery() => QueryOf(ShownParameters());

    // These parameters as a view keeps them (SavedViewService's order, no blanks); null when too long for one.
    private static string? QueryOf(Dictionary<string, object?> parameters) => SavedViewService.TryNormalize(string.Join('&', parameters
        .Select(p => p.Key + "=" + Uri.EscapeDataString(Convert.ToString(p.Value, System.Globalization.CultureInfo.InvariantCulture)!))));

    /// <summary>The saved view that is what's shown, if one is: the first, when two keep the same filters.</summary>
    internal ActionsSavedView? ActiveSaved => ShownQuery() is { } shown ? _saved.FirstOrDefault(v => v.Query == shown) : null;

    private IReadOnlyList<MenuButton.Item> SavedMenu(ActionsSavedView v)
    {
        var items = new List<MenuButton.Item> { new("Rename", "bi-pencil", EventCallback.Factory.Create(this, () => StartRename(v))) };
        if (_saved[0] != v) items.Add(new("Move earlier", "bi-arrow-left", EventCallback.Factory.Create(this, () => MoveSaved(v, -1))));
        if (_saved[^1] != v) items.Add(new("Move later", "bi-arrow-right", EventCallback.Factory.Create(this, () => MoveSaved(v, 1))));
        items.Add(new("Delete", "bi-trash", EventCallback.Factory.Create(this, () => DeleteSaved(v))));
        return items;
    }

    internal async Task StartSave()
    {
        (_renaming, _newName, _nameError) = (null, null, null);
        await _nameDialog.Ask("Save this view", null, "Save view", danger: false);
    }

    internal async Task StartRename(ActionsSavedView v)
    {
        (_renaming, _newName, _nameError) = (v.Id, v.Name, null);
        await _nameDialog.Ask($"Rename \"{v.Name}\"", null, "Rename", danger: false);
    }

    // The dialog's Save view or Rename: kept open, saying why, when it's refused.
    internal async Task<bool> SaveName()
    {
        _nameError = null;
        try
        {
            if (_renaming is { } id)
            {
                await SavedViews.RenameAsync(id, _newName ?? "");
                Toasts.Show("View renamed.");
            }
            else
            {
                var saved = await SavedViews.SaveAsync(_newName ?? "", ShownQuery() ?? throw new ArgumentException("These filters are too long to keep as a view."));
                Toasts.Show($"Saved \"{saved.Name}\" beside the tabs.");
            }
            _saved = await SavedViews.ListAsync();
            return true;
        }
        catch (Exception ex)
        {
            _nameError = UserFacingError.For(ex);
            return false;
        }
    }

    internal async Task MoveSaved(ActionsSavedView v, int by)
    {
        try
        {
            await SavedViews.MoveAsync(v.Id, by);
            _saved = await SavedViews.ListAsync();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    internal async Task DeleteSaved(ActionsSavedView v)
    {
        if (!await _confirm.Ask($"Delete \"{v.Name}\"?", "Only your shortcut goes: no action changes.", "Delete view")) return;
        try
        {
            await SavedViews.DeleteAsync(v.Id);
            _saved = await SavedViews.ListAsync();
            Toasts.Show($"Deleted \"{v.Name}\".");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    private ConfirmDialog _confirm = default!;

    // --- Counts, No owner and Take it ---------------------------------------------------------------------------------

    // How many each tab shows (read with the list or board), and which teams' actions this person works (the list's Take it).
    private ActionViewCounts? _counts;
    private ActionWorkers _workers = ActionWorkers.None;
    private bool _taking;

    internal IReadOnlyList<ActionRow> Rows => _rows;
    internal ActionViewCounts? Counts => _counts;

    // Once the list is drawn again, focus goes to a row (_focusId's, or else the first), or with none, to the heading: the
    // person keeps their place.
    private bool _refocus;
    private Guid? _focusId;
    private ActionTable? _table;
    private ElementReference _heading;

    private ActionRow? FocusRow => _rows.FirstOrDefault(r => r.Id == _focusId) ?? _rows.FirstOrDefault();

    /// <summary>Where focus is going next ("A-12", or "heading"), until it has gone there.</summary>
    internal string? Focusing => !_refocus ? null : FocusRow is { } row ? Ui.ActionLabel(row.Number) : "heading";

    // "Show them" on an empty Mine is a link the browser follows as it would any other: Ctrl, Cmd or Shift+click and the
    // middle button open it elsewhere and leave this page alone. A plain click or Enter brings the list here, and focus
    // goes to its first row once it has arrived (the click and the new address reach the page in either order).
    private bool _focusOnArrival;

    internal void ShowThemClicked(MouseEventArgs e)
    {
        if (e.Button != 0 || e.CtrlKey || e.MetaKey || e.ShiftKey || e.AltKey) return;
        _focusOnArrival = true;
        FocusIfArrived();
    }

    // Once My teams with No owner is shown after a plain click on Show them, focus goes to its first row.
    private void FocusIfArrived()
    {
        if (_focusOnArrival && _view == ActionView.MyTeams && _assignee == ActionFilter.Unassigned) (_focusOnArrival, _refocus, _focusId) = (false, true, null);
    }

    // On an empty Mine: how many open actions of the person's teams have nobody, when there are any.
    private int? UnownedInMyTeams => _view == ActionView.Mine && _counts is { MineOpen: 0, MyTeamsUnowned: > 0 and var n } ? n : null;

    // Those actions: My teams with No owner, the other filters as they are.
    private string NoOwnerLink
    {
        get
        {
            var shown = ShownParameters();
            (shown["view"], shown["assignee"], shown["page"]) = (ActionView.MyTeams.ToString().ToLowerInvariant(), ActionFilter.Unassigned, null);
            return "actions?" + (QueryOf(shown) ?? "view=myteams&assignee=none");
        }
    }

    // Take it on a row: the action is this person's, through the same checked and recorded take as its page's; refused
    // when someone took it since the list was read. The list is read again either way.
    internal async Task Take(ActionRow row)
    {
        if (_taking) return;
        _taking = true;
        try
        {
            await ActionSvc.TakeAsync(row.Id, onlyIfNobodys: true);
            Toasts.Show($"You took {Ui.ActionLabel(row.Number)} on.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _taking = false; }
        var was = _rows;
        await Read(quiet: true);
        // Focus stays on the row, or when it has left the list (No owner), goes to the next row, else the one before,
        // else the heading.
        var at = was.ToList().FindIndex(r => r.Id == row.Id);
        bool Still(ActionRow r) => _rows.Any(x => x.Id == r.Id);
        var next = was.Skip(at).FirstOrDefault(Still) ?? was.Take(at).LastOrDefault(Still);
        (_refocus, _focusId) = (true, next?.Id);
    }

    // A new sort from the list's headings, or "Clear the filter" from its empty state: from the first page.
    private async Task Query(TableQuery q)
    {
        _sort = q.Sort;
        _search = string.IsNullOrWhiteSpace(q.Filter) ? null : q.Filter.Trim();
        _page = 1;
        await Load();
        Remember();
    }

    // "Show the last 30 days" under the board: its closed strip counts 30 days back, for this visit.
    private async Task ShowOlder()
    {
        _closedDays = ActionService.BoardOlderDays;
        await Load();
    }

    private Task Load() => Read(quiet: false);

    private ActionFilter Filter() => new ActionFilter(_view, _teamId, _kind, AssigneeId: _assignee)
    {
        Search = Words, Priorities = _priorities, Due = _due, Status = _status, ParentNumber = _parentNumber, Teams = _side, RaisedByMe = _raised,
    };

    private ActionSort SortOf(TableSort? sort) => sort?.Key switch
    {
        "number" => ActionSort.Number,
        "title" => ActionSort.Title,
        "kind" => ActionSort.Kind,
        "team" => ActionSort.Team,
        "status" => ActionSort.Status,
        "due" => ActionSort.Due,
        _ => _view == ActionView.Closed ? ActionSort.Closed : ActionSort.Due,
    };

    // Reads the board, or the list's page (with each rule filter's count).
    private async Task Fetch()
    {
        var filter = Filter();
        // The team's count against its limit and the tabs' counts are read alongside, each on its own context.
        var active = _teamId is { } team ? ActionSvc.TeamActiveAsync(team) : Task.FromResult<TeamActive?>(null);
        var counts = ActionSvc.ViewCountsAsync(filter, _rules.FirstOrDefault(r => r.Id == _ruleId), _asBoard ? _closedDays : null);
        if (_asBoard)
        {
            var board = ActionSvc.BoardAsync(filter);
            await Task.WhenAll(active, board, counts);
            (_board, _active, _counts) = (board.Result, active.Result, counts.Result);
            _ruleCounts = _rules.Where(r => r.ShowAsFilter).ToDictionary(r => r.Id, r => _board.Cards.Count(c => ActionRules.Matches(r, c, ActionSvc.Today, ActionSvc.Days)));
            return;
        }
        var grouping = _groupByKind ? ActionGrouping.Kind : ByUrgency ? ActionGrouping.Urgency : ActionGrouping.None;
        var read = ActionSvc.PageAsync(filter with { RuleId = _ruleId }, SortOf(_sort), _sort?.Descending ?? false, grouping, _page);
        await Task.WhenAll(active, read, counts);
        var page = read.Result;
        (_active, _counts, _workers) = (active.Result, counts.Result, page.Workers);
        // A page past the end (an old link, or the list shrank) shows the last one; the pager says which, and so does the
        // address (in place, recorded first so it isn't read again; a prerender can't move it, and the live page does).
        var asked = _page;
        (_rows, _total, _page, _groups) = (page.Rows, page.Total, page.Page, page.Groups);
        if (_page != asked && _applied is { } applied)
        {
            _applied = applied with { Page = _page > 1 ? _page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null };
            TableView.SayPage(Nav, RendererInfo, _page);
        }
        _ruleCounts = _rules.Any(r => r.ShowAsFilter) ? await ActionSvc.RuleCountsAsync(filter, _rules.Where(r => r.ShowAsFilter)) : new Dictionary<Guid, int>();
    }

    // Quiet, the list stays as it is while it's read (it's the prerendered one); otherwise it shows "Loading". False when
    // the read failed.
    private async Task<bool> Read(bool quiet)
    {
        if (!quiet) _loading = true;
        _movedBy = new Dictionary<Guid, string>();   // what's shown next is this person's choice, not a colleague's news
        _marks?.Clear();
        try
        {
            await Fetch();
            return true;
        }
        catch (Exception ex)
        {
            Toasts.Error(UserFacingError.For(ex));
            return false;
        }
        finally { _loading = false; }
    }

    public void Dispose()
    {
        _typing.Now();   // a search typed just before is dropped
        _live?.Dispose();
        _marks?.Dispose();
    }
}
