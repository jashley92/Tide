@inject SavedQueryService SavedSvc
@inherits LibraryPage<SavedQueryRow>

@* The team's saved hunt queries (ADR 0006), by language, a tab of the Library page (which checks who may open it): a
   tuned sweep or a behavioural hunt kept for a colleague to add to their own action from its Hunt queries card. Whoever
   works actions saves, edits, retires and restores them, and deletes one they saved (an administrator, any); everyone
   else who reads actions reads them. The list names each with its language and how many actions it was added to; the
   one chosen is shown in full. A colleague's change re-reads the list in place; an edit under way keeps what's typed,
   and its save is refused if the query changed since it began. *@

<PageTitle>Saved queries · Library · TIDE</PageTitle>

<ConfirmDialog @ref="_confirm" />

@if (_canWrite && _form is null)
{
    <LibraryHead><button class="btn btn-primary" @onclick="New"><span class="bi bi-plus-lg" aria-hidden="true"></span> New saved query</button></LibraryHead>
}

@if (_form is { Id: null })
{
    <section class="tide-card tide-card-form" aria-labelledby="sq-new-h">
        <h2 id="sq-new-h">New saved query</h2>
        @EditForm
    </section>
}
else if (EditingAway)
{
    @* The saved query being edited isn't the one shown (another was chosen, or a colleague retired, deleted or renamed it,
       or a filter hides it): its form stays here, so what's typed can be saved or cancelled. *@
    <section class="tide-card tide-card-form" aria-labelledby="sq-edit-h">
        <h2 id="sq-edit-h">Edit saved query</h2>
        @EditForm
    </section>
}

@* The platform (all, or one language), each with how many it holds; the order, by platform or the most used first; and
   Show retired, a checkbox: it widens the list rather than narrowing it. The words are the Library's search's. *@
<div class="tide-library-filters">
    <TabBar Items="PlatformItems" Active="@(_language.Length > 0 ? _language : All)" Label="Platform" Level="TabLevel.Sub" OnSelect="ChoosePlatform" />
    <TabBar Items="SortItems" Active="@_sort" Label="Sort" Level="TabLevel.Sub" OnSelect="SortBy" />
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="sq-retired" checked="@_showRetired" @onchange="ToggleRetired" />
        <label class="form-check-label small" for="sq-retired">Show retired</label>
    </div>
</div>

@if (_rows is null)
{
    <LoadingBlock />
}
else if (_rows.Count == 0)
{
    <div class="tide-card" tabindex="-1" @ref="_empty">
        <EmptyState Icon="bi-bookmark" Title="No saved queries yet.">Save one from any hunt on an action with Save for the team@(_canWrite ? ", or add one here" : "").</EmptyState>
    </div>
}
else if (Shown.Count == 0)
{
    <div class="tide-card" tabindex="-1" @ref="_empty">
        <EmptyState Icon="bi-search" Title="No saved query matches these filters." />
    </div>
}
else
{
    @* The page's queries by name, each language's together (the list says each one's); the one chosen in full. *@
    var r = Selected!;
    var q = r.Query;
    var id = "sq-" + q.Id.ToString("N");
    <LibraryBrowser Count="@CountText" Entries="Entries" Selected="SelectedId" Label="Saved queries" OnPick="Pick" Groups="_groups" @ref="_browser">
        <ChildContent>
            <article class="tide-hunt tide-library-entry @(q.IsRetired ? "tide-retired" : "")" aria-labelledby="@(id + "-h")" @key="q.Id">
                @if (_form?.Id == q.Id)
                {
                    <h3 class="tide-subhead mt-0" id="@(id + "-h")">Edit @q.Name</h3>
                    @EditForm
                }
                else
                {
                    @* The entry's name and what it is on the left, its Copy, Edit and More at the top right; its query under. *@
                    <div class="tide-library-entry-head">
                        <div class="tide-library-entry-title">
                            <h3 class="tide-subhead my-0" id="@(id + "-h")">@q.Name</h3>
                            <div class="small tide-muted"><Badge>@HuntQueryBuilder.DialectName(q.Dialect)</Badge> @if (q.IsRetired) { <Badge>Retired</Badge> } @Provenance(q) · <span>@Used(r.Actions, "on", "action")</span></div>
                        </div>
                        <div class="tide-library-entry-tools">
                            <span id="@(id + "-status")" class="small tide-muted" role="status" aria-live="polite"></span>
                            <button type="button" class="btn btn-primary btn-sm" data-copy-target="@(id + "-text")" data-copy-status="@(id + "-status")"><span class="bi bi-clipboard" aria-hidden="true"></span> Copy</button>
                            @if (_canWrite)
                            {
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_form is not null)" aria-label="Edit @q.Name" @onclick="() => Edit(q)"><span class="bi bi-pencil" aria-hidden="true"></span> Edit</button>
                            }
                            @if (MoreItems(q) is { Count: > 0 } more)
                            {
                                <MenuButton Label="More" MenuLabel="@($"More for {q.Name}")" Items="more" ButtonClass="btn btn-outline-secondary btn-sm" Disabled="_busy" />
                            }
                        </div>
                    </div>
                    @if (q.Description is { } about) { <p class="small mb-2">@about</p> }
                    <pre id="@(id + "-text")" class="tide-query">@q.Text</pre>
                }
            </article>
        </ChildContent>
        <Below><Pager Page="_page" Pages="TableView.Pages(_shown.Count, PageSize)" Many="saved queries" Href="PageHref" /></Below>
    </LibraryBrowser>
}

@code {
    private SavedQueryForm? _form;
    private ConfirmDialog _confirm = default!;
    private bool _canWrite;
    private string _language = "";

    internal SavedQueryForm? Form => _form;

    protected override string Topic => ChangeFeed.SavedQueries;

    protected override (string One, string Many, string Library) Names => ("saved query", "saved queries", "saved queries");

    protected override async Task<IReadOnlyList<SavedQueryRow>> ReadAsync(bool includeRetired) => await SavedSvc.ListAsync(includeRetired);

    protected override Guid IdOf(SavedQueryRow row) => row.Query.Id;

    protected override LibraryEntry Entry(SavedQueryRow row) =>
        new(row.Query.Id, row.Query.Name, row.Query.Description, QueryDialects.ShortName(row.Query.Dialect), Used(row.Actions, "on", "action"), row.Query.IsRetired,
            _groups is null ? null : HuntQueryBuilder.DialectName(row.Query.Dialect));

    protected override Guid? EditingId => _form?.Id;

    private const string All = "all", ByPlatform = "platform", MostUsed = "used";

    private string _sort = ByPlatform;

    // How many each platform holds of those the words leave (and All), and, sorted by platform, each platform's count
    // for the list's headings: worked out when the rows or the filters change.
    private Dictionary<string, int> _platforms = [];
    private Dictionary<string, int>? _groups;

    // The language chosen (or all) and every word typed: each language's queries together (the languages in the order
    // they first come, so the pages run through them in order), or the most used first.
    protected override IEnumerable<SavedQueryRow> Filtered(IReadOnlyList<SavedQueryRow> rows, IReadOnlyList<string> words)
    {
        var chosen = rows.Where(r => _language.Length == 0 || r.Query.Dialect == _language).Where(r => SavedQueryService.Matches(r.Query, words));
        return _sort == MostUsed
            ? chosen.OrderByDescending(r => r.Actions).ThenBy(r => r.Query.Name, StringComparer.OrdinalIgnoreCase)
            : chosen.GroupBy(r => r.Query.Dialect).SelectMany(g => g);
    }

    protected override void Filtering()
    {
        var words = TableView.Words(_words);
        var matching = (_rows ?? []).Where(r => SavedQueryService.Matches(r.Query, words)).ToList();
        _platforms = matching.GroupBy(r => r.Query.Dialect).ToDictionary(g => g.Key, g => g.Count());
        _platforms[All] = matching.Count;
        _groups = _sort == ByPlatform ? Shown.GroupBy(r => HuntQueryBuilder.DialectName(r.Query.Dialect)).ToDictionary(g => g.Key, g => g.Count()) : null;
    }

    protected override void ClearOwnFilters() => _language = "";


    private IReadOnlyList<TabBarItem> PlatformItems =>
        [new("All", "", null, All, _platforms.GetValueOrDefault(All)), .. QueryDialects.All.Select(d => new TabBarItem(QueryDialects.ShortName(d.Key), "", null, d.Key, _platforms.GetValueOrDefault(d.Key)))];

    private static readonly IReadOnlyList<TabBarItem> SortItems = [new("By platform", "", null, ByPlatform), new("Most used", "", null, MostUsed)];

    /// <summary>A platform chosen (All for every one): the list from its first page.</summary>
    internal void ChoosePlatform(string? key)
    {
        _language = key is null or All ? "" : key;
        Refilter();
        StateHasChanged();
    }

    /// <summary>The order chosen: by platform, under each one's heading, or the most used first.</summary>
    internal void SortBy(string? key)
    {
        _sort = key == MostUsed ? MostUsed : ByPlatform;
        Refilter();
        StateHasChanged();
    }

    /// <summary>The query's More menu: Retire or Restore, and Delete, for whoever may.</summary>
    internal IReadOnlyList<MenuButton.Item> MoreItems(SavedQuery q) =>
        MoreMenu(q.IsRetired, _canWrite, () => Retire(q, !q.IsRetired), SavedSvc.CanDelete(q), () => Delete(q));

    private RenderFragment EditForm => __builder =>
    {
        var f = _form!;
        <div data-submit-scope>
            <div class="row g-2">
                <div class="col-md-7">
                    <label class="tide-field-label" for="sq-f-name">Name</label>
                    <input id="sq-f-name" @ref="_formStart" class="form-control form-control-sm" maxlength="@SavedQuery.MaxName" placeholder="Encoded PowerShell from Office" @bind="f.Name" />
                </div>
                <div class="col-md-5">
                    <label class="tide-field-label" for="sq-f-language">Language</label>
                    <select id="sq-f-language" class="form-select form-select-sm" @bind="f.Dialect">
                        @foreach (var d in QueryDialects.All) { <option value="@d.Key">@d.Name</option> }
                    </select>
                </div>
                <div class="col-12">
                    <label class="tide-field-label" for="sq-f-about">What it's for (optional)</label>
                    <input id="sq-f-about" class="form-control form-control-sm" maxlength="@SavedQuery.MaxDescription" @bind="f.Description" />
                </div>
                <div class="col-12">
                    <label class="tide-field-label" for="sq-f-text">Query</label>
                    <textarea id="sq-f-text" class="tide-query tide-autogrow" spellcheck="false" aria-describedby="sq-f-text-help" @bind="f.Text"></textarea>
                    <SavedQueryHelp Id="sq-f-text-help" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-primary btn-sm" disabled="@_busy" data-submit @onclick="Save">Save</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        _canWrite = SavedSvc.CanWrite;
        await base.OnInitializedAsync();
    }

    private void New()
    {
        _form = new SavedQueryForm { Dialect = _language.Length > 0 ? _language : QueryDialects.All[0].Key };
        FocusForm();
    }

    internal void Edit(SavedQuery q)
    {
        _form = SavedQueryForm.From(q);
        FocusForm();
        StateHasChanged();
    }

    private void Cancel()
    {
        _form = null;
        FocusList();
    }

    internal Task Save() => Run(async () =>
    {
        Reveal(await SavedSvc.SaveAsync(_form!));
        Toasts.Show(_form!.Id is null ? $"{_form.Name.Trim()} saved for the team." : "Saved.");
        _form = null;
        FocusList();
    });

    internal Task Retire(SavedQuery q, bool retired) => Retiring(q.Name, retired, () => SavedSvc.SetRetiredAsync(q.Id, retired));

    private async Task Delete(SavedQuery q)
    {
        if (!await _confirm.Ask($"Delete {q.Name}?", "It goes from the team's saved queries. Hunts already added from it keep their text and its name.", "Delete")) return;
        await Run(async () =>
        {
            await SavedSvc.DeleteAsync(q.Id);
            Toasts.Show($"{q.Name} deleted.");
            FocusList();
        });
    }
}
