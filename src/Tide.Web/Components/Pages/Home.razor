@page "/"
@attribute [Authorize(Policy = Policies.ReadPublished)]
@inject OrgClock Clock
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@* Today: the start page is today's brief (BriefPage, drawn as Today). Readers have only the published archive, so
   that's their home page instead. *@

@if (CurrentUser.Has(Permission.ReadTeamEdition))
{
    <BriefPage Day="@Ui.IsoDay(Clock.CurrentBriefDate)" AsToday="true" />
}

@code {
    protected override void OnInitialized()
    {
        if (!CurrentUser.Has(Permission.ReadTeamEdition)) Nav.NavigateTo("published", replace: true);
    }
}
