@page "/outreach/templates"
@attribute [Authorize(Policy = Policies.ReadActions)]
@inject OutreachTemplateService TemplateSvc
@inherits LibraryPage<OutreachTemplateRow>

@* The team's outreach emails (ADR 0019): a question to a vendor, a partner, an ISAC or another team, kept for a
   colleague to fill from their own Outreach action with Write the email. Kept as the saved hunt queries are: whoever
   works actions saves, edits, retires and restores them, and deletes one they saved (an administrator, any); everyone
   else who reads actions reads them. Each shows how many emails were written from it. A colleague's change re-reads the
   list in place; an edit under way keeps what's typed, and its save is refused if the template changed since it began. *@

<PageTitle>Outreach templates · TIDE</PageTitle>

<ConfirmDialog @ref="_confirm" />

<div class="tide-page-head">
    <div>
        <h1>Outreach templates</h1>
        <div class="tide-sub">Emails kept for the team, for asking a vendor, a partner, an ISAC or another team for information.
            Fill one on an Outreach action with Write the email: <span class="tide-data">{{article.title}}</span>,
            <span class="tide-data">{{indicators}}</span> and the other placeholders take the action's details, held to the
            template's TLP ceiling. TIDE never sends them. Changes are audited.</div>
    </div>
    @if (_canWrite && _form is null)
    {
        <button class="btn btn-primary" @onclick="New"><span class="bi bi-plus-lg" aria-hidden="true"></span> New template</button>
    }
</div>

@if (_form is { Id: null })
{
    <section class="tide-card tide-card-form" aria-labelledby="ot-new-h">
        <h2 id="ot-new-h">New template</h2>
        @EditForm
    </section>
}
else if (EditingOffPage)
{
    @* The template being edited left this page (a colleague retired, deleted or renamed it, or a filter hides it): its
       form stays here, so what's typed can be saved or cancelled. *@
    <section class="tide-card tide-card-form" aria-labelledby="ot-edit-h">
        <h2 id="ot-edit-h">Edit template</h2>
        @EditForm
    </section>
}

@* The filter bar: the words, and Show retired as the switch it was, as on Saved queries. *@
<FilterBar Active="@(!string.IsNullOrWhiteSpace(_words))" OnClear="ClearFilters">
    <Search>
        <input id="ot-find" type="search" class="tide-maxw-md form-control form-control-sm" placeholder="Name, description, subject or body" aria-label="Find templates"
               @bind="_words" @bind:event="oninput" @bind:after="Refilter" />
    </Search>
    <ChildContent>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="ot-retired" checked="@_showRetired" @onchange="ToggleRetired" />
            <label class="form-check-label small" for="ot-retired">Show retired</label>
        </div>
    </ChildContent>
</FilterBar>

@if (_rows is null)
{
    <LoadingBlock />
}
else if (_rows.Count == 0)
{
    <div class="tide-card">
        <EmptyState Icon="bi-envelope-paper" Title="No outreach templates yet.">@(_canWrite ? "Add one here, then fill it from an Outreach action." : "Someone who works actions can add one.")</EmptyState>
    </div>
}
else if (Shown.Count == 0)
{
    <div class="tide-card">
        <EmptyState Icon="bi-search" Title="No template matches these filters." />
    </div>
}
else
{
    <section class="tide-card" aria-labelledby="ot-list-h">
        <h2 id="ot-list-h">Templates <span class="tide-count tide-muted fw-normal">(@Shown.Count)</span></h2>
        <p class="small tide-muted mb-2" role="status">@CountText</p>
        @foreach (var r in OnPage)
        {
            var t = r.Template;
            var id = "ot-" + t.Id.ToString("N");
            <article class="tide-hunt tide-outreach-template @(t.IsRetired ? "tide-retired" : "")" aria-labelledby="@(id + "-h")" @key="t.Id">
                @if (_form?.Id == t.Id)
                {
                    <h3 class="tide-subhead mt-0" id="@(id + "-h")">Edit @t.Name</h3>
                    @EditForm
                }
                else
                {
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <h3 class="tide-subhead my-0" id="@(id + "-h")">@t.Name</h3>
                        <TlpBadge Level="t.Ceiling" />
                        @if (t.IsRetired) { <Badge>Retired</Badge> }
                        <span class="ms-auto small tide-muted">@Used(r.Emails, "for", "email")</span>
                    </div>
                    @if (t.Description is { } about) { <p class="small mb-1">@about</p> }
                    <div class="small tide-muted mb-2">@Provenance(t)</div>
                    <div class="small mb-1">Filled up to @Tlp.Label(t.Ceiling)@(t.To is { } to ? $", always to {to}" : "").</div>
                    <div class="tide-field-label mb-0">Subject</div>
                    <div class="tide-data mb-2">@t.Subject</div>
                    <div class="tide-field-label mb-0">Body</div>
                    <pre id="@(id + "-text")" class="tide-email-text">@t.Body</pre>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-copy-target="@(id + "-text")" data-copy-status="@(id + "-status")" data-copy-done="Copied."><span class="bi bi-clipboard" aria-hidden="true"></span> Copy</button>
                        @if (_canWrite)
                        {
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(_form is not null)" aria-label="Edit @t.Name" @onclick="() => Edit(t)"><span class="bi bi-pencil" aria-hidden="true"></span> Edit</button>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" aria-label="@((t.IsRetired ? "Restore " : "Retire ") + t.Name)" @onclick="() => Retire(t, !t.IsRetired)">@(t.IsRetired ? "Restore" : "Retire")</button>
                        }
                        @if (TemplateSvc.CanDelete(t))
                        {
                            <button class="btn btn-link btn-sm text-danger" disabled="@_busy" aria-label="Delete @t.Name" @onclick="() => Delete(t)">Delete</button>
                        }
                        <span id="@(id + "-status")" class="small tide-muted" role="status" aria-live="polite"></span>
                    </div>
                }
            </article>
        }
        <Pager Page="_page" Pages="TableView.Pages(_shown.Count, PageSize)" Many="templates" Href="PageHref" />
    </section>
}

@code {
    private OutreachTemplateForm? _form;
    private ConfirmDialog _confirm = default!;
    private bool _canWrite;

    internal OutreachTemplateForm? Form => _form;

    protected override string Topic => ChangeFeed.OutreachTemplates;

    protected override (string One, string Many, string Library) Names => ("template", "templates", "outreach templates");

    protected override async Task<IReadOnlyList<OutreachTemplateRow>> ReadAsync(bool includeRetired) => await TemplateSvc.ListAsync(includeRetired);

    protected override Guid IdOf(OutreachTemplateRow row) => row.Template.Id;

    protected override Guid? EditingId => _form?.Id;

    // Every word typed.
    protected override IEnumerable<OutreachTemplateRow> Filtered(IReadOnlyList<OutreachTemplateRow> rows, IReadOnlyList<string> words) =>
        rows.Where(r => OutreachTemplateService.Matches(r.Template, words));

    private RenderFragment EditForm => __builder =>
    {
        var f = _form!;
        <div data-submit-scope>
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="tide-field-label" for="ot-f-name">Name</label>
                    <input id="ot-f-name" class="form-control form-control-sm" maxlength="@OutreachTemplate.MaxName" placeholder="Are we affected? (vendor PSIRT)" @bind="f.Name" />
                </div>
                <div class="col-md-3">
                    <label class="tide-field-label" for="ot-f-ceiling">Highest TLP it carries</label>
                    <TlpSelect @bind-Value="f.Ceiling" Id="ot-f-ceiling" DescribedBy="ot-f-ceiling-help" Label="Highest TLP it carries" />
                    <div class="form-text" id="ot-f-ceiling-help">Parts above it are left out. CLEAR or GREEN for outside the organization.</div>
                </div>
                <div class="col-md-3">
                    <label class="tide-field-label" for="ot-f-to">Always to (optional)</label>
                    <input id="ot-f-to" type="email" class="form-control form-control-sm" maxlength="@OutreachTemplate.MaxTo" placeholder="psirt@vendor.example" aria-describedby="ot-f-to-help" @bind="f.To" />
                    <div class="form-text" id="ot-f-to-help">Otherwise the product's contact, or whoever the analyst types.</div>
                </div>
                <div class="col-12">
                    <label class="tide-field-label" for="ot-f-about">What it's for (optional)</label>
                    <input id="ot-f-about" class="form-control form-control-sm" maxlength="@OutreachTemplate.MaxDescription" @bind="f.Description" />
                </div>
                <div class="col-12">
                    <label class="tide-field-label" for="ot-f-subject">Subject</label>
                    <input id="ot-f-subject" class="form-control form-control-sm" maxlength="@OutreachTemplate.MaxSubject" placeholder="{{product.name}}: are we affected by {{article.cves}}?" @bind="f.Subject" />
                </div>
                <div class="col-12">
                    <label class="tide-field-label" for="ot-f-body">Body</label>
                    <textarea id="ot-f-body" class="form-control form-control-sm tide-email-body tide-autogrow" maxlength="@OutreachTemplate.MaxBody" aria-describedby="ot-f-body-help" @bind="f.Body"></textarea>
                    <OutreachTemplateHelp Id="ot-f-body-help" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-primary btn-sm" disabled="@_busy" data-submit @onclick="Save">Save</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _form = null">Cancel</button>
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        _canWrite = TemplateSvc.CanWrite;
        await base.OnInitializedAsync();
    }

    internal void New()
    {
        _form = new OutreachTemplateForm { Subject = StarterSubject, Body = StarterBody };
        StateHasChanged();
    }

    // A new template starts from a common question, so the placeholders are there to keep or cut.
    internal const string StarterSubject = "{{product.name}}: are we affected? ({{article.title}})";

    internal const string StarterBody = """
        Hello {{product.contact}},

        We run {{product.name}} {{product.versions}}. We're looking at the report below and would like to know whether our versions are affected, and if so what you recommend.

        {{article.title}}
        {{article.link}}

        {{article.cves}}

        Thank you,
        {{sender.name}}
        {{sender.team}}
        """;

    internal void Edit(OutreachTemplate t)
    {
        _form = OutreachTemplateForm.From(t);
        StateHasChanged();
    }

    internal Task Save() => Run(async () =>
    {
        await TemplateSvc.SaveAsync(_form!);
        Toasts.Show(_form!.Id is null ? $"{_form.Name.Trim()} saved for the team." : "Saved.");
        _form = null;
    });

    internal Task Retire(OutreachTemplate t, bool retired) => Retiring(t.Name, retired, () => TemplateSvc.SetRetiredAsync(t.Id, retired));

    private async Task Delete(OutreachTemplate t)
    {
        if (!await _confirm.Ask($"Delete {t.Name}?", "It goes from the team's outreach templates. Emails already written from it keep their text and its name.", "Delete")) return;
        await Run(async () =>
        {
            await TemplateSvc.DeleteAsync(t.Id);
            Toasts.Show($"{t.Name} deleted.");
        });
    }
}
