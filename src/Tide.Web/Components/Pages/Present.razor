@page "/present/{Day}"
@using Tide.Application.Indicators
@using Tide.Application.Operations
@layout BlankLayout
@* Anyone who may join meetings can open it to join a live meeting; starting, running and ending one are the analysts'.
   A Visitor (not on the team edition) sees it only from a seat in the day's live meeting: the seat is taken before
   anything is read, and the services let their reads through only while it's held (MeetingAccess). *@
@attribute [Authorize(Policy = Policies.JoinMeetings)]
@inject BriefService BriefSvc
@inject Tide.Application.Settings.DistributionSettings Distribution
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IJSRuntime JS
@inject OrgClock Clock
@inject Tide.Application.Metrics.MetricsService MetricsSvc
@inject ActionService ActionSvc
@inject CveService CveSvc
@inject TeamService TeamSvc
@inject ICurrentUser CurrentUser
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@inject TimeProvider Time
@inject MeetingService MeetingSvc
@inject LiveMeetings Meetings
@inject PresenceCircuit Circuit
@inject Tide.Application.Stack.StackService StackSvc
@inject PrerenderHandoff Handoff
@implements IAsyncDisposable

<PageTitle>Presenting @Ui.ShortDay(_date) · TIDE</PageTitle>
@* The slides have no heading of their own for FocusOnNavigate to land on, so the page says what it is to a screen reader. *@
<h1 class="visually-hidden">Presenting the brief for @Ui.ShortDay(_date)</h1>
@* In rehearsal everything below is drawn read-only: each component that saves takes the cascade and saves nothing. *@
<CascadingValue Name="@ReadOnlyCascade.Name" Value="RehearsalAsked">

@if (RehearsalAsked)
{
    @* Learn to present's steps, announced as each shows (in rehearsal only). *@
    <div class="visually-hidden" role="status" aria-live="polite">@GuideSaid</div>
}
@if (_brief is null || NotLive || RehearsalRefused is not null)
{
    <div class="tide-present">
        <div></div>
        <div class="tide-slide"><div class="tide-slide-body"><div class="tide-slide-cover">
            @if (_loaded && _valid && RehearsalRefused is { } refused)
            {
                <h2>@refused</h2>
                <a href="@(_readsTeam ? Ui.BriefUrl(_date) : "published")">@(_readsTeam ? "Go to the brief" : "Go to the published briefs")</a>
            }
            else if (_loaded && !_valid)
            {
                <h2>“@Day” isn't a day</h2>
                <a href="@Ui.BriefUrl(Clock.Today)">Go to today's brief</a>
            }
            else if (_failed)
            {
                @* The error toast says what happened; this says there's nothing to present, rather than loading for ever. *@
                <h2>The brief couldn't be loaded</h2>
                <a href="@Nav.Uri" data-enhance-nav="false">Reload the page to try again</a>
            }
            else if (_loaded && _visitor)
            {
                <h2>There's no meeting on now</h2>
                <a href="published">Go to the published briefs</a>
            }
            else if (_loaded && !_canPresent)
            {
                <h2>No meeting going on</h2>
                <a href="@Ui.BriefUrl(_date)">Go to the brief</a>
            }
            else if (_loaded)
            {
                <h2>No brief for @Ui.Day(_date)</h2>
                <a href="@Ui.BriefUrl(_date)">Build it first</a>
            }
            else
            {
                <LoadingBlock Rows="2" Columns="1" Label="Loading the brief…" />
            }
        </div></div></div>
        <div></div>
    </div>
}
else
{
    var edition = Cut(_brief);
    var count = edition.Articles.Count;
    var last = LastSlide;
    @* Worked out once a render, for the slide and the rail both. *@
    var slideArticle = ArticleAt(edition, _slide);
    var slideMatch = slideArticle is null ? default : RecommendedActions.Match(slideArticle.Article.RecommendedActions, slideArticle.Actions, r => r.Recommendation);
    var notRaised = _slide == last && TeamEdition ? edition.Articles.Select(x => (x.Article, Lines: Unraised(x))).Where(x => x.Lines.Count > 0).ToList() : null;
    List<BriefItem> undiscussed = _slide == last && !Presented ? Undiscussed(edition) : [];
    <div id="present-root" class="tide-present @(RailDocked ? "has-rail" : "") @(ActionBeside ? "has-beside" : "")">
        <header class="tide-present-top" inert="@RailOver">
            <div class="tide-present-title">
                <span class="tide-brand-mark" aria-hidden="true">T</span>
                <span>@Clock.TeamName daily brief <small>&middot; @Ui.Day(_date)</small></span>
                @if (_past) { <span class="tide-present-help" title="This brief is being presented or recorded after its day">past day</span> }
            </div>
            @* Who is here and whose hands are up, for the presenter and everyone following alike: the first few dots and "+N"
               (the whole roster for a screen reader, read when reached; arrivals and hands are said briefly, in a status
               region of their own, so a follower moving slides doesn't have the roster read again), how many are here, the hands as their count and then as
               many whole names as fit, in the order they went up (a button: the list, where the presenter lowers one or
               all). A follower's own Raise hand comes before the hands, which take the room that's left. With no meeting, who else has the brief open. *@
            <div class="tide-present-people">
                <span class="visually-hidden" role="status">@_presenceSaid</span>
                @if (_view is { } meeting)
                {
                    var raised = meeting.Hands.Select(h => h.UserId).ToHashSet();
                    var beyond = meeting.People.Skip(TopBarDots).ToList();
                    var listOpen = HandsListOpen;   // read on every draw, so it shuts as the last hand goes down
                    <span class="tide-presence tide-presence-sm">
                        @foreach (var p in meeting.People.Take(TopBarDots))
                        {
                            var away = meeting.Away(p);
                            var up = raised.Contains(p.UserId);
                            <span class="tide-presence-dot tide-avatar-@Ui.AvatarSwatch(p.UserId) @(away ? "is-away" : "") @(up ? "has-hand" : meeting.IsPresenter(p.UserId) ? "is-presenting" : "")" @key="p.UserId" title="@Says(meeting, p)" aria-hidden="true">
                                @MainLayout.Initials(p.Name)
                                @if (up) { <span class="tide-presence-edit bi bi-hand-index-thumb-fill"></span> }
                                else if (away) { <span class="tide-presence-slide">@(p.Slide + 1)</span> }
                            </span>
                        }
                        @if (beyond.Count > 0)
                        {
                            <span class="tide-presence-dot tide-presence-more" title="@string.Join(", ", beyond.Select(p => Says(meeting, p)))" aria-hidden="true">+@beyond.Count</span>
                        }
                        <span class="visually-hidden">In the meeting: @string.Join(", ", meeting.People.Select(p => Says(meeting, p))).</span>
                    </span>
                    <span class="tide-present-here" aria-hidden="true">@Here(meeting)</span>
                    @if (!Presenting)
                    {
                        var mine = raised.Contains(_me);
                        <button class="btn btn-sm @(mine ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@Ui.Aria(mine)" @onclick="ToggleHand">
                            <span class="bi bi-hand-index-thumb" aria-hidden="true"></span> @(mine ? "Lower hand" : "Raise hand")
                        </button>
                    }
                    @if (meeting.Hands.Count > 0)
                    {
                        var names = string.Join(", ", meeting.Hands.Select(h => h.Name));
                        <div class="tide-hands-box" @ref="_handsHolder">
                            <button type="button" class="tide-hands-btn" @ref="_handsButton" aria-expanded="@Ui.Aria(listOpen)" aria-controls="present-hands"
                                    aria-label="@($"{Ui.Plural(meeting.Hands.Count, "hand")} up: {names}")" title="@names" @onclick="ToggleHandsList">
                                <span class="tide-hands-count"><span class="bi bi-hand-index-thumb" aria-hidden="true"></span><span class="tide-hands-n">@meeting.Hands.Count</span></span>
                                <span class="tide-hands-names" aria-hidden="true"><i></i>@foreach (var h in meeting.Hands) { <span @key="h.UserId">@h.Name</span> }</span>
                            </button>
                            @if (listOpen)
                            {
                                <div class="tide-hands-pop" id="present-hands">
                                    <ol class="tide-hands" aria-label="Hands up, in order">
                                        @foreach (var h in meeting.Hands)
                                        {
                                            <li @key="h.UserId"><span class="tide-hand-name">@h.Name</span></li>
                                        }
                                    </ol>
                                </div>
                            }
                        </div>
                    }
                }
                else if (!RehearsalAsked)
                {
                    <PresenceNote Place="@($"brief:{Ui.IsoDay(_date)}")" Editing="NoteDirty" Compact="true" />
                }
            </div>
            <div class="tide-present-tools">
                @if (Rehearsing)
                {
                    <span class="tide-rehearsal"><span class="bi bi-easel" aria-hidden="true"></span> Rehearsal: nothing here is shared or saved</span>
                }
                @* Whom this page follows, as a pill among the tools: it takes no height from the slide. When there's something to
                   do (back to the presenter, take over) it holds that one button; it's a live region, so a change is read out. *@
                @if (_view is { } live && !Presenting)
                {
                    var pill = FollowPill(live);
                    <div class="tide-follow @pill.Class" role="status">
                        <span class="tide-follow-dot" aria-hidden="true"></span><span class="tide-follow-text" title="@pill.Title">@pill.Text</span>@pill.After
                    </div>
                }
                <TlpBadge Level="edition.Marking" />
                <select class="form-select form-select-sm" aria-label="Edition shown" value="@_edition" @onchange="SetEdition" disabled="@(_view is not null)">
                    <option value="@Edition.Team">Team edition</option>
                    <option value="@Edition.Public">Company-wide edition</option>
                </select>
                @if (TeamEdition && _readsTeam && !RehearsalAsked)
                {
                    var unseen = Unseen;
                    <button class="btn btn-sm btn-outline-secondary tide-notes-btn" title="Meeting notes" aria-label="@(unseen > 0 ? $"Meeting notes, {unseen} new" : "Meeting notes")" @onclick="ToggleNotes">
                        <span class="bi bi-pencil-square" aria-hidden="true"></span> Notes
                        @if (unseen > 0) { <span class="tide-notes-new" aria-hidden="true">@unseen</span> }
                    </button>
                }
                @if (_view is null && _canPresent && TeamEdition && !Presented)
                {
                    @* In a rehearsal it's shown, for the guide to point at, and does nothing: disabled, and Run refuses it even
                       if a script takes that away. *@
                    <button id="present-start" class="btn btn-sm btn-primary" disabled="@(_busy || RehearsalAsked)" aria-disabled="@(RehearsalAsked ? "true" : null)"
                            title="@(RehearsalAsked ? "Starts the real meeting; not in a rehearsal" : null)" @onclick="StartMeeting"><span class="bi bi-broadcast" aria-hidden="true"></span> Start the meeting</button>
                }
                @if (_view is not null || Rehearsing)
                {
                    <button id="present-copy-link" class="btn btn-sm btn-outline-secondary" disabled="@RehearsalAsked" aria-disabled="@(RehearsalAsked ? "true" : null)"
                            title="@(RehearsalAsked ? "Copies the link to follow the meeting; not in a rehearsal" : "Copy the join link")" @onclick="CopyLink"><span class="bi bi-link-45deg" aria-hidden="true"></span> Copy link</button>
                }
                @if (CanEnd && (_view is not null || !Presented) && !RehearsalAsked)
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="EndFromTop"><span class="bi bi-flag" aria-hidden="true"></span> End the meeting</button>
                }
                @if (Rail)
                {
                    <button type="button" id="present-rail-toggle" class="btn btn-sm btn-outline-secondary" aria-controls="present-rail" aria-expanded="@Ui.Aria(RailOpen)" @ref="_railToggle"
                            title="Your controls for this slide (])" @onclick="ToggleRail">Rail <span class="tide-kbd">]</span></button>
                }
                <button class="btn btn-sm btn-outline-secondary" title="Full screen (F)" aria-label="Full screen (F)" @onclick="ToggleFullscreen"><span class="bi @(_fullscreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></span></button>
                <a class="btn btn-sm btn-outline-secondary" href="@(_readsTeam ? Ui.BriefUrl(_date) : "published")" title="Leave present mode" aria-label="Leave present mode"><span class="bi bi-x-lg" aria-hidden="true"></span></a>
            </div>
        </header>

        @* Announces the slide moved to, briefly; the slide itself isn't a live region, so a timer tick or typing isn't read out. *@
        <div class="visually-hidden" aria-live="polite" aria-atomic="true">Slide @(_slide + 1) of @(last + 1): @SlideTitle(edition, _slide)</div>
        @* The slide's body scrolls inside the slide when it's too long even shrunk to fit (present.js: no less than 80%);
           the header and the footer stay put, and the page itself never scrolls. A new body for each slide (its key), so
           each starts at its top. present.js sets is-more-above and is-more-below on it (the edge fades, the More pill);
           data-scroll-share says whether its scroll is the room's (presenting) or follows the presenter's. *@
        @{
            var scrollKey = SlideKey(_slide);
            var scrollPaused = ScrollBackShown(scrollKey);
        }
        <section class="tide-slide" aria-label="Slide @(_slide + 1) of @(last + 1)" inert="@RailOver">
            <div class="tide-slide-body tide-scrollfade" @key="scrollKey" data-slide-body data-slide-key="@scrollKey" data-scroll-share="@ScrollShare" data-scroll-paused="@(scrollPaused ? "true" : null)">
            <div class="tide-slide-inner">
                @if (_slide == 0)
                {
                    <div class="tide-slide-cover">
                        <div class="tide-slide-kicker justify-content-center">@Clock.TeamName</div>
                        <h2>Daily brief</h2>
                        <div class="tide-cover-meta">@Ui.Day(_date) &middot; @_brief.AnalystName</div>
                        @if (edition.ShowIntro)
                        {
                            <div class="tide-slide-intro mt-2"><Md Text="@_brief.Intro" /></div>
                        }
                        @* What's coming: the slides before the articles in a line, then the articles, each with KEV when it names
                           a CVE on CISA's list (shown on both editions, as the article slide's CVEs are). *@
                        @if (FirstUp is { } first)
                        {
                            <p class="tide-agenda-first">First: @first.</p>
                        }
                        @if (AfterArticles is { } after)
                        {
                            <p class="tide-agenda-first">After the articles: @after.</p>
                        }
                        <ol class="tide-agenda">
                            @foreach (var (ea, i) in edition.Articles.Select((a, i) => (a, i)))
                            {
                                var item = ItemFor(ea.Article.Id);
                                <li class="@(item?.Discussed == true ? "done" : "")">
                                    <span class="n">@(i + 1)</span>
                                    <ClassBadge Classification="ea.Article.Classification" Priority="ea.Article.Priority" />
                                    <span>@ea.Article.Title</span>
                                    @if (ea.Article.Cves.Any(c => _cves.GetValueOrDefault(c.CveId)?.IsKev == true))
                                    {
                                        <span class="tide-kev" title="It names a CVE on CISA's known exploited list">KEV</span>
                                    }
                                    @if (item?.Discussed == true) { <span class="bi bi-check2 ms-auto" aria-hidden="true"></span> }
                                </li>
                            }
                        </ol>
                        @if (edition.WithheldArticles > 0)
                        {
                            <div class="tide-present-help mt-2">@edition.WithheldArticles restricted item@(edition.WithheldArticles == 1 ? " is" : "s are") left out of this edition.</div>
                        }
                    </div>
                }
                else if (NoteSlides == 1 && _slide == 1 && edition.TeamNote is { } note)
                {
                    @* The team's opening note, read before the numbers: team edition only, and only when it isn't blank. *@
                    <div class="tide-slide-note">
                        <div class="tide-slide-kicker"><span>Opening note</span><span>&middot; team edition only</span></div>
                        <h2 tabindex="-1" @ref="_noteHeading">Before we start</h2>
                        <Md Text="@note" />
                    </div>
                }
                else if (OpenSlides == 1 && _slide == OpenAt)
                {
                    @* The open actions the room should look at, from any brief: overdue, escalated, or gone too long without an
                       update (ActionService.MeetingActionsAsync). Team edition only (ADR 0005), at most 8, most pressing first. *@
                    var limits = Clock.StaleLimits;
                    var more = _open.Overdue - _open.Rows.Count;
                    <div>
                        <div class="tide-slide-kicker"><span>Open actions</span><span>&middot; team edition only</span></div>
                        <h2>@ReviewTitle</h2>
                        @* Each with why it's here (late, escalated, quiet too long), its last update, and the one thing to do about it. *@
                        <table class="tide-slide-open">
                            <thead><tr><th scope="col">Action</th><th scope="col">Who</th><th scope="col">Waited</th><th scope="col">Next</th></tr></thead>
                            <tbody>
                                @foreach (var o in _open.Rows)
                                {
                                    <tr>
                                        @* The badge, title and number flow as text; where this page can open the action, a button over the cell does. *@
                                        <td><PriorityBadge Priority="o.Row.Priority" /> <ActionRef Number="o.Row.Number" Title="@o.Row.Title" Link="false" TitleClass="tide-slide-row-title" /> <EscalatedBadge At="o.Row.EscalatedSince" />@if (CanOpenAction)
                                            {
                                                var n = o.Row.Number;
                                                <button type="button" class="tide-slide-row-open" aria-label="Open @Ui.ActionLabel(n), @o.Row.Title" data-card-opener="action:@n" @onclick="() => ShowAction(n)"></button>
                                            }</td>
                                        <td>@o.Row.TeamName <span class="tide-present-help">&middot; <HolderText Label="o.Holder" Short="true" Links="!_visitor" /> &middot; <span class="text-nowrap">@ActionService.StatusName(o.Row.Status)</span></span></td>
                                        <td><span class="tide-slide-why">@foreach (var (why, i) in o.Reasons.Select((w, i) => (w, i))) { @(i > 0 ? " · " : "")<span class="tide-slide-late">@why</span> }</span>@if (o.LastUpdate is { } lastUpdate)
                                            {
                                                <span class="tide-slide-waited">last: @lastUpdate</span>
                                            }</td>
                                        <td><span class="tide-slide-next">@o.NextInTheRoom(o.QuietDays)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="tide-present-help mt-2">@_open.Rows.Count of @_open.Overdue shown: overdue, escalated, or with no update for @Ui.Plural(limits.OpenDays, "business day") (@limits.BlockedDays when blocked).@if (more > 0)
                            {
                                @(" ")@if (_readsTeam) { <a href="actions">@more more under Actions</a> } else { @($"{more} more under Actions") }@(".")
                            }</div>
                    </div>
                }
                else if (_slide > NoteSlides && _slide <= NoteSlides + MetricsSlides)
                {
                    var ms = MetricPlan[_slide - 1 - NoteSlides];
                    var tiles = ms.Group?.Tiles ?? [];
                    var compared = tiles.Any(t => t.Previous is not null);
                    <div class="tide-slide-mgroup">
                        <div class="tide-slide-kicker">
                            <span>@(_past ? "Numbers for " + Ui.ShortDay(_date) : "Today's numbers")</span>
                            @if (MetricsSlides > 1) { <span>&middot; @(_slide - NoteSlides) of @MetricsSlides</span> }
                            @if (compared) { <span>&middot; each compared with its last earlier value</span> }
                            else if (tiles.Any(t => t.Value is not null)) { <span>&middot; no earlier values to compare with</span> }
                        </div>
                        <h2 tabindex="-1" @ref="_numbersHeading">@(ms.Group?.Group.Name ?? "Opening metrics")</h2>
                        @if (ms.AllZero.Count > 0)
                        {
                            <ul class="tide-mzero" aria-label="Groups with every number at 0">
                                @foreach (var z in ms.AllZero) { <li>@z.Group.Name: all 0</li> }
                            </ul>
                        }
                        @if (ms.Group is { } g)
                        {
                            var swatches = g.Group.Chart != MetricChart.None;
                            <div class="tide-mtiles">
                                @foreach (var (t, ti) in tiles.Select((t, i) => (t, i)))
                                {
                                    <div class="tide-mtile">
                                        <div class="tide-tile-name">@if (swatches) { <i class="tide-mchart-swatch @LineChart.Series(ti)" aria-hidden="true"></i> }@t.Metric.Name</div>
                                        <div class="tide-mtile-value @(t.Level == Tide.Application.Metrics.MetricLevel.Normal ? "" : "tide-level-" + t.Level.ToString().ToLowerInvariant())">@t.Display<LevelMark Level="t.Level" /></div>
                                        @if (t.Value is null) { <div class="tide-mtile-missing">not entered</div> }
                                        @if (compared)
                                        {
                                            <div class="tide-tile-change"><MetricChange Tile="t" ShowDate="false" />@if (t.Previous is { } p && p.Date != Clock.Days.Previous(_date)) { <span class="tide-muted"> vs @Tide.Application.Metrics.MetricMath.ReferenceLabel(p.Date, _date, Clock.Days)</span> }</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(t.Note))
                                        {
                                            <div class="tide-mtile-note" title="@t.Note">@t.Note</div>
                                        }
                                    </div>
                                }
                            </div>
                            @if (g.Group.Chart != MetricChart.None)
                            {
                                <div class="tide-slide-mchart"><MetricGroupChart Group="g" Days="g.TrendDays" /></div>
                            }
                        }
                    </div>
                }
                else if (slideArticle is { } ea)
                {
                    var a = ea.Article;
                    var item = ItemFor(a.Id);
                    <div class="@(a.Classification == Classification.Threat ? "tide-slide-threat" : "")">
                        <div class="tide-slide-kicker">
                            <span>@(_slide - LeadSlides) of @count</span>
                            <ClassBadge Classification="a.Classification" Priority="a.Priority" />
                            <TlpBadge Level="a.Tlp" />
                            @if (ea.Marking > a.Tlp) { <span title="Some of this article is marked higher than the article itself">holds <TlpBadge Level="ea.Marking" /></span> }
                            @if (!string.IsNullOrWhiteSpace(a.SourceUrl))
                            {
                                @* The original report, for a question the slide doesn't answer: a new tab, so the meeting stays put. *@
                                <a class="tide-slide-source" href="@a.SourceUrl" target="_blank" rel="noopener noreferrer" title="Open the source in a new tab">@(string.IsNullOrWhiteSpace(a.SourceName) ? "Source" : a.SourceName) <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span><span class="visually-hidden"> (opens in a new tab)</span></a>
                            }
                            else if (!string.IsNullOrWhiteSpace(a.SourceName)) { <span>@a.SourceName</span> }
                            @if (HandsOn(a.Id) is { Count: > 0 } hands)
                            {
                                <span class="tide-hand" title="@string.Join(", ", hands.Select(h => h.Name))"><span class="bi bi-hand-index-thumb" aria-hidden="true"></span> @string.Join(", ", hands.Select(h => h.Name))</span>
                            }
                        </div>
                        <h2>@a.Title</h2>
                        @* What we run that the article is about: the team's (product notes are internal), never the company-wide edition's. *@
                        @if (TeamEdition && _stackOf.GetValueOrDefault(a.Id) is { Count: > 0 } runs)
                        {
                            <div class="tide-slide-werun">
                                <span class="tide-slide-werun-label">We run</span>
                                @foreach (var p in runs)
                                {
                                    var v = Tide.Application.Stack.StackService.ChipVersions(p.Versions);
                                    var what = p.Name + (v is null ? "" : " " + v) + (p.IsRetired ? " (retired)" : "");
                                    var muted = p.IsRetired ? "tide-slide-werun-retired" : "";
                                    @if (CanOpenCard)
                                    {
                                        <button type="button" @key="p.Id" class="tide-chip tide-slide-werun-chip @muted" title="Open what we know about @p.Name"
                                                aria-label="We run @what: open its notes" @onclick="() => ShowProduct(p.Id)">@p.Name@if (v is not null) { <span class="tide-slide-werun-ver">@v</span> }@if (p.IsRetired) { <span class="tide-slide-werun-ver">retired</span> }</button>
                                    }
                                    else
                                    {
                                        <span @key="p.Id" class="tide-chip tide-slide-werun-chip @muted">@p.Name@if (v is not null) { <span class="tide-slide-werun-ver">@v</span> }@if (p.IsRetired) { <span class="tide-slide-werun-ver">retired</span> }</span>
                                    }
                                }
                            </div>
                        }
                        <div class="tide-slide-bluf">@a.Bluf</div>
                        <div class="tide-slide-cols @(ea.Screenshots.Count == 0 ? "no-shots" : "")">
                            <div>
                                @if (ea.Bullets.Count > 0)
                                {
                                    <ul class="tide-slide-bullets">
                                        @foreach (var b in ea.Bullets)
                                        {
                                            <li><Md Text="@b.Text" Inline="true" />@if (a.Effective(b.Tlp) > a.Tlp) { <text> </text><TlpBadge Level="a.Effective(b.Tlp)" /> }</li>
                                        }
                                    </ul>
                                }
                                @if (ea.ShowWhy)
                                {
                                    <div class="tide-slide-section">Why it matters to us @if (a.Effective(a.WhyItMattersTlp) > a.Tlp) { <TlpBadge Level="a.Effective(a.WhyItMattersTlp)" /> }</div>
                                    <Md Text="@a.WhyItMatters" />
                                }
                                @* The recommended lines, each with the action it became (by the line the action stored as it was raised,
                                   never its title), and the article's other actions in a list of their own below: raised by hand, or
                                   from a line since edited or removed. Actions are the team edition's alone (ADR 0005). *@
                                @{ var (recoLines, otherActions) = slideMatch; }
                                @if (!string.IsNullOrWhiteSpace(a.RecommendedActions))
                                {
                                    <div class="tide-slide-section">Recommended actions</div>
                                    @if (TeamEdition && recoLines.Count > 0)
                                    {
                                        @* Each line, and the action it became (number, status, holder): the room's view. The presenter
                                           raises a line, and works an action, from the rail. *@
                                        <ul class="tide-reco">
                                            @foreach (var ((line, done), n) in recoLines.Select((l, n) => (l, n)))
                                            {
                                                <li @key="n" class="@(done is null ? "" : "is-raised")">
                                                    <span>@line</span>
                                                    @if (done is not null)
                                                    {
                                                        <span class="tide-reco-done">
                                                            <span class="bi bi-check2" aria-hidden="true"></span> @ActionNum(done.Number) &middot; @ActionService.StatusName(done.Status) &middot; <HolderText Label="@done.Holder("nobody")" Links="!_visitor" />
                                                        </span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <Md Text="@a.RecommendedActions" />
                                    }
                                }
                                @* Its scorecard tags, ATT&CK by tactic and CVEs, in one section. Each edition shows what its email and web copy
                                   show (SlideTags): ATT&CK and CVEs on both, the scorecard tags on the team edition's only. A writer edits
                                   the tags from the heading, over the slide (PresentTagEditor). *@
                                @{
                                    var (tactics, allTags) = TagsOf(a);
                                    var scorecard = SlideTags.ShowsScorecard(_edition) ? allTags : [];
                                }
                                @if (tactics.Count > 0 || scorecard.Count > 0 || a.Cves.Count > 0 || CanEditTags)
                                {
                                    var heading = scorecard.Count > 0 ? "Tags and ATT&CK" : tactics.Count == 0 && a.Cves.Count > 0 ? "CVEs" : "ATT&CK";
                                    <section class="tide-slide-tagsec" aria-label="@heading">
                                        <div class="tide-slide-section tide-slide-tagshead">
                                            <span>@heading</span>
                                            @if (CanEditTags)
                                            {
                                                var none = tactics.Count + scorecard.Count == 0;
                                                <button type="button" class="btn btn-sm btn-outline-secondary tide-slide-tags-edit" @ref="_editTagsButton" aria-label="@((none ? "Add tags to " : "Edit the tags on ") + a.Title)"
                                                        aria-expanded="@Ui.Aria(_tagEdit == a.Id)" @onclick="() => EditTags(a.Id)"><span class="bi bi-tags" aria-hidden="true"></span> @(none ? "Add tags" : "Edit tags")</button>
                                            }
                                        </div>
                                        @if (scorecard.Count > 0)
                                        {
                                            <ul class="tide-slide-scorecard" aria-label="Scorecard tags">
                                                @foreach (var g in scorecard)
                                                {
                                                    @foreach (var tag in g.Tags)
                                                    {
                                                        <li class="tide-chip tide-slide-tagchip" title="@g.Category"><span class="visually-hidden">@g.Category: </span>@tag</li>
                                                    }
                                                }
                                            </ul>
                                        }
                                        @if (tactics.Count > 0)
                                        {
                                            <ul class="tide-slide-attack" aria-label="ATT&CK by tactic">
                                                @foreach (var t in tactics)
                                                {
                                                    <li @key="t.Tactic" class="tide-slide-tactic" style="--tac:@Ui.TacticColor(t.Tactic)">
                                                        <span class="tide-slide-tactic-name"><span class="bi @Ui.TacticGlyph(t.Tactic)" aria-hidden="true"></span><span class="tide-slide-tag-name">@t.Name</span><span class="visually-hidden">:</span></span>
                                                        @foreach (var x in t.Shown)
                                                        {
                                                            <span class="tide-slide-tech"><span class="tide-slide-tech-id">@x.Id</span> @x.Name</span>
                                                        }
                                                        @if (t.Left.Count > 0)
                                                        {
                                                            var rest = string.Join("; ", t.Left.Select(x => $"{x.Id} {x.Name}"));
                                                            <span class="tide-slide-tech-more" title="@rest">+@t.Left.Count more<span class="visually-hidden">: @rest</span></span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        @if (a.Cves.Count > 0)
                                        {
                                            var cves = SlideCves.For(a.Cves.Select(c => c.CveId), _cves);
                                            var many = cves.Items.Count > 1;
                                            var open = !many || (!CanOpenCard && _cvesOpen.Contains(a.Id));
                                            var cvesId = $"slide-cves-{a.Id:N}";
                                            <div class="tide-slide-cves" id="@cvesId">
                                                @if (many)
                                                {
                                                    <span class="tide-slide-cve-sum @(cves.Kev > 0 ? "tide-slide-cve-sum-kev" : "")">@cves.Summary</span>
                                                }
                                                @foreach (var (id, record) in open ? cves.Items : cves.Items.Take(1))
                                                {
                                                    <CveChip @key="id" CveId="@id" Record="record" />
                                                }
                                                @if (many && CanOpenCard)
                                                {
                                                    <button type="button" class="btn btn-link btn-sm tide-slide-cve-more" data-card-opener="cves-more:@a.Id" aria-expanded="@Ui.Aria(ShownCves?.Article.Id == a.Id)"
                                                            title="Show them all over the slide" @onclick="() => ShowCves(a.Id)">+@(cves.Items.Count - 1) more</button>
                                                }
                                                else if (many)
                                                {
                                                    <button type="button" class="btn btn-link btn-sm tide-slide-cve-more" aria-expanded="@Ui.Aria(open)" aria-controls="@cvesId" @onclick="() => ToggleCves(a.Id)">@(open ? "Show fewer" : $"+{cves.Items.Count - 1} more")</button>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                                @* The indicators the edition carries (the team's only, ADR 0005), defanged as the email shows them, in the
                                   card's order, so the room reads them without a click; the first ten, then how many more. A chip opens
                                   the larger card over the slide (by type, with the notes), as "+N more" does; where no card opens
                                   (a held follower, the company-wide edition), they are plain chips. *@
                                @if (ea.Indicators.Count > 0)
                                {
                                    var openIocs = ShownIndicators?.Article.Id == a.Id;
                                    var moreIocs = ea.Indicators.Count - SlideIndicators;
                                    var iocsId = $"slide-iocs-{a.Id:N}";
                                    <section class="tide-slide-iocsec" aria-labelledby="@iocsId">
                                        <div class="tide-slide-section" id="@iocsId">Indicators (@ea.Indicators.Count)</div>
                                        <ul class="tide-slide-iocs">
                                            @foreach (var ind in ea.Indicators.Take(SlideIndicators))
                                            {
                                                var type = IndicatorLabels.For(ind.Type);
                                                var title = string.IsNullOrWhiteSpace(ind.Note) ? type : $"{type} · {ind.Note}";
                                                var shown = IndicatorLabels.Shown(ind.Type, ind.Value);
                                                <li @key="ind.Id">
                                                    @if (CanOpenCard)
                                                    {
                                                        <button type="button" class="tide-slide-ioc" data-card-opener="ioc:@ind.Id" title="@title" aria-expanded="@Ui.Aria(openIocs)" @onclick="() => ShowIndicators(a.Id)"><span class="visually-hidden">@type: </span><span class="tide-data">@shown</span></button>
                                                    }
                                                    else
                                                    {
                                                        <span class="tide-slide-ioc" title="@title"><span class="visually-hidden">@type: </span><span class="tide-data">@shown</span></span>
                                                    }
                                                </li>
                                            }
                                            @if (moreIocs > 0)
                                            {
                                                <li>
                                                    @if (CanOpenCard)
                                                    {
                                                        <button type="button" class="btn btn-link btn-sm tide-slide-cve-more tide-slide-ioc-more" data-card-opener="iocs-more:@a.Id" aria-expanded="@Ui.Aria(openIocs)" title="Show them all over the slide" @onclick="() => ShowIndicators(a.Id)">+@moreIocs more</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="tide-present-help tide-slide-ioc-more">+@moreIocs more</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </section>
                                }
                                @if (ea.WithheldParts > 0)
                                {
                                    <div class="tide-present-help mt-2">@ea.WithheldParts restricted part@(ea.WithheldParts == 1 ? " is" : "s are") left out of this edition.</div>
                                }
                                @* Indicators and actions are the team's: the company-wide edition never carries them (ADR 0005). *@
                                @if (TeamEdition)
                                {
                                <div class="tide-slide-actions">
                                    <div class="tide-slide-section">@(recoLines.Count > 0 ? "Other actions" : "Actions")</div>
                                    @if (otherActions.Count > 0)
                                    {
                                        <ul class="tide-slide-actlist">
                                            @foreach (var r in otherActions)
                                            {
                                                <li>
                                                    @ActionTitle(r.Number, r.Title)
                                                    <span class="tide-present-help">@r.TeamName@if (r.Holder("") is { Kind: not HolderKind.Nobody } who) { @(" · ")<HolderText Label="who" Short="true" Links="!_visitor" /> }@(r.DueDate is { } due ? " · due " + Ui.ShortDay(due) : "")</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <div class="tide-present-help">None yet.</div>
                                    }
                                </div>
                                }
                            </div>
                            @if (ea.Screenshots.Count > 0)
                            {
                                <div class="tide-slide-shots">
                                    @foreach (var s in ea.Screenshots)
                                    {
                                        <figure>
                                            <button type="button" class="tide-zoom" aria-label="Show @(s.Caption ?? "the screenshot") full size" @onclick="() => _zoom = s"><img src="@Ui.ImageUrl(s.FileId)" alt="@(s.Caption ?? "Screenshot")" /></button>
                                            @if (!string.IsNullOrWhiteSpace(s.Caption)) { <figcaption>@s.Caption</figcaption> }
                                        </figure>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="tide-slide-cover">
                        <h2>That's the brief</h2>
                        @{ var threats = edition.Articles.Count(a => a.Article.Classification == Classification.Threat); }
                        <div class="tide-cover-meta">
                            @threats threat@(threats == 1 ? "" : "s"),
                            @edition.Articles.Count(a => a.Article.Classification == Classification.Informational) informational
                        </div>
                        @* What's left, as three short lists the room reads alike (the presenter's rail acts on them): the
                           recommended lines no action has been raised from yet (by the stored link), who is doing what, and
                           the articles not marked discussed. All from the edition, so nothing above its ceiling is named. The
                           company-wide edition has no actions: it shows the recommendations as written instead. *@
                        <div class="tide-wrap">
                            @if (TeamEdition)
                            {
                                var open = notRaised!;
                                var holders = WrapUp.WhoHasWhat(edition.Articles.SelectMany(x => x.Actions));
                                <section class="tide-wrap-list" data-wrap="unraised" aria-labelledby="wrap-unraised-h">
                                    <h3 id="wrap-unraised-h" class="tide-slide-section">Recommended, with no action raised yet (@open.Sum(x => x.Lines.Count))</h3>
                                    @foreach (var x in open)
                                    {
                                        <div class="tide-wrap-item"><strong>@x.Article.Title</strong><ul>@foreach (var l in x.Lines) { <li>@l</li> }</ul></div>
                                    }
                                    @if (open.Count == 0) { <p class="tide-present-help">Nothing left to raise.</p> }
                                </section>
                                <section class="tide-wrap-list" data-wrap="owners" aria-labelledby="wrap-owners-h">
                                    <h3 id="wrap-owners-h" class="tide-slide-section">Who is doing what (@holders.Sum(g => g.Actions.Count))</h3>
                                    @foreach (var g in holders)
                                    {
                                        <div class="tide-wrap-item">
                                            @* An external team's ticket links out, as on the open actions slide (words only for a Visitor). *@
                                            <strong>@if (g.Outside is { Kind: HolderKind.Ticket } ticket) { <HolderText Label="ticket" Links="!_visitor" />@($" · {g.TeamName}") } else { @g.Who }</strong>
                                            <ul>
                                                @foreach (var r in g.Actions)
                                                {
                                                    @* The status and the due date each kept on one line. *@
                                                    <li>@ActionTitle(r.Number, r.Title) <span class="tide-present-help"><span class="text-nowrap">@ActionService.StatusName(r.Status)</span>@if (r.DueDate is { } due) { @(" · ")<span class="text-nowrap">due @Ui.ShortDay(due)</span> }</span></li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    @if (holders.Count == 0) { <p class="tide-present-help">No actions raised on these articles.</p> }
                                </section>
                            }
                            else if (edition.Articles.Where(x => !string.IsNullOrWhiteSpace(x.Article.RecommendedActions)).ToList() is { Count: > 0 } recommended)
                            {
                                <section class="tide-wrap-list" data-wrap="recommended" aria-labelledby="wrap-reco-h">
                                    <h3 id="wrap-reco-h" class="tide-slide-section">Recommended actions</h3>
                                    @foreach (var x in recommended)
                                    {
                                        <div class="tide-wrap-item"><strong>@x.Article.Title</strong><Md Text="@x.Article.RecommendedActions" /></div>
                                    }
                                </section>
                            }
                            @if (!Presented)
                            {
                                @* Only the articles this edition shows: the company-wide one mustn't name the team-only ones. *@
                                <section class="tide-wrap-list" data-wrap="undiscussed" aria-labelledby="wrap-undiscussed-h" role="status">
                                    <h3 id="wrap-undiscussed-h" class="tide-slide-section">Not marked discussed (@undiscussed.Count)</h3>
                                    @foreach (var item in undiscussed)
                                    {
                                        <div class="tide-wrap-item">@item.Article!.Title@(_carry.Contains(item.ArticleId) ? " (carried to the next brief)" : "")</div>
                                    }
                                    @if (undiscussed.Count == 0) { <p class="tide-present-help">Every article was discussed.</p> }
                                </section>
                            }
                        </div>
                        @if (!Presented)
                        {
                            @if (TeamEdition && (_view is not null || _record.Attendees.Count > 0))
                            {
                                <div class="tide-slide-text text-start mx-auto tide-slide-actions">
                                    @{ var attendance = Attendance; }
                                    <div class="tide-slide-section">Attended (@attendance.Count)</div>
                                    <ul class="tide-attendance">
                                        @foreach (var p in attendance)
                                        {
                                            <li>
                                                <span class="tide-presence-dot tide-avatar-@Ui.AvatarSwatch(p.Key)" aria-hidden="true">@MainLayout.Initials(p.Name)</span> @p.Name
                                                @if (p.Here) { <span class="tide-present-help">here</span> }
                                                @* Someone following takes off a name they added here; the presenter, any, from their rail. *@
                                                @if (!Rail && p.Row is { } row && MayRemove(row))
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove @p.Name" title="Remove" disabled="@_busy" @onclick="() => RemoveAttendee(row)"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                                                }
                                            </li>
                                        }
                                    </ul>
                                    @* For those following who may add: the presenter adds from their rail. *@
                                    @if (!Rail && MayAddAttendees)
                                    {
                                        <div class="tide-wrap-add">
                                            <input id="wrap-add-name" class="form-control form-control-sm" aria-label="Add someone who was here" placeholder="Add someone who was here" maxlength="256" @bind="_addName" @bind:event="oninput" @onkeydown="AddNameKey" />
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_addName))" @onclick="AddAttendee"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add</button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="tide-present-help">
                                @if ((_brief.MeetingHeldAtUtc ?? _brief.PresentedAtUtc) is { } held) { <text>Held @Ui.When(Clock, held).</text> }
                                @if (_brief.PresentedAtUtc is { } rec) { <text> Recorded @Ui.When(Clock, rec).</text> }
                            </div>
                        }
                    </div>
                }
            </div>
            </div>
            <div class="tide-slide-dock">
                @if (scrollPaused)
                {
                    <button type="button" class="tide-slide-back" @onclick="BackToPlace">Back to @(_view?.PresenterName)'s place</button>
                }
                <button type="button" class="tide-slide-more" data-slide-more aria-label="More below: scroll down">More <span aria-hidden="true">&darr;</span></button>
            </div>
        </section>

        @* The presenter's rail: what's theirs to do on this slide, in one place beside it (docked from 1500px, over it below
           that once ] or Rail opens it). Never in a follower's page: it's drawn only for the page presenting, or with no
           meeting for someone who could present. *@
        @if (RailOpen)
        {
            var railArticle = slideArticle;
            var railItem = railArticle is null ? null : ItemFor(railArticle.Article.Id);
            var onNumbers = _slide > NoteSlides && _slide <= NoteSlides + MetricsSlides;
            var railTiles = onNumbers ? MetricPlan[_slide - 1 - NoteSlides].Group?.Tiles ?? [] : [];
            @if (RailOver)
            {
                @* Over the slide the rail is modal: the page under it is inert, behind a scrim that closes it on a click. *@
                <div class="tide-present-scrim" @onclick="CloseRailFromScrim"></div>
            }
            <aside id="present-rail" class="tide-present-rail @(RailDocked ? "is-docked" : "is-over")" tabindex="-1" @ref="_railBox"
                   role="@(RailDocked ? null : "dialog")" aria-modal="@(RailOver ? "true" : null)" aria-label="Presenter's controls">
                @* Pinned at the top, never scrolled away: the rail's head, and the bar of what's pressed most (Mark
                   discussed, Lock to me, the hands). Below it the rail scrolls. *@
                <div class="tide-present-rail-pin">
                <div class="tide-present-rail-head">
                    <span>Presenter &middot; @(_slide == 0 ? "before you start" : _slide == last ? "before you end" : "this slide")</span>
                    <button type="button" id="present-rail-close" class="btn btn-sm btn-outline-secondary" aria-label="Close the rail (])" title="Close the rail (])" @ref="_railClose" @onclick="ToggleRail"><span class="tide-kbd">]</span></button>
                </div>
                @if (railItem is not null || _view is not null && Presenting)
                {
                    <fieldset class="tide-rehearsal-controls" disabled="@RehearsalAsked">
                    <div class="tide-present-rail-bar">
                        @if (railItem is not null)
                        {
                            <button type="button" class="btn btn-sm tide-present-rail-discussed @(railItem.Discussed ? "on" : "")" aria-pressed="@Ui.Aria(railItem.Discussed)" @onclick="() => ToggleDiscussed(railItem)">
                                <span class="bi @(railItem.Discussed ? "bi-check2" : "bi-square")" aria-hidden="true"></span> @(railItem.Discussed ? "Discussed" : "Mark discussed") <span class="tide-kbd">D</span>
                            </button>
                        }
                        @if (_view is { } pinned && Presenting)
                        {
                            <button type="button" id="present-rail-lock" class="btn btn-sm @(pinned.Locked ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@Ui.Aria(pinned.Locked)"
                                    title="@(pinned.Locked ? "Let everyone browse the slides again" : "Everyone follows your slide, and can't browse off")" @onclick="ToggleLock">
                                <span class="bi @(pinned.Locked ? "bi-lock-fill" : "bi-unlock")" aria-hidden="true"></span> Lock to me <span class="tide-present-rail-state">@(pinned.Locked ? "On" : "Off")</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary tide-present-rail-hands" aria-label="Hands up: @pinned.Hands.Count" aria-expanded="@Ui.Aria(HandsListOpen)"
                                    aria-controls="present-hands" disabled="@(pinned.Hands.Count == 0)" @onclick="ToggleHandsList">
                                <span class="bi bi-hand-index-thumb" aria-hidden="true"></span> @pinned.Hands.Count
                            </button>
                        }
                    </div>
                    </fieldset>
                }
                </div>
                @* In rehearsal every control here is disabled (and each step checks again where it's handled). *@
                <fieldset class="tide-rehearsal-controls" disabled="@RehearsalAsked">
                @if (_slide == 0)
                {
                    <section aria-labelledby="rail-ready-h">
                        <h3 id="rail-ready-h">Ready to present?</h3>
                        <div class="tide-present-rail-row"><span class="bi bi-check2 tide-present-rail-ok" aria-hidden="true"></span><span class="tide-present-rail-grow">@Ui.Plural(edition.Articles.Count, "article") in order</span></div>
                        @if (PresenterTools && BriefService.TeamNoteCarriedOver(_brief))
                        {
                            <div class="tide-present-rail-row"><span class="tide-present-rail-warn" aria-hidden="true">!</span><span class="tide-present-rail-grow">Opening note not updated</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="KeepOpeningNote">Still current</button></div>
                        }
                        @if (PresenterTools && FirstMissingSlide is { } missingAt)
                        {
                            <div class="tide-present-rail-row"><span class="tide-present-rail-warn" aria-hidden="true">!</span><span class="tide-present-rail-grow">@Ui.Plural(MissingNumbers, "number") missing</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToMissingNumber(missingAt)">Enter</button></div>
                        }
                    </section>
                    @if (FirstUp is { } first)
                    {
                        <section aria-labelledby="rail-then-h"><h3 id="rail-then-h">Then</h3><p class="tide-present-help">First: @first.</p></section>
                    }
                }
                else if (NoteSlides == 1 && _slide == 1)
                {
                    <section aria-labelledby="rail-note-h">
                        <h3 id="rail-note-h">The note</h3>
                        @if (PresenterTools)
                        {
                            @* The presenter's alone (never in a follower's page): the note edited here, through the brief's own
                               save, and, carried from the last brief and not looked at since, kept as it is. *@
                            <div class="tide-slide-presenter">
                                @if (_noteEditing)
                                {
                                    <ChangedElsewhere By="@_noteChangedBy" What="team's opening note" Consequence="Saving now would be refused." OnReload="EditOpeningNote" />
                                    <label class="visually-hidden" for="slide-note-text">Opening note</label>
                                    <textarea id="slide-note-text" class="form-control" rows="3" maxlength="@BriefService.TeamNoteMax" @ref="_noteBox"
                                              aria-describedby="slide-note-hint" @bind="_noteDraft" @bind:event="oninput" @onkeydown="NoteBoxKey"></textarea>
                                    <div class="tide-slide-presenter-row">
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_noteDraft))" @onclick="() => SaveOpeningNote(_noteDraft)">Save note</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="CancelOpeningNote">Cancel</button>
                                        <span class="tide-slide-presenter-say" id="slide-note-hint">Esc cancels. An empty note isn't saved here: it would take the slide away.</span>
                                    </div>
                                }
                                else if (BriefService.TeamNoteCarriedOver(_brief))
                                {
                                    <div class="tide-slide-presenter-row">
                                        <span class="tide-slide-presenter-flag"><span class="bi bi-clock-history" aria-hidden="true"></span> Not updated</span>
                                        <span class="tide-slide-presenter-say">Carried from the last brief.</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @ref="_noteEditButton" @onclick="EditOpeningNote">Edit</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="KeepOpeningNote">Still current</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="tide-slide-presenter-row">
                                        <span class="tide-slide-presenter-say">Current for this brief.</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @ref="_noteEditButton" @onclick="EditOpeningNote">Edit</button>
                                    </div>
                                }
                            </div>
                        }
                        <p class="tide-present-help">Team edition only: it never goes company-wide.</p>
                    </section>
                }
                else if (onNumbers && (PresenterTools ? railTiles.Where(Missing).ToList() : []) is { Count: > 0 } missing)
                {
                    <section aria-labelledby="rail-numbers-h">
                        <h3 id="rail-numbers-h">The numbers</h3>
                        @* The presenter's alone: a number not entered yet (the room sees a dash), entered here through the
                           day's numbers' own save. *@
                        <div class="tide-slide-presenter">
                            <div class="tide-slide-presenter-say">@Ui.Plural(missing.Count, "number") missing. The room sees a dash until it's saved.</div>
                            @foreach (var t in missing)
                            {
                                var refused = _numberErrors.GetValueOrDefault(t.Metric.Id);
                                var errorId = $"slide-number-error-{t.Metric.Id:N}";
                                <div class="tide-slide-presenter-row" @key="t.Metric.Id">
                                    <span class="tide-slide-presenter-name">@t.Metric.Name</span>
                                    <input type="text" inputmode="decimal" class="form-control form-control-sm tide-slide-presenter-number" aria-label="@($"{t.Metric.Name} for {Ui.ShortDay(_date)}")"
                                           aria-invalid="@(refused is null ? null : "true")" aria-describedby="@(refused is null ? null : errorId)"
                                           value="@_numberDrafts.GetValueOrDefault(t.Metric.Id)" @oninput="e => _numberDrafts[t.Metric.Id] = e.Value?.ToString() ?? string.Empty"
                                           @onkeydown="e => NumberKey(e, t.Metric.Id)" @ref="_numberBoxes[t.Metric.Id]" />
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => EnterMissingNumber(t.Metric.Id, _numberDrafts.GetValueOrDefault(t.Metric.Id) ?? string.Empty)">Save</button>
                                    @if (refused is not null) { <span class="tide-slide-presenter-error" id="@errorId">@refused</span> }
                                </div>
                            }
                        </div>
                    </section>
                }
                else if (railArticle is { } ra && TeamEdition)
                {
                    var (railLines, railOthers) = slideMatch;
                    var railActions = railLines.Where(l => l.Action is not null).Select(l => l.Action!).Concat(railOthers).ToList();
                    <section aria-labelledby="rail-actions-h">
                        <h3 id="rail-actions-h">Actions on this article (@railActions.Count)</h3>
                        @foreach (var r in railActions)
                        {
                            <div class="tide-present-rail-action" @key="r.Id">
                                <div class="tide-present-rail-row">@ActionNum(r.Number)<span class="tide-present-rail-grow">@r.Title</span></div>
                                @ActionControls(r)
                            </div>
                        }
                        @if (CanRaise)
                        {
                            @foreach (var line in railLines.Where(l => l.Action is null).Select(l => l.Line))
                            {
                                var draft = LineDraft(ra.Article.Id, line);
                                var chipOpen = _chipsOpen.Contains((ra.Article.Id, line));
                                @* The line and its one Raise; under it, what it'll be raised as, a chip that opens the two lists in place. *@
                                <div class="tide-present-rail-raise" @key="line">
                                    <div class="tide-present-rail-raise-line">@line</div>
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@_raising" @onclick="() => Raise(ra.Article.Id, line, draft)"><span class="bi bi-plus-lg" aria-hidden="true"></span> Raise</button>
                                    @KindTeamChip("Change the kind and team for: " + line, draft.Kind, draft.Team, chipOpen, () => EditRaiseChip(ra.Article.Id, line))
                                    @if (chipOpen)
                                    {
                                        <div class="tide-present-rail-chip-edit">
                                            <select class="form-select form-select-sm" aria-label="Kind for: @line" value="@draft.Kind" @onchange="e => SetLineKind(draft, e)">
                                                @foreach (var k in Enum.GetValues<ActionKind>()) { <option value="@k">@ActionService.KindName(k)</option> }
                                            </select>
                                            <select class="form-select form-select-sm" aria-label="Team for: @line" @bind="draft.Team">
                                                @foreach (var t in _teams) { <option value="@t.Id">@t.Name</option> }
                                            </select>
                                        </div>
                                    }
                                </div>
                            }
                            @* Another action: collapsed to its button; opened, the title on a row, then its kind and team, due date and Add. *@
                            <div class="tide-quick-add @(QuickAddOpen(ra.Article.Id) ? "is-open" : "")">
                                @if (!QuickAddOpen(ra.Article.Id))
                                {
                                    <button type="button" class="btn btn-sm btn-link tide-quick-add-open" @onclick="() => OpenQuickAdd(ra.Article.Id)"><span class="bi bi-plus-lg" aria-hidden="true"></span> Another action</button>
                                }
                                else
                                {
                                    <input class="form-control form-control-sm" placeholder="What needs doing" aria-label="New action title" maxlength="300" @ref="_quickAddTitleBox"
                                           @bind:get="QuickAddTitle(ra.Article.Id)" @bind:set="v => TypeQuickAddTitle(ra.Article.Id, v)" @bind:event="oninput" />
                                    <div class="tide-quick-add-row">
                                        @KindTeamChip("Change the kind and team for the new action", _qaKind, _qaTeam, _qaChipOpen, () => _qaChipOpen = !_qaChipOpen)
                                        <input type="date" class="form-control form-control-sm" aria-label="Due (blank: from the SLA)" title="Due (blank: from the SLA)" @bind="_qaDue" />
                                        <button class="btn btn-sm btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(QuickAddTitle(ra.Article.Id)))" @ref="_quickAddButton" @onclick="() => QuickAdd(ra.Article.Id)"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add</button>
                                    </div>
                                    @if (_qaChipOpen)
                                    {
                                        <div class="tide-present-rail-chip-edit">
                                            <select class="form-select form-select-sm" aria-label="Kind" @bind="_qaKind">
                                                @foreach (var k in Enum.GetValues<ActionKind>()) { <option value="@k">@ActionService.KindName(k)</option> }
                                            </select>
                                            <select class="form-select form-select-sm" aria-label="Team" @bind="_qaTeam">
                                                @foreach (var t in _teams) { <option value="@t.Id">@t.Name</option> }
                                            </select>
                                        </div>
                                    }
                                    @if (_qaDue is { } qd && qd < ActionSvc.Today)
                                    {
                                        <span class="tide-present-help" role="status">That date has passed: it'll be overdue at once.</span>
                                    }
                                }
                            </div>
                        }
                    </section>
                    @if (_readsTeam && _canNote)
                    {
                        @* One line until it's written in, growing as it is; Add note beside it. The team's meeting notes:
                           everyone in the meeting reads them under Notes. *@
                        <section aria-labelledby="rail-note-mine-h">
                            <h3 id="rail-note-mine-h">Your note</h3>
                            <div class="tide-present-rail-note">
                                <textarea class="form-control form-control-sm tide-autogrow" rows="1" aria-label="Note on this article" maxlength="@MeetingService.MaxNote" placeholder="Note on this article. Ctrl+Enter adds it."
                                          @bind:get="_noteText" @bind:set="TypeNote" @bind:event="oninput" @onkeydown="RailNoteKey"></textarea>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_noteText))" @onclick="AddNote">Add note</button>
                            </div>
                        </section>
                    }
                }
                else if (_slide == last)
                {
                    <section aria-labelledby="rail-end-h">
                        <h3 id="rail-end-h" tabindex="-1" @ref="_endHeading">Before you end</h3>
                        @if (TeamEdition && CanRaise)
                        {
                            <div class="tide-present-rail-sub">Not raised yet (@notRaised!.Sum(x => x.Lines.Count))</div>
                            @foreach (var (art, lines) in notRaised!)
                            {
                                @foreach (var line in lines)
                                {
                                    var draft = LineDraft(art.Id, line);
                                    <div class="tide-present-rail-raise" @key="(art.Id, line)">
                                        <div class="tide-present-rail-raise-line">@line <span class="tide-present-help">&middot; @art.Title</span></div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_raising" @onclick="() => Raise(art.Id, line, draft)">Raise as @ActionService.KindName(draft.Kind)</button>
                                    </div>
                                }
                            }
                            @if (notRaised!.Count == 0) { <p class="tide-present-help">Nothing left to raise.</p> }
                        }
                        @if (!Presented)
                        {
                            <div class="tide-present-rail-sub">Not discussed (@undiscussed.Count)</div>
                            @if (undiscussed.Count == 0) { <p class="tide-present-help">Every article was discussed.</p> }
                            @foreach (var item in undiscussed)
                            {
                                var id = item.ArticleId;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="carry-@id" checked="@_carry.Contains(id)" @onchange="e => Carry(id, e.Value is true)" />
                                    <label class="form-check-label" for="carry-@id">@item.Article!.Title</label>
                                </div>
                            }
                            @if (undiscussed.Count > 0)
                            {
                                <p class="tide-present-help">Tick to carry it to @Ui.Day(Clock.Days.Next(_date))'s brief instead of marking it presented.</p>
                            }
                            @if (TeamEdition && (_view is not null || _record.Attendees.Count > 0))
                            {
                                <div class="tide-present-rail-sub">Attendance</div>
                                @foreach (var at in Attendance.Where(x => x.Row is not null))
                                {
                                    <div class="tide-present-rail-row"><span class="tide-present-rail-grow">@at.Name</span>
                                        @if (MayRemove(at.Row!))
                                        {
                                            <button class="btn btn-sm btn-link p-0" aria-label="Remove @at.Name" title="Remove" disabled="@_busy" @onclick="() => RemoveAttendee(at.Row!)"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                                        }
                                    </div>
                                }
                                @if (MayAddAttendees)
                                {
                                    <div class="tide-quick-add">
                                        <input class="form-control form-control-sm" aria-label="Add someone who was in the room" placeholder="Someone in the room" maxlength="256" @bind="_addName" @bind:event="oninput" @onkeydown="AddNameKey" />
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_addName))" @onclick="AddAttendee"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add</button>
                                    </div>
                                }
                            }
                            @if (_past)
                            {
                                <div class="tide-present-help mt-2">
                                    <label for="held">The meeting was held</label>
                                    <input id="held" type="datetime-local" class="form-control form-control-sm d-inline-block w-auto ms-1" @bind="_heldAt" />
                                </div>
                            }
                            @if (CanEnd)
                            {
                                <div><button id="present-end" class="btn btn-primary mt-2" disabled="@_busy" @onclick="EndMeeting"><span class="bi bi-flag" aria-hidden="true"></span> End the meeting</button></div>
                                <div class="tide-present-help">Marks the brief and its articles presented and records the meeting time.</div>
                            }
                        }
                            @* Marked presented or sent from elsewhere while the meeting ran: it can still be ended. *@
                            @if (Presented && _view is not null && CanEnd)
                            {
                                <div><button class="btn btn-primary mt-2" disabled="@_busy" @onclick="EndMeeting"><span class="bi bi-flag" aria-hidden="true"></span> End the meeting</button></div>
                            }
                    </section>
                }
                @if (_slide > 0 && _slide < last)
                {
                    <p class="tide-present-rail-next"><span class="tide-present-rail-next-label">Up next</span> @SlideTitle(edition, _slide + 1)</p>
                }
                @if (_view is { } room && Presenting)
                {
                    @* Everyone's view, at the foot: the hands to lower, bringing everyone back, handing presenting on. *@
                    <section aria-labelledby="rail-hands-h">
                        <h3 id="rail-hands-h">Hands</h3>
                        @if (room.Hands.Count == 0)
                        {
                            <p class="tide-present-help">None up.</p>
                        }
                        else
                        {
                            @foreach (var h in room.Hands)
                            {
                                <div class="tide-present-rail-row" @key="h.UserId"><span class="tide-present-rail-grow">@h.Name</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Lower @h.Name's hand" @onclick="() => ClearHand(h.UserId)">Lower</button></div>
                            }
                            @if (room.Hands.Count > 1) { <button type="button" class="btn btn-sm btn-outline-secondary tide-hands-clear" @onclick="() => ClearHand(null)">Clear all</button> }
                        }
                    </section>
                    <section aria-labelledby="rail-view-h">
                        <h3 id="rail-view-h">Everyone's view</h3>
                        <div class="tide-present-rail-row tide-present-rail-wrap">
                            @if (room.People.Any(room.Away))
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="Summon">Bring everyone here</button>
                            }
                            @if (room.People.Any(p => p.CanPresent && !room.IsPresenter(p.UserId)))
                            {
                                <select class="form-select form-select-sm w-auto" aria-label="Hand presenting to" value="@(_handTo ?? "")" @key="HandOffResets" @onchange="ChooseHandOff">
                                    <option value="">Hand off to…</option>
                                    @foreach (var p in room.People.Where(p => p.CanPresent && !room.IsPresenter(p.UserId))) { <option value="@p.UserId">@p.Name</option> }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_handTo is null)" @onclick="ConfirmHandOff">Hand off</button>
                            }
                        </div>
                    </section>
                }
                </fieldset>
                <p class="tide-present-help tide-present-rail-foot">@(RehearsalAsked ? "A rehearsal: these controls do nothing here." : "Only on your page: never on a follower's.")</p>
            </aside>
        }

        <footer class="tide-present-bottom" inert="@RailOver">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_slide == 0 || Held)" @onclick="() => Move(_slide - 1)" aria-label="Previous slide"><span class="bi bi-chevron-left" aria-hidden="true"></span></button>
            <nav class="tide-progress" aria-label="Slides">
                @for (var i = 0; i <= last; i++)
                {
                    var n = i;
                    var shown = ArticleAt(edition, n)?.Article.Id;
                    var done = shown is { } d && ItemFor(d)?.Discussed == true;
                    var hand = shown is { } h && HandsOn(h).Count > 0;
                    var title = SlideTitle(edition, n);
                    <button class="@(n == _slide ? "current" : done ? "done" : "") @(hand ? "hand" : "")" title="@title"
                            aria-label="@(title + (done ? " (discussed)" : "") + (hand ? " (hand raised)" : ""))" disabled="@Held" aria-current="@(n == _slide ? "step" : null)" @onclick="() => Move(n)"><span class="tide-progress-name">@SlideName(edition, n)</span></button>
                }
            </nav>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_slide == last || Held)" @onclick="() => Move(_slide + 1)" aria-label="Next slide"><span class="bi bi-chevron-right" aria-hidden="true"></span></button>
            <span>@Elapsed</span>
            <span class="d-none d-md-inline"><span class="tide-kbd">&larr;</span> <span class="tide-kbd">&rarr;</span> move &middot; <span class="tide-kbd">Space</span> scroll, then next &middot; <span class="tide-kbd">F</span> full screen</span>
        </footer>

        @if (_showNotes && TeamEdition)
        {
            <div class="tide-present-notes">
                <div class="d-flex justify-content-between mb-1"><strong>Meeting notes</strong><button class="btn btn-sm btn-link p-0" @onclick="() => _showNotes = false">Close</button></div>
                <ol class="tide-note-list" aria-label="Notes so far">
                    @foreach (var n in _record.Notes)
                    {
                        <li @key="n.Id" data-submit-scope>
                            <div class="tide-note-meta">
                                <span class="tide-presence-dot tide-avatar-@Ui.AvatarSwatch(n.AuthorId)" aria-hidden="true">@MainLayout.Initials(n.AuthorName)</span>
                                <strong>@n.AuthorName</strong>
                                <span class="tide-note-time">@Ui.Time(Clock, n.AtUtc)</span>
                                @if (n.AuthorId == _me && _editingNote != n.Id)
                                {
                                    <span class="tide-note-tools">
                                        <button class="btn btn-sm btn-link p-0" @onclick="() => EditNote(n)">Edit</button>
                                        <button class="btn btn-sm btn-link p-0" disabled="@_busy" @onclick="() => DeleteNote(n)">Delete</button>
                                    </span>
                                }
                            </div>
                            @if (ArticleTitle(n.ArticleId) is { } on) { <div class="tide-note-on" title="@on">@on</div> }
                            @if (_editingNote == n.Id)
                            {
                                <textarea class="tide-autogrow tide-grow-3" aria-label="Edit the note" maxlength="@MeetingService.MaxNote" @bind="_editText" @bind:event="oninput"></textarea>
                                <div class="d-flex gap-2 mt-1">
                                    <button class="btn btn-sm btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_editText))" data-submit @onclick="SaveEdit">Save</button>
                                    <button class="btn btn-sm btn-link" @onclick="() => _editingNote = null">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <div class="tide-note-text">@n.Text</div>
                            }
                        </li>
                    }
                </ol>
                @if (_canNote)
                {
                    <div data-submit-scope>
                        <textarea class="tide-autogrow tide-grow-3" aria-label="New note" maxlength="@MeetingService.MaxNote" placeholder="@NotePlaceholder" @bind:get="_noteText" @bind:set="TypeNote" @bind:event="oninput"></textarea>
                        @if (NoteElsewhere is { } on) { <div class="tide-present-help">This note is on @on</div> }
                        <button class="btn btn-sm btn-primary mt-1" disabled="@(_busy || string.IsNullOrWhiteSpace(_noteText))" data-submit @onclick="AddNote">Add note</button>
                    </div>
                }
            </div>
        }

        @if (TeamEdition && _actionDetail is { } shownAction)
        {
            <PresentAction Detail="shownAction" Version="_actionVersion" Kicker="@Kicker(_ownAction)" CanClose="!Held" Autofocus="_focusAction"
                           OnClose="CloseAction" Changed="OnActionChanged" Links="_readsTeam" Beside="ActionBeside" Inert="RailOver" />
        }

        @if (CanEditTags && _tagEdit is { } editing)
        {
            <PresentTagEditor @key="editing" @ref="_tagEditor" ArticleId="editing" Title="@ArticleTitle(editing)" OnClose="CloseTags" />
        }
        @if (TeamEdition && _product is { } shownProduct)
        {
            <PresentProduct Card="shownProduct" Kicker="@Kicker(_popup.Own)" CanClose="!Held" Autofocus="_focusCard" OnClose="CloseCard" Links="_readsTeam" />
        }
        else if (ShownIndicators is { } shownIocs)
        {
            <PresentIndicators Article="shownIocs" Kicker="@Kicker(_popup.Own)" CanClose="!Held" Autofocus="_focusCard" OnClose="CloseCard" Links="_readsTeam" />
        }
        else if (ShownCves is { } shownCves)
        {
            <PresentCves Article="shownCves.Article" Cves="SlideCves.For(shownCves.Article.Cves.Select(c => c.CveId), _cves)" Kicker="@Kicker(_popup.Own)" CanClose="!Held" Autofocus="_focusCard" OnClose="CloseCard" Links="_readsTeam" />
        }

        @* Inside the slides' root, so it shows in full screen too; present.js leaves the keys to it while it's open. *@
        <ConfirmDialog @ref="_confirm" />
        <OverLimitDialog @ref="_overLimit" />
        @* A meeting note typed and not added: leaving present mode asks first. *@
        <UnsavedGuard Dirty="AsksBeforeLeaving" Message="@UnsavedMessage" Discard="DiscardUnsaved" />
        @* Learn to present, only in rehearsal: no meeting, nobody following, so nobody else ever sees it. Inside the slides'
           root, so it shows in full screen too; present.js leaves the keys to it while it's up (it's a .tide-modal). *@
        @if (Rehearsing && GuideStep is { } guideStep)
        {
            <GuideStepDialog Step="guideStep" Index="_guideAt" Count="_guide.Count" Name="@_guideName"
                             Skips="@(ForTheDay && _guideAt == 0)" OnSkip="BackToTheDay"
                             OnNext="GuideNext" OnBack="GuideBack" OnEnd="GuideEnd" />
        }
    </div>

    <Lightbox FileId="_zoom?.FileId" Caption="@_zoom?.Caption" OnClose="() => _zoom = null" />
}
</CascadingValue>

@code {
    [Parameter] public string? Day { get; set; }

    private DateOnly _date;
    private Brief? _brief;
    private Tide.Application.Metrics.MetricDay? _metrics;
    private ILookup<Guid, EditionAction>? _actions;
    private IReadOnlyDictionary<string, CveRecord> _cves = new Dictionary<string, CveRecord>();
    private IReadOnlyList<Team> _teams = [];
    private bool _canCreate;
    // The quick-add title per article, kept as it's typed: a follower's slide can move before the box loses focus, and
    // what was typed stays with the article it was typed for.
    private readonly Dictionary<Guid, string?> _qaTitles = [];
    private ActionKind _qaKind = ActionKind.IocSweep;
    private Guid _qaTeam;
    private DateOnly? _qaDue;
    private bool _loaded, _showNotes, _fullscreen, _busy;
    private int _slide;
    private Edition _edition = Edition.Team;
    private TlpLevel _publicMax = TlpLevel.Green, _teamMax = TlpLevel.AmberStrict;
    private bool _past;
    private DateTime? _heldAt;
    private readonly HashSet<Guid> _carry = [];
    private ArticleScreenshot? _zoom;
    private DotNetObjectReference<Present>? _ref;
    private readonly DateTimeOffset _startedAt = DateTimeOffset.UtcNow;
    private System.Threading.Timer? _clock;

    // The day last asked for: another one (the palette's "Present today's brief", or Back) starts from its own first
    // slide, with nothing of the last day's zoom, carried-over ticks or drafts.
    private string? _day;
    private bool _valid, _failed;

    protected override Task OnParametersSetAsync() => LoadDay();

    private async Task LoadDay()
    {
        var day = Day;
        if (day != _day)
        {
            _day = day;
            (_brief, _loaded, _failed, _slide, _zoom, _actions, _record) = (null, false, false, 0, null, null, MeetingRecord.None);
            LeaveMeeting();
            (_noteText, _noteOn, _addName, _editText, _editingNote, _showNotes) = (null, null, null, null, null, false);
            (_actionDetail, _ownAction, _sharedSeen) = (null, false, null);
            DropCard(forget: true);
            _seen.Clear();
            _follow = [];
            _carry.Clear();
            _drafts.Clear();
        }
        _valid = Ui.TryParseDay(day, out var date);
        if (!_valid) { _loaded = true; return; }
        _date = date;
        // A rehearsal asked for by someone who can't present, or of a day other than today's brief: refused before anything is
        // read or joined.
        if (RehearsalAsked && (!CanRehearse || !OfToday)) { _loaded = true; return; }
        if (_visitor && !TakeVisitorSeat())
        {
            // Nothing of the team's is theirs without a seat: loading until the page is live, then "no meeting on now".
            _loaded = _interactive;
            return;
        }
        // The first interactive draw starts from the slides the prerender read, so a reload doesn't flash "Loading" over
        // them; they're read again below, quietly, only if something was saved in between, and the meeting is joined
        // once the page is live, as ever.
        var fresh = false;
        if (Handoff.Take<Present>(RendererInfo, PrerenderedState, out var current) is { } prerendered && prerendered._day == day)
        {
            Adopt(prerendered);
            fresh = current;
        }
        try
        {
            if (!fresh) await ReadDay(day, date);
            if (Day != day) return;
            Seen();   // the notes there already aren't news
            _qaTeam = _teams.FirstOrDefault()?.Id ?? Guid.Empty;
            _follow = Followed();
            _past = BriefSvc.IsPast(_date);
            _heldAt = Clock.MeetingStart(_date).DateTime;
            _slide = Math.Min(_slide, LastSlide);
            _failed = false;
            _view = Meetings.Get(_date);
            PrerenderedState = Handoff.Keep(RendererInfo, this, PrerenderedState);
            if (_interactive) await JoinIfLive();
        }
        catch (Exception ex)
        {
            // A failed read leaves the slides already shown (or says nothing could be shown), rather than ending the circuit.
            if (Day != day) return;
            _failed = _brief is null;
            Toasts.Error(UserFacingError.For(ex));
        }
        _loaded = true;
        StartGuide();
    }

    // Reads the day in full before anything is shown: dropped if the address moved on meanwhile.
    private async Task ReadDay(string? day, DateOnly date)
    {
        var (publicMax, teamMax) = await Distribution.GetAsync();
        var brief = await BriefSvc.GetAsync(date);
        var metrics = brief is null ? null : await MetricsSvc.GetDayAsync(date);
        var open = brief is null ? OpenActionsReview.None : await ActionSvc.MeetingActionsAsync(date, teamMax);
        var canCreate = CurrentUser.Has(Permission.WriteArticles);
        var canPresent = CurrentUser.Has(Permission.PresentBriefs);
        var (canWork, canNote) = (CurrentUser.Has(Permission.WorkActions), MeetingSvc.CanNote);
        var record = brief is null ? MeetingRecord.None : await MeetingSvc.GetAsync(brief.Id);
        // Internal teams only: the meeting raises work for the security team's own teams, and an external team's part is
        // split off an action afterwards (QuickAddAsync refuses one).
        var teams = _readsTeam ? (await TeamSvc.ListAsync()).Where(t => !t.IsExternal).ToList() : [];
        var teamsByKind = canCreate ? await ActionSvc.TeamsByKindAsync() : new Dictionary<ActionKind, Guid>();
        var actions = brief is null ? null : await BriefSvc.EditionActionsAsync(brief);
        var cves = brief is null ? new Dictionary<string, CveRecord>() : await CvesOf(brief);
        var stack = await StackOf(brief);
        if (Day != day) return;
        DayRead = (publicMax, teamMax, brief, metrics, open, canCreate, teams, teamsByKind, actions, cves, canPresent, record, stack, canWork, canNote);
    }

    // What a read of the day sets, as one: the read and Adopt both go through it, so neither can miss a part.
    private (TlpLevel PublicMax, TlpLevel TeamMax, Brief? Brief, Tide.Application.Metrics.MetricDay? Metrics, OpenActionsReview Open, bool CanCreate,
        IReadOnlyList<Team> Teams, IReadOnlyDictionary<ActionKind, Guid> TeamsByKind, ILookup<Guid, EditionAction>? Actions,
        IReadOnlyDictionary<string, CveRecord> Cves, bool CanPresent, MeetingRecord Record, IReadOnlyDictionary<Guid, IReadOnlyList<StackProduct>> StackOf,
        bool CanWork, bool CanNote) DayRead
    {
        get => (_publicMax, _teamMax, _brief, _metrics, _open, _canCreate, _teams, _teamsByKind, _actions, _cves, _canPresent, _record, _stackOf, _canWork, _canNote);
        set => (_publicMax, _teamMax, _brief, _metrics, _open, _canCreate, _teams, _teamsByKind, _actions, _cves, _canPresent, _record, _stackOf, _canWork, _canNote) = value;
    }

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
    public string? PrerenderedState { get; set; }

    // Takes what the prerendered page read, so the first interactive draw is the prerendered page again. Not its seat,
    // view of the meeting or live subscriptions: those were the prerender's, and it's gone. The meeting as it is now is
    // read here instead, so a follower sees the slides rather than "No meeting going on" until the page is live.
    private void Adopt(Present p)
    {
        DayRead = p.DayRead;
        (_qaTeam, _past, _heldAt) = (p._qaTeam, p._past, p._heldAt);
        Seen();
        Refresh();
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // An analyst's day asked for a rehearsal while the meeting is live: present mode refuses it, and the day goes on
        // at Send, saying why.
        if (ForTheDay && !_backToTheDay && _brief is not null && _view is not null)
        {
            _backToTheDay = true;
            Nav.NavigateTo(Nav.BaseUri + BackToTheDayFrom(live: true));
        }
        await (_handsPopout ??= new Popout(JS, HandsListDismissed)).FollowAsync(HandsListOpen, _handsHolder, _handsButton);
        await FocusOnSlideAsync();
        if (_moveRailFocus)
        {
            var to = RailOpen ? _railBox : _railToggle;
            _moveRailFocus = false;
            await to.TryFocusAsync(orGone: true);
        }
        else if (_railDrawn && !RailOpen)
        {
            // The rail went with focus in it (closed docked, handed off, taken over): focus doesn't drop to the body.
            try { await JS.InvokeVoidAsync("tidePresent.refocus"); }
            catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException) { /* the tab has gone, or not interactive */ }
        }
        _railDrawn = RailOpen;
        if (_focusOpener)
        {
            _focusOpener = false;
            try { await JS.InvokeVoidAsync("tidePresent.backToOpener"); }
            catch (JSDisconnectedException) { /* the tab has gone */ }
        }
        if (_focusEditTags)
        {
            // The tag panel closed: focus goes back to the button that opened it.
            _focusEditTags = false;
            await _editTagsButton.TryFocusAsync(orGone: true);
        }
        if (_focusQuickAdd && !_busy)
        {
            _focusQuickAdd = false;
            await _quickAddButton.TryFocusAsync(orGone: true);
        }
        if (_focusQuickAddTitle)
        {
            _focusQuickAddTitle = false;   // Another action opened it: the title is what's typed first
            await _quickAddTitleBox.TryFocusAsync(orGone: true);
        }
        if (_focusEnd)
        {
            // The top bar's End brought the wrap-up forward: focus goes to its choices in the rail, read from their heading.
            _focusEnd = false;
            await _endHeading.TryFocusAsync(orGone: true);
        }
        await CatchUpScrollAsync();
        // Back on the actions that need review (however this page came to it: a key, following, a reload): its rows are
        // read again, so what changed while it was off screen shows.
        var key = _brief is null ? null : SlideKey(_slide);
        if (key == "open" && _drawnKey is not null && _drawnKey != "open") _ = InvokeAsync(RereadReview);
        _drawnKey = key;
        if (!firstRender) return;
        // The elapsed time in the footer ticks once a minute. Started before the await below, so a page closed during it
        // still stops the clock when it's disposed.
        _clock = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
        _ref = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("tidePresent.start", _ref); }
        catch (JSDisconnectedException) { }
        // Joined once the page is live, not while it's prerendered: a prerendered page would sit in the meeting unseen.
        await GoLive();
        StateHasChanged();
    }

    /// <summary>The page is live, not prerendered: it joins the day's meeting if one's on. A Visitor takes a seat in it
    /// only now, and then reads the slides.</summary>
    internal async Task GoLive()
    {
        _interactive = true;
        if (_visitor) await LoadDay();
        else await JoinIfLive();
    }

    private string Elapsed => $"{(int)(DateTimeOffset.UtcNow - (_view?.StartedAtUtc ?? _startedAt)).TotalMinutes} min";

    private BriefItem? ItemFor(Guid articleId) => _brief?.Items.FirstOrDefault(i => i.ArticleId == articleId);

    // The edition's articles nobody ticked off, in running order.
    private List<BriefItem> Undiscussed(BriefEdition edition) =>
        edition.Articles.Select(x => ItemFor(x.Article.Id)).OfType<BriefItem>().Where(i => !i.Discussed).ToList();

    internal void Carry(Guid articleId, bool on)
    {
        if (!InCharge) return;
        if (on) _carry.Add(articleId);
        else _carry.Remove(articleId);
    }

    private string SlideTitle(BriefEdition e, int n) => SlideLabel(e, n, shortName: false);

    /// <summary>A slide's name in the footer: short, the whole title in the button's own.</summary>
    private string SlideName(BriefEdition e, int n) => SlideLabel(e, n, shortName: true);

    private string SlideLabel(BriefEdition e, int n, bool shortName)
    {
        if (n == 0) return "Title";
        if (n <= NoteSlides) return "Opening note";
        if (n <= NoteSlides + MetricsSlides)
        {
            var group = MetricPlan[n - 1 - NoteSlides].Group?.Group.Name;
            return shortName ? group ?? "Numbers" : "Numbers: " + (group ?? "all 0");
        }
        if (OpenSlides == 1 && n == OpenAt) return ReviewTitle;
        return ArticleAt(e, n) is not { } x ? "Wrap-up"
            : shortName ? $"{n - LeadSlides} · {FirstWords(x.Article.Title, 2)}" : $"{n - LeadSlides}. {x.Article.Title}";
    }

    // A title's first words ("Edge VPN" of "Edge VPN appliance zero-day…"), for a name the footer has room for.
    private static string FirstWords(string title, int n) => string.Join(' ', title.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(n));

    // The article on slide n of the edition, if slide n is an article's.
    private EditionArticle? ArticleAt(BriefEdition e, int n)
    {
        var i = n - 1 - LeadSlides;
        return n > LeadSlides && i < e.Articles.Count ? e.Articles[i] : null;
    }

    private bool TeamEdition => _edition == Edition.Team;

    // Already presented, or sent: the meeting has nothing left to mark.
    private bool Presented => _brief?.Status is BriefStatus.Presented or BriefStatus.Sent;

    // The edition shown: what its ceiling allows, and (team edition only) the indicators and actions. Slides render only
    // what this carries, so the company-wide edition can't show the team's actions or indicators (ADR 0005). The team
    // edition's marking counts the overdue actions its slide shows.
    // Cut again only when what it's cut from changes: a render asks for it once per slide count and slide key. Each input
    // is replaced, not changed in place, when it's read again (a discussed tick, changed in place, isn't in the cut).
    private BriefEdition Cut(Brief brief)
    {
        if (_cut is not { } c || !ReferenceEquals(c.Brief, brief) || c.Edition != _edition || c.PublicMax != _publicMax
            || c.TeamMax != _teamMax || !ReferenceEquals(c.Actions, _actions) || !ReferenceEquals(c.Open, _open))
        {
            var edition = _edition == Edition.Public
                ? BriefEditions.Build(brief, _edition, _publicMax)
                : BriefEditions.Build(brief, _edition, _teamMax, _actions) with { Open = _open };
            _cut = c = new CutOf(brief, _edition, _publicMax, _teamMax, _actions, _open, edition);
        }
        return c.Result;
    }
    private sealed record CutOf(Brief Brief, Edition Edition, TlpLevel PublicMax, TlpLevel TeamMax,
        ILookup<Guid, EditionAction>? Actions, OpenActionsReview Open, BriefEdition Result);
    private CutOf? _cut;

    // The metric slides follow the title slide on the team edition when any metric is defined, one per group (all-0
    // groups folded into a line on the first: MetricSlides); never on the public one.
    private int MetricsSlides => TeamEdition ? MetricPlan.Count : 0;

    // Cut again only when the numbers are read again.
    private IReadOnlyList<Tide.Application.Metrics.MetricSlide> MetricPlan
    {
        get
        {
            if (!ReferenceEquals(_planOf, _metrics)) (_plan, _planOf) = (Tide.Application.Metrics.MetricSlides.Plan(_metrics), _metrics);
            return _plan;
        }
    }
    private IReadOnlyList<Tide.Application.Metrics.MetricSlide> _plan = [];
    private Tide.Application.Metrics.MetricDay? _planOf;

    // The actions that need review (overdue, escalated, or gone too long without an update: ActionService.MeetingActionsAsync)
    // come after the articles, just before the wrap-up, on the team edition when there are any; never on the public one.
    private OpenActionsReview _open = OpenActionsReview.None;
    private int OpenSlides => TeamEdition && _open.Any ? 1 : 0;

    /// <summary>The open actions slide's title, wherever it's named.</summary>
    internal const string ReviewTitle = "Actions that need review";

    // The team's opening note has a slide of its own straight after the title, before the numbers: on the team edition,
    // when the note isn't blank (the edition carries it only then). Switching editions, or a colleague clearing the note,
    // takes it away; the slide shown stays on screen by its key.
    private int NoteSlides => _brief is { } b && Cut(b).ShowTeamNote ? 1 : 0;

    /// <summary>The opening note's slide key.</summary>
    internal const string NoteKey = "note";

    /// <summary>The slides before the first article: the opening note, then the numbers.</summary>
    private int LeadSlides => NoteSlides + MetricsSlides;

    /// <summary>The actions that need review's slide, after the articles (when there's one: <see cref="OpenSlides"/>).</summary>
    private int OpenAt => _brief is null ? 0 : LeadSlides + Cut(_brief).Articles.Count + 1;

    private int LastSlide => _brief is null ? 0 : Cut(_brief).Articles.Count + LeadSlides + OpenSlides + 1;

    private void Go(int n)
    {
        if (Held) return;   // the presenter has everyone on their slide
        if (Pinned) return;   // it stays under the panel open over it
        var to = Math.Clamp(n, 0, LastSlide);
        if (to != _slide)
        {
            // An action or a product's card open over the slide was that slide's; back on the presenter's, theirs shows again.
            DropAction();
            _sharedSeen = null;
            DropCard(forget: true);
        }
        _slide = to;
        _dueTyped.Clear();
        if (_seat is null) return;
        // Someone following who moves off the presenter's slide stops following; moving back onto it follows again.
        if (!Presenting) _following = _view is not { } live || SlideFor(live) == _slide;
        _seat.At(_slide, _following, SlideKey(_slide));
        Refresh();
    }

    // A move from a button: as Go, and a follower back on the presenter's slide sees what they have open.
    private async Task Move(int n)
    {
        Go(n);
        await SyncAction();
    }

    internal void SetEdition(ChangeEventArgs e)
    {
        // The slide shown stays on screen by its key: the other edition has no note, numbers or open actions slides, so
        // the article being shown is at another number there (and the note's slide gives way to the title).
        var shown = SlideKey(_slide);
        if (Enum.TryParse<Edition>(e.Value?.ToString(), out var ed)) _edition = ed;
        if (!TeamEdition)
        {
            (_showNotes, _actionDetail, _tagEdit) = (false, null, null);   // the meeting notes are the team's, like its actions
            DropCard(forget: true);   // and Our stack's notes, internal to it
        }
        _slide = SlideNamed(shown) ?? Math.Min(_slide, LastSlide);
    }

    private async Task ToggleFullscreen()
    {
        try { await JS.InvokeVoidAsync("tidePresent.toggleFullscreen"); }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task OnPresentKey(string action)
    {
        // The tag panel open over the slide: Esc cancels it, and the slide behind it stays put.
        if (Pinned && action != "render")
        {
            if (action == "close" && _tagEditor is not null) await _tagEditor.Escape();
            StateHasChanged();
            return;
        }
        switch (action)
        {
            case "next": Go(_slide + 1); break;
            case "prev": Go(_slide - 1); break;
            case "first": Go(0); break;
            case "last": Go(LastSlide); break;
            case "rail":
                ToggleRail();
                break;
            case "close":
                if (_handsOpen) _handsOpen = false;
                else if (RailOpen && !_railRoom) ToggleRail();   // the rail over the slide closes first
                else if (_zoom is not null) _zoom = null;
                else if (CardOpen) await CloseCard();
                else await CloseAction();
                break;
            case "discussed":
                if (_brief is null || !InCharge) break;   // no brief for the day, or not theirs to tick
                if (ShownArticle() is { } shown && ItemFor(shown) is { } item) await ToggleDiscussed(item);
                break;
        }
        if (action is "next" or "prev" or "first" or "last") await SyncAction();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnFullscreenChanged(bool on)
    {
        _fullscreen = on;
        StateHasChanged();
    }

    internal async Task ToggleDiscussed(BriefItem item)
    {
        if (!InCharge) return;
        try
        {
            await BriefSvc.SetDiscussedAsync(item.Id, !item.Discussed);
            item.Discussed = !item.Discussed;
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    // A colleague's save to this brief or an article on it (a late edit, a discussed tick, an action), or to the day's
    // numbers (the opening slide), shows on the slides as it lands. The slide being shown stays on screen, and unsaved meeting notes stay as typed.
    private LiveChanges? _live;
    private volatile HashSet<string> _follow = [];

    protected override void OnInitialized()
    {
        _live = new LiveChanges(Feed, Origin, c => _follow.Contains(c.Topic), InvokeAsync, OnChangedElsewhere, time: Time);
        (_me, _meName) = (CurrentUser.UserId, CurrentUser.DisplayName);
        _visitor = MeetingAccess.MeetingOnly(CurrentUser);
        _readsTeam = CurrentUser.Has(Permission.ReadTeamEdition);
        _writesBriefs = CurrentUser.Has(Permission.WriteArticles);
        Meetings.Changed += OnMeetingChanged;
        Meetings.Scrolled += OnMeetingScrolled;
        Clock.Changed += OnOrgChanged;
    }

    private HashSet<string> Followed()
    {
        var topics = BriefPage.Follow(_brief, _date);
        if (_brief is not null) topics.Add(ChangeFeed.Meeting(_brief.Id));
        topics.Add(ChangeFeed.MetricsDay(_date));
        topics.Add(ChangeFeed.Metrics);
        topics.Add(ChangeFeed.Actions);
        if (_actionDetail is { } open) topics.Add(ChangeFeed.Action(open.Action.Id));
        // An article's products tagged or untagged: its chips.
        foreach (var item in _brief?.Items ?? []) topics.Add(ChangeFeed.ArticleTags(item.ArticleId));
        // A product edited or retired on Our stack: its chips, and its card if it's open.
        topics.Add(ChangeFeed.Stack);
        return topics;
    }

    internal async Task OnChangedElsewhere(IReadOnlyList<Change> changes)
    {
        if (_brief is null) return;
        // A change to the action open over the slide: it's re-read in place.
        var actionTopic = _actionDetail is { } open ? ChangeFeed.Action(open.Action.Id) : null;
        if (actionTopic is not null && changes.Any(c => c.Topic == actionTopic)) await ReloadAction();
        // A product tagged or untagged on one of the articles, or edited or retired on Our stack: its chips (and its
        // card, if it's the one open), without a toast.
        if (changes.Any(IsTags))
        {
            _stackOf = await StackOf(_brief);
            if (_product is not null && changes.Any(c => c.Topic == ChangeFeed.Stack)) await LoadCard();
            changes = changes.Where(c => !IsTags(c)).ToList();
            if (changes.Count == 0)
            {
                StateHasChanged();
                return;
            }
        }
        // A colleague's action save: the slides' action lists and the open ones only, without a toast (a due date being
        // typed stays as typed). Someone joined, or took a note: the record only, also without one (notes come thick and fast).
        var others = changes.Where(c => !ChangeFeed.IsAction(c)).ToList();
        if (others.All(c => c.Topic == ChangeFeed.Meeting(_brief.Id)))
        {
            if (others.Count < changes.Count) await ReloadActionLists();
            if (others.Count > 0) await ReloadRecord();
            StateHasChanged();
            return;
        }
        changes = others;
        var shown = SlideKey(_slide);
        var brief = await BriefSvc.GetAsync(_date);
        if (brief is null) return;
        // Only an article's ATT&CK techniques or scorecard tags changed (present mode's tag panel, or the editor): the
        // chips update quietly, as a product tag's do, and nothing else the slides show is read again.
        var tagsOnly = SlideTags.OnlyTagsChanged(_brief, brief, changes);
        NoteHeard(brief, changes);
        _brief = brief;
        _follow = Followed();
        if (!tagsOnly)
        {
            _metrics = await MetricsSvc.GetDayAsync(_date);
            _open = await ActionSvc.MeetingActionsAsync(_date, _teamMax);
            await LoadActions();
            _cves = await CvesOf(_brief);
            _stackOf = await StackOf(_brief);
            if (changes.Any(c => c.Topic == ChangeFeed.Meeting(_brief.Id))) await ReloadRecord();
        }
        Reslide(SlideNamed(shown) ?? Math.Min(_slide, LastSlide), shown);
        await SyncAction();
        if (tagsOnly)
        {
            StateHasChanged();
            return;
        }
        var numbers = changes.All(c => ChangeFeed.IsMetricsOf(c, _date));
        Toasts.Show($"{LiveChanges.Who(changes)} updated {(numbers ? "the numbers" : "this brief")}.");
        StateHasChanged();
    }

    // The actions the slides list (each article's, the wrap-up's) and the ones still open from earlier briefs. The slide
    // shown stays on screen, though the open actions' slide may have come or gone before it.
    private async Task ReloadActionLists()
    {
        var shown = SlideKey(_slide);
        _open = await ActionSvc.MeetingActionsAsync(_date, _teamMax);
        await LoadActions();
        var at = SlideNamed(shown) ?? Math.Min(_slide, LastSlide);
        if (at == _slide && SlideKey(at) == shown && !Behind) return;
        Reslide(at, shown);
        await SyncAction();
    }

    // After a reload, to slide n, where the slide that was shown (called shown) now is, or what took its place. The
    // running order moved: the others go where this page went. Something open over a slide that's gone goes with it.
    // Someone following goes to the presenter's slide: one this page couldn't name before it read the brief again (an
    // article just added, a group whose numbers just came in) had it land elsewhere, and it'd stay there, still
    // "following". Its seat says where it is now, so the presenter's view of who's where isn't a renumbering behind.
    private void Reslide(int n, string shown)
    {
        if (!Presenting && _seat is not null && _following && !Pinned && _view is { } live) n = SlideFor(live);
        _slide = n;
        if (SlideKey(_slide) != shown)
        {
            DropAction();
            _sharedSeen = null;
            DropCard(forget: true);
        }
        if (Presenting) _seat!.At(_slide, key: SlideKey(_slide));
        else _seat?.At(_slide, _following, SlideKey(_slide));
    }

    // Following the presenter, but not on their slide as this page now numbers it.
    private bool Behind => !Presenting && _seat is not null && _following && _view is { } live && SlideFor(live) != _slide;

    // The article on the slide being shown, if it's an article's slide, so a reload keeps it on screen.
    private Guid? ShownArticle() => ArticleAt(Cut(_brief!), _slide)?.Article.Id;

    // What slide n is, as every page names it alike ("note", "metrics:{group key}", "article:{id}", "wrap"), however many lead slides each has loaded.
    private string SlideKey(int n) =>
        _brief is null ? ""
        : n == 0 ? "title" : n <= NoteSlides ? NoteKey
        : n <= LeadSlides ? MetricPlan[n - 1 - NoteSlides].Key
        : ArticleAt(Cut(_brief), n) is { } x ? ArticleKey(x.Article.Id) : OpenSlides == 1 && n == OpenAt ? "open" : "wrap";

    // An article's slide key.
    private static string ArticleKey(Guid articleId) => "article:" + articleId;

    // This page's number for the slide the meeting is on: by its name, else by its number.
    private int SlideFor(LiveMeetingView live) => Math.Clamp(SlideNamed(live.SlideKey) ?? live.Slide, 0, LastSlide);

    // The slide called key on this page, if it has it.
    private int? SlideNamed(string? key) => (key ?? "") switch
    {
        "title" => 0,
        // The note's slide, or the title when this page has none (the note was cleared, or this is the company-wide edition).
        NoteKey => NoteSlides,
        var k when MetricsSlides > 0 && Tide.Application.Metrics.MetricSlides.IndexOf(MetricPlan, k) is { } at => at + 1 + NoteSlides,
        "open" when OpenSlides > 0 => OpenAt,
        // A numbers or open actions slide this page doesn't have (the company-wide edition, or none left): the slide
        // in its place (the first article; the wrap-up), rather than whichever slide has its number.
        "open" => LastSlide,
        var k when k == Tide.Application.Metrics.MetricSlides.Key || k.StartsWith(Tide.Application.Metrics.MetricSlides.KeyPrefix, StringComparison.Ordinal)
            => Math.Min(NoteSlides + 1, LastSlide),
        "wrap" => LastSlide,
        var k when k.StartsWith("article:", StringComparison.Ordinal) => SlideOf(k),
        _ => null,
    };

    // The article slide called key, if this edition shows that article.
    private int? SlideOf(string key)
    {
        var edition = Cut(_brief!);
        for (var i = 0; i < edition.Articles.Count; i++)
            if (ArticleKey(edition.Articles[i].Article.Id) == key) return i + 1 + LeadSlides;
        return null;
    }

    // The CVE records for the brief's articles, for their chips.
    private Task<IReadOnlyDictionary<string, CveRecord>> CvesOf(Brief brief) =>
        CveSvc.GetAsync(brief.Items.SelectMany(i => i.Article?.Cves.Select(c => c.CveId) ?? []));

    private async Task LoadActions()
    {
        if (_brief is null) return;
        _actions = await BriefSvc.EditionActionsAsync(_brief);
    }

    // A team that warns at its limit asks why first (OverLimitDialog), as the action page's create does.
    private OverLimitDialog _overLimit = default!;

    /// <summary>For tests: the dialog asking why an action goes over its team's limit.</summary>
    internal OverLimitDialog OverLimit => _overLimit;

    // The day an action raised here is raised for: the brief's once its day has gone, asked as it's raised rather than as
    // the page opened, so a meeting run past midnight raises its actions for its own day; today's, by leaving it out.
    private DateOnly? RaisedFor => BriefSvc.IsPast(_date) ? _date : null;

    /// <summary>The quick-add title typed for an article's slide, not yet added.</summary>
    internal string? QuickAddTitle(Guid articleId) => _qaTitles.GetValueOrDefault(articleId);

    // The recommended lines whose kind and team chip is open for editing, by article and line; the quick add's own chip,
    // and the articles whose quick add is open (one typed in stays open, as it would be left).
    private readonly HashSet<(Guid Article, string Line)> _chipsOpen = [];
    private readonly HashSet<Guid> _quickAddsOpen = [];
    private bool _qaChipOpen, _focusQuickAddTitle;
    private ElementReference _quickAddTitleBox;

    /// <summary>Opens a recommended line's kind and team chip into its two lists, or shuts it again.</summary>
    internal void EditRaiseChip(Guid articleId, string line)
    {
        if (!_chipsOpen.Remove((articleId, line))) _chipsOpen.Add((articleId, line));
    }

    /// <summary>Whether the article's quick add is open: opened, or with a title typed in it.</summary>
    private bool QuickAddOpen(Guid articleId) => _quickAddsOpen.Contains(articleId) || !string.IsNullOrEmpty(QuickAddTitle(articleId));

    /// <summary>Another action: opens the article's quick add, its title box taking focus.</summary>
    internal void OpenQuickAdd(Guid articleId)
    {
        _quickAddsOpen.Add(articleId);
        _focusQuickAddTitle = true;
    }

    // A kind and team, as a chip ("Threat hunt · Identity & Access ✎"); pressed, it opens or shuts the lists that change them.
    private RenderFragment KindTeamChip(string label, ActionKind kind, Guid team, bool open, Action toggle) =>
        @<button type="button" class="tide-present-rail-chip" aria-label="@label" aria-expanded="@Ui.Aria(open)" @onclick="toggle">
            <span>@ActionService.KindName(kind) &middot; @(_teams.FirstOrDefault(t => t.Id == team)?.Name ?? "no team")</span>
            <span class="bi @(open ? "bi-check2" : "bi-pencil")" aria-hidden="true"></span>
        </button>;

    /// <summary>The quick-add box, as typed (each keystroke).</summary>
    internal void TypeQuickAddTitle(Guid articleId, string? title) => _qaTitles[articleId] = title;

    internal Task QuickAdd(Guid articleId) => Run(async () =>
    {
        if (!InCharge) return;
        var number = 0;
        if (!await _overLimit.RunAsync(async reason =>
                number = await ActionSvc.QuickAddAsync(articleId, QuickAddTitle(articleId) ?? "", _qaKind, _qaTeam, _qaDue, RaisedFor, reason)))
        {
            _focusQuickAdd = true;   // the over-limit question cancelled: back to Add, which was disabled while it asked
            return;
        }
        _qaTitles.Remove(articleId);
        _quickAddsOpen.Remove(articleId);   // added: back to Another action
        _qaChipOpen = false;
        _qaDue = null;
        await LoadActions();
        Toasts.Show($"{Ui.ActionLabel(number)} added and assigned to you.");
    });

    // --- the recommended lines, raised one at a time ------------------------------------------------------------

    /// <summary>What a recommended line will be raised as: a kind guessed from its wording, and that kind's usual team.</summary>
    private sealed class RaiseDraft
    {
        public ActionKind Kind { get; set; }
        public Guid Team { get; set; }
    }

    private readonly Dictionary<(Guid Article, string Line), RaiseDraft> _drafts = [];
    private IReadOnlyDictionary<ActionKind, Guid> _teamsByKind = new Dictionary<ActionKind, Guid>();
    private bool _raising;
    private ConfirmDialog _confirm = default!;
    private ElementReference _endHeading;
    private bool _focusEnd, _focusQuickAdd;

    /// <summary>For tests: focus goes back to the rail's Add once the page is drawn (the over-limit question cancelled).</summary>
    internal bool FocusingQuickAdd => _focusQuickAdd;
    private ElementReference _quickAddButton;

    private RaiseDraft LineDraft(Guid articleId, string line)
    {
        if (_drafts.TryGetValue((articleId, line), out var d)) return d;
        var kind = RecommendedActions.GuessKind(line);
        return _drafts[(articleId, line)] = new RaiseDraft { Kind = kind, Team = TeamFor(kind) };
    }

    // The team that last took this kind of action, if it's still offered; otherwise the default.
    private Guid TeamFor(ActionKind kind) =>
        _teamsByKind.TryGetValue(kind, out var team) && _teams.Any(t => t.Id == team) ? team : _qaTeam;

    private void SetLineKind(RaiseDraft draft, ChangeEventArgs e)
    {
        if (!Enum.TryParse<ActionKind>(e.Value?.ToString(), out var kind)) return;
        draft.Kind = kind;
        draft.Team = TeamFor(kind);
    }

    /// <summary>Whether this page can raise actions in the meeting: someone who may create them, with a team to give them.</summary>
    private bool CanRaise => _canCreate && _teams.Count > 0;

    // The edition article's recommended lines no action was raised from.
    private static IReadOnlyList<string> Unraised(EditionArticle x) => RecommendedActions.Unraised(x.Article.RecommendedActions, x.Actions, r => r.Recommendation);

    /// <summary>Raises a recommended line as its draft (kind, team) has it.</summary>
    internal Task Raise(Guid articleId, string line) => Raise(articleId, line, LineDraft(articleId, line));

    private async Task Raise(Guid articleId, string line, RaiseDraft draft)
    {
        if (_raising || !InCharge) return;   // a second click while the first is saving would raise it twice
        _raising = true;
        try
        {
            var number = 0;
            if (!await _overLimit.RunAsync(async reason =>
                    number = await ActionSvc.QuickAddAsync(articleId, line, draft.Kind, draft.Team, null, RaisedFor, reason, recommendation: line))) return;
            await LoadActions();
            Toasts.Show($"{Ui.ActionLabel(number)} raised and assigned to you.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _raising = false; }
    }

    // One step at a time: a second click while one runs (a double-click on Add or End) does nothing, so it can't add the
    // action twice or end the meeting twice. The buttons are disabled meanwhile. A rehearsal runs none: it changes nothing.
    private async Task Run(Func<Task> step)
    {
        if (_busy || RehearsalAsked) return;
        _busy = true;
        try { await step(); }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // The top bar's End: a past day's meeting needs its time chosen, and articles not ticked off need a decision, which
    // the wrap-up's rail asks for; otherwise it asks first.
    // On the wrap-up slide with the rail open its choices are on screen, so the top bar's End ends the meeting as the
    // rail's does. With the rail shut (a window too narrow to dock it), End opens it on those choices first: a meeting is
    // never ended past choices no one could see.
    internal async Task EndFromTop()
    {
        if (RehearsalAsked) return;   // nothing ends in a rehearsal
        var needsWrapUp = _past || Undiscussed(Cut(_brief!)).Count > 0;
        if (needsWrapUp && _slide == LastSlide && RailOpen)
        {
            await EndMeeting();
            return;
        }
        if (needsWrapUp)
        {
            Go(LastSlide);
            if (_slide != LastSlide) return;
            if (!RailOpen && Rail) _railToggled = !_railToggled;
            _focusEnd = true;
            return;
        }
        if (await _confirm.Ask("End the meeting now?", "The brief and its articles are marked presented.", "End the meeting", danger: false)) await EndMeeting();
    }

    internal Task EndMeeting() => Run(async () =>
    {
        // A past day's meeting is recorded at the time chosen (that day's meeting time unless changed); today's, now, even
        // once it has run past midnight (left to the service, a day gone by then would be put at that day's meeting time).
        DateTimeOffset? held = !_past ? Clock.Now : _heldAt is { } h ? new DateTimeOffset(h, Clock.Zone.GetUtcOffset(h)) : null;
        var carry = Undiscussed(Cut(_brief!)).Select(i => i.ArticleId).Where(_carry.Contains).ToList();
        // Not this page's to end any more (the presenter came back from a drop): nothing is marked.
        Refresh();
        if (!CanEnd)
        {
            Toasts.Error($"{_view?.PresenterName} is presenting again: it's theirs to end.");
            return;
        }
        var seat = _seat;
        // Already presented or sent from the brief page while the meeting ran: only the live meeting is left to end.
        var already = Presented;
        // What's saved decides, not this page's copy, which may not have heard yet that the brief was put back to ready
        // (or marked presented) a moment ago: ending on it would leave a reopened brief unmarked, or carry articles from
        // one already presented. The wrap-up is shown as it is now, to be ended from again.
        if (await BriefSvc.GetAsync(_date) is { } saved && saved.Id == _brief!.Id && (saved.Status is BriefStatus.Presented or BriefStatus.Sent) != already)
        {
            var shown = SlideKey(_slide);
            _brief = saved;
            _follow = Followed();
            Reslide(SlideNamed(shown) ?? Math.Min(_slide, LastSlide), shown);
            Toasts.Error(already ? "The brief was put back to ready a moment ago. Check the wrap-up, then end the meeting."
                : "The brief was marked presented a moment ago. Check the wrap-up, then end the meeting.");
            return;
        }
        DateOnly? carriedTo = null;
        try
        {
            if (!already) carriedTo = await BriefSvc.MarkPresentedAsync(_brief!.Id, held, carry: carry);
        }
        catch (KeyNotFoundException)
        {
            await EndLive(seat);   // the brief is gone: so is its meeting
            throw;
        }
        await EndLive(seat);
        Toasts.Show(already ? "The meeting has ended."
            : carriedTo is { } next ? $"Marked as presented. {carry.Count} article{(carry.Count == 1 ? "" : "s")} carried to {Ui.Day(next)}."
            : "Marked as presented.");
        Nav.NavigateTo(Ui.BriefUrl(_date));
    });

    // The meeting stops being live (everyone in it lands on the wrap-up), and who was there until when is kept. A seat the
    // meeting wouldn't end for (the presenter came back meanwhile) is left, so it doesn't outlive the page.
    private async Task EndLive(IMeetingSeat? seat)
    {
        if (seat is null) return;
        if (_seat == seat) _seat = null;
        if (Meetings.End(seat) is not { } left)
        {
            seat.Dispose();
            Refresh();
            return;
        }
        Refresh();
        try { await MeetingSvc.LeftAsync(_brief!.Id, left); }
        catch (KeyNotFoundException) { /* the brief went with it */ }
    }

    // --- the live meeting -----------------------------------------------------------------------------------------

    private bool _canPresent, _canWork, _canNote, _interactive, _attended, _disposed, _following = true;

    // A Visitor: in the meeting from a seat only (MeetingAccess); and their seat, taken ahead of the brief's read, not yet
    // settled into the meeting (JoinIfLive).
    private bool _visitor, _seatTaken;

    // Whether this person reads the team's own pages (the team edition): the links to them, its teams, its actions and
    // products opened over a slide, and the meeting notes. On this page (JoinMeetings), everyone but a Visitor.
    private bool _readsTeam;

    // The notes this person has seen: the ones there as the page opened, and every one while the notes are open. Others'
    // notes beyond those are the Notes button's count.
    private readonly HashSet<Guid> _seen = [];

    private int Unseen => _showNotes ? 0 : _record.Notes.Count(n => n.AuthorId != _me && !_seen.Contains(n.Id));

    private void Seen()
    {
        foreach (var n in _record.Notes) _seen.Add(n.Id);
    }

    internal void ToggleNotes()
    {
        _showNotes = !_showNotes;
        if (_showNotes) Seen();
    }

    // Who's signed in, read as the page opens: a meeting's change arrives on another page's thread, where the signed-in
    // user isn't this page's.
    private string _me = "", _meName = "";
    private int _summons;
    private IMeetingSeat? _seat;
    private LiveMeetingView? _view;
    private MeetingRecord _record = MeetingRecord.None;
    private string? _noteText, _editText, _addName;
    private Guid? _editingNote;

    /// <summary>Whether this page is held on the presenter's slide: in a meeting they've locked, and not presenting it.</summary>
    private bool Held => _seat is not null && _view?.HeldOn(_me) == true;

    // The article whose tags this page is editing over its slide (PresentTagEditor), for this person alone.
    private Guid? _tagEdit;

    // The slide is pinned under a panel open over it (the tag panel): this page's moves, following the presenter and a
    // reload's reslide all leave it where it is until the panel closes.
    private bool Pinned => _tagEdit is not null;
    private PresentTagEditor? _tagEditor;
    private ElementReference _editTagsButton;
    private bool _focusEditTags;

    /// <summary>Whether this page can edit an article's tags from its slide: an analyst (who can write articles), on the
    /// team edition, presenting or following (never a Viewer or Visitor, who can't write). The save itself is the article editor's, which checks again.</summary>
    private bool CanEditTags => TeamEdition && !RehearsalAsked && CurrentUser.Has(Permission.WriteArticles);

    // The articles whose full CVE list is open in place on this screen: where no card can open (the company-wide
    // edition, or a follower the presenter holds). Elsewhere "+N more" opens the CVE card.
    private readonly HashSet<Guid> _cvesOpen = [];

    /// <summary>Opens or closes an article's full CVE list in place on its slide, for this screen alone.</summary>
    internal void ToggleCves(Guid articleId)
    {
        if (!_cvesOpen.Remove(articleId)) _cvesOpen.Add(articleId);
    }

    /// <summary>For tests: the tag panel open over the slide, if any.</summary>
    internal PresentTagEditor? TagEditor => _tagEditor;

    internal void EditTags(Guid articleId)
    {
        if (!CanEditTags) return;
        _tagEdit = articleId;
    }

    // The tag panel closed. Saved: the brief is read again, so this page's chips show the save (the others hear it on the
    // article's change feed). Either way a follower catches up with the presenter, who may have moved meanwhile.
    internal async Task CloseTags(bool saved)
    {
        _tagEdit = null;
        _tagEditor = null;
        _focusEditTags = true;
        _scrollCaughtUp = null;   // the presenter may have scrolled meanwhile: to their place again, once it's drawn
        if (saved && await BriefSvc.GetAsync(_date) is { } brief)
        {
            var shown = SlideKey(_slide);
            _brief = brief;
            _follow = Followed();
            Reslide(SlideNamed(shown) ?? Math.Min(_slide, LastSlide), shown);
        }
        else if (Behind) Reslide(SlideFor(_view!), SlideKey(_slide));
        await SyncAction();
        StateHasChanged();
    }

    /// <summary>The follow pill as drawn: its look, its words and their tooltip, and what follows them (the lock, or the one button).</summary>
    private sealed record FollowState(string Class, string Title, RenderFragment Text, RenderFragment? After = null);

    // The follow pill's state: dropped (gone for good), back (reconnecting), held (locked), following, or away (browsed off).
    private FollowState FollowPill(LiveMeetingView live)
    {
        var name = live.PresenterName;
        RenderFragment who = @<span class="tide-follow-name">@name</span>;
        RenderFragment following = @<text><span class="tide-follow-label">Following </span>@who</text>;
        if (live.CanTakeOver)
            return new("is-dropped", $"{name} dropped out", @<text>@who dropped out</text>,
                _canPresent ? @<text><span class="tide-follow-sep" aria-hidden="true">&middot;</span><button class="btn btn-sm btn-primary tide-follow-btn" @onclick="TakeOver">Take over</button></text> : null);
        if (!live.PresenterHere) return new("is-reconnecting", $"{name} is reconnecting…", @<text>@who is reconnecting…</text>);
        if (Held)
            return new("is-held", $"Following {name}, locked by the presenter", following,
                @<text><span class="tide-follow-sep" aria-hidden="true">&middot;</span><span class="tide-follow-lock"><span class="bi bi-lock-fill" aria-hidden="true"></span> locked<span class="visually-hidden"> by the presenter</span></span></text>);
        if (_following) return new("is-following", $"Following {name}", following);
        var at = $" is on slide {live.Slide + 1}" + (live.Action is { } shown ? $" · showing {Ui.ActionLabel(shown)}" : "");
        return new("is-away", name + at, @<text>@who<span class="tide-follow-label">@at</span></text>,
            @<text><span class="tide-follow-sep" aria-hidden="true">&middot;</span><button class="btn btn-sm btn-primary tide-follow-btn" @onclick="BackToPresenter">Back to @name</button></text>);
    }

    /// <summary>Whether this page is the one presenting.</summary>
    private bool Presenting => _seat is not null && _view is { } v && v.IsPresenter(_me);

    // Someone who can't present has nothing to look at until a meeting starts (or after one they were in).
    private bool NotLive => _loaded && !_canPresent && _view is null && !_attended;

    // The presenter ends it, or anyone who can present once the presenter has gone for good; with no live meeting, any analyst.
    private bool CanEnd => _canPresent && (_view is null || Presenting || _view.CanTakeOver);

    private bool NoteDirty => !string.IsNullOrWhiteSpace(_noteText);

    internal Task StartMeeting() => Run(async () =>
    {
        if (_disposed || !_canPresent) return;
        try { _seat = Meetings.Start(_date, _brief!.Id, _me, _meName, Circuit.CircuitId, Origin.Id, _slide); }
        catch (InvalidOperationException)
        {
            await JoinIfLive();   // someone else started it a moment ago: join theirs
            return;
        }
        _seat.At(_slide, key: SlideKey(_slide));
        if (_actionDetail is { } open) Meetings.Open(_seat, open.Action.Number);   // what's open goes to the room
        else if (CardOpen && _popup.Shown is { } card)
        {
            Meetings.Show(_seat, card);
            _popup.Open(card, presenting: true, inMeeting: true);
        }
        await Seated();
    });

    /// <summary>Joins the day's meeting if one is going on and this page isn't in it yet.</summary>
    internal async Task JoinIfLive()
    {
        Refresh();
        // A rehearsal never joins: with the meeting live it's refused instead (RehearsalRefused).
        if (_disposed || RehearsalAsked || _seat is not null && !_seatTaken || _brief is null || _view is not { } live || live.BriefId != _brief.Id) return;
        // A Visitor's seat was taken before the brief was read (TakeVisitorSeat): it's settled into here.
        _seatTaken = false;
        _seat ??= Meetings.Join(_date, _me, _meName, _canPresent, Circuit.CircuitId, Origin.Id, live.Slide);
        if (_seat is null) return;
        _edition = Edition.Team;   // first, so the slide is found among the team edition's
        _slide = SlideFor(live);
        DropAction();   // the presenter's, if any, shows instead
        DropCard(forget: true);
        try
        {
            await Seated();
            // The presenter back (a reload, a second tab) sees what they have open for the room, and can close it.
            if (Presenting) await MirrorPresenter(_view!);
            else await SyncAction();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    /// <summary>
    /// A Visitor's seat in the day's live meeting, taken before anything of the team's is read: their reads go through only
    /// from it. None before the page is live (a prerendered page would sit in the meeting unseen), or with no meeting on.
    /// </summary>
    private bool TakeVisitorSeat()
    {
        if (_seat is not null) return true;
        if (!_interactive || _disposed || Meetings.Get(_date) is not { } live) return false;
        _seat = Meetings.Join(_date, _me, _meName, canPresent: false, Circuit.CircuitId, Origin.Id, live.Slide);
        _seatTaken = _seat is not null;
        return _seatTaken;
    }

    // The meeting a Visitor was in ended: what it showed goes with it. Their reads are refused now anyway; the page says
    // there's no meeting on, and joins the next one that starts.
    private void ForgetMeeting()
    {
        (_brief, _metrics, _actions, _open, _record, _zoom, _attended) = (null, null, null, OpenActionsReview.None, MeetingRecord.None, null, false);
        (_cves, _stackOf, _cut) = (new Dictionary<string, CveRecord>(), new Dictionary<Guid, IReadOnlyList<StackProduct>>(), null);
        _seat?.Dispose();
        (_seat, _seatTaken, _slide) = (null, false, 0);
        DropAction();
        DropCard(forget: true);
    }

    // In the meeting, started or joined: on the team edition, following, and recorded as there.
    private async Task Seated()
    {
        // A rehearsal is never in the meeting, however a seat came its way: it's given back, unrecorded.
        if (RehearsalAsked) { LeaveMeeting(); return; }
        Refresh();
        (_attended, _following, _summons, _edition) = (true, true, _view?.Summons ?? 0, Edition.Team);
        _scrollCaughtUp = null;   // the slide drawn before the seat (the title, as the page opened) may be the presenter's
        await MeetingSvc.JoinedAsync(_brief!.Id);
        await ReloadRecord();
    }

    // The meeting as it is now, after this page's own change (which it doesn't hear about: see OnMeetingChanged).
    private void Refresh()
    {
        var was = _view;
        _view = Meetings.Get(_date);
        if (was is not null && _view is not null && PresenceNews(was, _view, _me) is { } news) _presenceSaid = news;
        if (RehearsalAsked && _view is not null) GuideEnd();   // the meeting went live: the rehearsal is over
    }

    // Said once, briefly, as people come and go and hands go up and down (the top bar's status region).
    private string? _presenceSaid;

    /// <summary>Who joined, left, raised or lowered a hand between two views of the meeting ("Robin Analyst raised a
    /// hand."), leaving out this page's own; null when nothing of that changed (a follower moving slides, say).</summary>
    internal static string? PresenceNews(LiveMeetingView was, LiveMeetingView now, string me)
    {
        string? Said<T>(IEnumerable<T> from, IEnumerable<T> notIn, Func<T, string> id, Func<T, string> name, string what)
        {
            var other = notIn.Select(id).ToHashSet();
            var names = from.Where(x => id(x) != me && !other.Contains(id(x))).Select(name).ToList();
            return names.Count > 0 ? $"{string.Join(", ", names)} {what}." : null;
        }
        var parts = new[]
        {
            Said(now.People, was.People, p => p.UserId, p => p.Name, "joined"),
            Said(was.People, now.People, p => p.UserId, p => p.Name, "left"),
            Said(now.Hands, was.Hands, h => h.UserId, h => h.Name, "raised a hand"),
            Said(was.Hands, now.Hands, h => h.UserId, h => h.Name, "lowered a hand"),
        }.OfType<string>().ToList();
        return parts.Count == 0 ? null : string.Join(" ", parts);
    }

    private async Task ReloadRecord()
    {
        _record = await MeetingSvc.GetAsync(_brief!.Id);
        if (_showNotes) Seen();
    }

    private void LeaveMeeting()
    {
        _seat?.Dispose();
        (_seat, _view, _attended, _following) = (null, null, false, true);
    }

    // Someone else's change to this day's meeting. The page's own (it starts, joins, moves) it already shows, as a
    // ChangeFeed change from its own origin is skipped.
    private void OnMeetingChanged(MeetingChange change)
    {
        if (change.Day != _date || change.Origin == Origin.Id) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Follow();
                StateHasChanged();
            }
            catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        });
    }

    // Keeps up with the meeting: joins it when it starts, follows the presenter's slide, comes back on "Bring everyone
    // here", and lands on the wrap-up when it ends.
    internal async Task Follow()
    {
        if (_disposed) return;
        var was = _view;
        Refresh();
        if (_view is null)
        {
            if (_seat is null) return;
            if (_visitor)
            {
                ForgetMeeting();
                Toasts.Show("The meeting has ended.");
                return;
            }
            // It ended under us: to the wrap-up. The brief, now presented, and the record follow as ChangeFeed changes.
            _seat = null;
            _slide = LastSlide;
            DropAction();
            DropCard(forget: true);
            Toasts.Show("The meeting has ended.");
            return;
        }
        if (_seat is null)
        {
            if (_visitor && _interactive) await LoadDay();   // a meeting started: a Visitor takes a seat, then reads
            else if (_interactive) await JoinIfLive();
            return;
        }
        // Handed on, to me or from me: what was open goes (the meeting closed it for everyone).
        if (was is not null && was.IsPresenter(_me) != _view.IsPresenter(_me))
        {
            DropAction();
            _sharedSeen = null;
            DropCard(forget: true);
            _scroll.Resume();   // a pause from before presenting isn't one now
        }
        if (Presenting)
        {
            _summons = _view.Summons;
            var handedMe = was is not null && !was.IsPresenter(_me);
            if (handedMe) Toasts.Show("You're presenting.");
            // Another of my tabs moved, or took the meeting: this one (a projector window) goes where it is, and shows
            // what that one has open over the slide.
            var at = SlideFor(_view);
            if (at != _slide)
            {
                DropAction();
                _sharedSeen = null;
                DropCard(forget: true);
            }
            // Handed the meeting on the slide this page shows: where it is on it is now the room's.
            if (handedMe && at == _slide) await ShareScroll();
            _slide = at;
            await MirrorPresenter(_view);
            return;
        }
        // Handed off (or taken over) from me, or brought back by the presenter: following again. The meeting moved this
        // page's seat along with the presenter already; the page catches up.
        if (was?.IsPresenter(_me) == true || _view.Summons > _summons || Held) _following = true;
        _summons = _view.Summons;
        if (_following && !Pinned && _slide != SlideFor(_view))
        {
            _slide = SlideFor(_view);
            _dueTyped.Clear();   // a date typed on the slide that moved away isn't saved later, unseen
            DropAction();   // one opened on the last slide was that slide's
            DropCard(forget: true);
        }
        await SyncAction();
    }

    // --- the slide's scroll, shared with the room ------------------------------------------------------------------
    //
    // The presenter's scroll down their slide's body goes to the meeting as a fraction (LiveMeetings.Scroll, at most ten
    // times a second); everyone following, on the same slide, scrolls smoothly to it. Scrolling by hand pauses that for
    // the slide (ScrollFollow), with a "Back to …'s place" button by the More pill; the slide changing ends the pause.
    // Locked meetings: a follower may still scroll by hand (it's only looking), and the presenter's next scroll brings
    // them back. Late joiners land at the presenter's fraction (CatchUpScroll).

    private readonly ScrollFollow _scroll = new();

    // The slide key whose scroll this page last caught up with after rendering it.
    private string? _scrollCaughtUp;

    /// <summary>For tests: where this page last asked the browser to scroll its slide to (a fraction), if anywhere.</summary>
    internal double? ScrolledTo { get; private set; }

    /// <summary>What present.js does with a scroll of the slide by hand: "present" passes it to the room, "follow" pauses
    /// following the presenter's, nothing outside a meeting or away from the presenter.</summary>
    private string? ScrollShare => _seat is null || _view is null ? null : Presenting ? "present" : _following ? "follow" : null;

    /// <summary>Whether the "Back to …'s place" button shows: following, and paused on this slide by a scroll by hand.</summary>
    private bool ScrollBackShown(string slideKey) => !Presenting && _seat is not null && _following && _scroll.Paused(slideKey);

    /// <summary>For tests: whether following the presenter's scroll is paused on the slide shown.</summary>
    internal bool ScrollPaused => ScrollBackShown(SlideKey(_slide));

    // On the presenter's slide as the meeting names it.
    private bool OnPresentersSlide(LiveMeetingView v, string key) => v.SlideKey is not null ? v.SlideKey == key : v.Slide == _slide;

    /// <summary>The slide's body was scrolled by hand (present.js, at most ten times a second): the presenter's goes to the
    /// room; a follower's pauses following the presenter's scroll on this slide.</summary>
    [JSInvokable]
    public void OnSlideScrolled(double fraction, string? slideKey = null)
    {
        if (_seat is null || _disposed) return;
        if (Presenting)
        {
            Meetings.Scroll(_seat, fraction, slideKey);
            return;
        }
        if (_following && _scroll.ScrolledByHand(SlideKey(_slide))) StateHasChanged();
    }

    private void OnMeetingScrolled(MeetingScroll scroll)
    {
        if (scroll.Day != _date || scroll.Origin == Origin.Id) return;
        _ = InvokeAsync(async () =>
        {
            try { await HeardScroll(scroll); }
            catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        });
    }

    // A presenter's scroll heard while this page's last tidePresent.follow is still on its way: only the latest is kept,
    // and sent when that one returns, so the calls don't pile up on a slow connection.
    private MeetingScroll? _scrollOwed;
    private bool _scrollSending;

    /// <summary>The presenter scrolled: this page goes with them if it's following on the same slide and not paused (or
    /// is the presenter's other tab). At most one call to the browser at a time; one heard meanwhile waits for it.</summary>
    internal async Task HeardScroll(MeetingScroll scroll)
    {
        _scrollOwed = scroll;
        if (_scrollSending) return;
        _scrollSending = true;
        try
        {
            while (_scrollOwed is { } next)
            {
                _scrollOwed = null;
                await FollowScroll(next);
            }
        }
        finally { _scrollSending = false; }
    }

    private async Task FollowScroll(MeetingScroll scroll)
    {
        if (_seat is null || _disposed || _brief is null) return;
        var key = SlideKey(_slide);
        if (Presenting)
        {
            if (scroll.SlideKey == key) await ScrollTo(scroll.Fraction, instant: false);
            return;
        }
        var paused = _scroll.Paused(key);
        if (_scroll.Heard(scroll.SlideKey, scroll.Fraction, key, _following && !Pinned, Held) is { } to) await ScrollTo(to, instant: false);
        if (paused != _scroll.Paused(key)) StateHasChanged();
    }

    /// <summary>"Back to …'s place": following the presenter's scroll again, from where they are now.</summary>
    internal async Task BackToPlace()
    {
        _scroll.Resume();
        Refresh();
        if (_view is { } v && _following && OnPresentersSlide(v, SlideKey(_slide))) await ScrollTo(v.Scroll, instant: false);
    }

    /// <summary>Where a page newly on the presenter's slide (just joined, or the slide just changed) scrolls to: the
    /// presenter's place, when it's following them there and isn't paused; else nowhere.</summary>
    internal double? CatchUpScroll()
    {
        if (_seat is null || _brief is null || Pinned || !Presenting && !_following) return null;
        var key = SlideKey(_slide);
        if (_scroll.Paused(key) || Meetings.Get(_date) is not { } v || !OnPresentersSlide(v, key)) return null;
        return v.Scroll > 0 ? v.Scroll : null;
    }

    /// <summary>After rendering: a page newly on a slide, newly seated, or with the tag panel just closed, goes to the
    /// presenter's place on it (CatchUpScroll), once.</summary>
    internal async Task CatchUpScrollAsync()
    {
        var key = _brief is null ? null : SlideKey(_slide);
        if (key == _scrollCaughtUp) return;
        _scrollCaughtUp = key;
        _scroll.Showing(key);   // a new slide: a pause on the last one is over
        if (CatchUpScroll() is { } f) await ScrollTo(f, instant: true);
    }

    private async Task ScrollTo(double fraction, bool instant)
    {
        ScrolledTo = fraction;
        try { await JS.InvokeVoidAsync("tidePresent.follow", fraction, instant); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }   // not live (prerendered)
        catch (JSException) { }
    }

    /// <summary>For tests: whether this page, handed the meeting, has told the room where it is on the slide.</summary>
    internal bool SharedPlace { get; private set; }

    // This page has just become the presenter: where it is on the slide is now the room's. The meeting starts a hand-off
    // at the top (LiveMeetings.MakePresenter), but the new presenter's page is where it was: wherever the last presenter
    // had the room, or where they'd scrolled to by hand.
    private async Task ShareScroll()
    {
        SharedPlace = true;
        try { await JS.InvokeVoidAsync("tidePresent.share"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }   // not live (prerendered)
        catch (JSException) { }
    }

    internal async Task BackToPresenter()
    {
        if (_view is null) return;
        _following = true;
        await Move(SlideFor(_view));
    }

    internal async Task TakeOver()
    {
        if (_seat is null || !Meetings.TakeOver(_seat)) return;
        Refresh();
        CloseHandedOn();
        Toasts.Show("You're presenting.");
        await ShareScroll();
    }

    // The meeting changed hands, which closed what was open over the slide for the room: this page's goes too (this
    // page doesn't hear its own change, which closes it on the others'), so a new presenter doesn't think the room sees
    // it, and one who handed off isn't left with the last presenter's card, which a lock wouldn't let them close.
    private void CloseHandedOn()
    {
        DropAction();
        _sharedSeen = null;
        DropCard(forget: true);
        _scroll.Resume();   // a pause from before presenting isn't one now
    }

    internal void ToggleHand()
    {
        if (_seat is null) return;
        var up = _view?.Hands.Any(h => h.UserId == _me) != true;
        Meetings.Hand(_seat, up, up ? ShownArticle() : null);
        Refresh();
    }

    /// <summary>How many people the top bar shows a dot for, before "+N".</summary>
    private const int TopBarDots = 5;

    // The list of hands, opened from the top bar's count of them: a shared popout (Popout), so Escape (focus back on the
    // count), a press outside it or Tab past it closes it as it does the other popouts.
    private bool _handsOpen;
    private ElementReference _handsHolder, _handsButton;
    private Popout? _handsPopout;

    /// <summary>Whether the list of hands is open: only while there's a hand up. When the last one goes down it shuts, and
    /// stays shut when the next goes up; it opens only from its button.</summary>
    private bool HandsListOpen => _handsOpen &= _view?.Hands.Count > 0;

    internal void ToggleHandsList() => _handsOpen = !_handsOpen && _view?.Hands.Count > 0;

    // --- the presenter's rail -----------------------------------------------------------------------------------

    /// <summary>Whether this page has the presenter's rail: the page presenting, or with no meeting someone who could
    /// present, or a rehearsal (its controls disabled). Never a follower's.</summary>
    private bool Rail => InCharge || Rehearsing;

    /// <summary>
    /// Whether this page runs the meeting: it's presenting it, or there's no meeting and it could present (alone, getting
    /// ready). Read from the live meeting, not this page's copy, so it holds the moment the meeting starts or changes
    /// hands. Every one of the presenter's steps checks it where it's handled, not only by what the page draws: someone
    /// following, an analyst who could present included, changes nothing with a key or a forged event. A rehearsal
    /// never runs it.
    /// </summary>
    private bool InCharge => !RehearsalAsked && _canPresent && (Meetings.Get(_date) is not { } live || _seat is not null && live.IsPresenter(_me));

    // --- rehearsal: Learn to present ----------------------------------------------------------------------------

    /// <summary>"1" when Help's Learn to present opened the page: a rehearsal (<see cref="RehearsalHref"/>).</summary>
    [SupplyParameterFromQuery(Name = "rehearse")] public string? Rehearse { get; set; }

    /// <summary>What, with <see cref="RehearsalHref"/>, marks a rehearsal as An analyst's day's presenting.</summary>
    public const string DayGuide = "guide=" + Guides.Day;

    /// <summary>Present mode for <paramref name="day"/>'s brief in rehearsal as An analyst's day's presenting.</summary>
    public static string DayRehearsalHref(DateOnly day) => RehearsalHref(day) + "&" + DayGuide;

    /// <summary>Where An analyst's day goes on back on Today (<see cref="BackToTheDayFrom"/>), read from
    /// <paramref name="uri"/>: the step, and whether the rehearsal was refused for a live meeting; null for any other
    /// address.</summary>
    public static (string From, bool Live)? ResumesTheDay(string uri)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(uri).Query);
        return query.TryGetValue("guide", out var guide) && guide == Guides.Day && query.TryGetValue("from", out var from)
            ? (from.ToString(), query.ContainsKey("live")) : null;
    }

    /// <summary><see cref="Guides.Day"/> when An analyst's day opened the rehearsal (<see cref="DayGuide"/>).</summary>
    [SupplyParameterFromQuery(Name = "guide")] public string? GuideOf { get; set; }

    // The rehearsal is An analyst's day's presenting: its guide is the day's, and ends back on Today at Send.
    private bool ForTheDay => RehearsalAsked && GuideOf == Guides.Day;
    private bool _backToTheDay;

    /// <summary>Today, with An analyst's day going on at Send (OnboardingHost); <paramref name="live"/> when present mode
    /// refused the rehearsal because the meeting is live.</summary>
    public static string BackToTheDayFrom(bool live) => $"?guide={Guides.Day}&from=send" + (live ? "&live=1" : "");

    // Skip the details, or Done: back to Today for Send.
    internal void BackToTheDay()
    {
        _backToTheDay = true;
        GuideEnd();
        Nav.NavigateTo(Nav.BaseUri + BackToTheDayFrom(live: false));
    }

    /// <summary>Present mode for <paramref name="day"/>'s brief in rehearsal, as Help's Learn to present opens it.</summary>
    public static string RehearsalHref(DateOnly day) => Ui.PresentUrl(day) + "?rehearse=1";

    /// <summary>
    /// Whether the address asks for a rehearsal: `rehearse` in it at all, whatever its value (1, true, empty), so a
    /// mistyped value fails safe, as a rehearsal. Such a page never starts, joins or ends a meeting, joins nobody's
    /// presence and broadcasts nothing; every step that saves is refused where it's handled (Run, InCharge), and the
    /// rail's controls are disabled. Nobody follows it, so Learn to present's steps are on this screen alone.
    /// </summary>
    private bool RehearsalAsked => Rehearse is not null;

    private bool CanRehearse => !_visitor && CurrentUser.Has(Permission.PresentBriefs);

    // Whether the page is of today's brief, the only one a rehearsal is of.
    private bool OfToday => _date == Clock.CurrentBriefDate;

    /// <summary>Why a rehearsal asked for isn't run: the person can't present, it isn't today's brief (only today's is
    /// rehearsed, so no rehearsal runs beside another day's live meeting), or today's meeting is live.</summary>
    private string? RehearsalRefused => !RehearsalAsked ? null
        : !CanRehearse ? "Rehearsal is for whoever presents the brief."
        : _valid && !OfToday ? "Only today's brief can be rehearsed."
        : _valid && _view is not null ? "The meeting is live, so it can't be rehearsed now." : null;

    /// <summary>A rehearsal is running: asked for, by someone who can present, with the day's meeting not live.</summary>
    private bool Rehearsing => RehearsalAsked && RehearsalRefused is null;

    private IReadOnlyList<TourStep> _guide = [];
    private string? _guideName;
    private int _guideAt;
    private bool _guideStarted;

    private TourStep? GuideStep => _guideAt < _guide.Count ? _guide[_guideAt] : null;

    private string GuideSaid => Rehearsing && GuideStep is { } s
        ? (_guideAt == 0 ? "Rehearsal: nothing here is shared or saved. " : "") + GuideStepDialog.Said(s, _guideAt, _guide.Count) : "";

    // Learn to present, once the rehearsal's brief is read: from its first step, on the title slide. A step about a slide
    // this brief hasn't (no numbers, nothing needing review, no article with indicators) is left out, so the count is of
    // the steps shown and none points at nothing.
    private void StartGuide()
    {
        if (_guideStarted || !Rehearsing || _brief is null) return;
        _guideStarted = true;
        var learn = Guides.Find(Guides.Present, CurrentUser.Has);
        (_guide, _guideName) = ((learn?.Steps ?? []).Where(s => GuideSlide(s.Route) is not null).ToList(),
            ForTheDay ? Guides.Find(Guides.Day, CurrentUser.Has)?.Title + " · Presenting" : learn?.Title);
        GuideTo(0);
    }

    /// <summary>Next, or Done on the last step.</summary>
    internal void GuideNext()
    {
        if (_guideAt + 1 < _guide.Count) GuideTo(_guideAt + 1);
        else if (ForTheDay) BackToTheDay();
        else GuideEnd();
    }

    /// <summary>Back.</summary>
    internal void GuideBack() => GuideTo(Math.Max(0, _guideAt - 1));

    /// <summary>End guide, Escape or Done: the steps go, and the rehearsal stays to look round.</summary>
    internal void GuideEnd() => (_guide, _guideAt) = ([], 0);

    // The step, on its slide.
    private void GuideTo(int at)
    {
        _guideAt = at;
        if (GuideStep is { } s && GuideSlide(s.Route) is { } n) Go(n);
    }

    // The slide a Learn to present step is on (its Route): the title, the first numbers slide, the actions that need
    // review, the first article; for a step about part of an article's slide, the first article with it (indicators, a
    // line raised as an action, an action to open); the wrap-up. Null when this brief has no such slide.
    private int? GuideSlide(string route)
    {
        if (_brief is not { } b) return null;
        var articles = Cut(b).Articles;
        int? First(Func<EditionArticle, bool> has) =>
            articles.Select((a, i) => (a, i)).Where(x => has(x.a)).Select(x => (int?)(LeadSlides + 1 + x.i)).FirstOrDefault();
        return route switch
        {
            "title" => 0,
            "metrics" when MetricsSlides > 0 => 1 + NoteSlides,
            "open" when OpenSlides > 0 => SlideNamed("open"),
            "article" => First(_ => true),
            "article:indicators" when TeamEdition => First(a => a.Indicators.Count > 0),
            "article:raised" when TeamEdition => First(a => Raised(a).Lines.Any(l => l.Action is not null)),
            "article:card" when TeamEdition => First(a => a.Actions.Count > 0),
            "wrap" => LastSlide,
            _ => null,
        };
    }

    private static (IReadOnlyList<(string Line, EditionAction? Action)> Lines, IReadOnlyList<EditionAction> Others) Raised(EditionArticle a) =>
        RecommendedActions.Match(a.Article.RecommendedActions, a.Actions, r => r.Recommendation);

    // Whether the window has room to dock it (1500px and wider, as present.js reports), and whether ] or Rail has turned it
    // from what that room gives (open when docked, shut over the slide).
    private bool _railRoom, _railToggled;
    private ElementReference _railBox, _railToggle, _railClose;
    private bool _moveRailFocus;

    // Whether the rail was drawn at the last render, to see it go.
    private bool _railDrawn;

    private bool RailOpen => Rail && _railRoom != _railToggled;

    /// <summary>Docked beside the slide (the slide's column narrows), rather than over it.</summary>
    private bool RailDocked => RailOpen && _railRoom;

    /// <summary>The rail open over the slide: a modal dialog, the page under it inert.</summary>
    private bool RailOver => RailOpen && !_railRoom;

    /// <summary>A click on the scrim around the rail open over the slide: it closes, and focus goes back to Rail.</summary>
    internal void CloseRailFromScrim()
    {
        if (RailOver) ToggleRail();
    }

    /// <summary>] or Rail: the rail opens or shuts. Over the slide it's a dialog: it takes focus as it opens, and gives it
    /// back to Rail as it shuts.</summary>
    internal void ToggleRail()
    {
        if (!Rail) return;
        _railToggled = !_railToggled;
        _moveRailFocus = !_railRoom;
    }

    /// <summary>present.js: whether the window is wide enough to dock the rail (it says again as that changes).</summary>
    [JSInvokable]
    public Task OnRailRoom(bool room) => InvokeAsync(() =>
    {
        if (_railRoom == room) return;
        (_railRoom, _railToggled) = (room, false);
        StateHasChanged();
    });

    // Ctrl+Enter in the rail's note adds it.
    private Task RailNoteKey(KeyboardEventArgs e) => e.Key == "Enter" && e.CtrlKey ? AddNote() : Task.CompletedTask;

    /// <summary>How many of the day's numbers are missing, and the first numbers slide with one (for the title's checks).</summary>
    private int MissingNumbers => MetricPlan.Sum(m => m.Group?.Tiles.Count(Missing) ?? 0);

    private int? FirstMissingSlide => MetricPlan.Select((m, i) => (m, i)).Where(x => x.m.Group?.Tiles.Any(Missing) == true)
        .Select(x => (int?)(x.i + 1 + NoteSlides)).FirstOrDefault();

    /// <summary>A number the day should have that nobody has entered.</summary>
    private static bool Missing(Tide.Application.Metrics.MetricTile t) => t.Value is null && t.Metric.FlagMissing;

    // --- the day's loose ends, dealt with on their slides by the presenter ------------------------------------------

    /// <summary>Whether this page has the presenter's tools on the slides: it's presenting (or there's no meeting and it
    /// could), on the team edition, as someone who may change the brief, before it's sent. Never a follower's.</summary>
    private bool PresenterTools => TeamEdition && InCharge && _writesBriefs
        && _brief is { Status: not BriefStatus.Sent };

    private bool _writesBriefs, _noteEditing;
    private string? _noteDraft;
    private readonly Dictionary<Guid, string> _numberDrafts = [];

    // The note as it was opened to edit, and the brief's version then: saving is refused if a colleague saved the brief
    // meanwhile (BriefService.SetTeamNoteAsync). A change heard to anything but the note moves the version on; one to the
    // note says who saved it (_noteChangedBy), as the brief page does, and the draft stays to copy from.
    private string? _noteBase, _noteChangedBy;
    private Guid? _noteVersion;

    internal void EditOpeningNote() =>
        (_noteEditing, _noteDraft, _noteBase, _noteVersion, _noteChangedBy, _slideFocus) = (true, _brief?.TeamNote, _brief?.TeamNote, _brief?.EditVersion, null, SlideFocus.NoteBox);

    /// <summary>Cancel (or Escape in the box): the note as saved, and focus back on Edit.</summary>
    internal void CancelOpeningNote() => (_noteEditing, _noteChangedBy, _slideFocus) = (false, null, SlideFocus.NoteEdit);

    // A brief heard to have changed while the note is open: who saved it, if it was the note; else the edit carries on.
    private void NoteHeard(Brief brief, IReadOnlyList<Change> changes)
    {
        if (!_noteEditing) return;
        if (brief.TeamNote == _noteBase) _noteVersion = brief.EditVersion;
        else _noteChangedBy ??= LiveChanges.Who(changes);
    }

    // Typed and not saved: the meeting note (not yet added), the opening note's edit, or a number.
    private bool OpeningNoteDirty => _noteEditing && (_noteDraft ?? "") != (_noteBase ?? "");
    private bool NumbersDirty => _numberDrafts.Values.Any(v => !string.IsNullOrWhiteSpace(v));
    private bool Unsaved => NoteDirty || OpeningNoteDirty || NumbersDirty;

    /// <summary>Whether leaving asks first: something typed and not saved, outside a rehearsal (where nothing can be saved,
    /// so there's nothing to discard).</summary>
    internal bool AsksBeforeLeaving => Unsaved && !RehearsalAsked;
    private string UnsavedMessage => NoteDirty ? "Your meeting note isn't added."
        : OpeningNoteDirty ? "Your edit to the opening note isn't saved." : "A number you typed isn't saved.";

    private void DiscardUnsaved()
    {
        DiscardNote();
        (_noteEditing, _noteChangedBy) = (false, null);
        _numberDrafts.Clear();
    }

    // Escape in the note's box cancels; the slide's own keys never hear the box's (present.js leaves typing alone).
    private void NoteBoxKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelOpeningNote();
    }

    // Enter in a number's box saves it.
    private Task NumberKey(KeyboardEventArgs e, Guid metricId) =>
        e.Key == "Enter" ? EnterMissingNumber(metricId, _numberDrafts.GetValueOrDefault(metricId) ?? string.Empty) : Task.CompletedTask;

    // Where focus goes once a slide's strip is drawn again: into the note's box, back to Edit, or to the slide's heading
    // as a strip goes (the note kept or saved, the last number entered); a number refused keeps its box.
    private enum SlideFocus { None, NoteBox, NoteEdit, NoteHeading, NumbersHeading, NumberBox }

    private SlideFocus _slideFocus;
    private ElementReference _noteBox, _noteEditButton, _noteHeading, _numbersHeading;
    private readonly Dictionary<Guid, ElementReference> _numberBoxes = [];

    /// <summary>The title's Enter beside "numbers missing": the first numbers slide with one, focus in its first box.</summary>
    private async Task ToMissingNumber(int slide)
    {
        await Move(slide);
        _slideFocus = SlideFocus.NumberBox;
    }

    // The first missing number's box on the numbers slide shown.
    private ElementReference FirstNumberBox()
    {
        var onNumbers = _slide > NoteSlides && _slide <= NoteSlides + MetricsSlides;
        var first = onNumbers ? MetricPlan[_slide - 1 - NoteSlides].Group?.Tiles.FirstOrDefault(Missing) : null;
        return first is not null && _numberBoxes.TryGetValue(first.Metric.Id, out var box) ? box : default;
    }
    private readonly Dictionary<Guid, string> _numberErrors = [];

    private async Task FocusOnSlideAsync()
    {
        var to = _slideFocus switch
        {
            SlideFocus.NoteBox => _noteBox, SlideFocus.NoteEdit => _noteEditButton,
            // Over the slide the rail is modal and the slide inert: focus stays in the rail, on the note's Edit, or once no
            // number is left to enter, on its close button. A number still missing takes it first, wherever the rail is.
            SlideFocus.NoteHeading => RailOver ? _noteEditButton : _noteHeading,
            SlideFocus.NumbersHeading => FirstNumberBox() is { Id: not null } next ? next : RailOver ? _railClose : _numbersHeading,
            SlideFocus.NumberBox => FirstNumberBox(), _ => default,
        };
        if (_slideFocus == SlideFocus.None || _busy) return;
        _slideFocus = SlideFocus.None;
        await to.TryFocusAsync(orGone: true);
    }

    /// <summary>Still current: the carried note kept as it is for this brief (BriefService marks it reviewed).</summary>
    internal Task KeepOpeningNote() => SaveOpeningNote(_brief?.TeamNote, "Opening note kept as it is.");

    /// <summary>Save note. An empty note isn't saved from the slide: clearing it would take the slide away from under the room
    /// mid-meeting (it's cleared from Today); Still current or Cancel are the ways out.</summary>
    internal Task SaveOpeningNote(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            Toasts.Error("An empty note isn't saved here: it would take the slide away. Use Cancel, or Still current.");
            return Task.CompletedTask;
        }
        return SaveOpeningNote(text, "Opening note saved.");
    }

    private Task SaveOpeningNote(string? text, string done) => Run(async () =>
    {
        if (_brief is null || !InCharge) return;
        try { await BriefSvc.SetTeamNoteAsync(_brief.Id, text, _noteEditing ? _noteVersion : _brief.EditVersion); }
        catch (StaleEditException)
        {
            _noteChangedBy ??= "Someone else";
            throw;
        }
        (_noteEditing, _noteChangedBy, _slideFocus) = (false, null, SlideFocus.NoteHeading);
        await ReadBriefAgain();
        Toasts.Show(done);
    });

    /// <summary>A number missing from the day's, entered on its slide: blank or not a number is refused, as the form does.</summary>
    internal Task EnterMissingNumber(Guid metricId, string text) => Run(async () =>
    {
        if (!InCharge) return;
        if (!Tide.Application.Metrics.MetricMath.TryParseValue(text, out var value))
        {
            _numberErrors[metricId] = string.IsNullOrWhiteSpace(text) ? "Type the number first." : "That isn't a number TIDE can keep.";
            return;
        }
        // The number only: a colleague's note added a moment ago isn't wiped by it.
        await MetricsSvc.SaveNumberAsync(metricId, _date, value);
        _numberDrafts.Remove(metricId);
        _numberErrors.Remove(metricId);
        // The group may fold away (its last number entered as 0): this page stays where its slide's line now is, with the room.
        var shown = SlideKey(_slide);
        _metrics = await MetricsSvc.GetDayAsync(_date);
        Reslide(SlideNamed(shown) ?? Math.Min(_slide, LastSlide), shown);
        _slideFocus = SlideFocus.NumbersHeading;
        Toasts.Show("Saved. The room sees it now.");
    });

    // After a save from a slide: the brief read again, and this page kept on the slide it showed (a cleared note takes its
    // slide away), as a colleague's change would.
    private async Task ReadBriefAgain()
    {
        var shown = SlideKey(_slide);
        if (await BriefSvc.GetAsync(_date) is not { } brief) return;
        _brief = brief;
        Reslide(SlideNamed(shown) ?? Math.Min(_slide, LastSlide), shown);
    }

    /// <summary>The slides before the articles, in a line for the title slide: "the opening note and the numbers"; null
    /// when the articles come first.</summary>
    private string? FirstUp
    {
        get
        {
            List<string> parts = [];
            if (NoteSlides > 0) parts.Add("the opening note");
            if (MetricsSlides > 0) parts.Add("the numbers");
            return parts.Count switch
            {
                0 => null,
                1 => parts[0],
                _ => string.Join(", ", parts[..^1]) + " and " + parts[^1],
            };
        }
    }

    /// <summary>What comes after the articles, before the wrap-up, for the title slide: "2 actions that need review"; null
    /// when the wrap-up follows them.</summary>
    private string? AfterArticles => OpenSlides > 0 ? Ui.Plural(_open.Overdue, "action") + (_open.Overdue == 1 ? " that needs review" : " that need review") : null;


    private Task HandsListDismissed() => InvokeAsync(() =>
    {
        _handsOpen = false;
        StateHasChanged();
    });

    internal void ClearHand(string? userId)
    {
        if (InCharge && _seat is not null && Meetings.ClearHands(_seat, userId)) Refresh();
    }

    internal void Summon()
    {
        if (InCharge && _seat is not null && Meetings.Summon(_seat)) Refresh();
    }

    internal void ToggleLock()
    {
        if (InCharge && _seat is not null && Meetings.Lock(_seat, _view?.Locked != true)) Refresh();
    }

    // Who's chosen in "Hand off to…": handed the meeting only once Hand off is pressed.
    private string? _handTo;

    internal void ChooseHandOff(ChangeEventArgs e) => _handTo = e.Value is string to && to.Length > 0 ? to : null;

    internal void ConfirmHandOff()
    {
        if (_handTo is { } to) HandOff(to);
    }

    internal void HandOff(string to)
    {
        _handTo = null;
        if (!InCharge || _seat is null || to.Length == 0) return;
        var name = _view?.People.FirstOrDefault(p => p.UserId == to)?.Name;
        if (!Meetings.HandTo(_seat, to))
        {
            // Refused (they left a moment ago): the list is drawn afresh, back on "Hand off to…", not left on their name.
            HandOffResets++;
            Toasts.Error($"{name ?? "They"} couldn't be handed the meeting: they may have left it.");
            Refresh();
            return;
        }
        Refresh();
        CloseHandedOn();
        // Following the new presenter now, from their slide (this page doesn't hear its own change).
        (_following, _summons) = (true, _view?.Summons ?? _summons);
        if (_view is not null) _slide = SlideFor(_view);
        Toasts.Show($"{name} is presenting.");
    }

    private async Task CopyLink()
    {
        if (RehearsalAsked) return;
        var link = Nav.ToAbsoluteUri(Ui.PresentUrl(_date)).ToString();
        var copied = false;
        try { copied = await JS.InvokeAsync<bool>("tideCopy", link); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        Toasts.Show(copied ? "Link copied." : $"Copy this link: {link}");
    }

    // --- an action opened over the slide ----------------------------------------------------------------------------

    private ActionDetail? _actionDetail;
    private int _actionVersion;

    // Opened by this page alone (a follower's own look), not the presenter's shown to the room; and the presenter's open
    // action this page last went along with, so one a follower closed for themselves stays closed until it changes.
    private bool _ownAction, _focusAction;
    private int? _sharedSeen;

    /// <summary>Whether this page can open an action: on the team edition, and not held by the presenter's lock.</summary>
    private bool CanOpenAction => TeamEdition && !Held && _readsTeam;

    /// <summary>Whether the action open shows beside the slide, which narrows for it (an administrator's choice, off until
    /// rehearsed): the same for the presenter and everyone following, so the room sees what they see.</summary>
    private bool ActionBeside => Clock.ActionBesideSlide && TeamEdition && _actionDetail is not null;

    // The organization's settings changed: an action open now moves beside the slide, or back over it, on every page in
    // the meeting at once (each draws it from the setting), rather than when it's next opened; and the actions that need
    // review are read again by the new limits, so the rows and the count agree with the line under them.
    private void OnOrgChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(RereadReview);
    }

    // The actions that need review, read again (a limit changed, or their slide is shown again), and drawn.
    private async Task RereadReview()
    {
        if (_disposed || _brief is null) return;
        try
        {
            await ReloadActionLists();
            StateHasChanged();
        }
        catch (ObjectDisposedException) { /* the page closed meanwhile */ }
    }

    // The slide key last drawn: coming to the actions that need review from another slide reads them again.
    private string? _drawnKey;

    // An action's title in a slide's list: it opens the action over the slide where this page can (its number after it).
    private RenderFragment ActionTitle(int number, string title) =>
        @<ActionRef Number="number" Title="@title" Link="false" Opener="@($"action:{number}")"
                    OnOpen="@(CanOpenAction ? EventCallback.Factory.Create(this, () => ShowAction(number)) : default)" />;

    // An action's due date, holder and Take it, for someone who can work it: on its recommended line, or in the list of
    // the article's other actions.
    private RenderFragment ActionControls(EditionAction r) =>
        @<text>@if (CanWork(r))
        {
            <span class="tide-action-assign">
                <input type="date" class="form-control form-control-sm" aria-label="Due date for @Ui.ActionLabel(r.Number)" value="@DueShown(r)" disabled="@_busy"
                       @key="(r.Id, DueResets(r.Id))" @onchange="e => _dueTyped[r.Id] = e.Value as string" @onfocusout="() => SetDue(r)" />
                @* An external team has no members, as expected: nobody here is given it, and its ticket names who has it. *@
                @if (r.TeamExternal)
                {
                    <span class="tide-present-help"><HolderText Label="@r.Holder("nobody")" Links="!_visitor" /></span>
                }
                else
                {
                <select class="form-select form-select-sm" aria-label="Assign @Ui.ActionLabel(r.Number)" value="@(r.AssigneeId ?? "")" disabled="@_busy"
                        @key="AssignKey(r.Id)" @onchange="e => Assign(r, e.Value as string)">
                    <option value="">Nobody</option>
                    @foreach (var member in MembersOf(r.TeamId).OrderBy(m => m.DisplayName)) { <option value="@member.UserId">@member.DisplayName</option> }
                    @if (r.AssigneeId is { } held && MembersOf(r.TeamId).All(member => member.UserId != held)) { <option value="@held">@r.AssigneeName</option> }
                </select>
                @* Only the team's members can be given it (ActionService.AssignAsync): with none, say so, and where to add them. *@
                @if (MembersOf(r.TeamId).Count == 0)
                {
                    <span class="tide-present-help tide-assign-none">No one is on @r.TeamName yet.
                        @if (CurrentUser.Has(Permission.Administer)) { <a href="admin/teams">Add them</a> }</span>
                }
                }
                @* Taken only by a member of its team, as it's only given to one; an external team has none. *@
                @if (r.AssigneeId != _me && OnTeam(r))
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" aria-label="Take @Ui.ActionLabel(r.Number)" @onclick="() => Take(r)">Take it</button>
                }
            </span>
        }</text>;

    // An action's number alone, where it's what's quoted ("Raised as A-6"): it opens the action too.
    private RenderFragment ActionNum(int number) =>
        @<text>@if (CanOpenAction)
        {
            <button type="button" class="tide-action-num tide-action-open" title="Open @Ui.ActionLabel(number) here" data-card-opener="action:@number" @onclick="() => ShowAction(number)">@Ui.ActionLabel(number)</button>
        }
        else
        {
            <span class="tide-action-num">@Ui.ActionLabel(number)</span>
        }</text>;

    // Whose the action or product card over the slide is: shown to the room, this page's own look, or the presenter's.
    private string? Kicker(bool own) => _view is not { } live || _seat is null ? null
        : Presenting ? "Shown to everyone following"
        : own ? "Only you see this"
        : Held ? $"{live.PresenterName} is showing this · locked"
        : $"{live.PresenterName} is showing this";

    /// <summary>
    /// Opens an action over the slide. The presenter's opens for everyone following them; anyone else's (unless the
    /// presenter has them locked) is theirs alone.
    /// </summary>
    internal async Task ShowAction(int number)
    {
        if (!CanOpenAction) return;
        if (Presenting)
        {
            Meetings.Open(_seat!, number);
            Refresh();
            _sharedSeen = number;
        }
        _ownAction = _seat is not null && !Presenting;
        await LoadAction(number, focus: true);
        // Not found: the room isn't left with one the presenter can't see (or close).
        if (Presenting && _actionDetail?.Action.Number != number && _view?.Action == number)
        {
            Meetings.Open(_seat!, null);
            Refresh();
        }
    }

    /// <summary>Closes the action: the presenter's, for everyone following; anyone else's, for themselves.</summary>
    internal Task CloseAction()
    {
        if (_actionDetail is null || Held) return Task.CompletedTask;
        if (Presenting)
        {
            Meetings.Open(_seat!, null);
            Refresh();
        }
        DropAction();
        _focusOpener = true;   // closed here (Escape, Close): focus back on the title that opened it, once it's drawn
        return Task.CompletedTask;
    }

    private void DropAction()
    {
        if (_actionDetail is null) return;
        (_actionDetail, _ownAction, _focusAction) = (null, false, false);
        _follow = Followed();
    }

    private async Task LoadAction(int number, bool focus = false)
    {
        ActionDetail? detail;
        try { detail = await ActionSvc.MeetingViewAsync(number, _teamMax); }
        catch (ForbiddenException) when (_visitor)
        {
            DropAction();   // the presenter closed it a moment ago: a Visitor sees only the one open for the room
            return;
        }
        if (detail is null)
        {
            Toasts.Error($"{Ui.ActionLabel(number)} wasn't found.");
            return;
        }
        DropCard();   // one thing open over the slide at a time
        (_actionDetail, _focusAction) = (detail, focus);
        _actionVersion++;
        _follow = Followed();
    }

    private Task ReloadAction() => _actionDetail is { } open ? LoadAction(open.Action.Number, _focusAction) : Task.CompletedTask;

    // A status move or a tick in the panel: re-read it, and the slides' lists that show its status, the actions that need
    // review among them (this page doesn't hear its own change, as the others following do).
    internal async Task OnActionChanged()
    {
        await ReloadAction();
        await ReloadActionLists();
    }

    // Goes along with the action the presenter has open: always while locked; otherwise when following, unless this page
    // closed that one itself. Their closing it closes it here, unless this page opened its own.
    internal async Task SyncAction()
    {
        await SyncCard();
        if (_seat is null || _view is not { } live || Presenting || !TeamEdition) return;
        var shared = live.Action;
        if (Held)
        {
            _sharedSeen = shared;
            _ownAction = false;
            if (_actionDetail?.Action.Number == shared) return;
            if (shared is { } n) await LoadAction(n);
            else DropAction();
            return;
        }
        if (!_following || shared == _sharedSeen) return;
        _sharedSeen = shared;
        if (shared is { } open)
        {
            _ownAction = false;
            await LoadAction(open);
        }
        else if (!_ownAction) DropAction();
    }

    // --- a card opened over an article's slide: an Our stack product's, or the article's indicators ---------------------
    // One card at a time, shown to the room as one (a MeetingCard, which says which kind it is), and moving on, handing
    // over or the meeting's end closes either alike.

    private IReadOnlyDictionary<Guid, IReadOnlyList<StackProduct>> _stackOf = new Dictionary<Guid, IReadOnlyList<StackProduct>>();
    private readonly MeetingPopup _popup = new();
    private Tide.Application.Stack.StackCard? _product;   // a product's card, as read
    private bool _focusCard;

    /// <summary>Whether this page can open a card: on the team edition, and not held by the presenter's lock.</summary>
    private bool CanOpenCard => TeamEdition && !Held && _readsTeam;

    /// <summary>How many of an article's indicators its slide shows; the card has them all.</summary>
    internal const int SlideIndicators = 10;

    // The article whose indicators are open over its slide, as this page's edition carries them (read again with it).
    private EditionArticle? ShownIndicators =>
        TeamEdition && _popup.Shown is { Kind: MeetingCardKind.Indicators, Id: var id } && _brief is not null
            ? Cut(_brief).Articles.FirstOrDefault(x => x.Article.Id == id && x.Indicators.Count > 0)
            : null;

    // The article whose CVEs are open over its slide (two or more: one is on the slide already).
    private EditionArticle? ShownCves =>
        TeamEdition && _popup.Shown is { Kind: MeetingCardKind.Cves, Id: var id } && _brief is not null
            ? Cut(_brief).Articles.FirstOrDefault(x => x.Article.Id == id && x.Article.Cves.Count > 1)
            : null;

    private bool CardOpen => _product is not null || ShownIndicators is not null || ShownCves is not null;

    // Each article's tactics and scorecard tags as its slide draws them, worked out once per read of the brief rather than
    // on every render. A brief read again is a new object, with new articles: the cache starts afresh for it.
    private readonly Dictionary<Article, (IReadOnlyList<SlideTactic> Tactics, IReadOnlyList<SlideTagGroup> Scorecard)> _tagsOf = new(ReferenceEqualityComparer.Instance);
    private Brief? _tagsOfBrief;

    private (IReadOnlyList<SlideTactic> Tactics, IReadOnlyList<SlideTagGroup> Scorecard) TagsOf(Article a)
    {
        if (!ReferenceEquals(_tagsOfBrief, _brief))
        {
            _tagsOf.Clear();
            _tagsOfBrief = _brief;
        }
        if (!_tagsOf.TryGetValue(a, out var tags)) _tagsOf[a] = tags = (SlideTags.Tactics(a), SlideTags.Scorecard(a));
        return tags;
    }

    private static bool IsTags(Change c) => c.Topic == ChangeFeed.Stack || c.Topic.StartsWith("article-tags:", StringComparison.Ordinal);

    // The products each of the brief's articles is tagged with, for the slides' chips.
    private async Task<IReadOnlyDictionary<Guid, IReadOnlyList<StackProduct>>> StackOf(Brief? brief) =>
        brief is null ? new Dictionary<Guid, IReadOnlyList<StackProduct>>() : await StackSvc.ForArticlesAsync(brief.Items.Select(i => i.ArticleId));

    /// <summary>Opens a product's card over the slide (<see cref="ShowCard"/>).</summary>
    internal Task ShowProduct(Guid productId) => ShowCard(MeetingCard.ForProduct(productId));

    /// <summary>Shows an article's indicators over its slide (<see cref="ShowCard"/>).</summary>
    internal Task ShowIndicators(Guid articleId) => ShowCard(MeetingCard.ForIndicators(articleId));

    /// <summary>Shows all of an article's CVEs over its slide (<see cref="ShowCard"/>).</summary>
    internal Task ShowCves(Guid articleId) => ShowCard(MeetingCard.ForCves(articleId));

    /// <summary>
    /// Opens a card over the slide, as <see cref="ShowAction"/> does an action: the presenter's opens for everyone
    /// following them; anyone else's (unless the presenter has them locked) is theirs alone.
    /// </summary>
    private async Task ShowCard(MeetingCard card)
    {
        if (!CanOpenCard) return;
        if (Presenting)
        {
            Meetings.Show(_seat!, card);
            Refresh();
        }
        _popup.Open(card, Presenting, _seat is not null);
        await LoadCard(focus: true);
        if (Presenting && !CardOpen && Meetings.Get(_date)?.Card == card)
        {
            Meetings.Show(_seat!, null);
            Refresh();
        }
    }

    /// <summary>Closes the card: the presenter's, for everyone following; anyone else's, for themselves.</summary>
    internal Task CloseCard()
    {
        if (!CardOpen || Held) return Task.CompletedTask;
        if (Presenting)
        {
            Meetings.Show(_seat!, null);
            Refresh();
        }
        DropCard();
        _focusOpener = true;   // closed here (Escape, Close): focus back on what opened it, once it's drawn
        return Task.CompletedTask;
    }

    private bool _focusOpener;

    // Closes the card; forgetting the presenter's too, so theirs shows again (a move, a hand-off, a new day).
    private void DropCard(bool forget = false)
    {
        if (forget) _popup.Reset();
        else _popup.Close();
        (_product, _focusCard) = (null, false);
    }

    // Reads the card for what's open. One that can't be read or shown (gone, or not this edition's) closes quietly: it
    // may be the presenter's, naming what this page can't show.
    private async Task LoadCard(bool focus = false)
    {
        _product = null;
        switch (TeamEdition ? _popup.Shown : null)
        {
            case { Kind: MeetingCardKind.Product, Id: var id } shown:
                Tide.Application.Stack.StackCard? card = null;
                try { card = await StackSvc.CardAsync(id, _teamMax, ShownArticle()); }
                catch (ForbiddenException) { /* not theirs to read: closed quietly */ }
                // Another was opened (or this one closed, or the edition changed) while it was read: that decides what shows.
                if (_popup.Shown != shown) return;
                _product = card;
                break;
            case { Kind: MeetingCardKind.Indicators or MeetingCardKind.Cves }:
                break;   // drawn from the edition as read (ShownIndicators, ShownCves)
        }
        if (!CardOpen)
        {
            DropCard();
            return;
        }
        DropAction();   // one thing open over the slide at a time
        _focusCard = focus;
    }

    // The presenter's other tab (a projector window) shows what the meeting has open: the presenter opened or closed it
    // from another tab, which this one doesn't hear about through SyncAction (that goes along with someone else's).
    private async Task MirrorPresenter(LiveMeetingView live)
    {
        if (!TeamEdition) return;
        if (live.Action != _actionDetail?.Action.Number)
        {
            if (live.Action is { } n) await LoadAction(n);
            else DropAction();
        }
        if (live.Card != _popup.Shown)
        {
            if (live.Card is { } card)
            {
                _popup.Open(card, presenting: true, inMeeting: true);
                await LoadCard();
            }
            else DropCard();
        }
        // What this presenter's page can't read (gone since) isn't left open for the room, which they couldn't close.
        // Only what's still open for the room: the presenter may have opened another while this was read.
        if (_seat is null) return;
        var now = Meetings.Get(_date);
        if (live.Action is not null && _actionDetail is null && now?.Action == live.Action) Meetings.Open(_seat, null);
        if (live.Card is not null && !CardOpen && now?.Card == live.Card) Meetings.Show(_seat, null);
        Refresh();
    }

    // Goes along with the card the presenter has open, as SyncAction does their action.
    internal async Task SyncCard()
    {
        if (_seat is null || _view is not { } live || Presenting) return;
        if (!TeamEdition)
        {
            DropCard();
            return;
        }
        if (_popup.Sync(live.Card, _following, Held)) await LoadCard();
    }

    private List<RaisedHand> HandsOn(Guid articleId) => _view?.Hands.Where(h => h.ArticleId == articleId).ToList() ?? [];

    private static string Says(LiveMeetingView m, MeetingPerson p)
    {
        var where = m.IsPresenter(p.UserId) ? " (presenting)" : m.Away(p) ? $" (on slide {p.Slide + 1})" : "";
        var hand = m.Hands.Any(h => h.UserId == p.UserId) ? ", hand raised" : "";
        return p.Name + where + hand;
    }

    /// <summary>How many are in the meeting, and how many aren't on the presenter's slide: short, so it's always whole.</summary>
    private static string Here(LiveMeetingView m)
    {
        var away = m.People.Count(m.Away);
        return away == 0 ? $"{m.People.Count} here" : $"{m.People.Count} here · {away} away";
    }

    // --- actions, given to someone at the meeting ----------------------------------------------------------------

    private IReadOnlyList<TeamMember> MembersOf(Guid teamId) => _teams.FirstOrDefault(t => t.Id == teamId)?.Members ?? [];


    // Who can assign it, as ActionService.CanWork decides (and checks again): analysts any action, others their own
    // teams'. Assign offers the action's team's members, the only people AssignAsync gives it to; only they take it.
    private bool CanWork(EditionAction r) => r.Id != Guid.Empty && (_canCreate || _canWork && OnTeam(r));

    private bool OnTeam(EditionAction r) => MembersOf(r.TeamId).Any(m => m.UserId == _me);

    internal Task Take(EditionAction r) => Run(async () =>
    {
        if (!InCharge) return;
        await ActionSvc.TakeAsync(r.Id);
        await LoadActions();
        Toasts.Show($"{Ui.ActionLabel(r.Number)} is yours.");
    });

    // Only the holder changes: the due date is left as it is now (null), not set back to what this page last read, which a
    // colleague may have moved since this page last heard.
    // A choice the service turns away (the person left the team a moment ago) redraws that row's list, as the due box
    // does: the value drawn hasn't changed, so the browser's wouldn't be put back.
    internal async Task Assign(EditionAction r, string? assigneeId)
    {
        if (!InCharge) return;
        var kept = false;
        await Run(async () =>
        {
            await ActionSvc.AssignAsync(r.Id, string.IsNullOrEmpty(assigneeId) ? null : assigneeId, null);
            kept = true;
            await LoadActions();
        });
        if (!kept) _assignResets[r.Id] = AssignResets(r.Id) + 1;
    }

    private readonly Dictionary<Guid, int> _assignResets = [];

    /// <summary>How many times an action's Assign list has been drawn afresh after a refused choice.</summary>
    internal int AssignResets(Guid actionId) => _assignResets.GetValueOrDefault(actionId);

    // The Assign list's key, unlike the due box's beside it (siblings' keys must differ).
    private (string, Guid, int) AssignKey(Guid actionId) => ("assign", actionId, AssignResets(actionId));

    /// <summary>How many times the "Hand off to…" list has been drawn afresh after a refused hand-off.</summary>
    internal int HandOffResets { get; private set; }

    private static DateOnly? DateInput(object? value) => Ui.TryParseDay(value as string, out var d) ? d : null;

    // A new due date, saved as the box is left. One emptied, half typed or refused is drawn afresh with the date the
    // action has (a meeting doesn't clear it), only that row's box.
    private readonly Dictionary<Guid, string?> _dueTyped = [];
    private readonly Dictionary<Guid, int> _dueResets = [];

    private int DueResets(Guid actionId) => _dueResets.GetValueOrDefault(actionId);

    // The date typed and not yet saved, else the action's: a colleague's save heard meanwhile doesn't overwrite it.
    private string? DueShown(EditionAction r) =>
        _dueTyped.TryGetValue(r.Id, out var typed) ? typed : r.DueDate is { } due ? Ui.IsoDay(due) : null;

    // Saved apart from the page's other steps (Run): leaving the box by clicking a button starts this save, and the
    // button's own step mustn't be turned away as "busy" by it.
    // Only the date changes: whoever holds it now keeps it (not this page's copy's holder, who may have been replaced).
    internal async Task SetDue(EditionAction r)
    {
        if (!_dueTyped.Remove(r.Id, out var typed) || !InCharge) return;   // left without a change
        if (DateInput(typed) is { } due && due != r.DueDate)
        {
            try
            {
                await ActionSvc.SetDueAsync(r.Id, due);
                await LoadActions();
            }
            catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
            if (Actions(r.Id)?.DueDate == due) return;   // kept
        }
        _dueResets[r.Id] = DueResets(r.Id) + 1;
    }

    // The action as the edition now has it.
    private EditionAction? Actions(Guid actionId) => _actions?.SelectMany(g => g).FirstOrDefault(a => a.Id == actionId);

    // --- attendance and notes -------------------------------------------------------------------------------------

    /// <summary>Someone at the meeting: in the record (<see cref="Row"/>), here now, or both.</summary>
    private sealed record Attendee(string Key, string Name, bool Here, MeetingAttendee? Row);

    private List<Attendee> Attendance
    {
        get
        {
            var here = _view?.People ?? [];
            var list = _record.Attendees
                .Select(a => new Attendee(a.UserId.Length > 0 ? a.UserId : a.Name, a.Name, a.UserId.Length > 0 && here.Any(p => p.UserId == a.UserId), a))
                .ToList();
            list.AddRange(here.Where(p => _record.Attendees.All(a => a.UserId != p.UserId)).Select(p => new Attendee(p.UserId, p.Name, true, null)));
            return list.OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        }
    }

    /// <summary>The name typed to add to who attended.</summary>
    internal string? AddAttendeeName { get => _addName; set => _addName = value; }

    /// <summary>The undiscussed articles ticked to carry to the next brief.</summary>
    internal IReadOnlyCollection<Guid> Carried => _carry;

    /// <summary>
    /// Whether this page adds to who attended (MeetingService.CanAddAttendees): it's in the brief's live meeting on the
    /// team edition, presenting or following (never a Visitor); or, with none live, it could present and corrects the
    /// record. Never in a rehearsal.
    /// </summary>
    private bool MayAddAttendees => TeamEdition && !RehearsalAsked && _brief is not null && MeetingSvc.CanAddAttendees(_brief.Id);

    /// <summary>Whether this page takes <paramref name="row"/> off who attended (MeetingService.CanRemoveAttendee): never in
    /// a rehearsal.</summary>
    private bool MayRemove(MeetingAttendee row) => TeamEdition && !RehearsalAsked && MeetingSvc.CanRemoveAttendee(row);

    internal Task AddAttendee() => Run(async () =>
    {
        if (!MayAddAttendees) return;
        if (string.IsNullOrWhiteSpace(_addName)) return;
        await MeetingSvc.AddAttendeeAsync(_brief!.Id, _addName);
        _addName = null;
        await ReloadRecord();
    });

    private Task AddNameKey(KeyboardEventArgs e) => e.Key == "Enter" ? AddAttendee() : Task.CompletedTask;

    /// <summary>Who the wrap-up lists as attending, by name.</summary>
    internal IReadOnlyList<string> AttendanceNames => Attendance.Select(a => a.Name).ToList();

    // Whoever added a name, or the presenter: MeetingService checks again as it saves.
    internal Task RemoveAttendee(MeetingAttendee row) => Run(async () =>
    {
        if (!MayRemove(row)) return;
        await MeetingSvc.RemoveAttendeeAsync(row.Id);
        await ReloadRecord();
    });

    private string? ArticleTitle(Guid? articleId) => articleId is { } id ? ItemFor(id)?.Article?.Title : null;

    private string NotePlaceholder => ArticleTitle(ShownArticle()) is { } title ? "On " + title : "On the meeting";

    // What a note being written is on: the article on screen (null, the meeting) as its first words were typed. The
    // presenter moving the slide on meanwhile doesn't file it against the next article, whose title the box, hidden
    // behind the words, no longer shows.
    private sealed record NoteOn(Guid? ArticleId);
    private NoteOn? _noteOn;

    internal void TypeNote(string? text)
    {
        if (string.IsNullOrWhiteSpace(_noteText) && !string.IsNullOrWhiteSpace(text)) _noteOn = new(ShownArticle());
        _noteText = text;
    }

    // The note's article, while it's still on the brief; else (gone since, or never said) the one on screen.
    private Guid? NoteArticle => _noteOn is { } on && (on.ArticleId is null || ItemFor(on.ArticleId.Value) is not null) ? on.ArticleId : ShownArticle();

    // Said under the box once the slide has moved on from what the note is on.
    private string? NoteElsewhere =>
        NoteDirty && _noteOn is not null && NoteArticle != ShownArticle() ? ArticleTitle(NoteArticle) ?? "the meeting" : null;

    private void DiscardNote() => (_noteText, _noteOn) = (null, null);

    internal Task AddNote() => Run(async () =>
    {
        if (string.IsNullOrWhiteSpace(_noteText)) return;
        await MeetingSvc.AddNoteAsync(_brief!.Id, NoteArticle, _noteText);
        (_noteText, _noteOn) = (null, null);
        await ReloadRecord();
    });

    private void EditNote(MeetingNote n) => (_editingNote, _editText) = (n.Id, n.Text);

    private Task SaveEdit() => Run(async () =>
    {
        if (_editingNote is not { } id || string.IsNullOrWhiteSpace(_editText)) return;
        await MeetingSvc.EditNoteAsync(id, _editText);
        _editingNote = null;
        await ReloadRecord();
    });

    private async Task DeleteNote(MeetingNote n)
    {
        if (!await _confirm.Ask("Delete this note?", n.Text, "Delete", danger: true)) return;
        await Run(async () =>
        {
            await MeetingSvc.DeleteNoteAsync(n.Id);
            await ReloadRecord();
        });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;   // a join or follow still under way doesn't take a seat for a page that's gone
        Meetings.Changed -= OnMeetingChanged;
        Meetings.Scrolled -= OnMeetingScrolled;
        Clock.Changed -= OnOrgChanged;
        LeaveMeeting();
        _live?.Dispose();
        if (_clock is not null) await _clock.DisposeAsync();
        await JS.StopAsync("tidePresent.stop");
        if (_handsPopout is not null) await _handsPopout.DisposeAsync();
        _ref?.Dispose();
    }
}
