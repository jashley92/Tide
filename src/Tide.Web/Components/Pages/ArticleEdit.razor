@page "/articles/{Id:guid}"
@attribute [Authorize(Policy = Policies.ReadTeamEdition)]

@* An article: the editor (ArticleEditorPanel holds the fields, saving and everything around them) and, in its context
   rail (or as the page, for someone who can't edit), ReaderPreview's tabs: Preview (the article as an edition will carry it, its gaps, its related work, whose "Mention"
   writes into the editor's why it matters), Actions and Details.
   ?edition=company opens the preview on the company-wide edition; ?side=actions or ?side=details opens that tab (in a
   narrow window, on the preview pane). On today's brief, BriefStepper walks to the article
   before or after it, in the edition the preview shows. *@
<ArticleEditorPanel Id="Id" @ref="_panel" StartPane="@(Side is "actions" or "details" ? ArticleEditorPanel.PreviewPane : null)">
    <Stepper>
        <BriefStepper ArticleId="Id" EditionKey="@_edition" SideKey="@_side" />
    </Stepper>
    <Aside Context="ed">
        <ReaderPreview State="ed" EditionKey="@_edition" Side="@_side" EditionChanged="e => _edition = e" SideChanged="s => _side = s" OnFocus="Focus" OnFix="Fix" OnMention="Mention" />
    </Aside>
</ArticleEditorPanel>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>The edition the preview opens on: <c>company</c>, or the team edition.</summary>
    [SupplyParameterFromQuery(Name = "edition")] public string? EditionKey { get; set; }

    /// <summary>The tab beside the article to open on: <c>actions</c> or <c>details</c>, else the preview.</summary>
    [SupplyParameterFromQuery(Name = "side")] public string? Side { get; set; }

    private ArticleEditorPanel? _panel;

    // The edition the preview shows: from the address, then as it's switched (which changes the address without a navigation).
    private string? _edition;

    // The tab beside the article, as the address names it and as it's picked.
    private string? _side;

    protected override void OnParametersSet() => (_edition, _side) = (EditionKey, Side);

    private Task Focus(ArticlePart part) => _panel?.FocusFieldAsync(part) ?? Task.CompletedTask;

    private Task Fix(ArticleFix fix) => _panel?.FixAsync(fix) ?? Task.CompletedTask;

    private Task Mention(string text) => _panel?.MentionAsync(text) ?? Task.CompletedTask;
}
