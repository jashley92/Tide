@page "/stack"
@page "/stack/{Id:guid}"
@attribute [Authorize(Policy = Policies.ReadTeamEdition)]
@using Tide.Application.Stack
@inject StackService Stack
@inject TeamService TeamSvc
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject ToastService Toasts
@inject OrgClock Clock
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@implements IDisposable

@* Our stack (EP-25): the products the organization runs, kept by analysts. The list puts the products that need a look
   first (StackRow.NeedsLook) and says why: "Right now" has the CVEs on the last week's briefs' articles about the
   product (held to the team edition's ceiling: one seen only above it is counted, not named) and, for those who
   triage, how many new items name it; an old or missing check is flagged. A filter box, quick filters with counts and
   a team narrow it; Add a product opens the add form. A product's page has its other names, versions and notes, and its history:
   the articles tagged with it or naming it, and their actions. Triage lifts items that name a product, and an article
   can be tagged with any number of them from the editor. A product's history is held to the team edition's TLP ceiling:
   articles above it, and actions raised from them, are counted but not named. A colleague's change to a product
   re-reads the page in place; the edit form keeps what's typed in it. *@

<PageTitle>@(_detail?.Product.Name ?? "Our stack") · TIDE</PageTitle>

@if (Id is null)
{
    <div class="tide-page-head">
        <div>
            <h1>Our stack</h1>
            <div class="tide-sub">Triage raises new items that name a product or one of its aliases; those items never age out. Changes are audited.</div>
        </div>
        @if (_canWrite)
        {
            <button type="button" class="btn btn-primary btn-sm" aria-expanded="@Ui.Aria(_adding)" @onclick="ToggleAdd" @ref="_addButton">Add a product</button>
        }
    </div>
    @if (_canWrite && _adding)
    {
        <div class="tide-card">
            <h2>Add a product</h2>
            <div class="row g-2 align-items-end">
                <div class="col-md-4"><label class="tide-field-label" for="new-name">Product</label>
                    <input id="new-name" class="form-control form-control-sm" maxlength="100" placeholder="GitLab" @bind="_newName" @ref="_nameBox" /></div>
                <div class="col-md-5"><label class="tide-field-label" for="new-others">Other names it's reported under</label>
                    <input id="new-others" class="form-control form-control-sm" maxlength="500" placeholder="GitLab CE; GitLab Runner" @bind="_newOthers" /></div>
                <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary btn-sm flex-fill" disabled="@_busy" @onclick="Add">Add</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleAdd">Cancel</button></div>
            </div>
        </div>
    }
    @if (_list is null)
    {
        <LoadingBlock />
    }
    else if (_list.Count == 0)
    {
        <div class="tide-card">
            <EmptyState Icon="bi-hdd-stack" Title="Nothing on Our stack yet.">Add the products you run, or add one from a triage item ("Add to what we run…").</EmptyState>
        </div>
    }
    else
    {
        var shown = Shown;
        @* The filters above the list: the words, a quick filter per reason to look (in + Filter too), a team, and the
           retired ones; the count says the order. *@
        <FilterBar Pills="Pills" Filters="Filters" Active="Narrowed" OnClear="ClearFilters" OnChanged="Refiltered"
                   Count="@($"{TableView.Count(1, shown.Count, shown.Count, _list.Count, Narrowed, "product", "products")} · most pressing first")">
            <Search>
                <input id="stack-q" type="search" class="tide-maxw-md form-control form-control-sm" placeholder="Product, other name or version" aria-label="Filter products"
                       @bind:get="_words" @bind:set="SetWords" @bind:event="oninput" />
            </Search>
            <ChildContent>
                <select id="stack-team" class="form-select form-select-sm tide-stack-team" aria-label="Owning team" @bind:get="_team ?? string.Empty" @bind:set="SetTeam">
                    <option value="">Any team</option>
                    @foreach (var t in TeamOptions) { <option value="@t.Value">@t.Label</option> }
                </select>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="show-retired" checked="@_showRetired" @onchange="ToggleRetired" />
                    <label class="form-check-label small" for="show-retired">Show retired products</label>
                </div>
            </ChildContent>
        </FilterBar>
        <div class="tide-card">
            @if (shown.Count == 0)
            {
                <EmptyState Icon="bi-funnel" Title="No product matches these filters." Compact="true" />
            }
            else
            {
                @* Each row's cells stack on a narrow window (data-label names each), so the list never scrolls sideways. *@
                <div class="table-responsive tide-stack-list">
                    <table class="tide-table tide-stack-table">
                        <caption class="visually-hidden">Our stack: products that need a look first</caption>
                        <thead><tr><th scope="col">Product</th><th scope="col">Versions</th><th scope="col">Team</th><th scope="col">Checked</th><th scope="col">Right now</th>
                            <th scope="col" class="tide-table-num">Articles</th><th scope="col" class="tide-table-num">Open actions</th></tr></thead>
                        <tbody>
                            @foreach (var r in shown)
                            {
                                <tr class="@(r.Product.IsRetired ? "tide-muted" : "")" @key="r.Product.Id">
                                    <td><a href="@($"stack/{r.Product.Id}")">@r.Product.Name</a>
                                        @if (r.Product.OtherNames is { } o) { <div class="small tide-muted">also @o</div> }
                                        @if (r.Product.IsRetired) { <Badge Tone="BadgeTone.Neutral">Retired</Badge> }</td>
                                    <td data-label="Versions">@(r.Product.Versions ?? "—")</td>
                                    <td data-label="Team">@if (r.TeamName is { } owner) { @owner } else if (r.NoTeam) { <Badge Tone="BadgeTone.Neutral" Class="tide-badge-off">No team</Badge> } else { <text>—</text> }</td>
                                    <td data-label="Checked">@if (r.Product.CheckedOn is { } on) { @Ui.ShortDay(on, Clock.Today) }
                                        @if (r.CheckOld) { <Badge Tone="BadgeTone.Warn" Icon="bi-clock-history">@(r.Product.CheckedOn is null ? "Never checked" : $"Over {StackService.CheckOldAfterDays} days ago")</Badge> }
                                        else if (r.Product.CheckedOn is null) { <text>—</text> }</td>
                                    <td class="tide-stack-now" data-label="Right now">
                                        @foreach (var c in r.Now.Cves.Take(CvesShown)) { <CveChip CveId="@c.Id" Record="c.Record" /> }
                                        @if (r.Now.Cves.Count > CvesShown) { <a class="small" href="@($"stack/{r.Product.Id}")">+@(r.Now.Cves.Count - CvesShown) more</a> }
                                        @if (r.Now.CvesAbove > 0) { <div class="small tide-muted">@AboveLine(r.Now.CvesAbove, "CVE", _ceiling)</div> }
                                        @if (r.Now.TriageItems is > 0 || r.Now.BriefedToday)
                                        {
                                            <div class="small">@if (r.Now.TriageItems is > 0 and var n) { <a href="triage?named=true">@n new in triage</a> }@Said(r.Now)</div>
                                        }
                                        @if (!r.Now.Any && !r.Now.BriefedToday) { <span class="small tide-muted">Nothing new</span> }
                                    </td>
                                    <td class="tide-table-num" data-label="Articles">@r.Articles</td>
                                    <td class="tide-table-num" data-label="Open actions">@r.OpenActions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}
else if (_detail is null)
{
    @if (_loaded) { <div class="tide-card"><EmptyState Icon="bi-hdd-stack" Title="Product not found"><a href="stack">Back to Our stack</a></EmptyState></div> }
    else { <LoadingBlock /> }
}
else
{
    var p = _detail.Product;
    <nav aria-label="Breadcrumb" class="tide-crumbs"><a href="stack">Our stack</a> &rsaquo; @p.Name</nav>
    <div class="tide-page-head">
        <div>
            <h1>@p.Name @if (p.IsRetired) { <Badge Tone="BadgeTone.Neutral">Retired</Badge> }</h1>
            <div class="tide-sub">@(_detail.TeamName is { } t ? $"{t} · " : "")@(p.CheckedOn is { } c ? $"checked {Ui.ShortDay(c)}" : "not checked yet")
                @if (p.ModifiedAtUtc is { } m) { <text> &middot; edited @Ui.When(Clock, m)</text> }</div>
        </div>
        @if (_canWrite)
        {
            <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => Retire(!p.IsRetired)">@(p.IsRetired ? "Bring back" : "Retire")</button>
        }
    </div>
    <div class="tide-today-grid">
        <div>
            <section class="tide-card" aria-labelledby="stack-about-h" data-submit-scope>
                <h2 id="stack-about-h">About it <TlpBadge Level="TlpLevel.Amber" /></h2>
                @if (_canWrite && _form is { } f)
                {
                    <ChangedElsewhere By="@_changedBy" What="product" OnReload="ReloadTheirs" />
                    <div class="row g-2">
                        <div class="col-md-6"><label class="tide-field-label" for="f-name">Product</label>
                            <input id="f-name" class="form-control form-control-sm" maxlength="100" @bind="f.Name" /></div>
                        <div class="col-md-6"><label class="tide-field-label" for="f-others">Other names it's reported under</label>
                            <input id="f-others" class="form-control form-control-sm" maxlength="500" placeholder="Separate with semicolons" @bind="f.OtherNames" /></div>
                        <div class="col-md-6"><label class="tide-field-label" for="f-versions">Versions in use</label>
                            <input id="f-versions" class="form-control form-control-sm" maxlength="200" placeholder="17.11.3 self-managed" @bind="f.Versions" /></div>
                        <div class="col-md-3"><label class="tide-field-label" for="f-team">Owning team</label>
                            <select id="f-team" class="form-select form-select-sm" @bind="TeamValue">
                                <option value="">None</option>
                                @foreach (var team in _teams) { <option value="@team.Id">@team.Name</option> }
                            </select></div>
                        <div class="col-md-3"><label class="tide-field-label" for="f-checked">Checked on</label>
                            <input id="f-checked" type="date" class="form-control form-control-sm" @bind="f.CheckedOn" /></div>
                        <div class="col-md-6"><label class="tide-field-label" for="f-contact-name">Vendor or support contact</label>
                            <input id="f-contact-name" class="form-control form-control-sm" maxlength="@Tide.Domain.Entities.StackProduct.MaxContactName" placeholder="Vendor PSIRT" @bind="f.ContactName" /></div>
                        <div class="col-md-6"><label class="tide-field-label" for="f-contact-email">Contact's email</label>
                            <input id="f-contact-email" type="email" class="form-control form-control-sm" maxlength="@Tide.Domain.Entities.StackProduct.MaxContactEmail" placeholder="psirt@vendor.example"
                                   aria-describedby="f-contact-help" @bind="f.ContactEmail" />
                            <div class="form-text" id="f-contact-help">Offered as the To line when an Outreach action's email is about this product.</div></div>
                        <div class="col-12"><label class="tide-field-label" for="f-notes">Notes (Markdown)</label>
                            <MarkdownToolbar For="f-notes" Label="Notes" BindsOnChange="true" />
                            <textarea id="f-notes" class="form-control form-control-sm tide-autogrow" rows="5" maxlength="4000"
                                      placeholder="Where it runs, who to ask, change windows, past decisions" @bind="f.Notes"></textarea></div>
                    </div>
                    <button class="btn btn-primary btn-sm mt-2" disabled="@_busy" data-submit @onclick="Save">Save</button>
                }
                else
                {
                    <dl class="tide-stack-facts">
                        <dt>Other names</dt><dd>@(p.OtherNames ?? "—")</dd>
                        <dt>Versions</dt><dd>@(p.Versions ?? "—")</dd>
                        <dt>Contact</dt><dd>@Contact(p)</dd>
                    </dl>
                    @if (p.Notes is { } notes) { <Md Text="@notes" /> } else { <p class="small tide-muted mb-0">No notes yet.</p> }
                }
            </section>
        </div>
        <div>
            <section class="tide-card" aria-labelledby="stack-articles-h">
                <h2 id="stack-articles-h">Articles <span class="tide-count">(@(_detail.Articles.Count + _detail.ArticlesAbove))</span></h2>
                @if (_detail.Articles.Count == 0 && _detail.ArticlesAbove == 0) { <div class="small tide-muted">No articles yet.</div> }
                <ul class="list-unstyled mb-0">
                    @foreach (var a in _detail.Articles)
                    {
                        <li class="tide-stack-row"><a href="@($"articles/{a.Id}")">@a.Title</a>
                            <span class="small tide-muted">@Ui.ShortDay(a.On) &middot; @(a.Tagged ? "tagged" : "names it")</span></li>
                    }
                </ul>
                @if (_detail.ArticlesAbove > 0) { <div class="small tide-muted mt-1">@AboveLine(_detail.ArticlesAbove, "article", _detail.Ceiling)</div> }
            </section>
            <section class="tide-card" aria-labelledby="stack-actions-h">
                <h2 id="stack-actions-h">Actions <span class="tide-count">(@(_detail.Actions.Count + _detail.ActionsAbove))</span></h2>
                @if (_detail.Actions.Count == 0 && _detail.ActionsAbove == 0) { <div class="small tide-muted">No actions yet.</div> }
                <ul class="list-unstyled mb-0">
                    @foreach (var a in _detail.Actions)
                    {
                        <li class="tide-stack-row"><PriorityBadge Priority="a.Priority" /> <ActionRef Number="a.Number" Title="@a.Title" />
                            <span class="small tide-muted">&middot; @a.TeamName &middot; @(a.AssigneeName ?? "unassigned")</span>
                            <ActionStatusBadge Status="a.Status" /></li>
                    }
                </ul>
                @if (_detail.ActionsAbove > 0) { <div class="small tide-muted mt-1">@AboveLine(_detail.ActionsAbove, "action", _detail.Ceiling, "from articles ")</div> }
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private IReadOnlyList<StackRow>? _list;
    private StackDetail? _detail;
    private StackForm? _form;
    private IReadOnlyList<Tide.Domain.Entities.Team> _teams = [];
    private bool _canWrite, _busy, _loaded, _showRetired, _adding;
    private string? _newName, _newOthers;

    // --- the list's filters: what's typed, the quick filters pressed (each narrows further) and one owning team ---

    /// <summary>How many CVEs a row's "Right now" shows before "+2 more" (the worst are first).</summary>
    internal const int CvesShown = 3;

    /// <summary>A quick filter: its key, what its pill says, and the rows it keeps.</summary>
    internal sealed record QuickFilter(string Key, string Label, string Title, Func<StackRow, bool> Matches);

    internal static readonly IReadOnlyList<QuickFilter> Quick =
    [
        new("look", "Needs a look", "Something is happening right now, the check is old or missing, or no team owns it", r => r.NeedsLook),
        new("old", "Check is old", $"Never checked, or checked more than {StackService.CheckOldAfterDays} days ago", r => r.CheckOld),
        new("noteam", "No owning team", "In use, with no team that owns it", r => r.NoTeam),
    ];

    private TlpLevel _ceiling;
    private string _words = "";
    private string? _team;
    private readonly HashSet<string> _quick = [];

    private bool Narrowed => _words.Trim().Length > 0 || _team is not null || _quick.Count > 0;

    // The bar's pills, each with how many products it would keep, and its filters: a switch behind each pill (offered in
    // + Filter too), and the team, chosen from its own list beside them.
    private IReadOnlyList<FilterPill> Pills =>
        [.. Quick.Select(q => new FilterPill(q.Key, $"{q.Label} ({_list!.Count(q.Matches)})", q.Key, FilterValues.Of(true)) { Title = q.Title })];

    private IReadOnlyList<FilterDef> Filters =>
    [
        .. Quick.Select(q => new FilterDef(q.Key, q.Label, FilterKind.Single, v => SetQuick(q.Key, v.Count > 0)) { Values = FilterValues.Of(_quick.Contains(q.Key)) }),
        new("team", "Owning team", FilterKind.Single, v => SetTeam(FilterValues.First(v))) { InMenu = false, Values = FilterValues.Of(_team), Options = TeamOptions },
    ];

    // The teams that own a product on the list, by name.
    private IReadOnlyList<FilterOption> TeamOptions =>
        [.. (_list ?? []).Where(r => r.Product.TeamId is not null).Select(r => new FilterOption(r.Product.TeamId!.Value.ToString(), r.TeamName ?? "")).Distinct().OrderBy(o => o.Label, StringComparer.OrdinalIgnoreCase)];

    /// <summary>The rows the filters leave, in the list's order.</summary>
    internal IReadOnlyList<StackRow> Shown
    {
        get
        {
            var words = _words.Trim();
            return (_list ?? []).Where(r => Quick.All(q => !_quick.Contains(q.Key) || q.Matches(r))
                && (_team is null || r.Product.TeamId?.ToString() == _team)
                && (words.Length == 0 || new[] { r.Product.Name, r.Product.OtherNames, r.Product.Versions }.Any(x => x?.Contains(words, StringComparison.OrdinalIgnoreCase) == true))).ToList();
        }
    }

    // Opening the add form puts focus in its first box, and closing it puts focus back on the button that opened it.
    private ElementReference _addButton, _nameBox;
    private bool _focusAdd;

    internal void ToggleAdd() => (_adding, _focusAdd) = (!_adding, true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAdd) return;
        _focusAdd = false;
        try { await (_adding ? _nameBox : _addButton).FocusAsync(); }
        catch (JSDisconnectedException) { /* the tab has gone */ }
        catch (JSException) { /* the element went before focus reached it */ }
    }
    internal void SetWords(string? words) => _words = words ?? "";
    internal void SetTeam(string? team) => _team = string.IsNullOrEmpty(team) ? null : team;
    internal void SetQuick(string key, bool on) { if (on) _quick.Add(key); else _quick.Remove(key); }
    private void ClearFilters() { (_words, _team) = ("", null); _quick.Clear(); }
    private static void Refiltered() { }   // nothing to read again: the bar's call draws the page with the filter it set

    private string TeamValue
    {
        get => _form?.TeamId?.ToString() ?? "";
        set { if (_form is not null) _form.TeamId = Guid.TryParse(value, out var g) ? g : null; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _canWrite = CurrentUser.Has(Permission.WriteArticles);
        await Load();
    }

    /// <summary>"2 articles above TLP:AMBER": what the page counts but doesn't name.</summary>
    internal static string AboveLine(int count, string noun, TlpLevel ceiling, string via = "") =>
        $"{count} {noun}{(count == 1 ? "" : "s")} {via}above {Tlp.Label(ceiling)}";

    // After the triage count: whether it's on today's brief, or the news about it isn't written up yet.
    private static string Said(StackNow now)
    {
        var said = now.BriefedToday ? "briefed today" : now.NotWrittenUp ? "not written up" : "";
        return said.Length == 0 ? "" : now.TriageItems > 0 ? " · " + said : said;
    }

    // A colleague added, edited or retired a product: re-read in place. The edit form keeps what's typed in it, and says
    // who saved it meanwhile (saving it then is refused by the product's edit version); one not touched takes their change.
    private LiveChanges? _live;
    private string? _changedBy;
    internal string? ChangedBy => _changedBy;

    protected override void OnInitialized() =>
        _live = new LiveChanges(Feed, Origin, c => c.Topic == ChangeFeed.Stack, InvokeAsync, OnChangedElsewhere);

    public void Dispose() => _live?.Dispose();

    internal async Task OnChangedElsewhere(IReadOnlyList<Change> heard)
    {
        if (_busy || !_loaded) return;   // a step is under way, and it reads theirs when it's done
        var who = LiveChanges.Who(heard);
        try
        {
            if (Id is { } id)
            {
                var before = _detail?.Product;
                _detail = await Stack.GetAsync(id);
                var now = _detail?.Product;
                if (now is null) _form = null;
                else if (_form is null || before is null || Untouched(_form, before)) (_form, _changedBy) = (StackForm.From(now), null);
                else if (now.EditVersion != _form.EditVersion) _changedBy = who;
                // The topic is every product's: only a change to this one is told.
                if (before is not null && (now is null || now.ModifiedAtUtc != before.ModifiedAtUtc || now.IsRetired != before.IsRetired))
                    Toasts.Show($"{who} updated this product.");
            }
            else
            {
                await ReadList();
                Toasts.Show($"{who} updated Our stack.");
            }
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        StateHasChanged();
    }

    /// <summary>Whether the edit form still holds the product as it was read (nothing typed in it).</summary>
    internal static bool Untouched(StackForm f, Tide.Domain.Entities.StackProduct p) =>
        Same(f.Name, p.Name) && Same(f.OtherNames, p.OtherNames) && Same(f.Versions, p.Versions) && Same(f.Notes, p.Notes)
        && f.TeamId == p.TeamId && f.CheckedOn == p.CheckedOn && Same(f.ContactName, p.ContactName) && Same(f.ContactEmail, p.ContactEmail);

    /// <summary>"Vendor PSIRT, psirt@vendor.example", or a dash.</summary>
    internal static string Contact(Tide.Domain.Entities.StackProduct p) =>
        string.Join(", ", new[] { p.ContactName, p.ContactEmail }.Where(x => !string.IsNullOrWhiteSpace(x))) is { Length: > 0 } c ? c : "—";

    private static bool Same(string? a, string? b) => string.Equals(a ?? "", b ?? "", StringComparison.Ordinal);

    internal StackForm? Form => _form;
    internal StackDetail? Detail => _detail;
    internal IReadOnlyList<StackRow>? List => _list;

    private async Task ReadList()
    {
        var list = await Stack.OverviewAsync(_showRetired);
        (_list, _ceiling) = (list.Rows, list.Ceiling);
    }

    private async Task Load()
    {
        try
        {
            if (Id is { } id)
            {
                _detail = await Stack.GetAsync(id);
                _form = _detail is null ? null : StackForm.From(_detail.Product);
                _changedBy = null;
                if (_canWrite && _teams.Count == 0) _teams = await TeamSvc.ListAsync();
            }
            else await ReadList();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        _loaded = true;
    }

    private async Task ToggleRetired(ChangeEventArgs e)
    {
        _showRetired = e.Value is true;
        await Load();
    }

    private async Task Run(Func<Task> step)
    {
        if (_busy) return;
        _busy = true;
        try { await step(); }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    internal Task Add() => Run(async () =>
    {
        var id = await Stack.SaveAsync(new StackForm { Name = _newName ?? "", OtherNames = _newOthers });
        Toasts.Show($"{_newName?.Trim()} added.");
        // Done with the form: the list and the product's page are one component, so Back would otherwise open it again.
        (_newName, _newOthers, _adding) = (null, null, false);
        Nav.NavigateTo($"stack/{id}");
    });

    internal Task Save() => Run(async () =>
    {
        await Stack.SaveAsync(_form!);
        Toasts.Show("Saved.");
        await Load();
    });

    // The banner's Reload: their version, and what was typed goes.
    internal async Task ReloadTheirs()
    {
        await Load();
        Toasts.Show("Reloaded. Your unsaved changes were dropped.");
    }

    private Task Retire(bool retired) => Run(async () =>
    {
        await Stack.SetRetiredAsync(_detail!.Product.Id, retired);
        Toasts.Show(retired ? "Retired. Its history stays; triage no longer lifts it." : "Back on Our stack.");
        await Load();
    });
}
