    // The team's opening note (team edition only): written by analysts until the brief is sent, read by everyone else.
    // Markdown, as an article's longer fields are, so bullets and sub-bullets show on the slide and in the email.
    private RenderFragment TeamNoteCard() => __builder =>
    {
        var editable = _canWrite && _brief!.Status != BriefStatus.Sent;
        if (!editable && string.IsNullOrWhiteSpace(_brief!.TeamNote)) return;
        <section class="tide-card" aria-labelledby="team-note-h" data-submit-scope>
            <h2 id="team-note-h">Opening note <span class="ms-auto small fw-normal tide-muted">team edition only</span></h2>
