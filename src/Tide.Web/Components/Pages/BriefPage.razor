        @if (_queue?.Escalated is { Count: > 0 } rows)
        {
            <section class="tide-card tide-escalated" aria-labelledby="escalated-h">
                <h2 id="escalated-h"><span class="bi bi-arrow-up-circle-fill text-danger" aria-hidden="true"></span> Escalated <span class="tide-count">(@rows.Count)</span>
                    <a class="ms-auto small fw-normal" href="actions?view=overdue">Overdue</a></h2>
                <p class="small tide-muted mb-1">Slipping long enough that the escalation ladder flagged them. Each stays until it closes or its due date moves.</p>
                @foreach (var r in rows)
                {
                    @QueueRow(r, $"{r.Priority} · {r.TeamName} · {r.AssigneeName ?? "Unassigned"}"
                                 + (r.ParentNumber is { } parent ? $" · part of {Ui.ActionLabel(parent)}" : ""), offerTake: false)
                }
            </section>
        }
    };

    // One row of a Today action list (the queue, the team's unassigned, the escalated): its number, title and files, a
    // line about it with how late it is, then Take it (when it's nobody's and offered) or its due-date badge.
    private RenderFragment QueueRow(ActionRow r, string meta, bool offerTake) => __builder =>
    {
        <div class="tide-queue-row @_actionMarks?.Css(r.Id)" @key="r.Id">
            <a class="tide-action-num" href="@Ui.ActionUrl(r.Number)">@Ui.ActionLabel(r.Number)</a>
            <span class="tide-queue-title">
                @r.Title <FileCount Count="r.Files" />
                <span class="tide-queue-meta">
                    @meta
                    @if (ActionSla.LateText(r.DueDate, ActionSvc.Today) is { } late)
                    {
                        <span>&middot; <span class="tide-queue-late">@late</span></span>
                    }
                </span>
            </span>
            @if (offerTake && r.AssigneeId is null)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" disabled="@_busy" @onclick="() => Take(r)"
                        aria-label="@($"Take {Ui.ActionLabel(r.Number)} on: {r.Title}")">Take it</button>
            }
            else
            {
                <SlaBadge State="r.Sla(ActionSvc.Today, Clock.Days)" Due="r.DueDate" />
            }
        </div>
    };

    private RenderFragment MyActions() => __builder =>
    {
        @if (_mine is not null)
        {
            <section class="tide-card" aria-labelledby="my-actions-h">
                <h2 id="my-actions-h">My actions <span class="tide-count">(@_mine.Count)</span> <a class="ms-auto small fw-normal" href="actions?view=mine">All</a></h2>
                @if (_mine.Count == 0)
                {
                    <EmptyState Icon="bi-check2-circle" Title="Nothing assigned to you." Compact="true" />
                }
                @foreach (var r in _mine.Take(6))
                {
                    <div class="d-flex gap-2 align-items-start py-1 border-bottom small @_actionMarks?.Css(r.Id)" @key="r.Id">
                        <a class="tide-action-num" href="@Ui.ActionUrl(r.Number)">@Ui.ActionLabel(r.Number)</a>
                        <span class="flex-grow-1">@r.Title <FileCount Count="r.Files" /></span>
                        <SlaBadge State="r.Sla(ActionSvc.Today, Clock.Days)" Due="r.DueDate" Today="ActionSvc.Today" />
                    </div>
                }
            </section>
        }
    };

    // An analyst on a team: one Actions card, their own and the team's unassigned ones on two tabs, where My actions and
    // the team queue used to list the same rows twice.
    private RenderFragment ActionsCard() => __builder =>
    {
        @if (_mine is not null && _queue is { } q)
        {
            var unassigned = q.Rows.Where(r => r.AssigneeId is null).ToList();
            var team = _actionsTab == "team";
            <section class="tide-card" aria-labelledby="actions-card-h">
                <h2 id="actions-card-h">Actions <a class="ms-auto small fw-normal" href="@(team ? "actions?view=myteams" : "actions?view=mine")">All</a></h2>
                <div class="tide-seg mb-2" role="group" aria-label="Whose actions">
                    <button type="button" class="tide-seg-opt @(team ? "" : "on")" aria-pressed="@(team ? "false" : "true")" @onclick="@(() => _actionsTab = "mine")">Mine <span class="tide-count">@_mine.Count</span></button>
                    <button type="button" class="tide-seg-opt @(team ? "on" : "")" aria-pressed="@Ui.Aria(team)" @onclick="@(() => _actionsTab = "team")">Team, unassigned <span class="tide-count">@q.Unassigned</span></button>
                </div>
                @if (!team)
                {
                    @if (_mine.Count == 0) { <EmptyState Icon="bi-check2-circle" Title="Nothing assigned to you." Compact="true" /> }
                    @foreach (var r in _mine.Take(6))
                    {
                        <div class="d-flex gap-2 align-items-start py-1 border-bottom small @_actionMarks?.Css(r.Id)" @key="r.Id">
                            <a class="tide-action-num" href="@Ui.ActionUrl(r.Number)">@Ui.ActionLabel(r.Number)</a>
                            <span class="flex-grow-1">@r.Title <FileCount Count="r.Files" /></span>
                            <SlaBadge State="r.Sla(ActionSvc.Today, Clock.Days)" Due="r.DueDate" Today="ActionSvc.Today" />
                        </div>
                    }
                }
                else
                {
                    @if (unassigned.Count == 0) { <EmptyState Icon="bi-check2-circle" Title="Nothing unassigned on your teams." Compact="true" /> }
                    @foreach (var r in unassigned)
                    {
                        @QueueRow(r, $"{ActionService.KindName(r.Kind)} · {r.TeamName}", offerTake: true)
                    }
                }
            </section>
        }
    };

    private string _actionsTab = "mine";

    // What a reader of the brief who can't write is shown of each article's readiness: nothing.
    private static readonly IReadOnlyDictionary<Guid, IReadOnlyList<ArticleCheck>> NoReadiness = new Dictionary<Guid, IReadOnlyList<ArticleCheck>>();

    // Beside today's brief: an analyst's actions (on a team, with the team's unassigned ones; action owners have the
    // queue first), the rotation and recent articles.
    private RenderFragment Side() => __builder =>
    {
        @if (_canWrite)
        {
            <ReviewsForYou />
            @Escalated()
            @if (_queue is { OnATeam: true }) { @ActionsCard() } else { @MyActions() }
        }
        <section class="tide-card" aria-labelledby="coming-up-h">
            <h2 id="coming-up-h">Coming up for you <a class="ms-auto small fw-normal" href="rotation">Rotation</a></h2>
            @if (_upcoming is { } up)
            {
                @if (up.ToApprove.Count > 0)
                {
                    <div class="small text-danger mb-1"><span class="bi bi-exclamation-circle" aria-hidden="true"></span> <a href="rotation">@up.ToApprove.Count swap or cover request@(up.ToApprove.Count == 1 ? "" : "s") waiting for you</a></div>
                }
                @if (up.MyRuns.Count == 0)
                {
                    <div class="small tide-muted">You're not on the rotation in the coming weeks.</div>
                }
                <ul class="list-unstyled small mb-0">
                    @foreach (var run in up.MyRuns.Take(3))
                    {
                        <li>You present @(run.From == run.To ? Ui.ShortDay(run.From) : $"{Ui.ShortDay(run.From)} to {Ui.ShortDay(run.To)}")</li>
                    }
                </ul>
            }
        </section>
        <section class="tide-card" aria-labelledby="recent-h">
            <h2 id="recent-h">Recently written <span class="tide-count">(@_recent.Count)</span></h2>
            @if (_recent.Count == 0)
            {
                <EmptyState Icon="bi-file-earmark-text" Title="No articles yet." Compact="true" />
            }
            <ul class="list-unstyled mb-0">
                @foreach (var r in _recent)
                {
                    <li class="mb-2">
                        <a href="articles/@r.Id" class="fw-semibold text-decoration-none">@r.Title</a>
                        <div class="tide-run-meta">
                            <ClassBadge Classification="r.Classification" Priority="r.Priority" />
                            <StatusBadge Status="@r.Status.ToString()" />
                            <span>@r.AuthorName &middot; @Ui.When(Clock, r.CreatedAtUtc)</span>
                        </div>
                    </li>
                }
            </ul>
            @if (_canWrite)
            {
                <a class="btn btn-outline-secondary btn-sm mt-2" href="articles?new=1"><span class="bi bi-plus-lg" aria-hidden="true"></span> New article</a>
            }
        </section>
    };
}
