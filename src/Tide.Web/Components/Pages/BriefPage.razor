            {
                <label class="visually-hidden" for="team-note">Opening note</label>
                <MarkdownToolbar For="team-note" Label="Opening note" />
                <textarea id="team-note" class="form-control tide-autogrow tide-grow-3" rows="3" maxlength="@BriefService.TeamNoteMax" aria-describedby="team-note-help"
                          placeholder="Key items coming up, recent phishing trends: read at the start of the meeting." @bind="_teamNote" @bind:event="oninput"></textarea>
                <div class="form-text" id="team-note-help">Markdown works: - bullets, indented two spaces for a sub-bullet, **bold**, _italic_, [text](https://link).
