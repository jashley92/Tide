@page "/admin/playbooks"
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@inject PlaybookService PlaybookSvc
@inject ToastService Toasts

<PageTitle>Playbooks · TIDE</PageTitle>

<ConfirmDialog @ref="_confirm" />

<div class="tide-page-head">
    <div>
        <h1 class="tide-admin-title">Playbooks</h1>
        <div class="tide-sub">Steps are copied onto an action when applied. Editing a playbook doesn't change existing actions.</div>
    </div>
    @if (_editing is null)
    {
        <button class="btn btn-primary" @onclick="New"><span class="bi bi-plus-lg" aria-hidden="true"></span> New playbook</button>
    }
</div>

@if (_editing is not null)
{
    <div class="tide-card-form tide-card">
        <h2>@(_editing.Id is null ? "New playbook" : "Edit " + _editing.Name)</h2>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="tide-field-label" for="pb-name">Name</label>
                <input id="pb-name" class="form-control form-control-sm" maxlength="100" @bind="_editing.Name" placeholder="Ransomware IOC sweep" />
            </div>
            <div class="col-md-4">
                <label class="tide-field-label" for="pb-kind">For</label>
                <select id="pb-kind" class="form-select form-select-sm" @bind="_editing.Kind">
                    <option value="">Any kind of action</option>
                    @foreach (var k in Enum.GetValues<ActionKind>()) { <option value="@k">@ActionService.KindName(k) actions</option> }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pb-active" @bind="_editing.IsActive" />
                    <label class="form-check-label small" for="pb-active">Offered</label>
                </div>
            </div>
            <div class="col-12">
                <label class="tide-field-label" for="pb-desc">What it's for (optional)</label>
                <input id="pb-desc" class="form-control form-control-sm" maxlength="1000" @bind="_editing.Description" />
            </div>
            <div class="col-12">
                <label class="tide-field-label" for="pb-steps">Steps, one per line, in order</label>
                <textarea id="pb-steps" class="form-control form-control-sm tide-autogrow tide-grow-3" rows="8" @bind="_steps"
                          placeholder="@("Pull the advisory's indicators\nSweep proxy logs, 30 days back\nSweep EDR telemetry\nRecord hits and escalate")"></textarea>
                <div class="form-text">Up to @Playbook.MaxSteps steps of @ActionChecklistItem.MaxText characters each.</div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="Save">Save playbook</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editing = null">Cancel</button>
        </div>
    </div>
}

@if (_playbooks.Count == 0)
{
    <EmptyState Icon="bi-journal-check" Title="No playbooks yet" />
}
@foreach (var (p, i) in _playbooks.Select((p, i) => (p, i)))
{
    <div class="tide-card @(p.IsActive ? "" : "tide-retired")" @key="p.Id">
        <h2>
            @p.Name
            <Badge>@(p.Kind is { } k ? ActionService.KindName(k) : "Any kind")</Badge>
            @if (!p.IsActive) { <Badge>Not offered</Badge> }
            <span class="ms-auto d-flex gap-1">
                <button class="btn btn-outline-secondary btn-sm" aria-label="Move @p.Name up" disabled="@(i == 0)" @onclick="() => Move(p, -1)"><span class="bi bi-arrow-up" aria-hidden="true"></span></button>
                <button class="btn btn-outline-secondary btn-sm" aria-label="Move @p.Name down" disabled="@(i == _playbooks.Count - 1)" @onclick="() => Move(p, 1)"><span class="bi bi-arrow-down" aria-hidden="true"></span></button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => Edit(p)"><span class="bi bi-pencil" aria-hidden="true"></span> Edit</button>
                <button class="btn btn-outline-secondary btn-sm" aria-label="Remove @p.Name" @onclick="() => Remove(p)"><span class="bi bi-trash" aria-hidden="true"></span></button>
            </span>
        </h2>
        @if (p.Description is not null) { <p class="small tide-muted">@p.Description</p> }
        <ol class="tide-playbook-preview small mb-0">
            @foreach (var s in p.Steps) { <li>@s.Text</li> }
        </ol>
    </div>
}

@code {
    private ConfirmDialog _confirm = default!;
    private IReadOnlyList<Playbook> _playbooks = [];
    private PlaybookForm? _editing;
    private string? _steps;
    private bool _busy;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load() => _playbooks = await PlaybookSvc.ListAsync(includeRetired: true);

    private void New()
    {
        _editing = new PlaybookForm();
        _steps = null;
    }

    private void Edit(Playbook p)
    {
        _editing = PlaybookForm.From(p);
        _steps = string.Join("\n", _editing.Steps);
    }

    private Task Save() => Run(async () =>
    {
        _editing!.Steps = (_steps ?? "").Split('\n').Select(s => s.Trim()).Where(s => s.Length > 0).ToList();
        await PlaybookSvc.SaveAsync(_editing);
        Toasts.Show($"{_editing.Name.Trim()} saved.");
        _editing = null;
    });

    private Task Move(Playbook p, int by) => Run(() => PlaybookSvc.MoveAsync(p.Id, by));

    private async Task Remove(Playbook p)
    {
        if (!await _confirm.Ask($"Remove {p.Name}?", "It's no longer offered. If an action was started from it, it's kept (not offered) so that action's history still names it; otherwise it's deleted.", "Remove playbook")) return;
        await Run(() => PlaybookSvc.RemoveAsync(p.Id));
    }

    private async Task Run(Func<Task> change)
    {
        if (_busy) return;   // a second click while a save runs: one rule or playbook, not two
        _busy = true;
        try
        {
            await change();
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
}
