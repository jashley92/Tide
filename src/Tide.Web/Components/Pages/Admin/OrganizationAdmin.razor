@page "/admin/organization"
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@using Tide.Application.Settings
@inject OperationalSettingsService Settings
@inject OrgClock Clock
@inject HolidayService Holidays
@inject ToastService Toasts

<PageTitle>Organization settings · TIDE</PageTitle>

@* The time zone, meeting time, team name, where a meeting's action opens and when an action needs review, saved in the app over the server's Org values (the installer's answers). *@
<div class="tide-page-head">
    <div>
        <h1 class="tide-admin-title">Organization settings</h1>
        <div class="tide-sub">Until saved here, the server's value (<code>Org</code> in <code>appsettings.Production.json</code>, from the installer) is used.</div>
    </div>
</div>

<section class="tide-card" aria-labelledby="org-title">
    <h2 id="org-title"><span class="bi bi-building" aria-hidden="true"></span> Organization</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="tide-field-label" for="org-name">Team name</label>
            <input id="org-name" class="form-control form-control-sm" maxlength="@OperationalSettings.MaxTeamName" @bind="_teamName" aria-describedby="org-name-help" />
            <div class="form-text" id="org-name-help">Shown in the header, on slides and in the brief's email.</div>
        </div>
        <div class="col-md-6">
            <label class="tide-field-label" for="org-zone">Time zone</label>
            <select id="org-zone" class="form-select form-select-sm" @bind="Zone" aria-describedby="org-zone-help">
                @foreach (var (id, label) in _zones)
                {
                    <option value="@id">@label</option>
                }
            </select>
            <div class="form-text" id="org-zone-help">Used for all dates and times in TIDE.</div>
        </div>
        <div class="col-md-6">
            <label class="tide-field-label" for="org-meeting">The brief meets at</label>
            <TimeBox @ref="MeetingBox" Id="org-meeting" Class="tide-maxw-xs form-control form-control-sm" @bind-Value="_meeting" Invalid="@(_meetingProblem is not null)"
                     DescribedBy="@(_meetingProblem is null ? "org-meeting-help" : "org-meeting-error org-meeting-help")" />
            @if (_meetingProblem is { } problem) { <div class="invalid-feedback d-block" id="org-meeting-error">@problem</div> }
            <div class="form-text" id="org-meeting-help">The brief-not-ready nudge stops at this time.</div>
        </div>
        <div class="col-md-6">
            <label class="tide-field-label" for="org-sent-by">The brief is due sent by</label>
            <TimeBox @ref="SentByBox" Id="org-sent-by" Class="tide-maxw-xs form-control form-control-sm" @bind-Value="_sentBy" Invalid="@(_sentByProblem is not null)"
                     DescribedBy="@(_sentByProblem is null ? "org-sent-by-help" : "org-sent-by-error org-sent-by-help")" />
            @if (_sentByProblem is { } sentProblem) { <div class="invalid-feedback d-block" id="org-sent-by-error">@sentProblem</div> }
            <div class="form-text" id="org-sent-by-help">Both editions out by this time on each business day, or the day's analyst is late
                (Reports, Brief timeliness). A test copy doesn't count.</div>
        </div>
        <div class="col-md-6">
            <label class="tide-field-label" for="org-posted-by">Its SharePoint copy is due posted by</label>
            <TimeBox @ref="PostedByBox" Id="org-posted-by" Class="tide-maxw-xs form-control form-control-sm" @bind-Value="_postedBy" Invalid="@(_postedByProblem is not null)"
                     DescribedBy="@(_postedByProblem is null ? "org-posted-by-help" : "org-posted-by-error org-posted-by-help")" />
            @if (_postedByProblem is { } postedProblem) { <div class="invalid-feedback d-block" id="org-posted-by-error">@postedProblem</div> }
            <div class="form-text" id="org-posted-by-help">Only where posting to SharePoint is required (Access &amp; distribution). Both times
                judge every day in the report, earlier ones too.</div>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input id="org-beside" type="checkbox" class="form-check-input" @bind="ActionBeside" aria-describedby="org-beside-help" />
                <label class="form-check-label" for="org-beside">In a meeting, an action opens beside the slide</label>
            </div>
            <div class="form-text" id="org-beside-help">The slide narrows so the room reads it and the action together; off, the action opens over the slide.
                Try it in a rehearsal in the meeting room before turning it on.</div>
        </div>
        <div class="col-md-6">
            <label class="tide-field-label" for="org-stale-open">An open action needs review after</label>
            <div class="input-group input-group-sm tide-maxw-xs">
                <input id="org-stale-open" type="number" class="form-control" min="@StaleLimits.MinDays" max="@StaleLimits.MaxDays" step="1"
                       @bind="StaleOpen" aria-describedby="org-stale-open-help" />
                <span class="input-group-text">business days</span>
            </div>
            <div class="form-text" id="org-stale-open-help">An Open or In progress action nobody has updated for this long is on the meeting's
                Actions that need review slide. A comment, a status change, a checklist tick or any other edit is an update; reminders and
                escalations aren't. 1 to 30.</div>
        </div>
        <div class="col-md-6">
            <label class="tide-field-label" for="org-stale-blocked">A blocked action needs review after</label>
            <div class="input-group input-group-sm tide-maxw-xs">
                <input id="org-stale-blocked" type="number" class="form-control" min="@StaleLimits.MinDays" max="@StaleLimits.MaxDays" step="1"
                       @bind="StaleBlocked" aria-describedby="org-stale-blocked-help" />
                <span class="input-group-text">business days</span>
            </div>
            <div class="form-text" id="org-stale-blocked-help">The same for a Blocked action, which usually waits on someone else. Weekends and
                the holidays below don't count. 1 to 30.</div>
        </div>
        <div class="col-md-6">
            <label class="tide-field-label" for="org-guide-link-days">Show me around links show for</label>
            <div class="input-group input-group-sm tide-maxw-xs">
                <input id="org-guide-link-days" type="number" class="form-control" min="@OrgOptions.MinGuideLinkDays" max="@OrgOptions.MaxGuideLinkDays" step="1"
                       @bind="GuideLinkDays" aria-describedby="org-guide-link-days-help" />
                <span class="input-group-text">days</span>
            </div>
            <div class="form-text" id="org-guide-link-days-help">A page's Show me around link, under its title, shows for this long after
                someone's first sign-in, and after a release changes the page, until they run its guide or close the link. The ? menu
                always has it. 1 to 90.</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary btn-sm mt-3" disabled="@_busy" @onclick="Save">Save</button>
</section>

@* EP-82: the days the team doesn't work besides weekends. *@
<section class="tide-card" aria-labelledby="holidays-title">
    <h2 id="holidays-title"><span class="bi bi-calendar-x" aria-hidden="true"></span> Holidays</h2>
    <p class="small tide-muted">Days off besides weekends: no brief is expected, no reminders are sent, and they don't count towards action deadlines.</p>
    @if (_shown.Count == 0)
    {
        <p class="small mb-2">No holidays from @_thisYear on. Add them below, or import your organization's calendar.</p>
    }
    else
    {
        <table class="tide-table mb-2" aria-label="Holidays">
            <thead><tr><th scope="col">Date</th><th scope="col">Holiday</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr></thead>
            <tbody>
                @foreach (var h in _shown)
                {
                    <tr @key="h.Date">
                        <td class="text-nowrap tide-data">@h.Date.ToString("ddd MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@h.Name</td>
                        <td class="text-end"><button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" aria-label="@($"Remove {h.Name}")" @onclick="() => Remove(h)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (_earlier > 0) { <p class="small tide-muted">@_earlier earlier holiday@(_earlier == 1 ? "" : "s") kept, for the rota and deadlines of those days.</p> }
    <div class="row g-2 align-items-end">
        <div class="col-sm-4 col-md-3">
            <label class="tide-field-label" for="holiday-date">Date</label>
            <input id="holiday-date" type="date" class="form-control form-control-sm" @bind="_newDate" />
        </div>
        <div class="col-sm-8 col-md-5">
            <label class="tide-field-label" for="holiday-name">Name</label>
            <input id="holiday-name" class="form-control form-control-sm" maxlength="@Holiday.MaxName" placeholder="Thanksgiving" @bind="_newName" />
        </div>
        <div class="col-md-4">
            <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="Add">Add holiday</button>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
        <div>
            <label class="tide-field-label" for="holiday-ics">Import a calendar (.ics)</label>
            <InputFile id="holiday-ics" OnChange="Import" accept=".ics,text/calendar" disabled="@_busy" class="form-control form-control-sm" />
        </div>
        @if (_copyFrom is { } year)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm align-self-end" disabled="@_busy" @onclick="() => Copy(year)">Copy @year to @(year + 1)</button>
        }
    </div>
    <div class="form-text">A calendar file from Outlook or your government's holiday list adds each all-day event. Copying a year keeps each date
        and name; check the ones that move, such as the 4th Thursday of November.</div>
    @if (_skipped.Count > 0)
    {
        <div class="alert alert-warning small mt-2 mb-0" role="status">
            <strong>Not added:</strong>
            <ul class="mb-0">@foreach (var s in _skipped) { <li>@s</li> }</ul>
        </div>
    }
</section>

<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = default!;
    private IReadOnlyList<(string Id, string Label)> _zones = [];
    private string _teamName = "";

    // The zone chosen (internal so a test can choose one).
    internal string Zone { get; set; } = "";
    private TimeOnly _meeting;

    // The meeting's box, so a save can tell a cleared or half-typed time from the last whole one (internal so a test can
    // type into it), and what's wrong with it, said on the field.
    internal TimeBox? MeetingBox { get; private set; }
    private string? _meetingProblem;

    // The brief's deadlines, as the meeting's time is kept (internal so a test can type into them).
    private TimeOnly _sentBy, _postedBy;
    internal TimeBox? SentByBox { get; private set; }
    internal TimeBox? PostedByBox { get; private set; }
    private string? _sentByProblem, _postedByProblem;

    // Whether a meeting's action opens beside the slide (internal so a test can tick it).
    internal bool ActionBeside { get; set; }

    // The business days an open, and a blocked, action may go without an update before the meeting asks (internal so a
    // test can set them). As typed, so the save refuses 2.5 rather than a number box reading it as 2.
    internal string StaleOpen { get; set; } = "";
    internal string StaleBlocked { get; set; } = "";

    // The days a page's Show me around link shows (internal so a test can set it), as typed.
    internal string GuideLinkDays { get; set; } = "";
    private bool _busy;

    // The holidays from this year on, how many are older, and the latest year to copy to the next (when that's empty).
    private IReadOnlyList<Holiday> _shown = [];
    private int _earlier;
    private int _thisYear;
    private int? _copyFrom;
    private DateOnly _newDate;
    private string _newName = "";
    private IReadOnlyList<string> _skipped = [];

    protected override async Task OnInitializedAsync()
    {
        Load();
        _newDate = Clock.Today;
        await LoadHolidays();
    }

    private async Task LoadHolidays()
    {
        var all = await Holidays.ListAsync();
        _thisYear = Clock.Today.Year;
        _shown = all.Where(h => h.Date.Year >= _thisYear).ToList();
        _earlier = all.Count - _shown.Count;
        var latest = all.Count == 0 ? (int?)null : all.Max(h => h.Date.Year);
        _copyFrom = latest is { } y && y >= _thisYear - 1 ? y : null;
    }

    internal Task Add() => Change(async () =>
    {
        var added = await Holidays.AddAsync(_newDate, _newName);
        _newName = "";
        _skipped = [];
        Toasts.Show($"{added.Name} added: {Ui.Day(added.Date)} is a day off.");
    });

    private Task Remove(Holiday h) => Change(async () =>
    {
        await Holidays.RemoveAsync(h.Date);
        Toasts.Show($"{h.Name} removed: {Ui.Day(h.Date)} is a working day again.");
    });

    private Task Import(InputFileChangeEventArgs e) => Change(async () =>
    {
        if (e.File.Size > HolidayService.MaxCalendarBytes) throw new ArgumentException(HolidayService.TooBig);
        await using var stream = e.File.OpenReadStream(maxAllowedSize: HolidayService.MaxCalendarBytes);
        using var copy = new MemoryStream();
        await stream.CopyToAsync(copy);
        Report(await Holidays.ImportAsync(copy.ToArray()), $"from {e.File.Name}");
    });

    private Task Copy(int year) => Change(async () => Report(await Holidays.CopyYearAsync(year), $"from {year}; check the dates that move"));

    private void Report(HolidayImport result, string from)
    {
        _skipped = result.Skipped;
        Toasts.Show(result.Added.Count == 0 ? "No holidays added." : $"{result.Added.Count} holiday{(result.Added.Count == 1 ? "" : "s")} added {from}.");
    }

    private async Task Change(Func<Task> change)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await change();
            await LoadHolidays();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    private void Load()
    {
        _teamName = Clock.TeamName;
        Zone = Clock.Zone.Id;
        _meeting = Clock.MeetingTime;
        (_sentBy, _postedBy) = (Clock.SentBy, Clock.PostedBy);
        ActionBeside = Clock.ActionBesideSlide;
        (StaleOpen, StaleBlocked) = (Clock.StaleLimits.OpenDays.ToString(System.Globalization.CultureInfo.InvariantCulture), Clock.StaleLimits.BlockedDays.ToString(System.Globalization.CultureInfo.InvariantCulture));
        GuideLinkDays = Clock.GuideLinkDays.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _zones = OperationalSettings.TimeZoneChoices(Zone);
        // A Windows id from the server (Eastern Standard Time) is shown as its IANA one, which is what's saved.
        if (!_zones.Any(z => z.Id == Zone) && TimeZoneInfo.TryConvertWindowsIdToIanaId(Zone, out var iana)) Zone = iana;
    }

    // What's wrong with a time box: cleared or half typed, it would otherwise save the last whole time it held.
    private static string? TimeProblem(TimeBox? box, string label, string example) =>
        box is { Whole: false } ? $"{label} is a 24-hour time such as {example}." : null;

    private static string Hm(TimeOnly t) => t.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    // Changing the time zone asks first: brief dates and reminder times follow it.
    internal async Task Save()
    {
        if (_busy) return;
        // A cleared box would otherwise save the last whole time, under "Saved.", as if it were what's shown.
        _meetingProblem = TimeProblem(MeetingBox, "The brief meets at", "10:30");
        _sentByProblem = TimeProblem(SentByBox, "The brief is due sent by", "11:30");
        _postedByProblem = TimeProblem(PostedByBox, "Its SharePoint copy is due posted by", "12:00");
        StateHasChanged();
        if ((_meetingProblem ?? _sentByProblem ?? _postedByProblem) is { } problem)
        {
            Toasts.Error("The settings weren't saved: " + problem);
            return;
        }
        var zoneChanged = !string.Equals(Zone, Clock.Zone.Id, StringComparison.Ordinal)
                          && !(TimeZoneInfo.TryConvertWindowsIdToIanaId(Clock.Zone.Id, out var was) && was == Zone);
        if (zoneChanged && !await _confirm.Ask($"Change the time zone to {Zone}?",
                "Brief dates, the meeting time and reminder times follow the time zone: \"today's\" brief, the reminder and digest " +
                "times and the brief-not-ready nudge all move to it at once, and times already shown are shown in it.", "Change time zone")) return;
        _busy = true;
        try
        {
            await Settings.SaveAsync(new Dictionary<string, string?>
            {
                [OperationalSettings.TeamName] = _teamName,
                [OperationalSettings.TimeZone] = Zone,
                [OperationalSettings.MeetingTime] = Hm(_meeting),
                [OperationalSettings.SentBy] = Hm(_sentBy),
                [OperationalSettings.PostedBy] = Hm(_postedBy),
                [OperationalSettings.ActionBesideSlide] = ActionBeside ? "true" : "false",
                [OperationalSettings.StaleOpenDays] = StaleOpen,
                [OperationalSettings.StaleBlockedDays] = StaleBlocked,
                [OperationalSettings.GuideLinkDays] = GuideLinkDays,
            });
            Load();
            Toasts.Show("Saved.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
}
