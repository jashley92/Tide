@page "/admin/system/audit"
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@using System.Globalization
@using Tide.Application.History
@inject AuditLogService Audit
@inject NavigationManager Nav
@inject OrgClock Clock
@inject ToastService Toasts

<PageTitle>Audit log · TIDE</PageTitle>

@* The audit log: every change the audit interceptor recorded, across the whole system, newest first, with
   who made it and what each field was before and after; and the downloads that are recorded (DownloadAudit: an export
   above TLP:GREEN, every file, the configuration bundle, this log's CSV), as the Download kind and the downloaded action. Administrators only (the service checks too): the log holds
   text at every TLP marking. The filters are the address's (AuditFilter.ToQuery), so a view can be bookmarked, and the
   export takes the same ones. Secrets show only as set or changed (HistoryFormatter.AuditChanges). *@
<div class="tide-page-head">
    <div>
        <h1 class="tide-admin-title">Audit log</h1>
        <div class="tide-sub">Times in @Clock.Zone.Id. Secret values aren't shown.</div>
    </div>
    <a class="btn btn-outline-secondary" href="@ExportHref" download>
        <span class="bi bi-filetype-csv" aria-hidden="true"></span> Export CSV
    </a>
</div>

<div class="tide-card tide-audit">
    <DataTable TItem="AuditRow" Items="_rows" Columns="Columns" Key="r => r.Id" One="change" Many="changes" Caption="Audit log"
               FilterLabel="Search the changed values" FilterPlaceholder="Search the changed values" Filter="@_filter.Search"
               ServerSide="true" Total="_total" PageSize="AuditLogService.PageSize" PageInAddress="true" Busy="_reading"
               Filtered="@(_filter.Narrowed || _since is not null)" OnQuery="Query">
        <Toolbar>
            @* The filter bar after the search box: Deleted and Downloads as pills, a chip for each other filter (a link to the log without
               it) and + Filter for who, the kind of record, the action and the dates. *@
            <FilterBar Pills="Pills" Filters="Defs" Chips="Chips" Active="_filter.Narrowed" ClearHref="@Href(_filter.Cleared())" />
        </Toolbar>
        <Filters>
            @if (_since is { } since)
            {
                <p class="small tide-muted" role="status">
                    Action and word filters cover @AuditLogService.UnindexedDays days at a time: changes since @since.ToString("d MMM yyyy", CultureInfo.InvariantCulture). Set dates or a person to search further back.
                </p>
            }
        </Filters>
        <Empty>
            @if (_filter.Narrowed || _since is not null)
            {
                <EmptyState Icon="bi-search" Title="No changes match these filters">
                    <Actions><a class="btn btn-outline-secondary btn-sm" href="@Href(_filter.Cleared())">Clear filters</a></Actions>
                    <ChildContent>Try removing one, or choosing other dates.</ChildContent>
                </EmptyState>
            }
            else
            {
                <EmptyState Icon="bi-journal-text" Title="No changes recorded yet" />
            }
        </Empty>
        <RowTemplate Context="r">
            <td class="small text-nowrap">@When(r.AtUtc)</td>
            <td class="small">@r.UserName</td>
            <td class="small">@r.What</td>
            <td class="tide-audit-record">
                <div class="small tide-muted">@r.Kind</div>
                @if (r.Href is { } href)
                {
                    <a href="@href">@r.Record</a>
                }
                else
                {
                    <span class="@(r.Record == r.EntityKey ? "tide-data small" : null)">@r.Record</span>
                }
                @if (_filter.Key is null || _filter.Kind != r.EntityType || _filter.Key != r.EntityKey)
                {
                    <div><a class="small" href="@Href(_filter with { Kind = r.EntityType, Key = r.EntityKey })" aria-label="Only this record: @r.Record">Only this record</a></div>
                }
            </td>
            <td class="small tide-audit-changes">
                @if (r.Changes.Count == 0)
                {
                    <span class="tide-muted">@(r.Action switch { AuditAction.Deleted => "Deleted.", AuditAction.Downloaded => "Downloaded.", _ => "No tracked fields changed." })</span>
                }
                else
                {
                    <ChangeLines Changes="r.Changes" Changed="@(r.Action == AuditAction.Changed)" Deleted="@(r.Action == AuditAction.Deleted)" />
                }
            </td>
        </RowTemplate>
    </DataTable>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "who")] public string? WhoParam { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? KindParam { get; set; }
    [SupplyParameterFromQuery(Name = "key")] public string? KeyParam { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromParam { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToParam { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? ActionParam { get; set; }

    /// <summary>The page of the log, from 1 (DataTable's <c>?page=</c>).</summary>
    // Text, not a number: "?page=abc" or one too big for an int is the first page, not a broken page.
    [SupplyParameterFromQuery(Name = DataTable<AuditRow>.PageParameter)] public string? PageParam { get; set; }

    private static readonly IReadOnlyList<TableColumn<AuditRow>> Columns =
    [
        new("when", "When"),
        new("who", "Who"),
        new("action", "Action"),
        new("record", "Record"),
        new("changes", "Changes"),
    ];

    private IReadOnlyList<AuditRow>? _rows;
    private int _total, _page = 1, _loadedPage;
    private DateOnly? _since;
    private AuditFilter _filter = new();
    private AuditFilter? _loaded;
    private IReadOnlyList<AuditChip> _chips = [];
    private IReadOnlyList<AuditPerson> _people = [];
    private bool _reading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _people = await Audit.PeopleAsync();
            _peopleOptions = [.. _people.Select(p => new FilterOption(p.UserId, p.Name))];
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    // A new filter or page in the address (a select, a chip removed, the pager, Back) lists afresh.
    protected override async Task OnParametersSetAsync()
    {
        var query = new Dictionary<string, string?>
        {
            ["q"] = Q, ["who"] = WhoParam, ["kind"] = KindParam, ["key"] = KeyParam, ["from"] = FromParam, ["to"] = ToParam, ["action"] = ActionParam,
        };
        _filter = AuditFilter.FromQuery(name => query.GetValueOrDefault(name));
        _page = TableView.PageFrom(PageParam);
        if (_filter != _loaded || _page != _loadedPage) await Load();
        _chips = _filter.Chips(PersonName, _filter.Key is null ? null : _rows?.FirstOrDefault()?.Record);
    }

    private string? PersonName(string id) => _people.FirstOrDefault(p => p.UserId == id)?.Name;

    private string When(DateTimeOffset utc) => Clock.ToLocal(utc).ToString("MMM d, yyyy, h:mm tt", CultureInfo.InvariantCulture);

    private string Href(AuditFilter f) => Nav.GetUriWithQueryParameters(AdminLayout.AuditHref, f.ToQuery());

    private string ExportHref => Nav.GetUriWithQueryParameters("admin/system/audit.csv", _filter.ToQuery());

    private void Go(AuditFilter f, bool replace = false) => Nav.NavigateTo(Href(f), replace: replace);

    // The pills: deletions and downloads, what's asked of the log most, presets of the action filter.
    internal static readonly IReadOnlyList<FilterPill> Pills =
    [
        new("deleted", "Deleted", "action", [nameof(AuditAction.Deleted)]),
        new("downloaded", "Downloads", "action", [nameof(AuditAction.Downloaded)]),
    ];

    // The chips, as the filter words them (the dates as one), each a link to the log without it.
    internal IReadOnlyList<FilterChipView> Chips => [.. _chips.Select(c => new FilterChipView(c.Label, c.Key, Href(c.Without)))];

    // The options that don't change: built once. The people's when they're read.
    private static readonly IReadOnlyList<FilterOption> KindOptions = [.. AuditKinds.All.Select(k => new FilterOption(k.Type, k.Name))];
    private static readonly IReadOnlyList<FilterOption> ActionOptions = FilterOption.ForEnum<AuditAction>();
    private IReadOnlyList<FilterOption> _peopleOptions = [];

    // Every filter, under + Filter. Each sets the filter and goes to the log's address with it, at its first page.
    internal IReadOnlyList<FilterDef> Defs =>
    [
        new("who", "Who", FilterKind.Single, v => Go(_filter with { Person = FilterValues.First(v) })) { Options = _peopleOptions, Values = FilterValues.Of(_filter.Person) },
        // Another kind drops the record chosen, which was one of the old kind.
        new("kind", "Kind of record", FilterKind.Single, v => Go(_filter with { Kind = FilterValues.First(v), Key = null })) { Options = KindOptions, Values = FilterValues.Of(_filter.Kind) },
        new("action", "Action", FilterKind.Single, v => Go(_filter with { Action = FilterValues.Enum<AuditAction>(v) }))
        {
            Options = ActionOptions, Values = FilterValues.Of(_filter.Action?.ToString()),
        },
        new("from", "From", FilterKind.Text, v => Go(_filter with { From = Ui.ParseDay(FilterValues.First(v)) })) { InputType = "date", Values = FilterValues.Of(Ui.IsoDay(_filter.From)) },
        new("to", "To", FilterKind.Text, v => Go(_filter with { To = Ui.ParseDay(FilterValues.First(v)) })) { InputType = "date", Values = FilterValues.Of(Ui.IsoDay(_filter.To)) },
    ];

    private async Task Load()
    {
        var (filter, number, asked) = (_filter, _page, _page);
        const int size = AuditLogService.PageSize;
        _reading = true;
        try
        {
            var page = await Audit.PageAsync(filter, size, (number - 1) * size);
            // A page past the end (an old link, or the log was pruned): the last page instead.
            if (page.Rows.Count == 0 && page.Total > 0 && number > 1)
            {
                number = TableView.Pages(page.Total, size);
                page = await Audit.PageAsync(filter, size, (number - 1) * size);
            }
            if (filter != _filter || asked != _page) return;   // moved on meanwhile: the later read draws it
            (_loaded, _loadedPage, _page) = (filter, number, number);
            // Fell back to the last page: the address says so, so it isn't read again as the page past the end.
            if (number != asked) Nav.NavigateTo(Nav.GetUriWithQueryParameter(DataTable<AuditRow>.PageParameter, number == 1 ? null : number), replace: true);
            _rows = page.Rows;
            _total = page.Total;
            _since = page.Since;
        }
        catch (Exception ex)
        {
            (_loaded, _loadedPage) = (filter, number);
            _rows ??= [];
            Toasts.Error(UserFacingError.For(ex));
        }
        finally { _reading = false; }
    }

    // New words go into the address in place (not a step for Back per pause in typing), at the first page.
    private async Task Query(TableQuery q)
    {
        if ((q.Filter ?? "") != (_filter.Search ?? "")) Go(_filter with { Search = q.Filter }, replace: true);
        else if (_page > 1) Go(_filter, replace: true);
        else await Load();
    }
}
