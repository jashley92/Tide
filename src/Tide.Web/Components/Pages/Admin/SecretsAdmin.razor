@page "/admin/system/secrets"
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@using Tide.Application.Settings
@inject StoredSecretService Secrets
@inject OrgClock Clock
@inject ToastService Toasts

<PageTitle>Secrets · TIDE</PageTitle>

<div class="tide-page-head">
    <div>
        <h1 class="tide-admin-title">Secrets</h1>
        <div class="tide-sub">Passwords and keys TIDE uses to reach other services. Saved here, each is encrypted with this server's
            Data Protection keys before it's stored, so the database holds only ciphertext, and it's never shown again.
            A secret set in the server's configuration (an environment variable on the app pool) is used instead.</div>
    </div>
</div>

@if (_rows is null)
{
    <LoadingBlock />
}
else
{
    @foreach (var r in _rows)
    {
        var d = r.Definition;
        var id = "secret-" + d.Key.Replace(':', '-').ToLowerInvariant();
        <section class="tide-card" aria-labelledby="@(id)-h" data-submit-scope>
            <h2 id="@(id)-h">@d.Label <code class="ms-2 small tide-muted fw-normal">@d.Key</code>
                <span class="ms-auto">
                    @if (r.ServerSets) { <Badge Tone="BadgeTone.Info" Icon="bi-hdd-stack">Set on the server</Badge> }
                    else if (r.Unreadable) { <Badge Tone="BadgeTone.Warn" Icon="bi-exclamation-triangle">Won't decrypt</Badge> }
                    else if (r.Saved) { <Badge Tone="BadgeTone.Ok" Icon="bi-lock-fill">Saved</Badge> }
                    else { <span class="small tide-muted">Not set</span> }
                </span>
            </h2>
            @if (r.Saved)
            {
                <p class="small tide-muted mb-2">Saved @Ui.When(Clock, r.SavedAtUtc!.Value) by @r.SavedBy.</p>
            }
            @if (r.ServerSets)
            {
                <p class="small mb-2">The server's configuration sets this, so that's the one TIDE uses@(r.Saved ? "; the one saved here is ignored until it's removed there" : "").</p>
            }
            @if (r.Unreadable)
            {
                <div class="tide-missing small mb-2" role="status">The saved one won't decrypt on this server: the database may have been restored without
                    its Data Protection keys. Save it again.</div>
            }
            <label class="form-label small" for="@id">@(r.Saved ? "Replace it" : "Save one")<span class="visually-hidden">: @d.Label</span></label>
            <div class="d-flex gap-2 flex-wrap">
                <input id="@id" type="password" class="form-control tide-secret-input" autocomplete="new-password" spellcheck="false" maxlength="@d.MaxLength"
                       @bind="_typed[d.Key]" @bind:event="oninput" />
                <button type="button" class="btn btn-primary" data-submit disabled="@(_busy || string.IsNullOrWhiteSpace(_typed[d.Key]))" @onclick="() => Save(d)">Save<span class="visually-hidden"> the @d.Label</span></button>
                @if (r.Saved)
                {
                    <button type="button" class="btn btn-outline-danger" disabled="@_busy" @onclick="() => Clear(d)">Remove<span class="visually-hidden"> the saved @d.Label</span></button>
                }
            </div>
        </section>
    }
    <p class="small tide-muted mt-3 mb-0">Back up the Data Protection keys (<code>DataProtection:KeyPath</code>) with the database: without them, a restored
        database's secrets won't decrypt and must be saved again. Everything else about the server: <a href="admin/system/server">Server configuration</a>.</p>
}

<ConfirmDialog @ref="_confirm" />

@code {
    private IReadOnlyList<StoredSecretStatus>? _rows;
    private readonly Dictionary<string, string?> _typed = StoredSecretDefinition.All.ToDictionary(d => d.Key, _ => (string?)null);
    private ConfirmDialog _confirm = default!;
    private bool _busy;

    protected override void OnInitialized() => _rows = Secrets.List();

    private Task Save(StoredSecretDefinition d) => Run(async () =>
    {
        await Secrets.SaveAsync(d.Key, _typed[d.Key]);
        _typed[d.Key] = null;
    }, $"{d.Label} saved.");

    private async Task Clear(StoredSecretDefinition d)
    {
        if (_busy || !await _confirm.Ask($"Remove the saved {d.Label}?", "TIDE uses the server's configuration for it again, if that sets one; otherwise it has none.", "Remove")) return;
        await Run(() => Secrets.ClearAsync(d.Key), $"{d.Label} removed.");
    }

    // One change at a time; the list read again after it, and a refusal said in a toast.
    private async Task Run(Func<Task> change, string done)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await change();
            _rows = Secrets.List();
            Toasts.Show(done);
        }
        catch (Exception ex) when (ex is ArgumentException or ForbiddenException) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
}
