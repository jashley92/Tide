@page "/admin/email-templates"
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@using Tide.Application.Distribution
@inject EmailTemplateService Templates
@inject ToastService Toasts

<PageTitle>Email templates · TIDE</PageTitle>

@* Email templates: the wording of each notification email, with a live preview. *@
<div class="tide-page-head">
    <div>
        <h1 class="tide-admin-title">Email templates</h1>
        <div class="tide-sub">Reminder and rotation emails. <span class="tide-data">{{Name}}</span> inserts a value when the email is sent; values typed by analysts are never read as formatting. The header, footer and TLP marking are fixed. The brief's email is generated from the brief and isn't listed.</div>
    </div>
</div>

@if (_views is null)
{
    <p class="tide-muted" role="status">Loading…</p>
}
else
{
    <section class="tide-card mb-3" aria-labelledby="etpl-archive-title" data-submit-scope>
        <h2 id="etpl-archive-title"><span class="bi bi-archive" aria-hidden="true"></span> Archive copy</h2>
        <p class="small tide-muted mb-2">One address blind-copied on <strong>every</strong> email TIDE sends, a brief's editions and test copies included: a record that each was sent.
            It must be inside @(Templates.HomeDomain ?? "your organization's domain (set Email:From on the server)"). Blank for none. Saving it is audited.</p>
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div class="flex-grow-1 tide-maxw-sm">
                <label class="tide-field-label" for="etpl-archive">Archive address</label>
                <input id="etpl-archive" type="email" class="form-control form-control-sm tide-data" maxlength="256" placeholder="@($"tide-archive@{Templates.HomeDomain ?? "example.org"}")" @bind="_archive" />
            </div>
            <button class="btn btn-outline-secondary btn-sm" data-submit disabled="@_busy" @onclick="SaveArchive">Save archive copy</button>
        </div>
        @if (_archiveError is not null) { <p class="text-danger small mt-2 mb-0" role="alert">@_archiveError</p> }
    </section>

    <div class="tide-etpl">
        <nav class="tide-etpl-list" aria-label="Email templates">
            @foreach (var v in _views)
            {
                var current = v.Template.Id == _id;
                <button type="button" class="tide-etpl-item @(current ? "active" : "")" aria-current="@(current ? "true" : null)"
                        @onclick="() => Select(v.Template.Id)" disabled="@_busy">
                    <span>@v.Template.Title</span>
                    @if (Templates.Copies(v.Template.Id).Any) { <span class="bi bi-people small tide-muted" title="Copied to standing addresses" aria-label="Has copies"></span> }
                    @if (_drafts.ContainsKey(v.Template.Id) || (current && Unsaved)) { <Badge Tone="BadgeTone.Warn">Unsaved</Badge> }
                    else if (v.IsCustomized) { <Badge Tone="BadgeTone.Ok">Customized</Badge> }
                </button>
            }
        </nav>

        @if (Selected is { } sel)
        {
            <div class="tide-etpl-main">
                <section class="tide-card" aria-labelledby="etpl-title" data-submit-scope>
                    <h2 id="etpl-title">@sel.Template.Title @if (sel.IsCustomized) { <Badge Tone="BadgeTone.Ok">Customized</Badge> }</h2>
                    <p class="small tide-muted">@sel.Template.Description</p>

                    <label class="tide-field-label" for="etpl-subject">Subject</label>
                    <input id="etpl-subject" class="form-control form-control-sm" maxlength="@EmailTemplateCatalog.MaxLine"
                           @bind="_subject" @bind:event="oninput" @bind:after="UpdatePreview" />

                    <label class="tide-field-label mt-2" for="etpl-heading">Heading</label>
                    <input id="etpl-heading" class="form-control form-control-sm" maxlength="@EmailTemplateCatalog.MaxLine"
                           @bind="_heading" @bind:event="oninput" @bind:after="UpdatePreview" aria-describedby="etpl-heading-help" />
                    <div class="form-text" id="etpl-heading-help">The large line in the email's dark header.</div>

                    <label class="tide-field-label mt-2" for="etpl-body">Body</label>
                    <MarkdownToolbar For="etpl-body" Label="Body" />
                    <textarea id="etpl-body" class="tide-query tide-etpl-body tide-autogrow" spellcheck="true" maxlength="@EmailTemplateCatalog.MaxBody"
                              @bind="_body" @bind:event="oninput" @bind:after="UpdatePreview" aria-describedby="etpl-body-help"></textarea>
                    <div class="form-text" id="etpl-body-help">Markdown: <span class="tide-data">**bold**</span>, <span class="tide-data">*italic*</span>,
                        <span class="tide-data">- a list</span>, a blank line between paragraphs. HTML is shown as typed.</div>

                    <div class="tide-etpl-tokens" role="group" aria-label="Values this email can fill in">
                        <div class="small tide-muted">Insert a value at the end of the body:</div>
                        @foreach (var token in sel.Template.Tokens)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm tide-data" title="@token.Description"
                                    aria-describedby="@($"etpl-tok-{token.Name}")" @onclick="() => AddToken(token.Name)">@($"{{{{{token.Name}}}}}")</button>
                            <span id="@($"etpl-tok-{token.Name}")" class="visually-hidden">@token.Description@(token.Required ? " The body needs it." : "")</span>
                        }
                    </div>

                    @if (_error is not null) { <p class="text-danger small mt-2 mb-0" role="alert">@_error</p> }
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                        <button class="btn btn-primary btn-sm" data-submit @onclick="Save" disabled="@(_busy || !Unsaved)">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="Revert" disabled="@(_busy || !Unsaved)">Discard changes</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="Reset" disabled="@(_busy || !sel.IsCustomized)">Back to the default</button>
                        <span class="tide-etpl-sep" aria-hidden="true"></span>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="SendTest" disabled="@(_busy || _to is null)"
                                title="@(_to is null ? "Your directory account has no email address (the mail attribute)." : $"Sends the draft on screen to {_to}. It isn't saved.")">
                            <span class="bi bi-send" aria-hidden="true"></span> Send me a test
                        </button>
                    </div>
                </section>

                <section class="tide-card" aria-labelledby="etpl-copies-title" data-submit-scope>
                    <h2 id="etpl-copies-title"><span class="bi bi-people" aria-hidden="true"></span> Copies</h2>
                    <p class="small tide-muted mb-2">Addresses every email from this template is copied to, one copy per email: a reminder run sends one email per person or team,
                        so a copy here gets one each. Up to @EmailCopyRules.MaxPerList in each; separate them with commas or lines. Saving is audited, and copies aren't carried in a configuration bundle.</p>
                    @if (EmailCopyRules.GoesOutside(sel.Template))
                    {
                        <div class="tide-missing small mb-2" role="note"><span class="bi bi-shield-lock" aria-hidden="true"></span> This email goes to people outside TIDE, so its copies are blind only: they never see an internal address.</div>
                    }
                    else
                    {
                        <label class="tide-field-label" for="etpl-cc">Always copy (CC) <span class="fw-normal">: every recipient sees these</span></label>
                        <textarea id="etpl-cc" class="form-control form-control-sm tide-data tide-autogrow tide-grow-2" rows="1" @bind="_cc"></textarea>
                    }
                    <label class="tide-field-label mt-2" for="etpl-bcc">Always blind-copy (BCC) <span class="fw-normal">: no recipient sees these</span></label>
                    <textarea id="etpl-bcc" class="form-control form-control-sm tide-data tide-autogrow tide-grow-2" rows="1" @bind="_bcc"></textarea>
                    @if (_copyError is not null) { <p class="text-danger small mt-2 mb-0" role="alert">@_copyError</p> }
                    <button class="btn btn-outline-secondary btn-sm mt-2" data-submit disabled="@_busy" @onclick="() => SaveCopies(false)">Save copies</button>
                </section>

                <section class="tide-card" aria-labelledby="etpl-preview-title">
                    <h2 id="etpl-preview-title"><span class="bi bi-eye" aria-hidden="true"></span> Preview <span class="small tide-muted fw-normal">with sample values</span></h2>
                    @if (_preview is { } p)
                    {
                        <div class="small mb-2"><span class="tide-muted">Subject:</span> @p.Subject</div>
                        @if (AlsoSentTo(sel) is { } also) { <div class="small mb-2" id="etpl-also"><span class="tide-muted">Also sent to:</span> <span class="tide-data">@also</span></div> }
                        <iframe class="tide-etpl-frame" title="Preview of the email" sandbox="" srcdoc="@p.Html"></iframe>
                    }
                </section>
            </div>
        }
    </div>
}

<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = default!;
    private string? _cc, _bcc, _archive, _copyError, _archiveError;

    /// <summary>The standing copies every email from <paramref name="v"/> carries, as saved: "CC a@x; BCC b@x (archive)".</summary>
    internal string? AlsoSentTo(EmailTemplateView v)
    {
        var copies = Templates.Copies(v.Template.Id);
        var outside = EmailCopyRules.GoesOutside(v.Template);
        var parts = new List<string>();
        if (!outside && copies.Cc.Count > 0) parts.Add("CC " + EmailCopyRules.Join(copies.Cc));
        var bcc = (outside ? copies.Cc.Concat(copies.Bcc) : copies.Bcc).ToList();
        if (bcc.Count > 0) parts.Add("BCC " + EmailCopyRules.Join(bcc));
        if (Templates.Archive is { } archive) parts.Add($"BCC {archive} (archive)");
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    // The copies' boxes, as saved for the template shown.
    private void ShowCopies()
    {
        var c = Templates.Copies(_id);
        (_cc, _bcc, _copyError) = (string.Join(Environment.NewLine, c.Cc), string.Join(Environment.NewLine, c.Bcc), null);
    }

    // Saved as typed; an address outside the organization's domain is asked about first.
    internal async Task SaveCopies(bool confirmed)
    {
        if (_busy) return;
        _busy = true;
        _copyError = null;
        var ask = (string?)null;
        try
        {
            await Templates.SaveCopiesAsync(_id, _cc, _bcc, confirmed);
            ShowCopies();
            Toasts.Show("Copies saved. They go with the next email from this template.");
        }
        catch (OutsideCopiesException ex) { ask = ex.Message; }
        catch (Exception ex) { _copyError = UserFacingError.For(ex); }
        finally { _busy = false; }
        if (ask is not null && await _confirm.Ask("Copy outside your organization?", ask, "Copy anyway")) await SaveCopies(true);
    }

    internal async Task SaveArchive()
    {
        if (_busy) return;
        _busy = true;
        _archiveError = null;
        try
        {
            await Templates.SaveArchiveAsync(_archive);
            _archive = Templates.Archive;
            Toasts.Show(_archive is null ? "No archive copy." : $"Every email TIDE sends is now blind-copied to {_archive}.");
        }
        catch (Exception ex) { _archiveError = UserFacingError.For(ex); }
        finally { _busy = false; }
    }

    private IReadOnlyList<EmailTemplateView>? _views;
    private string _id = "";
    private string _subject = "", _heading = "", _body = "";
    private string _stamp = "";   // what was saved when the editor opened it, so a stale page can't write over a newer change
    private EmailPreview? _preview;
    private string? _error;
    private bool _busy;
    private string? _to;   // where a test goes: AD's address, or the one saved on an earlier visit while AD is down

    // What was typed into a template not yet saved, so moving to another one doesn't lose it.
    private readonly Dictionary<string, (string Subject, string Heading, string Body, string Stamp)> _drafts = new();

    private EmailTemplateView? Selected => _views?.FirstOrDefault(v => v.Template.Id == _id);

    // Judged as the save would store it: one line and trimmed.
    private bool Unsaved => Selected is { } v &&
        (EmailTemplateCatalog.Normalize(EmailPart.Subject, _subject) != v.Subject
         || EmailTemplateCatalog.Normalize(EmailPart.Heading, _heading) != v.Heading
         || EmailTemplateCatalog.Normalize(EmailPart.Body, _body) != v.Body);

    protected override async Task OnInitializedAsync()
    {
        _views = await Templates.GetAllAsync();
        _archive = Templates.Archive;
        _to = await Templates.TestAddressAsync();
        if (_views.Count > 0) Select(_views[0].Template.Id);
    }

    private void Select(string id)
    {
        if (_busy) return;
        if (Unsaved) _drafts[_id] = (_subject, _heading, _body, _stamp);
        else _drafts.Remove(_id);
        _id = id;
        _error = null;
        if (Selected is not { } v) return;
        (_subject, _heading, _body, _stamp) = _drafts.Remove(id, out var draft) ? draft : (v.Subject, v.Heading, v.Body, v.Stamp);
        ShowCopies();
        UpdatePreview();
    }

    private void AddToken(string name)
    {
        _body = (_body.TrimEnd().Length == 0 ? "" : _body.TrimEnd() + " ") + $"{{{{{name}}}}}";
        UpdatePreview();
    }

    private void UpdatePreview()
    {
        try { _preview = Templates.Preview(_id, _subject, _heading, _body); }
        catch (Exception ex) { _error = UserFacingError.For(ex); }
    }

    private void Revert()
    {
        if (Selected is not { } v) return;
        (_subject, _heading, _body, _stamp) = (v.Subject, v.Heading, v.Body, v.Stamp);
        _error = null;
        UpdatePreview();
    }

    private async Task Save()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            await Templates.SaveAsync(_id, _subject, _heading, _body, _stamp);
            await Reload();
            Toasts.Show("Template saved.");
        }
        catch (Exception ex) { _error = UserFacingError.For(ex); }
        finally { _busy = false; }
    }

    private async Task Reset()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            await Templates.ResetAsync(_id);
            await Reload();
            Toasts.Show("Reset to default.");
        }
        catch (Exception ex) { _error = UserFacingError.For(ex); }
        finally { _busy = false; }
    }

    // Reads the templates again and shows the selected one as saved.
    private async Task Reload()
    {
        _views = await Templates.GetAllAsync();
        if (Selected is { } v) (_subject, _heading, _body, _stamp) = (v.Subject, v.Heading, v.Body, v.Stamp);
        UpdatePreview();
    }

    private async Task SendTest()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Templates.SendTestAsync(_id, _subject, _heading, _body);
            if (result.Status == EmailSendStatus.Failed) _error = $"The test didn't send. {result.Error}";
            else if (result.Status == EmailSendStatus.Unknown) _error = $"The test may not have gone. {result.Error}";
            else if (result.Status == EmailSendStatus.Disabled) Toasts.Show("Email is turned off on this server, so nothing was sent.");
            else Toasts.Show($"Test sent to {_to}. The draft isn't saved.");
        }
        catch (Exception ex) { _error = UserFacingError.For(ex); }
        finally { _busy = false; }
    }
}
