@page "/admin/teams"
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@inject TeamService TeamSvc
@inject SlaSettings Sla
@inject OperationalSettingsService Settings
@inject ReminderService Reminders
@inject IUserDirectory Users
@inject OrgClock Clock
@inject ToastService Toasts
@inject IJSRuntime JS
@inject ActionFileService FileSvc
@inject Tide.Application.Preferences.NotificationPreferenceService NotifyPrefs
@using Tide.Application.Settings
@using Tide.Application.Preferences

<PageTitle>Teams &amp; SLA · TIDE</PageTitle>

<div class="tide-page-head">
    <div>
        <h1 class="tide-admin-title">Teams &amp; SLA</h1>
    </div>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="show-retired" @bind="_showRetired" @bind:after="Load" />
        <label class="form-check-label" for="show-retired">Show retired</label>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        @foreach (var (t, i) in _teams.Select((t, i) => (t, i)))
        {
            <div class="tide-card @(t.IsRetired ? "tide-retired" : "")" @key="t.Id" data-submit-scope>
                @if (_editing == t.Id)
                {
                    <ChangedElsewhere By="@_changedBy" What="team" OnReload="ReloadTheirs" />
                    <div class="row g-2 mb-2">
                        <div class="col-md-5"><input class="form-control form-control-sm" @bind="_form.Name" aria-label="Team name" /></div>
                        <div class="col-md-7"><input class="form-control form-control-sm" @bind="_form.Email" placeholder="Team mailbox (optional)" aria-label="Team mailbox" /></div>
                        <div class="col-12"><input class="form-control form-control-sm" @bind="_form.Description" placeholder="What the team does (optional)" aria-label="Team description" /></div>
                        <div class="col-12"><EscalationContactFields Id="@($"esc-contact-{t.Id}")" @bind-Name="_form.EscalationName" @bind-Email="_form.EscalationEmail" /></div>
                        <div class="col-12"><ActiveLimitFields Id="@($"limit-{t.Id}")" @bind-Limit="_form.ActiveLimit" @bind-Mode="_form.LimitMode" /></div>
                    </div>
                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-primary btn-sm" disabled="@_busy" data-submit @onclick="() => Save(t.Id)">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => (_editing, _changedBy) = (null, null)">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 align-items-start mb-2">
                        <div class="flex-grow-1">
                            <h2 class="tide-card-title mb-0">@t.Name @if (t.IsRetired) { <Badge>Retired</Badge> }</h2>
                            <div class="tide-muted small">@t.Description @if (t.Email is not null) { <span class="tide-data ms-1">@t.Email</span> }</div>
                            @if (t.ActiveLimit is { } limit) { <div class="small">@ActiveLimitFields.Summary(limit, t.LimitMode)</div> }
                            @if (t.EscalationEmail is not null) { <div class="small">Escalation contact: @t.EscalationName <span class="tide-data">@t.EscalationEmail</span></div> }
                        </div>
                        <button class="tide-icon-btn" title="Move up" aria-label="Move @t.Name up" disabled="@(i == 0)" @onclick="() => Run(() => TeamSvc.MoveAsync(t.Id, -1))"><span class="bi bi-arrow-up" aria-hidden="true"></span></button>
                        <button class="tide-icon-btn" title="Move down" aria-label="Move @t.Name down" disabled="@(i == _teams.Count - 1)" @onclick="() => Run(() => TeamSvc.MoveAsync(t.Id, 1))"><span class="bi bi-arrow-down" aria-hidden="true"></span></button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Edit(t)">Edit</button>
                        <button class="btn btn-outline-secondary btn-sm" title="A team that never owned an action is deleted; otherwise it's retired"
                                aria-label="@(t.IsRetired ? "Bring back" : "Retire") @t.Name" @onclick="() => Retire(t.Name, t.IsRetired, () => TeamSvc.SetRetiredAsync(t.Id, !t.IsRetired))">@(t.IsRetired ? "Bring back" : "Retire")</button>
                    </div>
                }
                <div>
                    @foreach (var m in t.Members)
                    {
                        <span class="tide-chip">@m.DisplayName
                            <button type="button" aria-label="Take @m.DisplayName off @t.Name" @onclick="() => RemoveMember(t.Name, t.Id, m.UserId, m.DisplayName)"><span class="bi bi-x" aria-hidden="true"></span></button>
                        </span>
                    }
                    @if (t.Members.Count == 0) { <span class="small tide-muted">No members yet.</span> }
                </div>
                @if (!t.IsRetired)
                {
                    <div class="d-flex gap-2 mt-2">
                        <select class="tide-maxw-md form-select form-select-sm" aria-label="Person to add to @t.Name" value="@_add.GetValueOrDefault(t.Id)" @onchange="e => _add[t.Id] = e.Value?.ToString() ?? string.Empty">
                            <option value="">Add a person&hellip;</option>
                            @foreach (var p in _people.Where(p => t.Members.All(m => m.UserId != p.Sid)))
                            {
                                <option value="@p.Sid">@p.DisplayName</option>
                            }
                        </select>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(_busy || string.IsNullOrEmpty(_add.GetValueOrDefault(t.Id)))" @onclick="() => AddMember(t.Id)">Add</button>
                    </div>
                    <div class="form-text">People appear here once they've signed in to TIDE.</div>
                }
            </div>
        }

        <div class="tide-card">
            <h2>External teams</h2>
            <p class="small tide-muted mb-2">Teams tracked here that work outside TIDE: no members, reminded by email at their contact address. Anyone who works actions keeps them; set their limits there too.</p>
            <a class="btn btn-outline-secondary btn-sm" href="teams/external"><span class="bi bi-building" aria-hidden="true"></span> Manage external teams</a>
        </div>

        <div class="tide-card" data-submit-scope>
            <h2>New team</h2>
            <div class="row g-2">
                <div class="col-md-5"><input class="form-control form-control-sm" placeholder="Name (e.g. Vulnerability Management)" aria-label="New team name" @bind="_newName" /></div>
                <div class="col-md-5"><input class="form-control form-control-sm" placeholder="Team mailbox (optional)" aria-label="New team mailbox" @bind="_newEmail" /></div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" disabled="@_busy" data-submit @onclick="AddTeam">Add team</button></div>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="tide-card" data-submit-scope>
            <h2>SLA targets</h2>
            <p class="small tide-muted">Business days a new action gets before it's due. A kind's target, when set, wins over the priority's. Blank or 0: none.</p>
            <table class="tide-table mb-2">
                <tbody>
                    @foreach (var p in Enum.GetValues<Priority>())
                    {
                        <tr>
                            <td>Priority <strong>@p</strong></td>
                            <td class="tide-col-sm"><input type="number" min="0" max="@ActionSla.MaxDays" class="form-control form-control-sm" aria-label="Business days for @p" value="@_byPriority.GetValueOrDefault(p)" @onchange="e => _byPriority[p] = ParseDays(e)" /></td>
                        </tr>
                    }
                    @foreach (var k in Enum.GetValues<ActionKind>())
                    {
                        <tr>
                            <td class="small">@ActionService.KindName(k)</td>
                            <td><input type="number" min="0" max="@ActionSla.MaxDays" class="form-control form-control-sm" aria-label="Business days for @ActionService.KindName(k)" value="@_byKind.GetValueOrDefault(k)" @onchange="e => _byKind[k] = ParseDays(e)" placeholder="priority's" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button class="btn btn-primary btn-sm" disabled="@_busy" data-submit @onclick="SaveSla">Save targets</button>
        </div>

        <section class="tide-card" aria-labelledby="rem-title" data-submit-scope>
            <h2 id="rem-title">Reminders and digests</h2>
            <p class="small tide-muted">All off by default but the personal digest's offer; each is sent once. Times in @Clock.Zone.Id
                (<a href="admin/organization">Organization settings</a>). Until saved here, the server's <span class="tide-data">Notifications</span> values apply.</p>
            <div class="row g-2 mb-2">
                <div class="col-sm-6">
                    <label class="tide-field-label" for="rem-time">Due-soon and overdue reminders go at</label>
                    <TimeBox Id="rem-time" @bind-Value="_rem.ReminderTime" DescribedBy="rem-time-help" />
                    <div class="form-text" id="rem-time-help">On business days; the brief rotation reminder goes then too.</div>
                </div>
            </div>
            <table class="tide-table mb-2">
                <tbody>
                    @foreach (var kind in Enum.GetValues<ReminderKind>().Where(k => k != ReminderKind.Escalation))
                    {
                        var last = Reminders.LastRun(kind);
                        var id = "rem-on-" + kind;
                        <tr>
                            <td>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="@id" checked="@_rem.On.GetValueOrDefault(kind)" @onchange="e => _rem.On[kind] = e.Value is true" />
                                    <label class="form-check-label" for="@id">@KindText(kind)</label>
                                </div>
                                <div class="small tide-muted">@KindAbout(kind)@(last is null ? "" : $" · last run {Ui.When(Clock, last.AtUtc)}: {(last.Error ?? $"{last.Sent} sent")}{(last.Note is { } note ? $" ({note})" : "")}")</div>
                                @if (PreferenceOf(kind) is { } pref) { @Count(pref, kind) }
                            </td>
                            <td class="text-end"><button class="btn btn-outline-secondary btn-sm text-nowrap" disabled="@_busy" aria-label="Run @KindText(kind) now" @onclick="() => RunNow(kind)">Run now</button></td>
                        </tr>
                        @if (_showing is not null && _showing == PreferenceOf(kind) && _owner == kind)
                        {
                            <tr><td colspan="2" class="pt-0">@List(_showing, KindText(kind), kind)</td></tr>
                        }
                        @if (kind == ReminderKind.ExternalReminder)
                        {
                            <tr>
                                <td colspan="2" class="ps-4">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" role="switch" id="rem-ext-new" aria-describedby="rem-ext-new-help" @bind="_rem.NewExternalTeamsOn" />
                                        <label class="form-check-label" for="rem-ext-new">New external teams start with their reminders on</label>
                                    </div>
                                    <div class="small tide-muted" id="rem-ext-new-help">Off: a team added on External teams or while splitting an action isn't emailed until someone turns its reminders on. Teams already added keep theirs.</div>
                                    <div class="row g-2 mt-1">
                                        <div class="col-sm-6">
                                            <label class="tide-field-label" for="rem-ext-before">A new team is reminded (business days before the due date)</label>
                                            <input id="rem-ext-before" type="number" min="0" max="@Team.MaxRemindBefore" class="form-control form-control-sm tide-w-count" @bind="_rem.NewExternalBefore" aria-describedby="rem-ext-before-help" />
                                            <div class="form-text" id="rem-ext-before-help">0: on the due day only.</div>
                                        </div>
                                        <div class="col-sm-6">
                                            <label class="tide-field-label" for="rem-ext-every">Then while overdue, every (business days)</label>
                                            <input id="rem-ext-every" type="number" min="@Team.MinRemindEvery" max="@Team.MaxRemindEvery" class="form-control form-control-sm tide-w-count" placeholder="Once" @bind="_rem.NewExternalEvery" aria-describedby="rem-ext-every-help" />
                                            <div class="form-text" id="rem-ext-every-help">Blank: once only. Whoever adds a team can change both.</div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tr>
                        <td colspan="2">
                            <div>@NotificationKinds.RotationRequests.Title</div>
                            <div class="small tide-muted">Swap and cover requests, and approved, recorded or declined notices: always sent. The managers' copies aren't anyone's to turn off.</div>
                            @Count(NotificationKinds.RotationRequests.Name)
                            @if (_showing == NotificationKinds.RotationRequests.Name) { @List(_showing, NotificationKinds.RotationRequests.Title) }
                        </td>
                    </tr>
                </tbody>
            </table>
            <p class="small tide-muted">People choose for themselves in My notifications (the account menu): they can turn off what's on here, and take a personal digest. These counts are read-only.</p>
            <div class="row g-2">
                <div class="col-sm-6">
                    <label class="tide-field-label" for="rem-digest-day">Digest goes on</label>
                    <select id="rem-digest-day" class="form-select form-select-sm" @bind="_rem.DigestDay">
                        @foreach (var d in Week) { <option value="@d">@d</option> }
                    </select>
                </div>
                <div class="col-sm-6">
                    <label class="tide-field-label" for="rem-digest-time">Digest goes at</label>
                    <TimeBox Id="rem-digest-time" @bind-Value="_rem.DigestTime" />
                </div>
                <div class="col-sm-6">
                    <label class="tide-field-label" for="rem-bnr-time">Brief-not-ready nudge at</label>
                    <TimeBox Id="rem-bnr-time" @bind-Value="_rem.BriefNotReadyTime" DescribedBy="rem-bnr-help" />
                    <div class="form-text" id="rem-bnr-help">Before the meeting (@Clock.MeetingTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)), or it isn't sent.</div>
                </div>
                <div class="col-12">
                    <label class="tide-field-label" for="rem-bnr-to">Told when there's no brief yet</label>
                    <textarea id="rem-bnr-to" class="form-control form-control-sm tide-data tide-autogrow tide-grow-2" rows="2" @bind="_rem.Recipients" placeholder="cti-lead@example.org" aria-describedby="rem-bnr-to-help"></textarea>
                    <div class="form-text" id="rem-bnr-to-help">The team lead or a team mailbox, when the day has no brief or its analyst has no address. Separate addresses with commas or lines.</div>
                </div>
                <div class="col-sm-6">
                    <label class="tide-field-label" for="rem-followup-days">Outreach follow-up after (business days)</label>
                    <input id="rem-followup-days" type="number" class="form-control form-control-sm tide-w-count" min="@ReminderOptions.FollowUpOptions.MinDays" max="@ReminderOptions.FollowUpOptions.MaxDays"
                           aria-describedby="rem-followup-help" @bind="_rem.FollowUpDays" />
                    <div class="form-text" id="rem-followup-help">How long an Outreach action's email waits for its reply before whoever sent it is reminded, at the reminder time.</div>
                </div>
                <div class="col-sm-6">
                    <label class="tide-field-label" for="rem-active-days">Remind people signed in within (days)</label>
                    <input id="rem-active-days" type="number" class="form-control form-control-sm tide-w-count" min="@ReminderOptions.MinActiveWithinDays" max="@ReminderOptions.MaxActiveWithinDays"
                           aria-describedby="rem-active-help" @bind="_rem.ActiveDays" />
                    <div class="form-text" id="rem-active-help">Someone who hasn't signed in for longer, or whose roles no longer let them see what a reminder shows, isn't sent one. A team mailbox always is.</div>
                </div>
            </div>
            <button class="btn btn-primary btn-sm mt-2" disabled="@_busy" data-submit @onclick="SaveReminders">Save reminders</button>
        </section>

        <section class="tide-card" aria-labelledby="esc-title">
            <h2 id="esc-title">Escalation</h2>
            <p class="small tide-muted">Steps that run by themselves on an open action as it slips (Tracking included), at the reminder time on business days.
                Each runs once per action and due date, and is kept in the action's history; a new due date starts the ladder again, and a closed action gets none.
                Off until it's turned on here.</p>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="esc-on" checked="@_esc.On" @onchange="e => _esc.On = e.Value is true" />
                <label class="form-check-label" for="esc-on">Climb the escalation ladder</label>
            </div>
            <fieldset class="mb-2">
                <legend class="tide-field-label">Which actions</legend>
                @foreach (var (scope, text) in EscalationForm.Scopes)
                {
                    var id = "esc-scope-" + scope;
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="esc-scope" id="@id" checked="@(_esc.Scope == scope)" @onchange="() => _esc.Scope = scope" />
                        <label class="form-check-label" for="@id">@text</label>
                    </div>
                }
            </fieldset>
            <table class="tide-table mb-2" aria-label="Escalation steps, in order">
                <thead><tr><th scope="col">When</th><th scope="col">What it does</th><th scope="col"><span class="visually-hidden">Order</span></th></tr></thead>
                <tbody>
                    @foreach (var (s, i) in _esc.Steps.Select((s, i) => (s, i)))
                    {
                        var n = i + 1;
                        <tr @key="s">
                            <td>
                                <div class="d-flex gap-1 align-items-center">
                                    @if (s.When != StepWhen.Due)
                                    {
                                        <input id="@($"esc-days-{n}")" type="number" min="0" max="@EscalationLadder.MaxDays" class="form-control form-control-sm tide-w-count"
                                               aria-label="@($"Step {n}: business days")" @bind="s.Days" />
                                    }
                                    <select id="@($"esc-when-{n}")" class="form-select form-select-sm" aria-label="@($"Step {n}: before, on or after the due date")" @bind="s.When">
                                        <option value="@StepWhen.Before">business days before</option>
                                        <option value="@StepWhen.Due">on the due day</option>
                                        <option value="@StepWhen.After">business days after</option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                @foreach (var (does, word, name) in EscalationLadder.Menu)
                                {
                                    var box = $"esc-{n}-{word}";
                                    <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" id="@box" checked="@s.Has(does)"
                                        @onchange="e => s.Set(does, e.Value is true)" /><label class="form-check-label small" for="@box">@name</label></div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="tide-icon-btn" title="Move up" aria-label="@($"Move step {n} up")" disabled="@(i == 0)" @onclick="() => _esc.Move(s, -1)"><span class="bi bi-arrow-up" aria-hidden="true"></span></button>
                                <button type="button" class="tide-icon-btn" title="Move down" aria-label="@($"Move step {n} down")" disabled="@(i == _esc.Steps.Count - 1)" @onclick="() => _esc.Move(s, 1)"><span class="bi bi-arrow-down" aria-hidden="true"></span></button>
                                <button type="button" class="tide-icon-btn" title="Remove" aria-label="@($"Remove step {n}")" @onclick="() => _esc.Remove(s)"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                            </td>
                        </tr>
                    }
                    @if (_esc.Steps.Count == 0)
                    {
                        <tr><td colspan="3" class="small tide-muted">No steps: the ladder does nothing.</td></tr>
                    }
                </tbody>
            </table>
            <div class="d-flex gap-2 mb-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_esc.CanAdd)" @onclick="_esc.Add"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add step</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="_esc.UseDefaults">Use the defaults</button>
            </div>
            <div class="form-text mb-2" id="esc-help">
                At most @EscalationLadder.MaxSteps steps, 0 to @EscalationLadder.MaxDays business days (the organization's, holidays skipped).
                <strong>Remind</strong> emails the team as its reminders do: an external team its reminder, an internal one the assignee, else its mailbox, else its members.
                <strong>Copy contact</strong> emails the team's escalation contact, set on the team (no TIDE links for an external team).
                <strong>Raise priority</strong> moves it up one, to P1 at most.
                <strong>Flag</strong> marks it Escalated: a badge, Today's Escalated list for its team and assignee, and the meeting's overdue list, until it closes or its due date changes.
                When several steps have come at once (the ladder just turned on), only the latest runs.
            </div>
            @if (Reminders.LastRun(ReminderKind.Escalation) is { } run)
            {
                <div class="small tide-muted mb-2">Last run @Ui.When(Clock, run.AtUtc): @(run.Error ?? $"{run.Sent} sent")@(run.Note is { } note ? $" ({note})" : "")</div>
            }
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveEscalation">Save escalation</button>
                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" aria-label="Run the escalation ladder now" @onclick="() => RunNow(ReminderKind.Escalation)">Run now</button>
            </div>
        </section>

        <section class="tide-card" aria-labelledby="files-title">
            <h2 id="files-title">Action files</h2>
            <p class="small tide-muted">Which files on actions and their comments download in a zip with the password <span class="tide-data">infected</span>
                by default, so a double-click can't run one and antivirus doesn't remove it on arrival. The file as it is stays a second link.
                A file can run when its name, its declared type or its first bytes say so: programs, scripts, installers, shortcuts, Office files with macros and the like.
                @FileSvc.LimitsText These limits are set on the server (<span class="tide-data">Files:MaxEvidenceMB</span>, <span class="tide-data">Files:MaxImageMB</span>).</p>
            <fieldset>
                <legend class="tide-field-label">Download in a password-protected zip</legend>
                @foreach (var (mode, text) in ZipChoices)
                {
                    var id = "zip-" + mode;
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="zip-mode" id="@id" checked="@(Zip == mode)" @onchange="() => Zip = mode" />
                        <label class="form-check-label" for="@id">@text</label>
                    </div>
                }
            </fieldset>
            <button class="btn btn-primary btn-sm mt-2" disabled="@_busy" @onclick="SaveZip">Save</button>
        </section>
    </div>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = default!;
    private IReadOnlyList<Team> _teams = [];
    private IReadOnlyList<AppUser> _people = [];
    private bool _showRetired, _busy;
    private Guid? _editing;
    private string? _newName, _newEmail;
    private TeamForm _form = new();

    private readonly Dictionary<Guid, string> _add = [];
    private readonly Dictionary<Priority, int?> _byPriority = [];
    private readonly Dictionary<ActionKind, int?> _byKind = [];
    private ReminderForm _rem = new();
    private EscalationForm _esc = new();

    /// <summary>The escalation ladder as the form holds it.</summary>
    internal EscalationForm Escalation => _esc;

    internal static readonly IReadOnlyList<(ZipDownloads Mode, string Text)> ZipChoices =
    [
        (ZipDownloads.RiskyOnly, "Files that can run (the default)"),
        (ZipDownloads.Always, "Every file"),
        (ZipDownloads.Never, "Never: every file downloads as it is"),
    ];

    internal ZipDownloads Zip { get; set; }

    internal async Task SaveZip()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Settings.SaveAsync(new Dictionary<string, string?> { [OperationalSettings.ZipDownloads] = Zip.ToString() });
            Toasts.Show("Saved.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    private static readonly DayOfWeek[] Week =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    // The reminder settings as the form edits them, from the settings in force (saved here, else the server's).
    private sealed class ReminderForm
    {
        public Dictionary<ReminderKind, bool> On { get; } = [];
        public TimeOnly ReminderTime { get; set; }
        public DayOfWeek DigestDay { get; set; }
        public TimeOnly DigestTime { get; set; }
        public TimeOnly BriefNotReadyTime { get; set; }
        public string? Recipients { get; set; }
        public int FollowUpDays { get; set; }
        public int ActiveDays { get; set; }
        public bool NewExternalTeamsOn { get; set; }
        public int NewExternalBefore { get; set; }
        public int? NewExternalEvery { get; set; }

        public static ReminderForm From(ReminderService r)
        {
            var o = r.Options;
            var form = new ReminderForm
            {
                ReminderTime = Time(o.ReminderTime, 8), DigestDay = o.Digest.Day, DigestTime = Time(o.Digest.Time, 8),
                BriefNotReadyTime = Time(o.BriefNotReady.Time, 10), Recipients = string.Join(Environment.NewLine, o.BriefNotReady.Recipients ?? []),
                FollowUpDays = ReminderOptions.FollowUpOptions.Clamp(o.OutreachFollowUp.Days),
                ActiveDays = o.ActiveDays,
                NewExternalTeamsOn = o.ExternalReminders.NewTeamsOn,
                NewExternalBefore = o.ExternalReminders.BeforeDays, NewExternalEvery = o.ExternalReminders.EveryDays,
            };
            foreach (var kind in Enum.GetValues<ReminderKind>()) form.On[kind] = r.IsEnabled(kind);
            return form;
        }

        private static TimeOnly Time(string? text, int fallbackHour) =>
            TimeOnly.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, out var t) ? t : new TimeOnly(fallbackHour, 0);
    }

    protected override async Task OnInitializedAsync()
    {
        // Before the first await: the page renders as soon as one yields (on SQL Server they do), and the reminder
        // switches read this form.
        _rem = ReminderForm.From(Reminders);
        _esc = EscalationForm.From(Reminders.Options.Escalation);
        Zip = FileSvc.ZipMode;
        _counts = await NotifyPrefs.CountsAsync();
        _people = await Users.ListAsync();
        var targets = await Sla.GetAsync();
        foreach (var p in Enum.GetValues<Priority>()) _byPriority[p] = targets.ByPriority.TryGetValue(p, out var v) ? v : null;
        foreach (var k in Enum.GetValues<ActionKind>()) _byKind[k] = targets.ByKind.TryGetValue(k, out var v) ? v : null;
        await Load();
    }

    // The internal teams: the external ones are kept on their own page, by whoever works actions.
    private async Task Load() => _teams = (await TeamSvc.ListAsync(_showRetired)).Where(t => !t.IsExternal).ToList();

    private static int? ParseDays(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? v : null;

    private static string KindText(ReminderKind k) => k switch
    {
        ReminderKind.DueSoon => "Due-soon reminders",
        ReminderKind.Overdue => "Overdue reminders",
        ReminderKind.Digest => "Weekly team digest",
        ReminderKind.Presenting => "Brief rotation reminder",
        ReminderKind.PersonalDigest => "Personal digest",
        ReminderKind.OutreachFollowUp => "Outreach follow-up",
        ReminderKind.ExternalReminder => "External team reminders",
        ReminderKind.Escalation => "Escalation ladder",
        _ => "Brief-not-ready nudge",
    };

    private static string KindAbout(ReminderKind k) => k switch
    {
        ReminderKind.DueSoon => "Actions due today or the next business day, to their owners",
        ReminderKind.Overdue => "Actions past due, to their owners",
        ReminderKind.Digest => "Each team's week, to its mailbox or members",
        ReminderKind.Presenting => "To whoever presents the next business day",
        ReminderKind.PersonalDigest => "Offered in My notifications: each person's own actions, daily at the reminder time or weekly on the digest day",
        ReminderKind.OutreachFollowUp => "To whoever marked an Outreach action's email sent, when no reply is recorded after the days set below",
        ReminderKind.ExternalReminder => "To each external team's contact email, with its reminders on: its actions due soon or overdue, at its own cadence. No TIDE links",
        ReminderKind.Escalation => "The steps each open action has reached as it slips",
        _ => "To the presenting analyst, if today's brief isn't ready",
    };

    // The choice in My notifications that leaves people out of a kind (or, for the personal digest, takes it).
    // None for the external teams' reminders: they go to no one in TIDE, so no one opts out.
    private static string? PreferenceOf(ReminderKind k) => NotificationKinds.For(k)?.Name;

    private IReadOnlyDictionary<string, int> _counts = new Dictionary<string, int>();
    private string? _showing;
    private ReminderKind? _owner;
    private IReadOnlyList<NotificationChooser> _choosers = [];

    /// <summary>"3 people opted out" or "5 people get a personal digest".</summary>
    internal static string CountText(string pref, int n)
    {
        var people = n == 1 ? "1 person" : $"{n} people";
        return pref == UserPreferences.NotifyDigest
            ? n == 0 ? "No one gets a personal digest" : $"{people} get{(n == 1 ? "s" : "")} a personal digest"
            : n == 0 ? "No one opted out" : $"{people} opted out";
    }

    // Two scans can share a choice (the rotation reminders), so a list is named for the row that opened it too.
    private static string ListId(string pref, ReminderKind? owner) => "optlist-" + pref.Replace('.', '-') + (owner is null ? "" : "-" + owner);

    // The count under a kind, a button that opens the list of those people (read-only) below it.
    private RenderFragment Count(string pref, ReminderKind? owner = null) => __builder =>
    {
        var n = _counts.GetValueOrDefault(pref);
        var listId = ListId(pref, owner);
        <div class="small">
            @if (n == 0)
            {
                <span class="tide-muted">@CountText(pref, n)</span>
            }
            else
            {
                <button type="button" class="tide-optcount" aria-expanded="@(_showing == pref && _owner == owner ? "true" : "false")" aria-controls="@listId"
                        @onclick="() => ShowChoosers(pref, owner)">@CountText(pref, n)</button>
            }
        </div>
    };

    // Who opted out of a kind (or takes a personal digest), and since when.
    private RenderFragment List(string pref, string what, ReminderKind? owner = null) => __builder =>
    {
        var digest = pref == UserPreferences.NotifyDigest;
        <table class="tide-table tide-optlist" id="@ListId(pref, owner)" aria-label="@what: @CountText(pref, _counts.GetValueOrDefault(pref))">
            <thead><tr><th>Name</th><th>Email</th>@if (digest) { <th>How often</th> }<th>Since</th></tr></thead>
            <tbody>
                @foreach (var c in _choosers)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td class="tide-data">@(c.Email ?? "no address")</td>
                        @if (digest) { <td>@c.Value</td> }
                        <td class="text-nowrap">@Ui.When(Clock, c.Since)</td>
                    </tr>
                }
            </tbody>
        </table>
    };

    internal async Task ShowChoosers(string pref, ReminderKind? owner = null)
    {
        if (_showing == pref && _owner == owner)
        {
            (_showing, _owner) = (null, null);
        }
        else
        {
            try
            {
                _choosers = await NotifyPrefs.PeopleAsync(pref);
                (_showing, _owner) = (pref, owner);
            }
            catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        }
        StateHasChanged();
    }

    private static string Hm(TimeOnly t) => t.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private static string Switch(bool on) => on ? "true" : "false";

    internal async Task SaveReminders()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Settings.SaveAsync(new Dictionary<string, string?>
            {
                [OperationalSettings.ReminderTime] = Hm(_rem.ReminderTime),
                [OperationalSettings.DueSoon] = Switch(_rem.On[ReminderKind.DueSoon]),
                [OperationalSettings.Overdue] = Switch(_rem.On[ReminderKind.Overdue]),
                [OperationalSettings.Presenting] = Switch(_rem.On[ReminderKind.Presenting]),
                [OperationalSettings.Digest] = Switch(_rem.On[ReminderKind.Digest]),
                [OperationalSettings.DigestDay] = _rem.DigestDay.ToString(),
                [OperationalSettings.DigestTime] = Hm(_rem.DigestTime),
                [OperationalSettings.BriefNotReady] = Switch(_rem.On[ReminderKind.BriefNotReady]),
                [OperationalSettings.BriefNotReadyTime] = Hm(_rem.BriefNotReadyTime),
                [OperationalSettings.BriefNotReadyRecipients] = _rem.Recipients,
                [OperationalSettings.PersonalDigest] = Switch(_rem.On[ReminderKind.PersonalDigest]),
                [OperationalSettings.OutreachFollowUp] = Switch(_rem.On[ReminderKind.OutreachFollowUp]),
                [OperationalSettings.OutreachFollowUpDays] = _rem.FollowUpDays.ToString(System.Globalization.CultureInfo.InvariantCulture),
                [OperationalSettings.ActiveWithinDays] = _rem.ActiveDays.ToString(System.Globalization.CultureInfo.InvariantCulture),
                [OperationalSettings.ExternalReminders] = Switch(_rem.On[ReminderKind.ExternalReminder]),
                [OperationalSettings.ExternalRemindersNewTeams] = Switch(_rem.NewExternalTeamsOn),
                [OperationalSettings.ExternalRemindersNewBefore] = _rem.NewExternalBefore.ToString(System.Globalization.CultureInfo.InvariantCulture),
                [OperationalSettings.ExternalRemindersNewEvery] = (_rem.NewExternalEvery ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture),
            });
            _rem = ReminderForm.From(Reminders);
            Toasts.Show("Saved. Applies within five minutes.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // Saves the ladder: on or off, its scope and its steps, together and each checked; refused whole, saying why.
    internal async Task SaveEscalation()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Settings.SaveAsync(new Dictionary<string, string?>
            {
                [OperationalSettings.Escalation] = Switch(_esc.On),
                [OperationalSettings.EscalationScope] = _esc.Scope.ToString(),
                [OperationalSettings.EscalationSteps] = _esc.StepsText(),
            });
            _esc = EscalationForm.From(Reminders.Options.Escalation);
            Toasts.Show("Escalation saved. Applies at the next reminder time.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    internal void Edit(Team t)
    {
        (_editing, _changedBy) = (t.Id, null);
        _form = TeamForm.From(t);
    }

    /// <summary>The form of the team being edited.</summary>
    internal TeamForm EditForm => _form;

    // Who changed the team being edited since its form opened ("Someone", once a save was refused as stale); null when
    // no one has.
    private string? _changedBy;
    internal string? ChangedBy => _changedBy;

    // One save, on the version the form opened on: another administrator's change since is refused, not overwritten.
    internal Task Save(Guid id) => Run(async () =>
    {
        try { await TeamSvc.UpdateAsync(id, _form); }
        catch (Tide.Application.Articles.StaleEditException)
        {
            // The form stays to copy from, and Reload shows theirs.
            _changedBy ??= "Someone";
            throw;
        }
        (_editing, _changedBy) = (null, null);
    });

    // The banner's Reload: the team as it is now (the list is read again), and what was typed goes.
    internal async Task ReloadTheirs()
    {
        var id = _editing;
        await Load();
        if (_teams.FirstOrDefault(t => t.Id == id) is { } now)
        {
            Edit(now);
            Toasts.Show("Reloaded. Your unsaved changes were dropped.");
        }
        else
        {
            (_editing, _changedBy) = (null, null);
            Toasts.Show("That team no longer exists.");
        }
    }

    /// <summary>The internal teams listed.</summary>
    internal IReadOnlyList<Team> Shown => _teams;

    private Task AddTeam() => Run(async () =>
    {
        await TeamSvc.AddAsync(_newName ?? "", null, _newEmail);
        _newName = _newEmail = null;
    });

    private Task AddMember(Guid teamId) => Run(async () =>
    {
        var sid = _add.GetValueOrDefault(teamId);
        var person = _people.FirstOrDefault(p => p.Sid == sid) ?? throw new ArgumentException("Choose a person.");
        await TeamSvc.AddMemberAsync(teamId, person.Sid, person.DisplayName);
        _add.Remove(teamId);
    });

    private async Task SaveSla()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Sla.SaveAsync(_byPriority, _byKind);
            Toasts.Show("SLA targets saved.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // Sends the reminder emails now: once per click, however fast the clicks.
    private async Task RunNow(ReminderKind kind)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var sent = await Reminders.RunNowAsync(kind);
            Toasts.Show($"{KindText(kind)}: {sent} email{(sent == 1 ? "" : "s")} sent.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    private async Task Retire(string name, bool isRetired, Func<Task> action)
    {
        if (await Retiring.ConfirmAsync(_confirm, name, isRetired)) await Run(action);
    }

    // Taking someone off hands their open actions for the team back to it, unassigned: asked first, and said after.
    private async Task RemoveMember(string team, Guid teamId, string userId, string name)
    {
        if (!await _confirm.Ask($"Take {name} off {team}?",
                $"Their open actions for {team} go back to the team, unassigned, so someone there picks them up. Each one's history says so.",
                "Take off")) return;
        if (_busy) return;
        _busy = true;
        try
        {
            var handed = await TeamSvc.RemoveMemberAsync(teamId, userId);
            await Load();
            Toasts.Show(handed == 0 ? $"{name} is off {team}." : $"{name} is off {team}; {handed} open action{(handed == 1 ? "" : "s")} went back to the team.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // One change at a time: a second click while one runs (a double-click on Add) does nothing, so nothing is added
    // twice. The buttons are disabled meanwhile.
    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await action();
            await Load();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
}
