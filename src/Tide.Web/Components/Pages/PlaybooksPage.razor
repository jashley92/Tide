@inject PlaybookService PlaybookSvc
@inherits LibraryPage<PlaybookRow>
@using Tide.Web.Components.LibraryRail

@* The team's playbooks, a tab of the Library page (which checks who may open it): a checklist for a kind of action, or
   for any, that an action's checklist starts from when it's raised, or that's applied from the checklist later. Kept as
   the saved queries are: whoever works actions adds, edits, reorders, retires and restores them, and deletes one they
   made (an administrator, any, the starters too); everyone else who reads actions reads them. One an action was started
   from is retired, not deleted. The list names each with the kind of action it's for and how many actions started from
   it; the one chosen is shown in full. A colleague's change re-reads the list in place; an edit under way keeps what's
   typed, and its save is refused if the playbook changed since it began. *@

<PageTitle>Playbooks · Library · TIDE</PageTitle>

<ConfirmDialog @ref="_confirm" />

@if (_canWrite && _form is null)
{
    <LibraryHead><button class="btn btn-primary" @onclick="New"><span class="bi bi-plus-lg" aria-hidden="true"></span> New playbook</button></LibraryHead>
}

@if (_form is { Id: null })
{
    <section class="tide-card tide-card-form" aria-labelledby="pb-new-h">
        <h2 id="pb-new-h">New playbook</h2>
        @EditForm
    </section>
}
else if (EditingAway)
{
    @* The playbook being edited isn't the one shown (another was chosen, or a colleague retired, deleted or renamed it, or
       a filter hides it): its form stays here, so what's typed can be saved or cancelled. *@
    <section class="tide-card tide-card-form" aria-labelledby="pb-edit-h">
        <h2 id="pb-edit-h">Edit playbook</h2>
        @EditForm
    </section>
}

@* The filter bar: a pill per kind of action (one at a time: those offered on that kind, its own and those for any), and
   Show retired as the checkbox it is on the other libraries. The words are the Library's search's. *@
<FilterBar Pills="Pills" Filters="Defs" Active="@(_kind is not null)" OnChanged="Refilter" OnClear="ClearFilters" PillsLabel="Kinds of action">
    <ChildContent>
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="pb-retired" checked="@_showRetired" @onchange="ToggleRetired" />
            <label class="form-check-label small" for="pb-retired">Show retired</label>
        </div>
    </ChildContent>
</FilterBar>

@if (_rows is null)
{
    <LoadingBlock />
}
else if (_rows.Count == 0)
{
    <div class="tide-card" tabindex="-1" @ref="_empty">
        <EmptyState Icon="bi-journal-check" Title="No playbooks yet.">@(_canWrite ? "Add one here, then choose it when you raise an action." : "Someone who works actions can add one.")</EmptyState>
    </div>
}
else if (Shown.Count == 0)
{
    <div class="tide-card" tabindex="-1" @ref="_empty">
        <EmptyState Icon="bi-search" Title="No playbook matches these filters." />
    </div>
}
else
{
    var r = Selected!;
    var p = r.Playbook;
    var id = "pb-" + p.Id.ToString("N");
    <LibraryBrowser Count="@CountText" Entries="Entries" Selected="SelectedId" Label="Playbooks" OnPick="Pick" Page="_page" Pages="Pages" OnPage="Turn" @ref="_browser">
        <ChildContent>
            <article class="tide-hunt tide-library-entry @(p.IsRetired ? "tide-retired" : "")" aria-labelledby="@(id + "-h")" @key="p.Id">
                @if (_form?.Id == p.Id)
                {
                    <h3 class="tide-subhead mt-0" id="@(id + "-h")">Edit @p.Name</h3>
                    @EditForm
                }
                else
                {
                    <div class="tide-library-entry-head">
                        <div class="tide-library-entry-title">
                            <h3 class="tide-library-entry-name" id="@(id + "-h")">@p.Name</h3>
                            <div class="small tide-muted"><Badge>@KindName(p)</Badge> @if (p.IsRetired) { <Badge>Retired</Badge> } @Provenance(p) · <span>@Used(r.Actions, "on", "action")</span></div>
                        </div>
                        <div class="tide-library-entry-tools">
                            @if (_canWrite)
                            {
                                @if (CanMove(p))
                                {
                                    <button class="btn btn-outline-secondary btn-sm" aria-label="Move @p.Name up" disabled="@(_busy || _form is not null || p.Id == _firstOffered)" @onclick="() => Move(p, -1)"><span class="bi bi-arrow-up" aria-hidden="true"></span></button>
                                    <button class="btn btn-outline-secondary btn-sm" aria-label="Move @p.Name down" disabled="@(_busy || _form is not null || p.Id == _lastOffered)" @onclick="() => Move(p, 1)"><span class="bi bi-arrow-down" aria-hidden="true"></span></button>
                                }
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_form is not null)" aria-label="Edit @p.Name" @onclick="() => Edit(p)"><span class="bi bi-pencil" aria-hidden="true"></span> Edit</button>
                            }
                            @if (MoreItems(r) is { Count: > 0 } more)
                            {
                                <MenuButton Label="More" MenuLabel="@($"More for {p.Name}")" Items="more" ButtonClass="btn btn-outline-secondary btn-sm" Disabled="_busy" />
                            }
                        </div>
                    </div>
                    @if (p.Description is { } about) { <p class="small mb-1">@about</p> }
                    <ol class="tide-playbook-preview small mb-3">
                        @foreach (var s in p.Steps) { <li>@s.Text</li> }
                    </ol>
                    <p class="small tide-muted tide-library-entry-foot">Its steps are copied onto an action, so an edit leaves started actions alone.@UnderMore(MoreItems(r))</p>
                }
            </article>
        </ChildContent>
        <Below><Pager Page="_page" Pages="Pages" Many="playbooks" Href="PageHref" /></Below>
    </LibraryBrowser>
    <LibraryEntryRail Kind="LibraryKind.Playbook" EntryId="p.Id" Name="@p.Name" Noun="playbook" Retired="p.IsRetired" For="p.Kind" OnAdded="Reread" Facts="Facts(r)" />
}

@code {
    private PlaybookForm? _form;
    private string? _steps;
    private ConfirmDialog _confirm = default!;
    private bool _canWrite;
    private ActionKind? _kind;

    // The first and last offered, in the pickers' order: what Move stops at.
    private Guid? _firstOffered, _lastOffered;

    internal PlaybookForm? Form => _form;

    protected override string Topic => ChangeFeed.Playbooks;

    protected override (string One, string Many, string Library) Names => ("playbook", "playbooks", "playbooks");

    protected override async Task<IReadOnlyList<PlaybookRow>> ReadAsync(bool includeRetired) => await PlaybookSvc.RowsAsync(includeRetired);

    // Those offered on the kind chosen (its own and those for any kind), or all, with every word typed.
    protected override IEnumerable<PlaybookRow> Filtered(IReadOnlyList<PlaybookRow> rows, IReadOnlyList<string> words) =>
        rows.Where(r => _kind is not { } k || PlaybookService.Suits(r.Playbook, k)).Where(r => PlaybookService.Matches(r.Playbook, words));

    protected override void ClearOwnFilters() => _kind = null;

    protected override Guid IdOf(PlaybookRow row) => row.Playbook.Id;

    protected override LibraryEntry Entry(PlaybookRow row) =>
        new(row.Playbook.Id, row.Playbook.Name, row.Playbook.Description, KindName(row.Playbook), Used(row.Actions, "on", "action"), row.Playbook.IsRetired);

    private static string KindName(Playbook p) => p.Kind is { } k ? ActionService.KindName(k) : "Any kind";

    protected override Guid? EditingId => _form?.Id;

    // The rail's facts: the kind of action it's for, its steps, who saved it, and how many actions started from it.
    private List<LibraryFact> Facts(PlaybookRow r) =>
        [new("For", r.Playbook.Kind is { } k ? ActionService.KindName(k) + " actions" : "Any action"), new("Steps", r.Playbook.Steps.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            SavedBy(r.Playbook), new("Used", r.Actions == 0 ? "Not yet" : "On " + Ui.Plural(r.Actions, "action"))];

    protected override void Filtering()
    {
        var offered = (_rows ?? []).Where(r => !r.Playbook.IsRetired).ToList();
        (_firstOffered, _lastOffered) = (offered.FirstOrDefault()?.Playbook.Id, offered.LastOrDefault()?.Playbook.Id);
    }

    // A pill per kind of action: presets of the kind filter, so one at a time.
    internal static readonly IReadOnlyList<FilterPill> Pills =
        [.. Enum.GetValues<ActionKind>().Select(k => new FilterPill(k.ToString(), ActionService.KindName(k), "kind", [k.ToString()]))];

    internal IReadOnlyList<FilterDef> Defs =>
        [new("kind", "Kind", FilterKind.Single, v => _kind = Enum.TryParse<ActionKind>(FilterValues.First(v), out var k) ? k : null)
            { InMenu = false, Values = FilterValues.Of(_kind?.ToString()) }];

    // Moving is in the whole order the pickers show, so it's offered only on the whole list: no words, no kind.
    private bool CanMove(Playbook p) => !p.IsRetired && _kind is null && string.IsNullOrWhiteSpace(_words);

    private RenderFragment EditForm => __builder =>
    {
        var f = _form!;
        @* Ctrl+Enter in a box presses Save (submitkeys.js): the form is its scope. *@
        <div data-submit-scope>
        <div class="row g-2">
            <div class="col-md-7">
                <label class="tide-field-label" for="pb-f-name">Name</label>
                <input id="pb-f-name" @ref="_formStart" class="form-control form-control-sm" maxlength="@Playbook.MaxName" placeholder="Ransomware IOC sweep" @bind="f.Name" />
            </div>
            <div class="col-md-5">
                <label class="tide-field-label" for="pb-f-kind">For</label>
                <select id="pb-f-kind" class="form-select form-select-sm" @bind="f.Kind">
                    <option value="">Any kind of action</option>
                    @foreach (var k in Enum.GetValues<ActionKind>()) { <option value="@k">@ActionService.KindName(k) actions</option> }
                </select>
            </div>
            <div class="col-12">
                <label class="tide-field-label" for="pb-f-about">What it's for (optional)</label>
                <input id="pb-f-about" class="form-control form-control-sm" maxlength="@Playbook.MaxDescription" @bind="f.Description" />
            </div>
            <div class="col-12">
                <label class="tide-field-label" for="pb-f-steps">Steps, one per line, in order</label>
                <textarea id="pb-f-steps" class="form-control form-control-sm tide-autogrow tide-grow-3" rows="8" aria-describedby="pb-f-steps-help" @bind="_steps"
                          placeholder="@("Pull the advisory's indicators\nSweep proxy logs, 30 days back\nSweep EDR telemetry\nRecord hits and escalate")"></textarea>
                <div class="form-text" id="pb-f-steps-help">Up to @Playbook.MaxSteps steps of @ActionChecklistItem.MaxText characters each.</div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-primary btn-sm" data-submit disabled="@_busy" @onclick="Save">Save</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Cancel">Cancel</button>
        </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        _canWrite = PlaybookSvc.CanWrite;
        await base.OnInitializedAsync();
    }

    internal void New()
    {
        _form = new PlaybookForm { Kind = _kind };
        _steps = null;
        FocusForm();
        StateHasChanged();
    }

    private void Cancel()
    {
        _form = null;
        FocusList();
    }

    internal void Edit(Playbook p)
    {
        _form = PlaybookForm.From(p);
        _steps = string.Join("\n", _form.Steps);
        FocusForm();
        StateHasChanged();
    }

    // The steps one a line, as typed: PlaybookService.Checked trims them and drops blank lines.
    internal Task Save() => Run(async () =>
    {
        _form!.Steps = [.. (_steps ?? "").Split('\n')];
        Reveal(await PlaybookSvc.SaveAsync(_form));
        Toasts.Show(_form.Id is null ? $"{_form.Name.Trim()} saved for the team." : "Saved.");
        _form = null;
        FocusList();
    });

    // Not while a form is open: a move changes the two it swaps, so an edit open on either would be refused as stale.
    internal Task Move(Playbook p, int by) => _form is not null ? Task.CompletedTask : Run(() => PlaybookSvc.MoveAsync(p.Id, by));

    /// <summary>The playbook's More menu: Retire or Restore, and Delete for one no action was started from (that one is
    /// kept for the action's history: Retire is the way out).</summary>
    internal IReadOnlyList<MenuButton.Item> MoreItems(PlaybookRow r) =>
        MoreMenu(r.Playbook.IsRetired, _canWrite, () => Retire(r.Playbook, !r.Playbook.IsRetired), r.Actions == 0 && PlaybookSvc.CanDelete(r.Playbook), () => Delete(r.Playbook));

    internal Task Retire(Playbook p, bool retired) => Retiring(p.Name, retired, () => PlaybookSvc.SetRetiredAsync(p.Id, retired));

    private async Task Delete(Playbook p)
    {
        if (!await _confirm.Ask($"Delete {p.Name}?", "It goes from the team's playbooks. No action was started from it.", "Delete")) return;
        await Run(async () =>
        {
            await PlaybookSvc.DeleteAsync(p.Id);
            Toasts.Show($"{p.Name} deleted.");
            FocusList();
        });
    }
}
