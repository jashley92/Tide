    <script src="js/triage.js?v=20261127-cycle22"></script>
    <script src="js/dialog.js?v=20261127-top-modal"></script>
    <script src="js/chart.js?v=20261127-simplify"></script>
    <script src="js/board.js?v=20261127-cycle27"></script>
    <script src="js/brief-order.js?v=20261110-focus-title"></script>
    <script src="js/tabs.js?v=20261127-cycle19"></script>
