    <link rel="stylesheet" href="lib/bootstrap-icons/bootstrap-icons.min.css?v=1.11.3" />
    @* The app's stylesheet, in parts by area (wwwroot/css). They load in file-name order, which is the cascade's: never reorder them. *@
    <link rel="stylesheet" href="css/00-tokens.css?v=20261127-cycle26" />
    <link rel="stylesheet" href="css/10-shell.css?v=20261127-cycle17" />
    <link rel="stylesheet" href="css/20-editor.css?v=20261127-cycle19" />
