@* The article's products from Our stack (EP-25), "We run": inside the editor's "Why it matters to us" section, under its
   text, always open; for someone who can't edit (the editor's fields are hidden from them), a read-only card in the
   rail (Boxed). Each tagged product shows its versions, the start of its notes and how much else has been written about
   it, and for an analyst a "Mention" that adds it to why it matters; the products the article names but isn't tagged
   with are offered as a one-click tag. Analysts tag with the same search picker as Threat actors (TagCard): with
   nothing typed it offers the products the text names, then those tagged lately; typing finds one by its name or other
   names ("Ivanti Connect Secure (also Pulse Secure)"), a few at a time (StackService.PickLimit), retired ones last and
   asked about first; and offers to add one to Our stack by the words typed, as triage's "Add to what we run…" does,
   with a link to fill it in. Tagging is optional and saved straight away. *@
@using Tide.Application.Stack
@inherits TagCard<StackProduct>
@inject StackService Stack
@{ base.BuildRenderTree(__builder); }

@code {
    /// <summary>Adds text to why it matters (ArticleEditorPanel.MentionAsync), for a product's "Mention".</summary>
    [Parameter] public EventCallback<string> OnMention { get; set; }

    private ArticleStack? _stack;
    private IReadOnlyDictionary<Guid, StackDetail> _details = new Dictionary<Guid, StackDetail>();

    private static readonly TagCardWords Said = new(Title: "We run", ListHref: "stack", ListName: "Our stack", FieldClass: "tide-tagfield tide-werun",
        PickPrefix: "stack-pick", MaxLength: StackProduct.MaxName, Placeholder: "Tag a product by any name, or add one", ListLabel: "Products we run",
        Help: "Matching products are listed as you type. Use the up and down arrows to choose, Enter to tag it.", ComboLabel: "Tag a product we run",
        NoneTagged: "No product tagged.", AddAs: "to Our stack", AddedTail: "to Our stack. Fill in its versions and notes when you can.",
        NothingYet: "Type any name a product we run goes by.", One: "product", Many: "products",
        RetiredAsk: "We no longer run it. Tag the article with it anyway?");

    protected override TagCardWords Words => Said;

    protected override IArticleTagSource Source => Stack;

    protected override async Task<IReadOnlyList<TagPick>> ReadAsync(bool offer)
    {
        (_stack, var offered) = await Stack.ForArticleCardAsync(ArticleId, offer);
        return offered;
    }

    protected override async Task ReadDetailsAsync() =>
        _details = await Stack.DetailsAsync(_stack!.Tagged.Select(p => p.Id).ToList());

    protected override IReadOnlyList<StackProduct>? Tagged => _stack?.Tagged;

    protected override IReadOnlyList<StackProduct> Suggested => _stack?.Suggested ?? [];

    protected override Guid IdOf(StackProduct tag) => tag.Id;

    protected override string NameOf(StackProduct tag) => tag.Name;

    // A retired product stays tagged (its history is kept), muted and marked, as present mode's chips show it.
    protected override string RowClass(StackProduct tag) => tag.IsRetired ? " tide-muted" : " ";

    protected override RenderFragment FieldHead => __builder =>
    {
        <h3 id="werun-h-@ArticleId" class="tide-subhead my-0">We run</h3>
        <a class="small" href="stack">Our stack</a>
    };

    protected override RenderFragment<StackProduct> TaggedRow => p => __builder =>
    {
        var d = _details.GetValueOrDefault(p.Id);
        <div class="d-flex gap-2 align-items-baseline flex-wrap">
            <a class="fw-semibold" href="@($"stack/{p.Id}")">@p.Name</a>
            @if (p.IsRetired) { <Badge Tone="BadgeTone.Neutral">Retired</Badge> }
            @if (p.Versions is { } v) { <span class="small">@v</span> }
            @UntagButton(p.Id, p.Name)
        </div>
        @if (p.Notes is { } notes) { <div class="small tide-muted">@Short(notes)</div> }
        @if (d is not null)
        {
            var others = d.Articles.Count(a => a.Id != ArticleId);
            var open = d.Actions.Count(a => !Tide.Domain.Entities.ActionItem.IsClosedStatus(a.Status));
            <div class="small"><a href="@($"stack/{p.Id}")">@others other article@(others == 1 ? "" : "s") &middot; @open open action@(open == 1 ? "" : "s")</a></div>
        }
        @if (CanWrite && OnMention.HasDelegate)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" @onclick="() => OnMention.InvokeAsync(MentionText(p))">Mention in Why it matters</button>
        }
    };

    // The start of the notes as plain text (no Markdown marks), for the card.
    private static string Short(string text)
    {
        var plain = System.Text.RegularExpressions.Regex.Replace(text, @"[*_#`>]+", "", System.Text.RegularExpressions.RegexOptions.None, TimeSpan.FromSeconds(1))
            .Replace('\n', ' ');
        return plain.Length > 160 ? plain[..160].TrimEnd() + "…" : plain;
    }

    internal static string MentionText(Tide.Domain.Entities.StackProduct p) =>
        $"We run {p.Name}{(p.Versions is { } v ? $" ({v})" : "")}.";
}
