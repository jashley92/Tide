@using Tide.Application.Preferences
@inject SavedViewService SavedViews
@inject ToastService Toasts
@* The person's own saved views of a list page (SavedViewService), on Actions, Triage, Articles and Search: a pill each
   that opens the filters it keeps, the one shown marked, with a menu of what can be done to it (its name says which: a
   view first or last can't move that way), and Save view, which names what's shown and keeps it. Up to 12 a page.
   With Inline, Save view ends the row of pills (and the row is there with no views yet); without it the page has its
   own Save view button, which calls StartSave (Actions has it beside its tabs). *@

@if (Inline || Saved.Count > 0)
{
    var current = Active;
    <nav class="tide-savedviews-list @Class" aria-label="Saved views">
        @foreach (var v in Saved)
        {
            var on = v.Id == current?.Id;
            var menu = Menu(v);
            <span class="tide-savedview" @key="v.Id">
                <a class="tide-chip tide-chip-pick @(on ? "selected" : "")" href="@Href(v)" aria-current="@(on ? "page" : null)"
                   @onclick="() => OnOpen.InvokeAsync(v.Query)" @onclick:preventDefault="OnOpen.HasDelegate">@v.Name</a>
                <MenuButton Label="@MenuLabel(v, menu)" IconOnly="true" Icon="bi-three-dots-vertical" ButtonClass="tide-savedview-menu" Items="@menu" />
            </span>
        }
        @if (Inline)
        {
            <button type="button" class="tide-filter-add" id="save-view" disabled="@(!CanSave)" @onclick="StartSave" title="@SaveTitle">
                <span class="bi bi-bookmark-plus" aria-hidden="true"></span> Save view
            </button>
        }
    </nav>
}

@* Save view and Rename: the view's name. Kept open, saying why, when it's refused (a name already used, the 12th view). *@
<ConfirmDialog @ref="_nameDialog" Form="true" Confirming="SaveName" ConfirmDisabled="@string.IsNullOrWhiteSpace(NewName)" ConfirmIcon="bi-bookmark-check">
    <label class="tide-field-label" for="saved-view-name">Name</label>
    <input id="saved-view-name" class="form-control form-control-sm" maxlength="@SavedActionView.MaxName" @bind="NewName" @bind:event="oninput"
           placeholder="@Placeholder" autocomplete="off" @onkeydown="NameKey" />
    <div class="form-text">@(_renaming is null ? $"Keeps {What} as a pill on this page. Only you see your views." : "Only the name changes: the view still opens the same filters.")</div>
    @if (_nameError is not null) { <div class="text-danger small mt-2" role="alert">@_nameError</div> }
</ConfirmDialog>
<ConfirmDialog @ref="Confirmer" />

@code {
    [Parameter, EditorRequired] public SavedViewPage Page { get; set; } = default!;

    /// <summary>What's shown, as a view of it keeps it (<see cref="SavedViewService.QueryOf"/>): null when it's more than
    /// a view can hold, which holds Save view back.</summary>
    [Parameter] public string? Query { get; set; }

    /// <summary>Save view at the end of the pills, rather than the page's own button.</summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>What a view of the page keeps, for Save view's words: "this tab, layout and filters".</summary>
    [Parameter] public string What { get; set; } = "these filters";

    [Parameter] public string Placeholder { get; set; } = "My P1s";

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Opens a view in place of following its link, for a page that writes its own address without the router (Triage):
    /// a link to the address the router last saw would change nothing. Given the view's query.
    /// </summary>
    [Parameter] public EventCallback<string> OnOpen { get; set; }

    /// <summary>The views were read or changed: for a page whose own Save view counts them.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    // Kept from the prerender, so the pills are there on the first interactive draw rather than appearing after it.
    [PersistentState] public IReadOnlyList<SavedViewEntry>? Kept { get; set; }

    private ConfirmDialog _nameDialog = default!;
    private Guid? _renaming;
    private string? _nameError;

    internal IReadOnlyList<SavedViewEntry> Saved => Kept ?? [];
    internal string? NewName { get; set; }
    internal string? NameError => _nameError;
    internal ConfirmDialog Confirmer { get; private set; } = default!;

    /// <summary>Whether another view may be kept: fewer than 12, and what's shown fits in one.</summary>
    public bool CanSave => Saved.Count < SavedViewService.MaxViews && !string.IsNullOrEmpty(Query);

    /// <summary>Save view's tooltip, saying why it's held back when it is.</summary>
    public string SaveTitle => Saved.Count >= SavedViewService.MaxViews ? $"You can keep up to {SavedViewService.MaxViews} views: delete one to save another"
        : string.IsNullOrEmpty(Query) ? "Nothing to keep yet: choose some filters first, or shorten the search"
        : $"Keep {What} as a view of your own, a pill on this page";

    /// <summary>The saved view that is what's shown, if one is: the first, when two keep the same filters.</summary>
    internal SavedViewEntry? Active => Query is { Length: > 0 } shown ? Saved.FirstOrDefault(v => v.Query == shown) : null;

    protected override async Task OnInitializedAsync()
    {
        try { Kept ??= await SavedViews.ListAsync(Page); }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        // A page's own Save view is drawn before these are read, as open to use: drawn again only when no more fit.
        if (Saved.Count >= SavedViewService.MaxViews) await OnChanged.InvokeAsync();
    }

    private string Href(SavedViewEntry v) => Page.Key + "?" + v.Query;

    private IReadOnlyList<MenuButton.Item> Menu(SavedViewEntry v)
    {
        var items = new List<MenuButton.Item> { new("Rename", "bi-pencil", EventCallback.Factory.Create(this, () => StartRename(v))) };
        if (Saved[0] != v) items.Add(new("Move earlier", "bi-arrow-left", EventCallback.Factory.Create(this, () => MoveSaved(v, -1))));
        if (Saved[^1] != v) items.Add(new("Move later", "bi-arrow-right", EventCallback.Factory.Create(this, () => MoveSaved(v, 1))));
        items.Add(new("Delete", "bi-trash", EventCallback.Factory.Create(this, () => DeleteSaved(v))));
        return items;
    }

    // The menu button's name says what its menu offers: "Weekly: rename, move later or delete".
    internal static string MenuLabel(SavedViewEntry v, IReadOnlyList<MenuButton.Item> menu)
    {
        var what = menu.Select(i => i.Label.ToLowerInvariant()).ToList();
        return $"{v.Name}: {(what.Count < 2 ? string.Concat(what) : string.Join(", ", what[..^1]) + " or " + what[^1])}";
    }

    // Enter in the Name box saves, as in a form (the dialog's button is held back while it's empty).
    private async Task NameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.Repeat && !string.IsNullOrWhiteSpace(NewName)) await _nameDialog.Confirm();
    }

    /// <summary>Save view: asks for the name of a view of what's shown.</summary>
    public async Task StartSave()
    {
        (_renaming, NewName, _nameError) = (null, null, null);
        await _nameDialog.Ask("Save this view", null, "Save view", danger: false);
    }

    internal async Task StartRename(SavedViewEntry v)
    {
        (_renaming, NewName, _nameError) = (v.Id, v.Name, null);
        await _nameDialog.Ask($"Rename \"{v.Name}\"", null, "Rename", danger: false);
    }

    // The dialog's Save view or Rename: kept open, saying why, when it's refused.
    internal async Task<bool> SaveName()
    {
        _nameError = null;
        try
        {
            if (_renaming is { } id)
            {
                await SavedViews.RenameAsync(Page, id, NewName ?? "");
                Toasts.Show("View renamed.");
            }
            else
            {
                var saved = await SavedViews.SaveAsync(Page, NewName ?? "", Query ?? throw new ArgumentException("These filters are too long to keep as a view."));
                Toasts.Show($"Saved \"{saved.Name}\" as a view.");
            }
            await Reload();
            return true;
        }
        catch (Exception ex)
        {
            _nameError = UserFacingError.For(ex);
            return false;
        }
    }

    internal async Task MoveSaved(SavedViewEntry v, int by)
    {
        try
        {
            await SavedViews.MoveAsync(Page, v.Id, by);
            await Reload();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    internal async Task DeleteSaved(SavedViewEntry v)
    {
        if (!await Confirmer.Ask($"Delete \"{v.Name}\"?", "Only your shortcut goes: nothing it shows changes.", "Delete view")) return;
        try
        {
            await SavedViews.DeleteAsync(Page, v.Id);
            await Reload();
            Toasts.Show($"Deleted \"{v.Name}\".");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    private async Task Reload()
    {
        Kept = await SavedViews.ListAsync(Page);
        StateHasChanged();
        await OnChanged.InvokeAsync();
    }
}
