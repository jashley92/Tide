@* The action page's tool drawer: one card in the side column whose tabs (TabBar with a panel; tabs.js) hold the existing
   panels: the checklist, the parts' timeline on a parent with dated parts, hunt queries and outreach, where each belongs
   (ActionGuide.Tools). It opens on the tool the address asks for (?tool=), else the kind's own (ActionGuide.Opening).
   Every panel stays drawn, the ones not chosen hidden, so a half-written query or email survives a look at another
   tab, and the page can reach the outreach panel for its primary button. The panels' own card and heading are folded
   into the drawer by CSS (.tide-drawer), so they're used as they are. *@

<section class="tide-card tide-drawer" aria-label="Tools">
    <TabBar Items="Tabs" Label="Tools" Level="TabLevel.Page" Active="@ActionGuide.Key(_tool)" PanelId="tool-panel" OnSelect="SelectKey" Class="tide-drawer-tabs" />
    <div role="tabpanel" id="tool-panel" aria-labelledby="@TabBar.TabId("tool-panel", ActionGuide.Key(_tool))" data-tool="@ActionGuide.Key(_tool)">
        <div hidden="@(_tool != ActionTool.Checklist)">
            @* An empty checklist is a button to start one, not an empty list; it opens in place. *@
            @if (A.Checklist.Count == 0 && Detail.CanWork && !_addingChecklist)
            {
                <button type="button" class="tide-add-section" @onclick="() => _addingChecklist = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add checklist item</button>
            }
            else if (Detail.CanWork || A.Checklist.Count > 0)
            {
                var done = A.Checklist.Count(i => i.IsDone);
                <div class="d-flex gap-2 align-items-center flex-wrap mb-2 small">
                    @if (A.Checklist.Count > 0) { <span class="tide-count tide-muted">@done of @A.Checklist.Count done</span> }
                    @if (A.PlaybookName is not null) { <Badge Class="ms-auto">@A.PlaybookName playbook</Badge> }
                </div>
                <ActionChecklist @key="A.Id" ActionId="A.Id" Kind="A.Kind" CanWork="Detail.CanWork" Autofocus="_addingChecklist" OnChanged="Changed" />
            }
            else
            {
                <p class="small tide-muted mb-0">Nothing on the checklist.</p>
            }
        </div>
        @if (_tools.Contains(ActionTool.Timeline) && Detail.Lineage is { } lineage)
        {
            <div hidden="@(_tool != ActionTool.Timeline)">
                <RemediationTimelineCard Parts="lineage.Parts" Today="Today" />
            </div>
        }
        @if (_tools.Contains(ActionTool.Hunt))
        {
            <div hidden="@(_tool != ActionTool.Hunt)">
                <HuntPanel @key="A.Id" Action="A" CanWork="Detail.CanWork" Changed="Changed" />
            </div>
        }
        @if (_tools.Contains(ActionTool.Outreach))
        {
            <div hidden="@(_tool != ActionTool.Outreach)">
                <OutreachPanel @key="@($"outreach-{A.Id}")" @ref="_outreach" Action="A" CanWork="Detail.CanWork" Files="Detail.Files" Changed="Changed" />
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ActionDetail Detail { get; set; } = default!;

    /// <summary>How many emails the action has (OutreachState), for whether it has the Outreach tool.</summary>
    [Parameter] public int Emails { get; set; }

    /// <summary>The tool the address asks for (<c>?tool=</c>), by its key.</summary>
    [Parameter] public string? Asked { get; set; }

    /// <summary>The organization's today (OrgClock).</summary>
    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    /// <summary>After a panel saves: the page reloads the action.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Another tab chosen: the page keeps it in the address.</summary>
    [Parameter] public EventCallback<string> ToolChanged { get; set; }

    private ActionItem A => Detail.Action;
    private IReadOnlyList<ActionTool> _tools = [ActionTool.Checklist];
    private ActionTool _tool;
    private string? _asked;
    private bool _started, _addingChecklist;
    private OutreachPanel? _outreach;

    /// <summary>The tool shown.</summary>
    internal ActionTool Tool => _tool;

    internal IReadOnlyList<ActionTool> Tools => _tools;

    /// <summary>The outreach panel, when the action has the tool.</summary>
    internal OutreachPanel? Outreach => _outreach;

    protected override void OnParametersSet()
    {
        var dated = Detail.Lineage is { } l && l.Parent.Id == A.Id && RemediationTimeline.Build(l.Parts, Today) is not null;
        _tools = ActionGuide.Tools(A.Kind, dated, A.Hunts.Count, Emails);
        // The address decides when it's first drawn and whenever it asks again; a tool that's gone falls back.
        if (!_started || _asked != Asked || !_tools.Contains(_tool)) _tool = ActionGuide.Opening(Asked, A.Kind, _tools);
        (_started, _asked) = (true, Asked);
    }

    private IReadOnlyList<TabBarItem> Tabs => _tools.Select(t => new TabBarItem(ActionGuide.Name(t), "", Icon(t), ActionGuide.Key(t),
        t == ActionTool.Checklist && A.Checklist.Count > 0 ? A.Checklist.Count : t == ActionTool.Hunt && A.Hunts.Count > 0 ? A.Hunts.Count
            : t == ActionTool.Outreach && Emails > 0 ? Emails : null)).ToList();

    private static string Icon(ActionTool t) => t switch
    {
        ActionTool.Timeline => "bi-bar-chart-steps",
        ActionTool.Hunt => "bi-terminal",
        ActionTool.Outreach => "bi-envelope-paper",
        _ => "bi-check2-square",
    };

    /// <summary>Shows a tool, as its tab does (the page's primary button and Next links use it too).</summary>
    internal async Task Select(ActionTool t)
    {
        if (!_tools.Contains(t) || t == _tool) return;
        _tool = t;
        StateHasChanged();
        await ToolChanged.InvokeAsync(ActionGuide.Key(t));
    }

    private Task SelectKey(string? key) => Select(ActionGuide.Opening(key, A.Kind, _tools));
}
