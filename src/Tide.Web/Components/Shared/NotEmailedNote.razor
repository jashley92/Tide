@* Under a choice of team (a hand-off, a split's part, the editor's team, an external action's card, Coverage's Raise
   action): says when an external team won't be emailed its reminders, and
   why, so work isn't handed to someone who never hears of it. Nothing for an internal team, or one that will be emailed,
   and nothing while external reminders are off for everyone: that's an administrator's choice, not this team's gap. *@
@* Each reason comes with its fix, for whoever may make it: whoever keeps the external teams turns this team's on here,
   or adds its contact email on External teams (in a new tab, so a dialog or form it sits in keeps what was typed). *@
@inject Tide.Application.Actions.TeamService TeamSvc
@inject ToastService Toasts
@using Tide.Application.Actions

@if (Team is not null && !_turnedOn.Contains(Team.Id) && TeamSvc.NotEmailed(Team) is { Cause: not NotEmailedCause.OffForEveryone } why)
{
    <div class="tide-missing small @Class" role="status">
        <span class="bi bi-envelope-slash" aria-hidden="true"></span> @why.Text
        @switch (why.Cause)
        {
            case NotEmailedCause.TeamOff when TeamSvc.CanManageExternal:
                <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" disabled="@_busy" @onclick="TurnOn">Turn their reminders on</button>
                break;
            case NotEmailedCause.NoContact when TeamSvc.CanManageExternal:
                @NewTab($"teams/external?edit={Team.Id}", "Add a contact email")
                break;
        }
    </div>
}

@code {
    [Parameter] public Tide.Domain.Entities.Team? Team { get; set; }

    /// <summary>Its spacing where it sits: a margin above by default.</summary>
    [Parameter] public string Class { get; set; } = "mt-2";

    // A fix on another page: a new tab, so the page this note is on (a dialog half filled in) isn't left. Said to a screen
    // reader, and shown by the icon.
    private static RenderFragment NewTab(string href, string text) => __builder =>
    {
        <a class="ms-1" href="@href" target="_blank" rel="noopener noreferrer">@text<span class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></span><span class="visually-hidden"> (opens in a new tab)</span></a>
    };

    /// <summary>After the team's reminders are turned on here, so the page can read the team again.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    // Teams turned on from this note: the Team handed in is the page's copy, read before the change.
    private readonly HashSet<Guid> _turnedOn = [];
    private bool _busy;

    internal async Task TurnOn()
    {
        if (Team is not { } team || _busy) return;
        _busy = true;
        try
        {
            await TeamSvc.TurnRemindersOnAsync(team.Id);
            _turnedOn.Add(team.Id);
            Toasts.Show($"{team.Name}'s reminders are on.");
            await Changed.InvokeAsync();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
}
