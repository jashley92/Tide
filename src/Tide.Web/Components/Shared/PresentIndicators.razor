@* An article's indicators, opened over its slide in present mode from the slide's "N indicators" button: every one the
   team edition carries, by type, defanged as the email shows them, with their notes. Team edition only (ADR 0005):
   Present draws it only there. *@
@using Tide.Application.Briefs
@using Tide.Application.Indicators
@inherits PresentCardBase

@{ var a = Article.Article; }
<PresentCard Shown="a.Id" TitleId="present-iocs-title" Class="tide-present-iocs" Href="@($"articles/{a.Id}")" LinkText="Open the article"
             CloseLabel="Close the indicators" Kicker="@Kicker" CanClose="CanClose" Autofocus="Autofocus" OnClose="OnClose" Links="Links">
    <Title><span class="tide-present-product-kicker">Indicators</span> @a.Title</Title>
    <ChildContent>
        @foreach (var group in _groups)
        {
            <div class="tide-slide-section">@IndicatorLabels.For(group.Key) (@group.Count())</div>
            <ul class="tide-present-iocs-list">
                @foreach (var ind in group)
                {
                    <li @key="ind.Id"><span class="tide-data">@IndicatorLabels.Shown(ind.Type, ind.Value)</span>
                        @if (!string.IsNullOrWhiteSpace(ind.Note)) { <span class="tide-present-help">@ind.Note</span> }</li>
                }
            </ul>
        }
    </ChildContent>
</PresentCard>

@code {
    [Parameter, EditorRequired] public EditionArticle Article { get; set; } = default!;

    // By type, worked out once for each article handed in rather than on every render (the slide redraws often).
    private EditionArticle? _groupedFor;
    private IReadOnlyList<IGrouping<IndicatorType, ArticleIndicator>> _groups = [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_groupedFor, Article)) return;
        _groupedFor = Article;
        _groups = Article.Indicators.GroupBy(i => i.Type).OrderBy(g => g.Key).ToList();
    }
}
