@* "What readers get": beside the article editor, the article as the team or the company-wide edition will carry it,
   drawn by EditionArticleView as the brief's edition preview draws it. It's built from the form in memory
   (ArticlePreview, the one cut), so it follows unsaved edits, a moment after typing stops: no database round trip.
   Only the writer sees what this pane adds: where a part, or the whole article, is left out of the edition, the
   company-wide edition's missing indicators and actions, and a dashed button for each gap the readiness checks find,
   which takes you to the field (and, for a check with a one-click fix, a button that makes it). Below, always shown:
   the threat story (StoryPicker), suggesting a related article's; under it, folded until opened, "Similar articles
   (N)": what's already been written about the same thing (RelatedPanel), where an action can be mentioned in why it
   matters (OnMention) and the article put in a related one's story (ShowRelated opens it and scrolls to it). For
   someone who can't edit, whose editor fields are hidden, the article's products and threat actors as read-only cards
   (they're tagged in the editor: We run under Why it matters, Threat actors under Context). Then, folded away: both
   editions' verdicts, the briefs it's on, its follow-up actions and CVE context. Keys 1 and 2 pick the edition (single characters, so the shortcut
   switch turns them off); the choice is kept in the address (?edition=company) so a link can open either, and told to
   the page (EditionChanged) so its own links, the brief stepper's, keep it. *@
@inject Tide.Application.Settings.DistributionSettings Distribution
@inject ActionService ActionSvc
@inject RelatedService RelatedSvc
@inject StoryService Stories
@inject ICurrentUser CurrentUser
@inject ToastService Toasts
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="tide-card tide-reader" aria-labelledby="reader-h">
    <div class="tide-reader-head">
        <h2 id="reader-h" class="mb-0">What readers get</h2>
        <div class="tide-seg" role="group" aria-label="Show">
            <button type="button" class="tide-seg-opt @(On(Edition.Team) ? "on" : "")" aria-pressed="@(On(Edition.Team) ? "true" : "false")"
                    aria-keyshortcuts="1" title="Team edition (1)" @onclick="() => Show(Edition.Team)">Team</button>
            <button type="button" class="tide-seg-opt @(On(Edition.Public) ? "on" : "")" aria-pressed="@(On(Edition.Public) ? "true" : "false")"
                    aria-keyshortcuts="2" title="Company-wide edition (2)" @onclick="() => Show(Edition.Public)">Company-wide</button>
        </div>
    </div>
    @if (Current is { } p)
    {
        <p class="tide-reader-hint">@Tide.Application.Distribution.BriefRenderer.EditionName(p.Edition) &middot; up to <TlpBadge Level="p.Ceiling" /></p>
        <p class="tide-reader-sum">
            @if (p.Checks.Count == 0)
            {
                <span class="tide-reader-ready"><span class="bi bi-check-circle-fill" aria-hidden="true"></span> Ready to brief</span>
            }
            else
            {
                <span class="tide-reader-need"><span class="bi bi-exclamation-circle" aria-hidden="true"></span> @p.Checks.Count thing@(p.Checks.Count == 1 ? "" : "s") missing</span>
            }
            @if (State.Dirty)
            {
                <span class="tide-reader-unsaved">Includes unsaved changes</span>
            }
        </p>

        <div class="tide-reader-doc tide-edition">
            @if (p.Cut is { } cut)
            {
                <EditionArticleView Article="cut" LeftOut="LeftOutLine" Missing="Placeholder">
                    @if (p.DropsTeamOnlyParts(_actions.Count))
                    {
                        <p class="tide-left-out">Indicators and follow-up actions aren't part of the company-wide edition.</p>
                    }
                </EditionArticleView>
            }
            else
            {
                <article class="tide-reader-out">
                    <h3>@p.Article.Title</h3>
                    <p class="tide-left-out">@LeftOutMarker &middot; the whole article is <TlpBadge Level="p.Article.Tlp" />, above this edition's <TlpBadge Level="p.Ceiling" /> &mdash; @OnlyYou</p>
                </article>
            }
            @{ var others = p.Checks.Where(c => p.Cut is null || !InPlace.Contains(c.Part)).ToList(); }
            @if (others.Count > 0)
            {
                <div class="tide-reader-gaps">
                    @foreach (var c in others)
                    {
                        @PlaceholderFor(c)
                    }
                </div>
            }
        </div>
    }
    @if (Current is not null)
    {
        <StoryPicker @ref="_storyPicker" ArticleId="State.Article.Id" StoryId="_storyId" Suggested="SuggestedStory" StoryChanged="StoryLinked" />

        <section class="tide-reader-similar" id="similar-articles" aria-labelledby="similar-h">
            <h3 id="similar-h" class="tide-reader-fold-h">
                <button type="button" class="tide-disclosure" aria-expanded="@Ui.Aria(_similarOpen)" aria-controls="similar-body"
                        @ref="_similarHead" @onclick="ToggleSimilar">
                    <span class="bi bi-chevron-right tide-disclosure-chev" aria-hidden="true"></span>
                    @SimilarTitle
                </button>
            </h3>
            <div id="similar-body" class="tide-disclosure-body" hidden="@(!_similarOpen)">
                @if (_similarOpen)
                {
                    <RelatedPanel Work="_work" StoryId="_storyId" CanWrite="_canWrite" WhyTlp="State.Form.WhyItMattersTlp"
                                  OnMention="t => OnMention.InvokeAsync(t)" OnSameStory="SameStory" />
                }
            </div>
        </section>

        @if (!_canWrite)
        {
            <ArticleStackCard ArticleId="State.Article.Id" Boxed="true" />
            <ArticleAdversaryCard ArticleId="State.Article.Id" Boxed="true" />
        }

        <details class="tide-reader-details">
            <summary><span class="bi bi-chevron-right tide-disclosure-chev" aria-hidden="true"></span> Details</summary>
            <h3 class="tide-subhead">Both editions</h3>
            <ul class="tide-reader-verdicts">
                @foreach (var v in _both)
                {
                    <li><span class="fw-semibold">@(v.Edition == Edition.Public ? "Company-wide" : "Team")</span> <span class="tide-muted">@VerdictText(v)</span></li>
                }
            </ul>
            @if (State.BriefDates.Count > 0)
            {
                <div class="small mt-2">On @(State.BriefDates.Count == 1 ? "the brief for " : "the briefs for ")
                    @foreach (var (d, i) in State.BriefDates.Select((d, i) => (d, i))) { @(i > 0 ? ", " : "")<a href="@Ui.BriefUrl(d)">@Ui.ShortDay(d)</a> }
                </div>
            }
            <ArticleActions ArticleId="State.Article.Id" />
            <ArticleIntel ArticleId="State.Article.Id" CveIds="_cveIds" Classification="State.Article.Classification" />
        </details>
    }
</section>

<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>The editor's state as it is on screen: the form the preview is built from, and whether it's saved.</summary>
    [Parameter, EditorRequired] public ArticleEditorPanel.State State { get; set; } = default!;

    /// <summary>The edition to show first, as named in the address: <c>company</c>, or the team edition.</summary>
    [Parameter] public string? EditionKey { get; set; }

    /// <summary>The edition picked here, by its key in the address (<c>company</c>, or null for the team edition).</summary>
    [Parameter] public EventCallback<string?> EditionChanged { get; set; }

    /// <summary>Takes the editor to the field a gap is in, for a placeholder's button (ArticleEditorPanel.FocusFieldAsync).</summary>
    [Parameter] public EventCallback<ArticlePart> OnFocus { get; set; }

    /// <summary>Makes a check's one-click fix (ArticleEditorPanel.FixAsync), offered to someone who can edit.</summary>
    [Parameter] public EventCallback<ArticleFix> OnFix { get; set; }

    /// <summary>Adds text to why it matters (ArticleEditorPanel.MentionAsync), for Similar articles' "Mention".</summary>
    [Parameter] public EventCallback<string> OnMention { get; set; }

    /// <summary>The words that mark something left out. They're drawn here only, never in what readers are sent.</summary>
    public const string LeftOutMarker = "Left out of this edition";
    public const string OnlyYou = "only you see this";

    /// <summary>How long after the last edit the preview is rebuilt.</summary>
    private static readonly TimeSpan Settle = TimeSpan.FromMilliseconds(250);

    // The parts whose placeholder stands where the part would be; the other gaps are listed after the article.
    private static readonly HashSet<ArticlePart> InPlace = [ArticlePart.BottomLine, ArticlePart.Bullets, ArticlePart.Recommended];

    private Edition _edition;
    private string? _keySeen;
    private bool _keyRead;
    private TlpLevel _publicMax = TlpLevel.Green, _teamMax = TlpLevel.AmberStrict;
    private IReadOnlyList<EditionAction> _actions = [];
    private Guid? _actionsFor;
    private ArticleForm? _builtFrom;
    private ArticlePreview[] _both = [];
    private IReadOnlyList<string> _cveIds = [];
    private CancellationTokenSource? _wait;
    private DotNetObjectReference<ReaderPreview>? _self;

    private ArticlePreview? Current => _both.FirstOrDefault(p => p.Edition == _edition);

    // Similar articles: whether its section is open (folded at first), and what it found for the article (null until read).
    private bool _similarOpen, _revealSimilar, _canWrite;
    private ElementReference _similarHead;
    private RelatedWork? _work;
    private Guid? _storyId;
    private ConfirmDialog _confirm = default!;
    private StoryPicker? _storyPicker;

    private bool On(Edition e) => _edition == e;

    /// <summary>Whether Similar articles is open (internal for the tests).</summary>
    internal bool SimilarOpen => _similarOpen;

    internal string SimilarTitle => _work is { } w ? $"Similar articles ({w.Total})" : "Similar articles";

    // A related article's story, while this one is in none.
    private (Guid Id, string Name)? SuggestedStory =>
        _storyId is null && _work?.Articles.FirstOrDefault(a => a.StoryId is not null) is { StoryId: { } id, StoryName: { } name } ? (id, name) : null;

    protected override async Task OnInitializedAsync() => (_publicMax, _teamMax) = await Distribution.GetAsync();

    protected override async Task OnParametersSetAsync()
    {
        // The edition the address names, when it opens or a link names another.
        if (!_keyRead || EditionKey != _keySeen)
        {
            (_keyRead, _keySeen) = (true, EditionKey);
            _edition = ArticlePreview.ParseEdition(EditionKey);
        }
        // The team edition's actions, read once for the article (again only when the editor moves to another one).
        if (_actionsFor != State.Article.Id)
        {
            _actionsFor = State.Article.Id;
            _actions = ArticlePreview.TeamActions(await ActionSvc.ForArticleAsync(State.Article.Id));
            _builtFrom = null;
            _canWrite = CurrentUser.Has(Permission.WriteArticles);
            _storyId = State.Article.StoryId;
            await ReadRelated();
        }
        // A form just loaded is drawn at once; an edit to it, once typing settles.
        if (!ReferenceEquals(State.Form, _builtFrom)) Build();
        else Rebuild();
    }

    private void Build()
    {
        _wait?.Cancel();
        _builtFrom = State.Form;
        _both = [ArticlePreview.Build(State.Form, Edition.Team, _teamMax, _actions, _publicMax),
            ArticlePreview.Build(State.Form, Edition.Public, _publicMax, companyCeiling: _publicMax)];
        // The saved article's CVEs, as before: CVE context is looked up for what's stored. A new list only when they change,
        // so the lookup isn't repeated on every keystroke.
        var cves = State.Article.Cves.Select(c => c.CveId).Order().ToList();
        if (!cves.SequenceEqual(_cveIds)) _cveIds = cves;
    }

    private void Rebuild()
    {
        _wait?.Cancel();
        _wait?.Dispose();
        var wait = _wait = new CancellationTokenSource();
        _ = BuildSoon(wait.Token);
    }

    private async Task BuildSoon(CancellationToken ct)
    {
        try { await Task.Delay(Settle, ct); }
        catch (OperationCanceledException) { return; }
        await InvokeAsync(() =>
        {
            if (ct.IsCancellationRequested) return;
            Build();
            StateHasChanged();
        });
    }

    private async Task ReadRelated()
    {
        try { _work = await RelatedSvc.ForArticleAsync(State.Article.Id); }
        catch (Exception ex)
        {
            _work = RelatedWork.None;
            Toasts.Error(UserFacingError.For(ex));
        }
    }

    /// <summary>
    /// Shows what's related: once the Related tab, now Similar articles under the story, opened and scrolled to (its
    /// heading takes focus), for anything that asks to see the related work.
    /// </summary>
    internal void ShowRelated()
    {
        _similarOpen = true;
        _revealSimilar = true;
        StateHasChanged();
    }

    private void ToggleSimilar() => _similarOpen = !_similarOpen;

    // The picker linked the article to a story (or took it off one): related work by story changes with it.
    private async Task StoryLinked(Guid? id)
    {
        _storyId = id;
        await ReadRelated();
    }

    /// <summary>
    /// "Same story": this article goes in the related one's story; when that has none, a story named after it is started,
    /// after asking, with both in it.
    /// </summary>
    internal async Task SameStory(RelatedArticle a)
    {
        try
        {
            var story = a.StoryId;
            if (story is null)
            {
                if (!await _confirm.Ask("Start a story for both?", $"A new threat story named “{Ui.Clip(a.Title)}” is started, with this article and that one in it.", "Start the story")) return;
                story = await Stories.CreateAsync(a.Title, null);
                await Stories.LinkAsync(a.Id, story);
            }
            await Stories.LinkAsync(State.Article.Id, story);
            Toasts.Show(a.StoryName is { } name ? $"Added to the story “{name}”." : "Story started with both articles.");
            if (_storyPicker is not null) await _storyPicker.RefreshAsync();
            await StoryLinked(story);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    private async Task Show(Edition edition)
    {
        if (_edition == edition) return;
        _edition = edition;
        _keySeen = ArticlePreview.EditionKey(edition);
        try { await JS.InvokeVoidAsync("tideEditor.showEdition", _keySeen); }
        catch (JSDisconnectedException) { /* the tab has gone */ }
        await EditionChanged.InvokeAsync(_keySeen);
    }

    /// <summary>Key 1 or 2, from wwwroot/js/editor.js.</summary>
    [JSInvokable]
    public async Task OnEditionKey(string key)
    {
        await Show(key == "2" ? Edition.Public : Edition.Team);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealSimilar)
        {
            _revealSimilar = false;
            try { await JS.InvokeVoidAsync("tideEditor.jump", _similarHead, null); }
            catch (JSDisconnectedException) { /* the tab has gone */ }
        }
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("tideEditor.editionKeys", _self); }
        catch (JSDisconnectedException) { /* the tab has gone */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_wait is not null) await _wait.CancelAsync();
        _wait?.Dispose();
        if (_self is null) return;
        await JS.StopAsync("tideEditor.editionKeys", [null]);
        _self.Dispose();
    }

    private static string VerdictText(ArticlePreview p) => p.Verdict switch
    {
        EditionVerdict.LeftOut => $"Left out: the article is {Tlp.Label(p.Article.Tlp)}, above {Tlp.Label(p.Ceiling)}",
        EditionVerdict.Partly => $"Partly included: {p.Cut!.WithheldParts} part{(p.Cut.WithheldParts == 1 ? "" : "s")} above {Tlp.Label(p.Ceiling)} left out",
        _ => "Included in full",
    };

    // A warning about a part that's written (its TLP) is checked, not written.
    private static string GoText(ArticleCheck c) => c.Fix is not null ? "Check it" : c.Part switch
    {
        ArticlePart.BottomLine or ArticlePart.WhyItMatters or ArticlePart.Recommended => "Write it",
        ArticlePart.Bullets => "Add one",
        _ => "Go to it",
    };

    private RenderFragment<TlpLevel> LeftOutLine => tlp => @<p class="tide-left-out">@LeftOutMarker &middot; <TlpBadge Level="tlp" /> &mdash; @OnlyYou</p>;

    private RenderFragment<ArticlePart> Placeholder => part => @<text>@foreach (var c in Current!.Checks.Where(c => c.Part == part)) { @PlaceholderFor(c) }</text>;

    private static string FixText(ArticleFix fix) => fix switch
    {
        ArticleFix.WhyItMattersAmber => "Mark AMBER",
        _ => "Fix it",
    };

    // A gap's button, and beside it, for a check with a one-click fix and someone who can edit, the fix.
    private RenderFragment PlaceholderFor(ArticleCheck c) => __builder =>
    {
        if (c.Fix is { } fix && State.CanWrite)
        {
            <div class="tide-placeholder-row">
                @GapButton(c)
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OnFix.InvokeAsync(fix)">@FixText(fix)<span class="visually-hidden"> (why it matters)</span></button>
            </div>
        }
        else
        {
            @GapButton(c)
        }
    };

    private RenderFragment GapButton(ArticleCheck c) =>
        @<button type="button" class="tide-placeholder" @onclick="() => OnFocus.InvokeAsync(c.Part)">
            <span class="bi @(c.Blocking ? "bi-x-circle-fill" : "bi-exclamation-circle")" aria-hidden="true"></span>
            <span class="visually-hidden">@(c.Blocking ? "Blocking:" : "Warning:")</span>
            @c.Message &middot; <span class="tide-placeholder-go">@GoText(c)</span>
        </button>;
}
