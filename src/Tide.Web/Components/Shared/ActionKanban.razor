@* The actions board: a lane per working status (Open, In progress, Blocked, Tracking), sharing the width and filling the
   window's height, each scrolling on its own when long, with a place to drop under its cards. Under the lanes, a strip
   counts what closed in the last week each way (Done, Cancelled, Not applicable): closed cards aren't drawn, and each
   way is a chip to drop a card on to close it so. A card the person may work can be dragged to another lane or a chip
   (board.js, which drops on the nearest .tide-kcol or .tide-kchip), or moved with its Move menu from the keyboard;
   either way ActionService.MoveAsync checks and makes the move. A move to a closed status asks for the outcome first,
   as the action's page does.
   It's shared live: a card someone else is dragging says who has it and lights the lane or chip it's over (BoardDrags),
   and a card someone else moved slides in from its old lane and says who moved it.
   A card says its article (to whoever may read it: the board leaves it off otherwise), KEV when that article names a
   CVE on CISA's known exploited list, its checklist's progress, how its hunt went (a sweep or hunt) and how long it has
   been in its lane.
   A lane shows its first 20 cards, then "Show N more" adds 20 at a time; a card moved here (by this person or someone
   else) stays shown whatever its place, and so does the selected card.
   One card is selected (the page keeps which, and its keys move it, as a list's row): it's marked, it's the board's one
   tab stop, and a card that takes focus (a click on it, or on anything in it) becomes it.
   The strip counts a week back; "Show the last 30 days" takes it to 30, and "Show the last 7 days" back again. Both are for this visit only. *@
@implements IAsyncDisposable
@inject ActionService ActionSvc
@inject ToastService Toasts
@inject IJSRuntime JS
@inject BoardDrags Drags
@inject ChangeOrigin Origin
@inject PresenceCircuit Circuit
@inject ICurrentUser CurrentUser
@inject OrgClock Clock

@{ var drags = Drags.Others(CurrentUser.UserId); }
<div class="tide-board" @ref="_root">
    <div class="tide-kanban" aria-label="Actions board">
        @foreach (var status in Lanes)
        {
            @Column(status, drags)
        }
    </div>
    <section class="tide-kstrip" aria-labelledby="kstrip-head">
        <h2 class="tide-kstrip-head" id="kstrip-head">Closed, last @ClosedDays days</h2>
        @foreach (var status in ClosedStatuses)
        {
            var incoming = drags.Where(d => d.Over == status).ToList();
            var name = ActionService.StatusName(status);
            var n = Counts.ClosedAs(status);
            <div class="tide-kchip @(incoming.Count > 0 ? "tide-kcol-incoming" : "")" data-status="@status" role="group"
                 aria-label="@($"{name}: {n} closed in the last {ClosedDays} days")">
                <ActionStatusBadge Status="status" /> <span class="tide-count" aria-hidden="true">@n</span>
                @foreach (var d in incoming)
                {
                    <span class="tide-kcol-incoming-by" title="@d.Name is moving a card here"><span class="bi bi-arrow-down-circle" aria-hidden="true"></span> @d.Name</span>
                }
            </div>
        }
        <span class="tide-kstrip-hint">Drop a card on one to close it that way</span>
        @* The strip's reach, a week or a month, either way. *@
        <button type="button" class="btn btn-link btn-sm tide-kstrip-more" @onclick="ShowOlder">Show the last @(ClosedDays < ActionService.BoardOlderDays ? ActionService.BoardOlderDays : ActionService.BoardClosedDays) days</button>
    </section>
</div>
<div class="visually-hidden" role="status">@_said</div>

@* A move asks what it needs first (the outcome, for a closed status) and is checked and recorded (ActionMover). *@
<ActionMover @ref="_mover" Id="kclose" OnChanged="OnChanged" />

@code {
    /// <summary>The working statuses, a lane each, left to right (the order the page's keys move through the cards); then
    /// the closed ones, a chip each on the strip under them.</summary>
    internal static readonly ActionStatus[] Lanes = [.. ActionItem.StatusOrder.Where(s => !ActionItem.IsClosedStatus(s))];
    private static readonly ActionStatus[] ClosedStatuses = [.. ActionItem.StatusOrder.Where(ActionItem.IsClosedStatus)];

    // One working status's lane: its heading and count, who is carrying a card into it, its cards and a place to drop.
    private RenderFragment Column(ActionStatus status, IReadOnlyList<BoardDrag> drags) => __builder =>
    {
        var cards = Board.In(status);
        var shown = Shown(status, cards);
        var incoming = drags.Where(d => d.Over == status).ToList();
        <section class="@(incoming.Count > 0 ? "tide-kcol tide-kcol-incoming" : "tide-kcol")" data-status="@status" aria-labelledby="kcol-@status">
            <h2 class="tide-kcol-head" id="kcol-@status" tabindex="-1">
                <ActionStatusBadge Status="status" /> <span class="tide-count tide-muted fw-normal">@cards.Count</span>
                @foreach (var d in incoming)
                {
                    <span class="tide-kcol-incoming-by" title="@d.Name is moving a card here"><span class="bi bi-arrow-down-circle" aria-hidden="true"></span> @d.Name</span>
                }
            </h2>
            <div class="tide-kcol-cards">
                @foreach (var r in shown)
                {
                    var canMove = Board.CanMove(r);
                    var matched = ActionRules.For(Rules, r, Today, ActionSvc.Days);
                    var held = drags.FirstOrDefault(d => d.ActionId == r.Id);
                    var arrived = _arrived.TryGetValue(r.Id, out var a) ? a : ((string Name, int Ticket, bool Moved)?)null;
                    var selected = r.Id == SelectedId;
                    <article @key="r.Id" class="tide-kcard @RowSelection.Css(selected) @(matched.Count > 0 ? "tide-ruled " + Ui.RuleClass(matched[0].Colour) : "") @(held is not null ? "tide-kcard-held" : "") @(arrived is not null ? "tide-kcard-arrived" : "")"
                             draggable="@(canMove ? "true" : "false")" data-id="@r.Id" data-status="@r.Status" aria-label="@($"{Ui.ActionLabel(r.Number)}: {r.Title}")"
                             aria-current="@RowSelection.Current(selected)" tabindex="@RowSelection.TabIndex(selected)" @onfocusin="() => Select(r)">
                        <div class="tide-kcard-head">
                            <PriorityBadge Priority="r.Priority" />
                            <EscalatedBadge At="r.EscalatedSince" />
                            @if (r.ArticleKev)
                            {
                                <span class="tide-kev" title="Its article names a CVE on CISA's known exploited list">KEV</span>
                            }
                            <span class="tide-muted small ms-auto text-truncate">@ActionService.KindName(r.Kind)</span>
                            @* The number at the head's end, to quote, as the design has it. *@
                            <span class="tide-action-num">@Ui.ActionLabel(r.Number)</span>
                        </div>
                        @if (held is not null)
                        {
                            <div class="tide-kcard-note"><span class="bi bi-arrows-move" aria-hidden="true"></span> @held.Name is moving this@(held.Over is { } o ? $" to {ActionService.StatusName(o)}" : "")</div>
                        }
                        else if (arrived is { } ar)
                        {
                            <div class="tide-kcard-note"><span class="bi @(ar.Moved ? "bi-arrow-right-circle" : "bi-plus-circle")" aria-hidden="true"></span> @(ar.Moved ? "Moved" : "Added") by @ar.Name</div>
                        }
                        @if (r.ParentNumber is { } parent)
                        {
                            <a class="tide-kcard-parent small" href="@Ui.ActionUrl(parent)" draggable="false">
                                <span class="bi bi-arrow-return-right" aria-hidden="true"></span> Part of @Ui.ActionLabel(parent)
                            </a>
                        }
                        <div><ActionRef Number="r.Number" Title="@r.Title" TitleClass="tide-kcard-title" Draggable="false" ShowNumber="false" /></div>
                        @if (r.ArticleTitle is not null)
                        {
                            <div class="tide-kcard-article" title="@r.ArticleTitle"><span class="bi bi-newspaper" aria-hidden="true"></span> <span class="text-truncate">@r.ArticleTitle</span></div>
                        }
                        @if (matched.Count > 0)
                        {
                            <div class="tide-kcard-labels">
                                @foreach (var rule in matched) { <span class="tide-rule-label @Ui.RuleClass(rule.Colour)">@rule.Name</span> }
                            </div>
                        }
                        @if (r.Children > 0)
                        {
                            <div class="small tide-muted tide-rollup"><span class="bi bi-diagram-3" aria-hidden="true"></span> @r.Rollup</div>
                        }
                        @if (r.ChecklistTotal > 0)
                        {
                            var open = _checklistFor.Contains(r.Id);
                            <button type="button" class="tide-kcard-progress" aria-expanded="@(open ? "true" : "false")"
                                    aria-label="Checklist for @Ui.ActionLabel(r.Number): @r.ChecklistDone of @r.ChecklistTotal done" @onclick="() => ToggleChecklist(r.Id)">
                                <span class="bi @(r.ChecklistDone == r.ChecklistTotal ? "bi-check2-square" : "bi-list-check")" aria-hidden="true"></span>
                                <span class="text-nowrap">@r.ChecklistDone of @r.ChecklistTotal</span>
                                <span class="tide-kcard-bar" aria-hidden="true"><span style="width: @(r.ChecklistDone * 100 / r.ChecklistTotal)%"></span></span>
                                <span class="bi @(open ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></span>
                            </button>
                            @if (open)
                            {
                                <ActionChecklist ActionId="r.Id" Kind="r.Kind" CanWork="canMove" Compact="true" OnChanged="OnChanged" />
                            }
                        }
                        <div class="tide-kcard-meta small">
                            <span class="bi bi-person" aria-hidden="true"></span> @(r.AssigneeName ?? "Unassigned") <span class="tide-muted">&middot; @r.TeamName</span>
                            <FileCount Count="r.Files" />
                        </div>
                        <div class="tide-kcard-foot small">
                            @if (r.DueDate is { } d)
                            {
                                <span>Due @Ui.ShortDay(d)</span> <SlaBadge State="r.Sla(Today, ActionSvc.Days)" Due="r.DueDate" Today="Today" />
                            }
                            else
                            {
                                <span class="tide-muted">@Age(r)</span>
                            }
                            @if (InColumn(r) is var (text, since))
                            {
                                <span class="tide-muted tide-kcard-since" title="@($"{ActionService.StatusName(r.Status)} since {Ui.ShortDay(since)}")">@text</span>
                            }
                            @if (ActionGuide.IsHunt(r.Kind))
                            {
                                @* How its hunt went: a sweep with no query yet hasn't been run either. *@
                                <HuntBadge Result="@(r.Hunted ?? HuntResult.NotRun)" />
                            }
                            @if (canMove)
                            {
                                <button type="button" class="btn btn-link btn-sm tide-kcard-move ms-auto" aria-haspopup="menu" aria-expanded="@(_menuFor == r.Id ? "true" : "false")"
                                        aria-controls="@(_menuFor == r.Id ? $"move-menu-{r.Id}" : null)"
                                        aria-label="Move @Ui.ActionLabel(r.Number)" disabled="@_mover?.Busy" @onclick="() => ToggleMenu(r.Id)">
                                    Move <span class="bi bi-chevron-down" aria-hidden="true"></span>
                                </button>
                            }
                        </div>
                        @if (_menuFor == r.Id)
                        {
                            @* A menu: opening it focuses its first option, the arrows move between them, Esc closes it and
                               focus goes back to Move (board.js), and Tab leaves it closed. *@
                            <div class="tide-kcard-menu" id="move-menu-@r.Id" role="menu" aria-label="Move @Ui.ActionLabel(r.Number) to" @onkeydown="OnMenuKey">
                                @foreach (var to in ActionItem.StatusOrder.Where(s => s != r.Status))
                                {
                                    <button type="button" role="menuitem" tabindex="-1" class="btn btn-outline-secondary btn-sm" disabled="@_mover?.Busy" @onclick="() => MoveFromMenu(r, to)">@ActionService.StatusName(to)</button>
                                }
                            </div>
                        }
                    </article>
                }
                @if (cards.Count > shown.Count)
                {
                    var more = Math.Min(MoreCards, cards.Count - shown.Count);
                    <button type="button" class="btn btn-outline-secondary btn-sm tide-kcol-more" aria-label="@($"Show {more} more in {ActionService.StatusName(status)}")"
                            @onclick="() => ShowMore(status)">Show @more more</button>
                }
                @* Room to drop under the cards (the whole lane takes a drop); an empty lane says so to a screen reader. *@
                <div class="tide-kcol-drop">@if (cards.Count == 0) { <span class="visually-hidden">Nothing here.</span> }</div>
            </div>
        </section>
    };

    // How long an open card has been in its column, from when it moved there (the organization's day), and that day;
    // nothing for an Open card with no due date that never moved, whose "Opened" already says it.
    private (string Text, DateOnly Since)? InColumn(ActionRow r)
    {
        if (r.InStatusSinceUtc is not { } at) return null;
        var since = Clock.DayOf(at);
        if (r.Status == ActionStatus.Open && r.DueDate is null && since == Clock.DayOf(r.CreatedAtUtc)) return null;
        var days = Today.DayNumber - since.DayNumber;
        return (days <= 0 ? "In column today" : $"In column {days}d", since);
    }

    [Parameter, EditorRequired] public ActionBoard Board { get; set; } = default!;
    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    /// <summary>How many of the board's view closed each way (the strip under the lanes), from the tabs' count.</summary>
    [Parameter] public ActionViewCounts Counts { get; set; } = ActionViewCounts.None;

    /// <summary>How far back the closed strip counts.</summary>
    [Parameter] public int ClosedDays { get; set; } = ActionService.BoardClosedDays;

    /// <summary>The administrators' card rules: a card takes the first matching one's colour, and every match's label.</summary>
    [Parameter] public IReadOnlyList<ActionCardRule> Rules { get; set; } = [];

    /// <summary>After a move (or a refused one): the page reloads the board.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>"Show the last 30 days" (or 7) under the lanes: the page counts the closed strip again, reaching that far.</summary>
    [Parameter] public EventCallback OnShowOlder { get; set; }

    /// <summary>The selected card (the page's), and a card that took focus, which becomes it.</summary>
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<ActionRow> OnSelect { get; set; }

    private Task Select(ActionRow card) => card.Id == SelectedId ? Task.CompletedTask : OnSelect.InvokeAsync(card);

    /// <summary>Who last changed each card, from the changes a live reload heard: a card that changed column says so.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, string> MovedBy { get; set; } = new Dictionary<Guid, string>();

    /// <summary>How long a card someone else moved says who moved it.</summary>
    private static readonly TimeSpan ArrivedFor = TimeSpan.FromSeconds(6);

    /// <summary>The cards a column shows at first, and how many more each "Show more" adds.</summary>
    internal const int FirstCards = 20, MoreCards = 20;

    // How many cards each column shows (FirstCards until "Show more"), and the cards moved into a column this visit, which
    // stay shown past that: a card dropped at the 25th place would otherwise vanish as it lands.
    private readonly Dictionary<ActionStatus, int> _cap = [];
    private readonly HashSet<Guid> _pinned = [];

    private List<ActionRow> Shown(ActionStatus status, IReadOnlyList<ActionRow> cards)
    {
        var cap = _cap.GetValueOrDefault(status, FirstCards);
        return cards.Where((c, i) => i < cap || _pinned.Contains(c.Id)).ToList();
    }

    internal void ShowMore(ActionStatus status)
    {
        _cap[status] = _cap.GetValueOrDefault(status, FirstCards) + MoreCards;
        StateHasChanged();
    }

    private Task ShowOlder() => OnShowOlder.InvokeAsync();

    private ElementReference _root;
    private ActionMover _mover = default!;
    private DotNetObjectReference<ActionKanban>? _self;
    private Guid? _menuFor;
    // The card whose Move menu just opened (focus goes to its first option), or that the menu just moved (focus goes
    // back to its Move button, in its new column).
    private Guid? _focusMenu;
    private bool _focusPlace;

    // The columns the cards were in at the last render, to see which moved; the cards this tab moved itself (its own
    // reload isn't news); the ones someone else moved, saying so for a moment; and the slides still to play.
    private Dictionary<Guid, ActionStatus>? _was;
    private readonly HashSet<Guid> _mine = [];
    private readonly Dictionary<Guid, (string Name, int Ticket, bool Moved)> _arrived = [];
    private List<object> _toPlay = [];
    private int _ticket;
    private string? _said;
    private readonly CancellationTokenSource _gone = new();

    protected override void OnInitialized() => Drags.Changed += OnDragsChanged;

    protected override void OnParametersSet()
    {
        ShowSelected();
        var was = _was;
        _was = Board.Cards.ToDictionary(c => c.Id, c => c.Status);
        if (was is null) return;
        var moved = Board.Cards.Where(c => was.TryGetValue(c.Id, out var s) && s != c.Status && !_mine.Remove(c.Id)).ToList();
        // A card that's new here, heard from a colleague (so not a view or filter this person chose): it glows in too.
        var added = Board.Cards.Where(c => !was.ContainsKey(c.Id) && MovedBy.ContainsKey(c.Id)).ToList();
        if (moved.Count == 0 && added.Count == 0) return;
        var ticket = ++_ticket;
        var said = new List<string>();
        foreach (var c in moved)
        {
            _pinned.Add(c.Id);
            var name = MovedBy.TryGetValue(c.Id, out var n) && !string.IsNullOrWhiteSpace(n) ? n : "Someone";
            _arrived[c.Id] = (name, ticket, true);
            _toPlay.Add(new { id = c.Id, from = was[c.Id].ToString() });
            said.Add($"{name} moved {Ui.ActionLabel(c.Number)} to {ActionService.StatusName(c.Status)}.");
        }
        foreach (var c in added)
        {
            _pinned.Add(c.Id);
            var name = string.IsNullOrWhiteSpace(MovedBy[c.Id]) ? "Someone" : MovedBy[c.Id];
            _arrived[c.Id] = (name, ticket, false);
            said.Add($"{name} added {Ui.ActionLabel(c.Number)} to {ActionService.StatusName(c.Status)}.");
        }
        _said = string.Join(" ", said);
        _ = Settle(ticket);
    }

    // The selected card past its lane's cards shown (J went on to it) is shown, with the cards before it.
    private void ShowSelected()
    {
        if (SelectedId is not { } id || Board.Cards.FirstOrDefault(c => c.Id == id) is not { } card) return;
        var at = Board.In(card.Status).ToList().FindIndex(c => c.Id == id);
        var cap = _cap.GetValueOrDefault(card.Status, FirstCards);
        while (cap <= at) cap += MoreCards;
        _cap[card.Status] = cap;
    }

    // After a moment the moved cards stop saying who moved them (unless they've moved again since).
    private async Task Settle(int ticket)
    {
        try
        {
            await Task.Delay(ArrivedFor, _gone.Token);
            await InvokeAsync(() =>
            {
                foreach (var id in _arrived.Where(kv => kv.Value.Ticket == ticket).Select(kv => kv.Key).ToList()) _arrived.Remove(id);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { /* the board closed */ }
        catch (ObjectDisposedException) { /* the board closed */ }
    }

    // Someone picked up, carried or let go of a card: show it.
    private void OnDragsChanged(string board) => _ = InvokeAsync(StateHasChanged);

    /// <summary>This tab picked up a card, or carried it over another column (null: its own, or none).</summary>
    [JSInvokable]
    public void OnDragging(string id, string? over)
    {
        if (!Guid.TryParse(id, out var cardId) || Board.Cards.FirstOrDefault(c => c.Id == cardId) is not { } card || !Board.CanMove(card)) return;
        ActionStatus? to = Enum.TryParse<ActionStatus>(over, out var s) && s != card.Status ? s : null;
        Drags.Report(Origin.Id, Circuit.CircuitId, cardId, CurrentUser.UserId, CurrentUser.DisplayName, to);
    }

    /// <summary>This tab let go of the card: dropped it, or the drag was cancelled.</summary>
    [JSInvokable]
    public void OnDragEnded() => Drags.End(Origin.Id);

    private string Age(ActionRow r)
    {
        // Today is the organization's day, so the day it was opened is too (not the UTC date, a day out every evening
        // west of Greenwich and every morning east of it).
        var days = Today.DayNumber - Clock.DayOf(r.CreatedAtUtc).DayNumber;
        return days <= 0 ? "Opened today" : $"Opened {days}d ago";
    }

    private readonly HashSet<Guid> _checklistFor = [];

    private void ToggleMenu(Guid id)
    {
        _menuFor = _menuFor == id ? null : id;
        _focusMenu = _menuFor;
    }

    private void ToggleChecklist(Guid id)
    {
        if (!_checklistFor.Remove(id)) _checklistFor.Add(id);
    }

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Tab") _menuFor = null;
    }

    /// <summary>After a move from a card's Move menu: the card, and the cards beside it in its lane then, where focus goes
    /// if it has left (the next, else the one before, else the lane's heading).</summary>
    internal (Guid Card, Guid? Next, Guid? Previous, ActionStatus Lane)? Place { get; private set; }

    // From the Move menu: once moved (or not), focus goes back to the card's Move button wherever it is now, or when it
    // has left the board (closed), to the card that was after it in its lane, else the one before, else the lane's heading.
    private async Task MoveFromMenu(ActionRow card, ActionStatus to)
    {
        var lane = Shown(card.Status, Board.In(card.Status));
        var at = lane.FindIndex(c => c.Id == card.Id);
        Place = (card.Id, at + 1 < lane.Count ? lane[at + 1].Id : null, at > 0 ? lane[at - 1].Id : null, card.Status);
        await Move(card, to);
        _focusPlace = true;
        StateHasChanged();
    }

    /// <summary>The rail's Move to: the card moves as its Move menu moves it, and stays selected wherever it lands (focus
    /// stays in the rail).</summary>
    internal async Task MoveFromRail(ActionRow card, ActionStatus to)
    {
        await Move(card, to);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnCardDropped(string id, string from, string to)
    {
        if (!Guid.TryParse(id, out var cardId) || !Enum.TryParse<ActionStatus>(to, out var status)) return;
        var card = Board.Cards.FirstOrDefault(c => c.Id == cardId);
        if (card is null || card.Status.ToString() != from)
        {
            // Moved (or taken off the board) by someone else while it was held: nothing moves, and the person is told why.
            Toasts.Show(card is null
                ? "That action was moved by someone else; the board is up to date."
                : $"{Ui.ActionLabel(card.Number)} was moved by someone else; the board is up to date.");
            StateHasChanged();
            return;
        }
        await Move(card, status);
        StateHasChanged();
    }

    // This tab's own move: its reload isn't news, and the card stays shown wherever it lands.
    private async Task Move(ActionRow card, ActionStatus to)
    {
        _menuFor = null;
        _mine.Add(card.Id);
        _pinned.Add(card.Id);
        await _mover.MoveAsync(card, to, refused: () => _mine.Remove(card.Id));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("tideBoard.start", _self, _root);
            }
            if (_focusMenu is { } open)
            {
                _focusMenu = null;
                await JS.InvokeVoidAsync("tideBoard.focusMenu", open.ToString());
            }
            if (_focusPlace && Place is { } p)
            {
                _focusPlace = false;
                await JS.InvokeVoidAsync("tideBoard.focusPlace", p.Card.ToString(), p.Next?.ToString(), p.Previous?.ToString(), $"kcol-{p.Lane}");
            }
            if (_toPlay.Count > 0)
            {
                var moves = _toPlay;
                _toPlay = [];
                await JS.InvokeVoidAsync("tideBoard.play", moves);
            }
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        Drags.Changed -= OnDragsChanged;
        Drags.End(Origin.Id);
        await _gone.CancelAsync();
        _gone.Dispose();
        // Only a board that started (interactively, after its first render) has anything to stop: a prerendered one
        // can't call JavaScript at all, and trying fails its page.
        if (_self is null) return;
        await JS.StopAsync("tideBoard.stop");
        _self.Dispose();
    }
}
