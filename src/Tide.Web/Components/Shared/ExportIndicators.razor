@* Export the indicators of an article, a brief, a story or a lookup as STIX 2.1 or CSV, up to a TLP: articles marked
   above it are left out whole. Behind its button, or (Inline) drawn where it's placed, in a context rail's section. *@

@if (Inline)
{
    @Panel
}
else
{
    <div class="tide-export">
        <button type="button" class="btn btn-outline-secondary" aria-expanded="@Ui.Aria(_open)" @onclick="() => _open = !_open">
            <span class="bi bi-box-arrow-up" aria-hidden="true"></span> Export indicators
        </button>
        @if (_open)
        {
            <div class="tide-export-panel">@Panel</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ExportScope Scope { get; set; }
    [Parameter, EditorRequired] public string Key { get; set; } = "";

    /// <summary>Drawn in place, with no button to open it.</summary>
    [Parameter] public bool Inline { get; set; }

    private bool _open;
    // The least sensitive ceiling, so a wider one is always chosen, never the one a click gets.
    private TlpLevel _ceiling = TlpLevel.Clear;

    private RenderFragment Panel => @<text>
        <label class="tide-field-label">Include articles marked up to</label>
        <TlpSelect @bind-Value="_ceiling" Label="Highest TLP to include" />
        <div class="d-flex gap-2 mt-2">
            <a class="btn btn-primary btn-sm" href="@Url("stix")" download><span class="bi bi-filetype-json" aria-hidden="true"></span> STIX 2.1</a>
            <a class="btn btn-outline-secondary btn-sm" href="@Url("csv")" download><span class="bi bi-filetype-csv" aria-hidden="true"></span> CSV</a>
        </div>
        <div class="form-text">Each object carries its article's TLP marking. STIX leaves out host names, process names and "other" indicators; the CSV has every one.</div>
    </text>;

    private string Url(string format) =>
        $"exports/{Scope.ToString().ToLowerInvariant()}/{Uri.EscapeDataString(Key)}?format={format}&tlp={Tlp.Key(_ceiling)}";
}
