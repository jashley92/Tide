@* Beside an article, out in the open (not folded under Details): the threat story it's part of, and a search to put it
   in one or start one. With nothing typed the search offers the open stories that had an article most recently; typing
   finds any story by name, closed ones too, and offers to start one by that name. It lists a few at a time
   (StoryService.PickLimit), so it stays short however many stories there are. While the article is in none, the story a
   related article is in comes first as a one-click suggestion. The story lives with ReaderPreview (StoryId,
   StoryChanged), so Similar articles' "Same story" and this picker agree. *@
@inject StoryService Stories
@inject ICurrentUser CurrentUser
@inject OrgClock Clock
@inject ToastService Toasts
@inject PrerenderHandoff Handoff

<div class="tide-story-pick">
    @if (_canWrite && (StoryId is null || _changing))
    {
        <h3 class="tide-subhead mt-0"><label for="story-pick">Threat story</label></h3>
        @if (StoryId is null && Suggested is { } hint)
        {
            <div class="tide-story-hint mt-0 mb-2">
                <span>A related article is in <strong>@hint.Name</strong>.</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => Link(hint.Id)">Use it</button>
            </div>
        }
        <SearchCombobox @ref="_combo" TItem="StoryRow" Id="story-pick" Type="search" Open="true" Placeholder="Find a story, or name a new one" ListLabel="Stories"
                        Help="Matching stories are listed below. Choose one to put the article in it." Disabled="_busy"
                        @bind-Text="_text" @bind-Text:after="Typed" Items="_found" Key="s => s.Id" OnPick="Pick"
                        NewOption="@(CanStart ? NewStory : null)" OnNew="StartStory" Empty="@(_found.Count == 0 && !CanStart ? NoStories : null)">
            <ItemTemplate Context="s">
                <span class="tide-story-result-name">@s.Name</span>
                <span class="tide-story-result-meta">@Meta(s)</span>
            </ItemTemplate>
        </SearchCombobox>
        @if (_changing)
        {
            <button type="button" class="btn btn-link btn-sm px-0" @onclick="StopChanging">Keep it in @(_current?.Name ?? "its story")</button>
        }
    }
    else
    {
        <h3 class="tide-subhead mt-0">Threat story</h3>
        @if (StoryId is { } sid)
        {
            <a href="stories/@sid">@(_current?.Name ?? "Its story")</a>
            @if (_current?.Status == StoryStatus.Closed) { <span class="small tide-muted"> (closed)</span> }
            @if (_canWrite)
            {
                <div class="d-flex flex-wrap gap-3 mt-1">
                    <button type="button" class="btn btn-link btn-sm p-0" disabled="@_busy" @onclick="StartChanging">Change</button>
                    <button type="button" class="btn btn-link btn-sm p-0" disabled="@_busy" @onclick="() => Link(null)">Take it off the story</button>
                </div>
            }
        }
        else
        {
            <p class="small tide-muted mb-0">Not part of a story.</p>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ArticleId { get; set; }

    /// <summary>The story the article is in now.</summary>
    [Parameter] public Guid? StoryId { get; set; }

    /// <summary>A story to suggest while it's in none: a related article's.</summary>
    [Parameter] public (Guid Id, string Name)? Suggested { get; set; }

    /// <summary>The article was linked to a story, or taken off one (null).</summary>
    [Parameter] public EventCallback<Guid?> StoryChanged { get; set; }

    internal IReadOnlyList<StoryRow> _found = [];
    internal SearchCombobox<StoryRow>? _combo;
    private StoryRow? _current;
    private Guid? _shown;
    private bool _canWrite, _busy, _loaded, _changing;
    // What's typed in the search: the words to find, and the name a new story would take (internal for the tests).
    internal string? _text;
    private readonly TypingPause _pause = new();

    private string Text => (_text ?? "").Trim();

    private RenderFragment NewStory => @<text><span class="bi bi-plus-lg" aria-hidden="true"></span> Start a story called “@Text”</text>;

    private static readonly RenderFragment NoStories = @<text>No open stories yet. Type a name to start one.</text>;

    // A new story by the words typed, unless a story listed is already called that.
    internal bool CanStart => Text.Length > 0 && !_found.Any(s => string.Equals(s.Name, Text, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _shown == StoryId) return;
        // A reload draws the prerendered story, or the search, at once; they're read again below if something was saved since.
        var fresh = false;
        if (Handoff.Take<StoryPicker>(RendererInfo, PrerenderedState, out var current) is { } prerendered && prerendered._shown == StoryId && prerendered.ArticleId == ArticleId)
            (_current, _found, _foundFor, fresh) = (prerendered._current, prerendered._found, prerendered._foundFor, current);
        _loaded = true;
        _shown = StoryId;
        _canWrite = CurrentUser.Has(Permission.WriteArticles);
        if (fresh) return;
        try
        {
            _current = StoryId is { } id ? await Stories.RowAsync(id) : null;
            if (_canWrite && StoryId is null) await Find();
            PrerenderedState = Handoff.Keep(RendererInfo, this, PrerenderedState);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
    public string? PrerenderedState { get; set; }

    // Typed in the box: the search runs once typing pauses (TypingPause.SearchMs), as the other pickers' do.
    private async Task Typed()
    {
        if (await _pause.Settled()) await Find();
    }

    // The stories for what's typed now; a slower answer for what was typed before is dropped.
    internal async Task Find()
    {
        var mine = _pause.Now();
        var text = Text;
        var found = await Stories.FindAsync(_text);
        if (!_pause.IsLatest(mine)) return;
        (_found, _foundFor) = (found, text);
        StateHasChanged();
    }

    // What _found was found for: until the search for what's typed now has run (it waits out the typing pause), the list
    // and "Start a story" still answer the words typed before.
    private string? _foundFor;

    private bool Stale => Text != _foundFor;

    // Enter (or a click) before the search for what's typed has run: it runs now, and the choice stands only if it's still
    // listed, so Enter right after typing never links the story the earlier words found (or the ones offered before
    // anything was typed), nor starts one a story listed is already called.
    private async Task<bool> Current(Func<bool> stillGood)
    {
        if (!Stale) return true;
        await Find();
        return !Stale && stillGood();
    }

    // A story picked from the list.
    internal async Task Pick(StoryRow s)
    {
        if (_busy) return;
        if (await Current(() => _found.Any(f => f.Id == s.Id))) await Link(s.Id);
    }

    private async Task StartChanging()
    {
        _changing = true;
        _text = null;
        await Find();
    }

    private void StopChanging() => (_changing, _text) = (false, null);

    private string Meta(StoryRow s)
    {
        var parts = new List<string> { s.Articles == 1 ? "1 article" : $"{s.Articles} articles" };
        if (s.LastArticleAtUtc is { } last) parts.Add("latest " + Clock.ToLocal(last).ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture));
        if (s.Status == StoryStatus.Closed) parts.Add("closed");
        return string.Join(" · ", parts);
    }

    private async Task Link(Guid? id)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Stories.LinkAsync(ArticleId, id);
            (_changing, _text) = (false, null);
            Toasts.Show(id is null ? "Taken off the story." : "Linked to the story.");
            await StoryChanged.InvokeAsync(id);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    // Once per click: a double-click makes one story.
    internal async Task StartStory()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (!await Current(() => CanStart)) return;
            var id = await Stories.CreateAsync(Text, null);
            await Stories.LinkAsync(ArticleId, id);
            (_changing, _text) = (false, null);
            Toasts.Show("Story started.");
            await StoryChanged.InvokeAsync(id);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    /// <summary>Reads the stories again: one was started elsewhere on the page (Similar articles' "Same story").</summary>
    public async Task RefreshAsync()
    {
        _current = StoryId is { } id ? await Stories.RowAsync(id) : null;
        if (_canWrite) await Find();
        StateHasChanged();
    }
}
