@* An action's Files, in the page's side column: those added to it and those attached to its comments, newest first. Each
   is a compact row (icon, name, size, the "Can run" badge and its downloads) over a muted line saying where it is, who
   added it and when. Its notes, description, SHA-256 and the Describe and Remove controls are behind its "More" button
   (aria-expanded), open on demand. Whoever works the action adds files and describes them; the person who added one, an
   analyst or an administrator removes it, saying why; an administrator restores it. *@
@inject ActionFileService FileSvc
@inject ICurrentUser CurrentUser
@inject OrgClock Clock
@inject ToastService Toasts

<section class="tide-card tide-files-side" id="files" aria-labelledby="files-h">
    <h2 id="files-h">Files <span class="tide-count tide-muted fw-normal">(@Files.Live.Count)</span></h2>
    @if (CanWork)
    {
        <FilePicker Files="_pending" Changed="StateHasChanged" Label="Add files to this action">
            @if (_pending.Count > 0)
            {
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="Add">Add @(_pending.Count == 1 ? "the file" : $"{_pending.Count} files")</button>
                    <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => _pending.Clear()">Cancel</button>
                </div>
            }
        </FilePicker>
    }
    @if (Files.Live.Count == 0)
    {
        <p class="small tide-muted mb-0 mt-2">No files yet.@(CanWork ? "" : " Files on its comments are listed here too.")</p>
    }
    else
    {
        <ul class="tide-file-list">
            @foreach (var f in Files.Live)
            {
                var open = IsOpen(f);
                <li class="tide-file" @key="f.FileId">
                    <div class="tide-file-row">
                        <span class="bi @Icon(f) tide-file-icon@(f.RiskReason is not null ? " tide-file-risky" : "")" aria-hidden="true"></span>
                        <span class="tide-file-name" title="@f.FileName">@f.FileName</span>
                        <span class="tide-file-size">@Ui.Size(f.SizeBytes)</span>
                        @if (f.RiskReason is not null)
                        {
                            <Badge Tone="BadgeTone.Danger" Icon="bi-exclamation-triangle" Title="@FileRisk.Sentence(f.RiskReason)">Can run</Badge>
                        }
                        <span class="tide-file-dl">
                            @if (FileSvc.ZipFirst(f))
                            {
                                <a href="@Ui.ZipUrl(f.FileId)" download="@(FileRisk.EntryName(f.FileName) + ".zip")" title="@ZipTitle"
                                   aria-label="Download @f.FileName in a zip"><span class="bi bi-file-earmark-zip" aria-hidden="true"></span>zip</a>
                                <a href="@Ui.DownloadUrl(f.FileId)" download="@f.FileName" title="@AsIsTitle(f)" aria-label="Download @f.FileName as is">as is</a>
                            }
                            else
                            {
                                <a href="@Ui.DownloadUrl(f.FileId)" download="@f.FileName" title="@(f.RiskReason is not null ? AsIsTitle(f) : "Download")"
                                   aria-label="Download @f.FileName"><span class="bi bi-download" aria-hidden="true"></span></a>
                            }
                        </span>
                    </div>
                    <div class="tide-file-sub">
                        @if (f.CommentId is { } commentId)
                        {
                            <a class="tide-file-source" href="@($"{Ui.ActionUrl(Number)}#comment-{commentId}")">On a comment by @f.AddedByName</a>
                        }
                        else if (f.FromComment)
                        {
                            <span class="tide-file-source">From a deleted comment by @f.AddedByName</span>
                        }
                        else
                        {
                            <span class="tide-file-source">Added by @f.AddedByName</span>
                        }
                        <span class="tide-file-when">&middot; @Ui.When(Clock, f.AddedAtUtc)</span>
                        <button type="button" class="btn btn-link btn-sm tide-file-more-btn" aria-expanded="@Ui.Aria(open)" aria-controls="file-more-@f.FileId"
                                aria-label="More about @f.FileName" @ref="_toggles[f.FileId]" @onclick="() => Toggle(f)">More<span class="bi @(open ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></span></button>
                    </div>
                    <div class="tide-file-more" id="file-more-@f.FileId" hidden="@(!open)">
                        @if (f.RiskReason is not null)
                        {
                            <div class="tide-file-note"><span class="bi bi-shield-exclamation" aria-hidden="true"></span> @FileRisk.Sentence(f.RiskReason)</div>
                        }
                        @if (f.TypeNote is not null)
                        {
                            <div class="tide-file-note"><span class="bi bi-question-diamond" aria-hidden="true"></span> @f.TypeNote It isn't shown as an image.</div>
                        }
                        @if (_describing == f.FileId)
                        {
                            <textarea class="form-control form-control-sm" rows="2" maxlength="@ActionFile.MaxDescription" aria-label="Description of @f.FileName"
                                      @ref="_box" @bind="_description" @bind:event="oninput"></textarea>
                            <div class="d-flex gap-2 align-items-center">
                                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => SaveDescription(f)">Save</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => Back(f)">Cancel</button>
                                <span class="small tide-muted">@((_description ?? "").Length) of @ActionFile.MaxDescription</span>
                            </div>
                        }
                        else if (f.Description is not null)
                        {
                            <div class="tide-file-desc">@f.Description</div>
                        }
                        else
                        {
                            <div class="tide-muted">No description.</div>
                        }
                        @if (f.Sha256 is { } hash)
                        {
                            <div class="tide-file-hash"><span class="tide-muted">SHA-256</span> <code class="tide-file-hash-full" aria-label="SHA-256 of @f.FileName">@hash</code></div>
                        }
                        @if ((CanWork && _describing != f.FileId) || (f.CanRemove && _removing != f.FileId))
                        {
                            <div class="tide-file-actions">
                                @if (CanWork && _describing != f.FileId)
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0" aria-label="@(f.Description is null ? "Describe" : "Edit the description of") @f.FileName"
                                            @onclick="() => StartDescribe(f)">@(f.Description is null ? "Describe" : "Edit description")</button>
                                }
                                @if (f.CanRemove && _removing != f.FileId)
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0" aria-label="Remove @f.FileName" @onclick="() => StartRemove(f)">Remove</button>
                                }
                            </div>
                        }
                        @if (_removing == f.FileId)
                        {
                            <div class="tide-file-remove">
                                <label class="form-label small mb-1" for="remove-reason">Why remove @f.FileName? The history keeps who removed it and why, and an administrator can restore it.</label>
                                <textarea id="remove-reason" class="form-control form-control-sm" rows="2" maxlength="@ActionFile.MaxReason" @ref="_box" @bind="_reason" @bind:event="oninput"></textarea>
                                <div class="d-flex gap-2 mt-1">
                                    <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))" @onclick="() => Remove(f)">Remove file</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => Back(f)">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    @if (Files.Removed.Count > 0)
    {
        <details class="tide-files-removed">
            <summary>Removed files (@Files.Removed.Count)</summary>
            <ul class="tide-file-list">
                @foreach (var f in Files.Removed)
                {
                    <li class="tide-file" @key="f.FileId">
                        <div class="tide-file-row">
                            <span class="bi bi-file-earmark-x tide-file-icon" aria-hidden="true"></span>
                            <span class="tide-file-name" title="@f.FileName">@f.FileName</span>
                            <span class="tide-file-size">@Ui.Size(f.SizeBytes)</span>
                            <button class="btn btn-outline-secondary btn-sm tide-file-restore" disabled="@_busy" @onclick="() => Restore(f)" aria-label="Restore @f.FileName">Restore</button>
                        </div>
                        <div class="tide-file-sub tide-file-sub-wrap">Removed by @f.RemovedByName, @Ui.When(Clock, f.RemovedAtUtc!.Value): @f.RemovedReason</div>
                        <div class="tide-file-sub tide-file-sub-wrap">
                            <span>@RemovedSource(f)</span>
                            @if (f.Sha256 is { } hash)
                            {
                                <span>SHA-256 <code title="SHA-256 @hash">@Ui.ShortHash(hash)</code></span>
                            }
                        </div>
                    </li>
                }
            </ul>
        </details>
    }
</section>

@code {
    [Parameter, EditorRequired] public ActionFileList Files { get; set; } = ActionFileList.None;
    [Parameter, EditorRequired] public Guid ActionId { get; set; }
    [Parameter, EditorRequired] public int Number { get; set; }
    [Parameter] public bool CanWork { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private readonly List<FilePicker.PendingFile> _pending = [];
    private Guid? _describing, _removing;
    private string? _description, _reason;
    private bool _busy;

    // Which files' More is open; Describe and Remove keep theirs open while their box is. Focus moves into the box when it
    // opens and back to the file's More button when it closes, so a keyboard user isn't dropped onto the page's body.
    private readonly HashSet<Guid> _open = [];
    private readonly Dictionary<Guid, ElementReference> _toggles = [];
    private ElementReference _box;
    private bool _focusBox;
    private Guid? _focusToggle;

    internal const string ZipTitle = "In a zip, so it can't run by accident. It opens with the password \"infected\".";

    internal bool IsOpen(ActionFileRow f) => _open.Contains(f.FileId) || _describing == f.FileId || _removing == f.FileId;

    // The row's icon: a warning for a file that can run, a picture for an image shown inline, otherwise a paperclip.
    internal static string Icon(ActionFileRow f) =>
        f.RiskReason is not null ? "bi-exclamation-triangle" : f.ShowsInline ? "bi-image" : "bi-paperclip";

    // Closing a file's More also drops a description or removal being typed there.
    internal void Toggle(ActionFileRow f)
    {
        if (!IsOpen(f)) { _open.Add(f.FileId); return; }
        _open.Remove(f.FileId);
        if (_describing == f.FileId) _describing = null;
        if (_removing == f.FileId) _removing = null;
    }

    private void Back(ActionFileRow f)
    {
        if (_describing == f.FileId) _describing = null;
        if (_removing == f.FileId) _removing = null;
        _focusToggle = f.FileId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusBox)
        {
            _focusBox = false;
            await Focus(_box);
        }
        else if (_focusToggle is { } id)
        {
            _focusToggle = null;
            if (_toggles.TryGetValue(id, out var toggle)) await Focus(toggle);
        }
    }

    private static async Task Focus(ElementReference element)
    {
        try { await element.FocusAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or TaskCanceledException) { /* gone, or not rendered yet */ }
    }

    // Where a removed file was, for the Removed files list.
    private string RemovedSource(ActionFileRow f) =>
        $"{(f.FromComment ? "Was on a comment by" : "Added to the action by")} {f.AddedByName}, {Ui.When(Clock, f.AddedAtUtc)}";

    internal static string AsIsTitle(ActionFileRow f) => f.RiskReason is not null
        ? $"Warning: {FileRisk.Sentence(f.RiskReason)} Download it as is only to open it somewhere safe."
        : "The file itself, not zipped.";

    internal IReadOnlyList<FilePicker.PendingFile> Pending => _pending;

    internal Task Add() => Run(async () =>
    {
        var sent = _pending.ToList();
        await FileSvc.AddAsync(ActionId, sent.Select(p => p.ToUpload()).ToList());
        _pending.RemoveAll(p => sent.Contains(p));
        Toasts.Show(sent.Count == 1 ? $"Added {sent[0].FileName}." : $"Added {sent.Count} files.");
    });

    internal void StartDescribe(ActionFileRow f)
    {
        (_describing, _description, _removing) = (f.FileId, f.Description, null);
        _open.Add(f.FileId);
        _focusBox = true;
    }

    internal Task SaveDescription(ActionFileRow f) => Run(async () =>
    {
        await FileSvc.DescribeAsync(f.FileId, _description);
        _describing = null;
        _focusToggle = f.FileId;
    });

    internal void StartRemove(ActionFileRow f)
    {
        (_removing, _reason, _describing) = (f.FileId, null, null);
        _open.Add(f.FileId);
        _focusBox = true;
    }

    internal Task Remove(ActionFileRow f) => Run(async () =>
    {
        await FileSvc.RemoveAsync(f.FileId, _reason ?? "");
        _removing = null;
        Toasts.Show(CurrentUser.Has(Permission.Administer) ? $"Removed {f.FileName}. It's under Removed files." : $"Removed {f.FileName}.");
    });

    internal Task Restore(ActionFileRow f) => Run(async () =>
    {
        await FileSvc.RestoreAsync(f.FileId);
        Toasts.Show($"Restored {f.FileName}.");
    });

    internal void SetDraft(Guid? describing, string? description, Guid? removing, string? reason) =>
        (_describing, _description, _removing, _reason) = (describing, description, removing, reason);

    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await action();
            await Changed.InvokeAsync();
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }
}
