@* An Our stack product's card, opened over an article's slide in present mode from its "We run" chip: what we run and
   where, who owns it, its notes (as the stack page renders them), when it was last checked, and the other articles
   about it. Team edition only: the notes are internal (TLP:AMBER); Present draws it only there. *@
@using Tide.Application.Stack
@inherits PresentCardBase

@{ var p = Card.Product; }
<PresentCard Shown="p.Id" TitleId="present-product-title" Href="@($"stack/{p.Id}")" LinkText="Open on Our stack" CloseLabel="@($"Close {p.Name}")"
             Kicker="@Kicker" CanClose="CanClose" Autofocus="Autofocus" OnClose="OnClose" Links="Links">
    <Title><span class="tide-present-product-kicker">We run</span> @p.Name
        @if (p.IsRetired) { <Badge Tone="BadgeTone.Neutral">Retired</Badge> }</Title>
    <ChildContent>
        <dl class="tide-facts">
            @if (StackService.SplitNames(p.OtherNames) is { Count: > 0 } others)
            {
                <div class="tide-fact"><dt>Also called</dt><dd>@string.Join(", ", others)</dd></div>
            }
            <div class="tide-fact"><dt>Versions</dt><dd>@(p.Versions ?? "Not given")</dd></div>
            <div class="tide-fact"><dt>Owning team</dt><dd>@(Card.TeamName ?? "No team")</dd></div>
            <div class="tide-fact"><dt>Last checked</dt><dd>@(p.CheckedOn is { } c ? Ui.Day(c) : "Not checked yet")</dd></div>
        </dl>
        <div class="tide-present-action-cols">
            <div>
                <div class="tide-slide-section">Notes</div>
                @if (p.Notes is { } notes) { <Md Text="@notes" /> } else { <div class="tide-present-help">No notes yet.</div> }
            </div>
            <div>
                <div class="tide-slide-section">Other recent articles</div>
                @if (Card.Others.Count == 0) { <div class="tide-present-help">None.</div> }
                else
                {
                    <ul class="tide-present-product-articles">
                        @foreach (var a in Card.Others)
                        {
                            <li @key="a.Id"><span class="tide-present-help">@Ui.ShortDay(a.On)</span> @a.Title</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </ChildContent>
</PresentCard>

@code {
    [Parameter, EditorRequired] public StackCard Card { get; set; } = default!;
}
