@* Walking today's brief from the article page, without going back to Today: "On today's brief · 4 of 5  ‹ Previous
   Next ›  Back to Today", in the brief's running order. The steps are plain links, so leaving unsaved changes goes
   through the editor's guard as any other link does, and they keep the edition the preview shows (?edition=company).
   At an end the step is there but dimmed. K and J press them (editor.js), unless focus is in a field.
   Draws nothing for an article that isn't on today's brief. *@
@inject BriefService Briefs
@inject PrerenderHandoff Handoff

@if (_at >= 0)
{
    <nav class="tide-stepper" aria-label="Today's brief">
        <span>On today's brief &middot; <strong>@(_at + 1) of @_order.Count</strong></span>
        @Step(_at - 1, "prev", "‹ Previous", "K", "K")
        @Step(_at + 1, "next", "Next ›", "J", "J")
        <a href="">Back to Today</a>
    </nav>
}

@code {
    /// <summary>The article shown.</summary>
    [Parameter, EditorRequired] public Guid ArticleId { get; set; }

    /// <summary>The edition the preview shows, as the address names it (<c>company</c>, or null for the team edition).</summary>
    [Parameter] public string? EditionKey { get; set; }

    /// <summary>The tab beside the article, as the address names it (<c>actions</c>, <c>details</c>, or null).</summary>
    [Parameter] public string? SideKey { get; set; }

    private IReadOnlyList<BriefStop> _order = [];
    private int _at = -1;
    private Guid? _readFor;

    // The running order is read again when the article changes, so a step lands where the brief is now.
    protected override async Task OnParametersSetAsync()
    {
        if (_readFor == ArticleId) return;
        // A reload draws the prerender's steps at once, not nothing until they're read; they're read again below if
        // something was saved since.
        var fresh = false;
        if (Handoff.Take<BriefStepper>(RendererInfo, PrerenderedState, out var current) is { } prerendered && prerendered._readFor == ArticleId)
            (_order, _at, fresh) = (prerendered._order, prerendered._at, current);
        _readFor = ArticleId;
        if (fresh) return;
        _order = await Briefs.RunningOrderAsync(Briefs.CurrentDate);
        _at = _order.Select(s => s.ArticleId).ToList().IndexOf(ArticleId);
        PrerenderedState = Handoff.Keep(RendererInfo, this, PrerenderedState);
    }

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
    public string? PrerenderedState { get; set; }

    /// <summary>The address of an article on the brief, in the edition and on the tab shown.</summary>
    public static string Href(Guid articleId, string? editionKey, string? sideKey = null)
    {
        var query = new[] { ("edition", editionKey), ("side", sideKey) }.Where(q => !string.IsNullOrEmpty(q.Item2))
            .Select(q => $"{q.Item1}={Uri.EscapeDataString(q.Item2!)}").ToList();
        return $"articles/{articleId}{(query.Count == 0 ? "" : "?" + string.Join('&', query))}";
    }

    private RenderFragment Step(int i, string which, string label, string keys, string shown) => i >= 0 && i < _order.Count
        ? @<a href="@Href(_order[i].ArticleId, EditionKey, SideKey)" data-step="@which" aria-keyshortcuts="@keys" title="@_order[i].Title (@shown)">@label</a>
        : @<a role="link" aria-disabled="true" class="tide-stepper-end">@label</a>;
}
