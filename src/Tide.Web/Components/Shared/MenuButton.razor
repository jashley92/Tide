@* A menu button: a button (aria-haspopup, aria-expanded) that opens a short menu of commands in the popover the filter bar's
   + Filter uses, over a backdrop that closes it. Each item runs something or goes somewhere. From the keyboard it works as
   + Filter does (filters.js): the down arrow on the button opens it, the first item takes focus, the arrows, Home and End
   move between items (tideRoving), Tab leaves it closed, and Esc anywhere on the page closes it with focus back on the
   button (Popout), the page under it not hearing that Esc. Choosing an item
   closes it first, so a dialog the item opens takes focus from there. With ChildContent instead of Items, the popover
   holds that (the metric history's chart picker: boxes to tick, and a find box that takes focus first), and stays open
   while it's used. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="tide-menubutton" @ref="_holder">
    <button type="button" class="@ButtonClass tide-menubutton-btn" aria-haspopup="menu" aria-expanded="@Ui.Aria(_open)" aria-controls="@(_open ? _id : null)"
            disabled="@Disabled" title="@(IconOnly ? Label : null)" aria-label="@AriaLabel" @ref="_trigger" @onclick="Toggle">
        @if (Icon is not null) { <span class="bi @Icon" aria-hidden="true"></span> }
        @if (IconOnly)
        {
            <span class="visually-hidden">@Label</span>
        }
        else
        {
            @Label <span class="bi bi-chevron-down tide-menubutton-caret" aria-hidden="true"></span>
        }
    </button>
    @if (_open)
    {
        <div class="tide-popover-backdrop" @onclick="() => Close(false)"></div>
        <div class="tide-popover tide-popover-end tide-menubutton-pop @PopClass" id="@_id" role="menu" aria-label="@(MenuLabel ?? Label)" @ref="_pop">
            @ChildContent
            @foreach (var i in Items)
            {
                @if (i.Href is not null)
                {
                    <a role="menuitem" tabindex="-1" class="tide-filter-item" href="@i.Href" @onclick="() => Close(false)">@Inner(i)</a>
                }
                else
                {
                    <button type="button" role="menuitem" tabindex="-1" class="tide-filter-item" @onclick="() => Choose(i)">@Inner(i)</button>
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>One command on the menu: a <see cref="Run"/> or an <see cref="Href"/>. Run is an EventCallback, so the
    /// component that made it (the page) draws again after it, as after a click of its own.</summary>
    public sealed record Item(string Label, string? Icon = null, EventCallback Run = default, string? Href = null);

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public IReadOnlyList<Item> Items { get; set; } = [];

    /// <summary>What the popover holds instead of <see cref="Items"/>; it stays open while it's used.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The popover's own class (its width), and its name for a screen reader when that isn't the button's.</summary>
    [Parameter] public string? PopClass { get; set; }
    [Parameter] public string? MenuLabel { get; set; }

    /// <summary>Called as it opens (the chart picker empties its find box).</summary>
    [Parameter] public Action? Opened { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string ButtonClass { get; set; } = "btn btn-outline-secondary";
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The button's name for a screen reader when its label alone doesn't say enough ("Status of A-12: Open").</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Only the icon shows (a saved view's menu beside its pill): the label is the button's name for a screen
    /// reader and its tooltip, and there's no caret.</summary>
    [Parameter] public bool IconOnly { get; set; }

    private readonly string _id = "menu-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _holder, _trigger, _pop;
    private Popout? _popout;
    private bool _open, _focusPop, _focusTrigger;

    internal bool IsOpen => _open;

    internal void Toggle()
    {
        if (_open) Close(true);
        else
        {
            (_open, _focusPop) = (true, true);
            Opened?.Invoke();
        }
        StateHasChanged();
    }

    /// <summary>Runs an item, as a click on it does: the menu closes first.</summary>
    internal async Task Choose(Item i)
    {
        Close(false);
        StateHasChanged();
        await i.Run.InvokeAsync();
    }

    private void Close(bool refocus)
    {
        _open = false;
        _focusTrigger = refocus;
    }

    private Task Dismissed()
    {
        Close(false);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static RenderFragment Inner(Item i) => @<text>
        @if (i.Icon is not null) { <span class="bi @i.Icon" aria-hidden="true"></span> }
        <span>@i.Label</span>
    </text>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPop && _open)
        {
            _focusPop = false;
            try { await JS.InvokeVoidAsync("tideFilters.focusIn", _pop); }
            catch (JSDisconnectedException) { }
            catch (JSException) { /* closed meanwhile */ }
        }
        if (_focusTrigger)
        {
            _focusTrigger = false;
            await _trigger.TryFocusAsync(orGone: true);
        }
        _popout ??= new Popout(JS, Dismissed);
        await _popout.FollowAsync(_open, _holder, _trigger);
    }

    public ValueTask DisposeAsync() => _popout?.DisposeAsync() ?? ValueTask.CompletedTask;
}
