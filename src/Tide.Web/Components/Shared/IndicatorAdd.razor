@* Adding indicators: one typed (its type guessed as it's typed, a CVE told apart), or those found in pasted text and
   picked (ArticleService.Suggest, so what's already there isn't offered again). The article editor and an action's Hunt
   queries card both use it; what's added, and where it's kept, is theirs (Adding). What was typed or pasted stays until
   they take it, so a refusal doesn't lose it. *@

<div class="row g-2 align-items-end">
    <div class="col-md-3">
        <select class="form-select form-select-sm" aria-label="New indicator type" disabled="@Disabled" @bind="_newType">
            @foreach (var t in Ui.PickableIndicatorTypes)
            {
                <option value="@t">@Ui.IndicatorLabel(t)</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <input class="form-control form-control-sm" placeholder="@(Cves ? "Add an indicator or CVE (defanged is fine)" : "Add an indicator (defanged is fine)")" aria-label="New indicator"
               disabled="@Disabled" @bind="_newValue" @bind:event="oninput" @bind:after="GuessType" @onkeydown="NewIndicatorKey" />
    </div>
    <div class="col-md-3">
        <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled="@Disabled" @onclick="AddOne">Add</button>
    </div>
</div>
<details class="mt-3" open="@_showExtract" data-submit-scope>
    <summary class="small fw-semibold">@(Cves ? "Find indicators and CVEs in pasted text" : "Find indicators in pasted text")</summary>
    <textarea class="form-control form-control-sm mt-2 tide-autogrow tide-grow-3" rows="5" aria-label="Text to search for indicators"
              placeholder="Paste the article, a vendor report's IOC appendix, or an email. Nothing here is saved." @bind="_extractText" @bind:event="oninput"></textarea>
    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-submit @onclick="Extract"><span class="bi bi-search" aria-hidden="true"></span> Find</button>
    @if (_found is not null)
    {
        @if (_found.Indicators.Count == 0 && _found.Cves.Count == 0)
        {
            <p class="tide-muted small mt-2 mb-0">Nothing new found.</p>
        }
        else
        {
            <div class="tide-suggest mt-2">
                @foreach (var c in _found.Cves)
                {
                    <label><input type="checkbox" class="form-check-input" checked="@_pickCves.Contains(c)" @onchange="e => Toggle(_pickCves, c, e)" />
                        <span class="tide-chip mb-0">CVE</span> <span class="tide-data">@c</span></label>
                }
                @foreach (var i in _found.Indicators)
                {
                    var key = Key(i);
                    <label><input type="checkbox" class="form-check-input" checked="@_pickIndicators.Contains(key)" @onchange="e => Toggle(_pickIndicators, key, e)" />
                        <span class="tide-chip mb-0">@Ui.IndicatorLabel(i.Type)</span> <span class="tide-ioc">@IocObservable.Defang(i.Type, i.Value)</span></label>
                }
            </div>
            <button type="button" class="btn btn-primary btn-sm mt-2" disabled="@Disabled" @onclick="AddFound">Add @(_pickCves.Count + _pickIndicators.Count) selected</button>
        }
    }
</details>

@code {
    /// <summary>What to add: one typed, or those picked from pasted text (<see cref="Picked"/>).</summary>
    public sealed record Addition(IReadOnlyList<IndicatorForm> Indicators, IReadOnlyList<string> Cves, bool Picked);

    /// <summary>What's there already, so the pasted text doesn't offer it again.</summary>
    [Parameter] public IReadOnlyCollection<IndicatorForm> Have { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> HaveCves { get; set; } = [];

    /// <summary>Whether CVEs are taken: an article carries them; a hunt doesn't search for them.</summary>
    [Parameter] public bool Cves { get; set; } = true;

    /// <summary>Takes what's to be added; true when it was, and the box is cleared.</summary>
    [Parameter, EditorRequired] public Func<Addition, Task<bool>> Adding { get; set; } = default!;

    /// <summary>Holds the add buttons back while the parent's step runs.</summary>
    [Parameter] public bool Disabled { get; set; }

    private string? _extractText, _newValue;
    private IndicatorType _newType = IndicatorType.IpAddress;
    private bool _showExtract;
    private Tide.Application.Indicators.IocExtractor.Found? _found;
    private readonly HashSet<string> _pickCves = [];
    private readonly HashSet<string> _pickIndicators = [];

    private void GuessType()
    {
        if (string.IsNullOrWhiteSpace(_newValue)) return;
        var t = IocObservable.DetectType(_newValue);
        if (t != IndicatorType.Other) _newType = t;
    }

    private Task NewIndicatorKey(KeyboardEventArgs e) => e.Key == "Enter" ? AddOne() : Task.CompletedTask;

    internal async Task AddOne()
    {
        var raw = (_newValue ?? "").Trim();
        if (raw.Length == 0 || Disabled) return;
        var addition = Cves && Tide.Application.Indicators.IocExtractor.NormalizeCve(raw) is { } cve
            ? new Addition([], [cve], false)
            : new Addition([new IndicatorForm { Type = _newType, Value = IocObservable.Normalize(_newType, raw) }], [], false);
        if (await Adding(addition)) _newValue = null;
    }

    /// <summary>Finds what the pasted text names that isn't there yet, every find ticked.</summary>
    internal void FindIn(string? text)
    {
        _extractText = text;
        Extract();
        StateHasChanged();
    }

    private void Extract()
    {
        var found = ArticleService.Suggest(_extractText, Have, HaveCves);
        _found = Cves ? found : found with { Cves = [] };
        _pickCves.Clear();
        _pickIndicators.Clear();
        foreach (var c in _found.Cves) _pickCves.Add(c);
        foreach (var i in _found.Indicators) _pickIndicators.Add(Key(i));
        _showExtract = true;
    }

    private static string Key(IocObservable.ParsedIndicator i) => $"{(int)i.Type}|{i.Value}";

    private static void Toggle(HashSet<string> set, string key, ChangeEventArgs e)
    {
        if (e.Value is true) set.Add(key); else set.Remove(key);
    }

    internal async Task AddFound()
    {
        if (_found is null || Disabled) return;
        var addition = new Addition(
            _found.Indicators.Where(i => _pickIndicators.Contains(Key(i))).Select(i => new IndicatorForm { Type = i.Type, Value = i.Value }).ToList(),
            _found.Cves.Where(_pickCves.Contains).ToList(), true);
        if (!await Adding(addition)) return;
        _found = null;
        _extractText = null;
    }
}
