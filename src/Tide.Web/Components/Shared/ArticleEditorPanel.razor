    // What the indicator box adds goes on the form, saved with the rest; pasted finds say so, as nothing is kept until then.
    private async Task<bool> AddIndicators(IndicatorAdd.Addition add)
    {
        foreach (var c in add.Cves) if (!_form!.Cves.Contains(c)) _form.Cves.Add(c);
        foreach (var i in add.Indicators)
            if (!_form!.Indicators.Any(x => x.Type == i.Type && string.Equals(x.Value, i.Value, StringComparison.OrdinalIgnoreCase)))
                _form.Indicators.Add(i);
        if (add.Picked) Toasts.Show($"Added {add.Indicators.Count + add.Cves.Count}. Save to keep them.");
        await Touch();
        // The box calls this as a plain function, which redraws only the box: the bar's Save and "Unsaved changes" are ours.
        StateHasChanged();
        return true;
    }

    private async Task Copy(string value)
    {
        if (await JS.InvokeAsync<bool>("tideCopy", value)) Toasts.Show("Copied the live value.");
    }

    internal async Task<bool> Save()
    {
        if (_busy) return false;
        _busy = true;
        _autosavePause.Now();
        var edits = _edits;
        try
        {
            var version = await ArticleSvc.SaveAsync(_form!);
            // The save went through, so whatever was heard meanwhile didn't make it stale: the banner saying it would
            // be refused goes.
            _changedBy = null;
            await Saved(version, edits, null);
            Toasts.Show("Saved.");
            return true;
        }
        catch (Exception ex)
        {
            Toasts.Error(UserFacingError.For(ex));
            return false;
        }
        finally { _busy = false; }
    }

    private async Task MarkReady()
    {
        if (_dirty && !await Save()) return;
        await SetStatus(ArticleStatus.Ready, "Marked ready for a brief.");
    }

    internal Task BackToDraft() => SetStatus(ArticleStatus.Draft, "Back to draft.");

    private async Task SetStatus(ArticleStatus status, string done)
    {
        _busy = true;
        try
        {
            var (was, now) = await ArticleSvc.SetStatusAsync(Id, status);
            if (was == _form!.EditVersion)
            {
                // Only the status changed under the form: it carries on from the new version.
                _article = await ArticleSvc.GetAsync(Id);
                _form.EditVersion = now;
            }
            else if (!_dirty)
            {
                // A colleague saved in between (their notice may still be on its way): show their text, not ours.
                await Reload();
            }
            else
            {
                // Keep the form's version, so saving these edits is refused as stale rather than overwriting theirs.
                _article = await ArticleSvc.GetAsync(Id);
                _changedBy ??= "Someone else";
            }
            Toasts.Show(done);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    internal async Task AddToTodaysBrief()
    {
        if (_busy || (_dirty && !await Save())) return;
        _busy = true;
        try
        {
            var brief = await Briefs.GetOrStartAsync(Briefs.CurrentDate);
            await Briefs.AddArticleAsync(brief.Id, Id);
            if (!_briefDates.Contains(brief.BriefDate)) _briefDates.Add(brief.BriefDate);
            _focusOnBrief = OnTodaysBrief;   // the button that added it has gone: focus lands on "On today's brief" instead
            Toasts.Show($"On the brief for {Ui.ShortDay(brief.BriefDate)}.");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        // The article the question was asked about: a confirmation left open while the address moved to another (Back)
        // deletes nothing.
        var id = Id;
        if (!await _confirm.Ask("Delete this draft?", "The draft and its screenshots are deleted. This can't be undone.", "Delete draft") || id != Id) return;
        try
        {
            await ArticleSvc.DeleteAsync(id);
            _dirty = false;
            Nav.NavigateTo("articles");
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    // After a save, by hand or by itself (autosavedAt): the form carries on from the new version. Typing during the save
    // may not have reached it: those edits stay unsaved, so the bar and the leave question still say so (and autosave
    // saves them after the next pause).
    private async Task Saved(Guid version, int edits, DateTimeOffset? autosavedAt)
    {
        _form!.EditVersion = version;
        _dirty = _edits != edits;
        (_autosaveNote, _autosavedAt) = (null, autosavedAt);
        _article = await ArticleSvc.GetAsync(Id) ?? _article;
    }

    /// <summary>Whether the form has changes not yet saved (for the tests; the bar and UnsavedGuard read it).</summary>
    internal bool Dirty => _dirty;

    /// <summary>
    /// Whether to let a navigation go ahead (UnsavedGuard): at once when nothing is unsaved; otherwise as the person
    /// chooses. Save and leave goes only if the save works (a stale copy is refused, and stays here to sort out); Discard
    /// and leave drops the changes (the next article, or the page, loads afresh); Stay keeps everything as it is.
    /// </summary>
    // Reads _dirty as it is now, not as the guard's last render had it.
    internal Task<bool> MayLeave() => _dirty ? _guard.Ask() : Task.FromResult(true);

    // Loaded again even when the way out leads back to this article, so what was discarded isn't left showing.
    private void DiscardChanges() => (_dirty, _loadedId) = (false, null);
}
