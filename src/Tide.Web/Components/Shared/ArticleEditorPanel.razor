    /// <summary>
    /// A readiness check's one-click fix, from a button in the preview: for "Why it matters" reaching the company-wide
    /// edition, marks it TLP:AMBER (never lower than the article). Focus goes to the section, where the new marking shows,
    /// since the button goes with the warning. Unsaved, like any other edit.
    /// </summary>
    public async Task FixAsync(ArticleFix fix)
    {
        if (_form is null || !_canWrite || fix != ArticleFix.WhyItMattersAmber) return;
        _form.WhyItMattersTlp = _form.Tlp > TlpLevel.Amber ? _form.Tlp : TlpLevel.Amber;
        await Touch();
        Toasts.Show($"Why it matters is marked {Tlp.Label(_form.WhyItMattersTlp)}. Save to keep it.");
        await Jump(ArticlePart.WhyItMatters, null);
    }

    // The company-wide edition's ceiling, for the warning on "Why it matters".
    private TlpLevel _publicMax = TlpLevel.Green;

    // "Keep it" answers for the saved text, from today's brief, as the running order does: offered while nothing is unsaved.
    private bool KeepOffered => OnTodaysBrief && !_dirty;

    /// <summary>
    /// "Set to AMBER", beside the warning in "Why it matters". With nothing unsaved and the article on today's open brief,
    /// it's the running order's own answer (<see cref="ArticleService.MarkWhyItMattersAmberAsync"/>: saved at once,
    /// permission- and version-checked and audited there), and the form reads the article again. Otherwise it's the
    /// preview's one-click fix (<see cref="FixAsync"/>): an unsaved edit, kept by Save.
    /// </summary>
    internal async Task SetWhyAmberAsync()
    {
        if (_form is null || !_canWrite || _busy) return;
        if (await OpenBriefAsync() is not { } briefId)
        {
            await FixAsync(ArticleFix.WhyItMattersAmber);
            return;
        }
        var changed = false;
        await AnswerOnBrief(async () => changed = await ArticleSvc.MarkWhyItMattersAmberAsync(Id, _form.EditVersion, briefId),
            () => changed ? $"Why it matters is now {Tlp.Label(TlpLevel.Amber)}. The company-wide edition leaves it out."
                : $"Why it matters was already {Tlp.Label(TlpLevel.Amber)} or stricter.");
    }

    /// <summary>
    /// "Keep it": the running order's other answer (<see cref="ArticleService.KeepWhyItMattersAsync"/>), recording that
    /// "Why it matters" is meant for the company-wide edition as it is. It changes no marking and no edition. Only for
    /// the saved text on today's open brief, as there.
    /// </summary>
    internal async Task KeepWhyAsync()
    {
        if (_form is null || !_canWrite || _busy || await OpenBriefAsync() is not { } briefId) return;
        TlpLevel? kept = null;
        await AnswerOnBrief(async () => kept = await ArticleSvc.KeepWhyItMattersAsync(Id, _form.EditVersion, briefId),
            () => kept is { } tlp ? $"Kept Why it matters at {Tlp.Label(tlp)}. It goes to the company-wide edition as it is." : "There's no Why it matters to keep.");
    }

    // Today's brief, when the article is on it, it hasn't gone out, and nothing here is unsaved: where the running order's
    // answers apply.
    private async Task<Guid?> OpenBriefAsync() =>
        KeepOffered && await Briefs.GetAsync(Briefs.CurrentDate) is { Status: not BriefStatus.Sent } brief ? brief.Id : null;

    // One of the running order's answers, saved by the service; then the article is read again (the form is clean) and
    // focus goes to the section, as the buttons went with the warning.
    private async Task AnswerOnBrief(Func<Task> answer, Func<string> done)
    {
        _busy = true;
        try
        {
            await answer();
            await Reload();
            Toasts.Show(done());
            await Jump(ArticlePart.WhyItMatters, null);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _busy = false; }
    }

