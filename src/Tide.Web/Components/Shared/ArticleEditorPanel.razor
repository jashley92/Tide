    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        _uploading = true;
        try
        {
            var room = Article.MaxScreenshots - _form!.Screenshots.Count;
            var files = e.GetMultipleFiles(Article.MaxScreenshots);
            if (files.Count > room) throw new ArgumentException($"Only {room} more screenshot{(room == 1 ? "" : "s")} fit on this article.");
            var uploads = new List<ScreenshotUpload>();
            foreach (var f in files)
            {
                if (f.Size > Shots.MaxBytes) throw new ArgumentException($"'{f.Name}' is over the {Shots.MaxBytes / 1024 / 1024} MB limit.");
                await using var stream = f.OpenReadStream(Shots.MaxBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                uploads.Add(new ScreenshotUpload(f.Name, ms.ToArray()));
            }
            var added = await Shots.AddAsync(Id, uploads);
            foreach (var s in added) _form.Screenshots.Add(new ScreenshotForm { Id = s.Id, FileId = s.FileId, Tlp = s.Tlp });
            // The saved article has the new screenshots: the review card reads from it (a new image needs review too).
            _article = await ArticleSvc.GetAsync(Id) ?? _article;
            Toasts.Show(added.Count == 1 ? "Screenshot added. Give it a caption." : $"{added.Count} screenshots added.");
            await OnFormChanged.InvokeAsync(_form);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
        finally { _uploading = false; }
    }

    private async Task RemoveShot(ScreenshotForm s)
    {
        if (!await _confirm.Ask("Remove this screenshot?", "The image is deleted.", "Remove screenshot")) return;
        try
        {
            await Shots.RemoveAsync(s.Id);
            _form!.Screenshots.Remove(s);
            _article = await ArticleSvc.GetAsync(Id) ?? _article;
            await OnFormChanged.InvokeAsync(_form);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

