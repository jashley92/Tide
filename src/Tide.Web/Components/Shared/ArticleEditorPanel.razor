    private Task AddPastedBullets()
    {
        foreach (var line in MarkdownService.BulletLines(_pasteBullets))
        {
            if (_form!.Bullets.Count >= Article.MaxBullets) break;
            // An empty bullet left at the end is filled first.
            if (_form.Bullets.Count > 0 && string.IsNullOrWhiteSpace(_form.Bullets[^1].Text)) _form.Bullets[^1].Text = line;
            else _form.Bullets.Add(new BulletForm { Text = line, Tlp = _form.Tlp });
        }
        _pasteBullets = null;
        _showPasteBullets = false;
        return Touch();
    }

    private Task MoveBullet(int i, int by)
    {
        var to = i + by;
        if (to < 0 || to >= _form!.Bullets.Count) return Task.CompletedTask;
        (_form.Bullets[i], _form.Bullets[to]) = (_form.Bullets[to], _form.Bullets[i]);
        return Touch();
    }

