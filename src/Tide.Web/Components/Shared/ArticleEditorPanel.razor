    private Task MoveShot(int i, int by)
    {
        var to = i + by;
        if (to < 0 || to >= _form!.Screenshots.Count) return Task.CompletedTask;
        (_form.Screenshots[i], _form.Screenshots[to]) = (_form.Screenshots[to], _form.Screenshots[i]);
