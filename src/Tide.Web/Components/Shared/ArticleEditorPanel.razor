@* The article editor: an article's fields as pairs of cards, side by side where there's room (Assessment beside Tags &
   ATT&CK, Bottom line beside Why it matters, Bullets across both, Recommended beside Indicators), under a section index
   (EditorSectionIndex) that says where each stands and takes you to it, and the sticky bar that saves, marks ready,
   discards or adds the article to today's brief (or says it's on it). It loads the article, keeps the edit version a save must match (a stale copy is refused),
   shows who else has it open, guards leaving with unsaved changes, and takes pasted or dropped screenshots.
   The page gives what readers get (Aside), drawn from the article, the form as it is on screen, and its checks: in the
   context rail ("Context · what readers get") for someone who can edit, and as the page for someone who can't.
   "Why it matters" carries the running order's warning where the company-wide edition would carry it, with its answers.
   For a pane that follows the form as it's typed (the reader preview): OnFormChanged fires after it loads and on every
   edit, FocusAsync takes you to a part, as the pills do, and FocusFieldAsync to the field a gap is in.
   On today's brief, the Stepper the page gives stands above the title in place of the breadcrumbs. At 900px or
   narrower the fields and the preview are one pane at a time, chosen by an Edit | Preview switch (app.css), and the choice
   is kept while you step through the brief; the sticky bar stays at the foot of either pane, so the save state and Save
   are there in Preview too. Leaving with unsaved changes asks: Save and leave, Discard and leave, or Stay (UnsavedGuard).
   Autosave: a pause of AutosavePause in typing saves the form for someone who can edit (ArticleService.AutosaveAsync,
   the one save path), and the bar says "Saving…", then "Saved at 10:12", or why it didn't: a marking changed or
   something now reaches everyone, the article is on a sent brief (each waits for Save), or a colleague saved meanwhile
   (autosave stops; what was typed stays in the form). *@
@inject ArticleService ArticleSvc
@inject ScreenshotService Shots
@inject BriefService Briefs
@inject Tide.Application.Scorecard.ScorecardService Scorecard
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IJSRuntime JS
@inject OrgClock Clock
@inject ICurrentUser CurrentUser
@inject Tide.Application.Detections.DetectionService Detections
@inject Tide.Application.Settings.DistributionSettings Distribution
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@inject PrerenderHandoff Handoff
@implements IDisposable

<PageTitle>@(_form?.Title ?? "Article") · TIDE</PageTitle>

@if (_notFound)
{
    <div class="tide-card"><h1 class="h4">That article doesn't exist</h1><a href="articles">Back to articles</a></div>
}
else if (_form is null || _article is null)
{
    <LoadingBlock />
}
else
{
    <UnsavedGuard @ref="_guard" Dirty="_dirty" Message="You've changed this article since it was last saved." Save="Save" Discard="DiscardChanges" />
    <ChangedElsewhere By="@_changedBy" What="article" OnReload="ReloadTheirs" />

    <div class="tide-page-head">
        <div class="tide-page-head-main">
            @if (Stepper is not null && OnTodaysBrief)
            {
                @Stepper
            }
            else
            {
                <Breadcrumbs Items="@([new("Articles", "articles"), new(Ui.Clip(_article.Title))])" />
            }
            <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                <PresenceNote Place="@($"article:{Id}")" Editing="_dirty" />
                <StatusBadge Status="@_article.Status.ToString()" />
                <ClassBadge Classification="_form.Classification" Priority="_form.Priority" />
                <TlpBadge Level="_form.Tlp" />
            </div>
            @if (_canWrite)
            {
                <h1 class="visually-hidden">Edit article: @_form.Title</h1>
                <input class="form-control form-control-lg fw-semibold" aria-label="Title" maxlength="300" @bind="_form.Title" @bind:event="oninput" @bind:after="Touch" />
            }
            else
            {
                <h1>@_form.Title</h1>
            }
            <div class="tide-sub">By @_article.AuthorName &middot; @Ui.When(Clock, _article.CreatedAtUtc)
                @if (_article.ModifiedAtUtc is { } m) { <text> &middot; saved @Ui.When(Clock, m)</text> }
            </div>
        </div>
        @if (_article.Indicators.Count > 0 || _article.Cves.Count > 0)
        {
            <ExportIndicators Scope="ExportScope.Article" Key="@_article.Id.ToString()" />
        }
    </div>

    var (checks, why) = Checks();
    <ReviewCard Article="_article" CanWrite="_canWrite" />
    @if (Aside is not null && _canWrite)
    {
        <TabBar Label="Show" Level="TabLevel.Sub" Class="tide-ws-switch" Active="@_pane" OnSelect="ShowPane"
                Items="@([new("Edit", "", Key: EditPane), new("Preview", "", Key: PreviewPane)])" />
    }
    @* Someone who can't write (an action owner) reads the article as an edition carries it, with its actions, rather
       than a form of greyed-out fields: the fields are hidden and the preview takes the page (app.css). *@
    <div class="tide-editor" data-pane="@(!_canWrite && Aside is not null ? PreviewPane : _pane)" data-readonly="@(!_canWrite && Aside is not null ? "true" : null)">
        <div class="tide-editor-main">
            <EditorSectionIndex Items="IndexItems(checks, why)" OnJump="FocusAsync" />

            @* The form as pairs of cards, side by side where there's room for both (app.css), one under the other where
               there isn't: what it is beside how it's tagged, the bottom line beside why it matters to us, the bullets
               across both, then what to do beside what to look for. *@
            <div class="tide-editor-pair">
            <section class="tide-card tide-section" aria-labelledby="sec-assessment">
                <h2 id="sec-assessment" tabindex="-1" @ref="_heads[ArticlePart.Assessment]">Assessment</h2>
                <div class="tide-assess-row">
                    <div class="tide-assess-class">
                        <span class="tide-field-label">Classification</span>
                        <div class="btn-group" role="group" aria-label="Classification">
                            <input type="radio" class="btn-check" name="cls" id="cls-threat" checked="@(_form.Classification == Classification.Threat)"
                                   disabled="@(!_canWrite)" @onchange="() => SetClass(Classification.Threat)" />
                            <label class="btn btn-outline-secondary btn-sm" for="cls-threat"><span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Threat</label>
                            <input type="radio" class="btn-check" name="cls" id="cls-info" checked="@(_form.Classification == Classification.Informational)"
                                   disabled="@(!_canWrite)" @onchange="() => SetClass(Classification.Informational)" />
                            <label class="btn btn-outline-secondary btn-sm" for="cls-info"><span class="bi bi-info-circle" aria-hidden="true"></span> Informational</label>
                        </div>
                    </div>
                    @if (_form.Classification == Classification.Threat)
                    {
                        <div>
                            <label class="tide-field-label" for="prio">Priority</label>
                            <select id="prio" class="form-select form-select-sm" disabled="@(!_canWrite)" value="@(_form.Priority?.ToString() ?? "")" @onchange="SetPriority">
                                <option value="">Choose&hellip;</option>
                                <option value="P1">P1: act today</option>
                                <option value="P2">P2: this week</option>
                                <option value="P3">P3: this month</option>
                                <option value="P4">P4: when convenient</option>
                            </select>
                        </div>
                    }
                    <div>
                        <label class="tide-field-label">Article TLP</label>
                        <TlpSelect Value="_form.Tlp" ValueChanged="SetTlp" Label="The article's TLP" Disabled="@(!_canWrite)" />
                    </div>
                </div>
                <div class="form-text mt-0 mb-2">Threat: something should be done. Informational: worth knowing, no action expected. Bullets and screenshots can be marked higher than the article, never lower.</div>
                <div class="tide-assess-row">
                    <div>
                        <label class="tide-field-label" for="src">Source</label>
                        <input id="src" class="form-control form-control-sm" maxlength="200" readonly="@(!_canWrite)" @bind="_form.SourceName" @bind:event="oninput" @bind:after="Touch" />
                    </div>
                    <div class="tide-assess-url">
                        <label class="tide-field-label" for="url">Link</label>
                        <div class="input-group input-group-sm">
                            <input id="url" class="form-control" maxlength="2000" readonly="@(!_canWrite)" @bind="_form.SourceUrl" @bind:event="oninput" @bind:after="Touch" placeholder="https://…" />
                            @if (Uri.TryCreate(_form.SourceUrl, UriKind.Absolute, out var u) && u.Scheme is "http" or "https")
                            {
                                <a class="btn btn-outline-secondary" href="@_form.SourceUrl" target="_blank" rel="noopener noreferrer" title="Open the source" aria-label="Open the source"><span class="bi bi-box-arrow-up-right" aria-hidden="true"></span></a>
                            }
                        </div>
                    </div>
                </div>
                @if (_links.Count > 0 || _canWrite)
                {
                    <div>
                        <div class="tide-field-label">Other reports</div>
                        <ul class="list-unstyled small mb-0">
                            @foreach (var l in _links)
                            {
                                <li @key="l.Id" class="d-flex gap-2 align-items-baseline">
                                    <a href="@l.Url" target="_blank" rel="noopener noreferrer">@l.Title</a>
                                    <span class="tide-muted">@l.SourceName@(l.PublishedAtUtc is { } pub ? " · " + Ui.ShortDay(DateOnly.FromDateTime(Clock.ToLocal(pub).DateTime)) : "")</span>
                                    @if (_canWrite)
                                    {
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-auto" aria-label="Remove the report “@l.Title”" @onclick="() => RemoveLink(l)">Remove</button>
                                    }
                                </li>
                            }
                        </ul>
                        @if (_canWrite)
                        {
                            @* Another outlet's report, added by hand (triage's "Attach to…" adds them from the feeds). *@
                            @if (_addingLink)
                            {
                                <form class="tide-add-link" aria-label="Add a report link" @onsubmit="AddLink">
                                    <div class="tide-add-link-url">
                                        <label class="tide-field-label" for="link-url">Report address</label>
                                        <input id="link-url" type="url" class="form-control form-control-sm" maxlength="2000" placeholder="https://…" required
                                               aria-invalid="@(_linkError is null ? null : "true")" aria-describedby="@(_linkError is null ? null : "link-error")"
                                               @ref="_linkUrlInput" @bind="_linkUrl" @bind:event="oninput" />
                                    </div>
                                    <div class="tide-add-link-source">
                                        <label class="tide-field-label" for="link-source">Source <span class="tide-muted">(optional)</span></label>
                                        <input id="link-source" class="form-control form-control-sm" maxlength="200" placeholder="Who published it" @bind="_linkSource" @bind:event="oninput" />
                                    </div>
                                    <div class="d-flex gap-2 align-items-end">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" disabled="@_busy">Add</button>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="CancelLink">Cancel</button>
                                    </div>
                                    @if (_linkError is not null)
                                    {
                                        <div id="link-error" class="tide-field-error" role="alert">@_linkError</div>
                                    }
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-link btn-sm p-0" @ref="_addLinkButton" @onclick="OpenAddLink"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add a report link</button>
                            }
                        }
                    </div>
                }
            </section>

            @* Scorecard tags, ATT&CK and the context, open beside the assessment. *@
            <section class="tide-card tide-section" aria-labelledby="sec-tags">
                <h2 id="sec-tags" tabindex="-1" @ref="_heads[ArticlePart.Tags]">Tags &amp; ATT&amp;CK</h2>
                <h3 class="tide-subhead">Scorecard tags <span class="tide-tagpick-count">@Tide.Application.Scorecard.ScorecardTagSearch.Summary(_form.TagIds.Count)</span></h3>
                <ScorecardTagPicker @ref="_tagPicker" Id="tags" Categories="_categories" Chosen="_form.TagIds" ReadOnly="!_canWrite" OnToggle="ToggleTag"
                                    RetiredName="RetiredTagName" />

                <h3 class="tide-subhead">ATT&amp;CK techniques</h3>
                @foreach (var id in TechniquesInMatrixOrder())
                {
                    var t = AttackCatalog.Find(id);
                    var gone = t is null ? AttackCatalog.Retired(id) : null;
                    <span class="tide-chip tide-chip-technique @(t is null ? "tide-chip-retired" : "")"
                          title="@(t is not null ? string.Join(", ", t.Tactics.Select(AttackMatrix.TacticName)) : gone is not null ? AttackCatalog.RetiredText(gone) : "Not in the ATT&CK catalog")">
                        @if (t is not null)
                        {
                            <a href="@AttackMatrix.TechniqueUrl(t.Id)" target="_blank" rel="noopener noreferrer">@t.Id</a> @t.Name
                            @if (_rules?.GetValueOrDefault(id) is { } rules) { <RuleCount Rules="rules" /> }
                        }
                        else
                        {
                            <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>@id<span class="visually-hidden"> (no longer in ATT&amp;CK)</span>
                        }
                        @if (_canWrite)
                        {
                            <button type="button" aria-label="Remove @id" @onclick="() => RemoveTechnique(id)"><span class="bi bi-x" aria-hidden="true"></span></button>
                        }
                    </span>
                }
                @if (_form.TechniqueIds.Count == 0) { <p class="tide-muted small mb-2">None tagged.</p> }
                @if (_canWrite)
                {
                    <div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _techniquesOpen = true">
                            <span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>@(_form.TechniqueIds.Count == 0 ? "Choose techniques" : "Edit techniques")
                        </button>
                    </div>
                }

                <h3 class="tide-subhead">Context</h3>
                @* The adversary picker is the article's one place to tag threat actors; it saves as it tags, apart from the form. *@
                <ArticleAdversaryCard ArticleId="_article.Id" CanWrite="_canWrite" />
                <label class="tide-field-label mt-3" for="sectors">Sectors</label>
                <input id="sectors" class="form-control form-control-sm" maxlength="500" readonly="@(!_canWrite)" placeholder="Financial services, healthcare" @bind="_form.Sectors" @bind:event="oninput" @bind:after="Touch" />
            </section>
            </div>

            @if (_canWrite)
            {
                <DraftAssist ArticleId="Id" Form="_form" OnEdited="Touch" />
            }

            <div class="tide-editor-pair">
            <section class="tide-card tide-section" aria-labelledby="sec-bluf">
                <h2 id="sec-bluf" tabindex="-1" @ref="_heads[ArticlePart.BottomLine]">Bottom line</h2>
                <textarea id="f-bluf" class="form-control tide-autogrow tide-grow-2" rows="2" maxlength="600" readonly="@(!_canWrite)" aria-label="Bottom line up front"
                          placeholder="One sentence: what happened and why it matters." @bind="_form.Bluf" @bind:event="oninput" @bind:after="Touch"></textarea>
                @if (_excerpt is not null)
                {
                    <div class="tide-source-excerpt mt-2">
                        <div class="small fw-semibold">From the source, to write in your own words</div>
                        <div class="small">@_excerpt</div>
                        @if (_canWrite && string.IsNullOrWhiteSpace(_form.Bluf))
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="StartFromExcerpt">Start from this</button>
                        }
                    </div>
                }
            </section>

            @* Why it matters to us, with the running order's warning where the company-wide edition would carry it, and its
               two answers: Set to AMBER, or Keep it (meant for everyone, as it is). *@
            <section class="tide-card tide-section @(why is not null ? "tide-section-warn" : null)" aria-labelledby="sec-why">
                <div class="d-flex gap-2 align-items-center justify-content-between flex-wrap">
                    <h2 id="sec-why" class="tide-card-title mb-0" tabindex="-1" @ref="_heads[ArticlePart.WhyItMatters]">Why it matters to us</h2>
                    <TlpSelect Value="_form.WhyItMattersTlp" ValueChanged="SetWhyTlp" Floor="_form.Tlp" Label="The TLP of why it matters" Class="w-auto" Disabled="@(!_canWrite)" />
                </div>
                @if (_whyHint && _canWrite)
                {
                    <div class="form-text mt-0 mb-1 text-end">Internal context starts at AMBER; lower it if it's safe to share.</div>
                }
                <MarkdownToolbar For="f-why" Label="Why it matters to us" Disabled="!_canWrite" />
                <textarea id="f-why" class="form-control tide-autogrow tide-grow-3" rows="3" maxlength="8000" readonly="@(!_canWrite)" aria-label="Why it matters to us"
                          placeholder="Do we run it? Are we in the targeted sector? What's our exposure?" @bind="_form.WhyItMatters" @bind:event="oninput" @bind:after="Touch"></textarea>
                @if (why is not null)
                {
                    <div class="tide-why-check">
                        <span class="tide-why-check-text"><span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Will reach the company-wide edition.</span>
                        @if (_canWrite)
                        {
                            @if (why.Fix == ArticleFix.WhyItMattersAmber)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="SetWhyAmberAsync">Set to AMBER</button>
                            }
                            @if (KeepOffered)
                            {
                                <button type="button" class="btn btn-link btn-sm" disabled="@_busy" @onclick="KeepWhyAsync">Keep it</button>
                            }
                        }
                    </div>
                }
                @* What we run, always open under the text it informs: tagging saves straight away; Mention adds to the text above. *@
                <ArticleStackCard ArticleId="_article.Id" CanWrite="_canWrite" OnMention="MentionAsync" />
            </section>
            </div>

            @* The bullets across both columns, and the screenshots with them. *@
            <section class="tide-card tide-section" aria-labelledby="sec-bullets">
                <h2 id="sec-bullets" tabindex="-1" @ref="_heads[ArticlePart.Bullets]">Bullets <span class="tide-count">(@_form.Bullets.Count)</span></h2>
                @foreach (var (b, i) in _form.Bullets.Select((b, i) => (b, i)).ToList())
                {
                    <div class="tide-bullet-row" @key="b">
                        <span class="tide-dot">&bull;</span>
                        <textarea id="f-bullet-@i" class="form-control form-control-sm tide-autogrow" rows="1" maxlength="2000" readonly="@(!_canWrite)" aria-label="Bullet @(i + 1)"
                                  @bind="b.Text" @bind:event="oninput" @bind:after="Touch"></textarea>
                        <TlpSelect Value="b.Tlp" ValueChanged="v => SetBulletTlp(b, v)" Floor="_form.Tlp" Label="This bullet's TLP" Disabled="@(!_canWrite)" />
                        @if (_canWrite)
                        {
                            <div class="d-flex gap-1">
                                <button type="button" class="tide-icon-btn" title="Move up" aria-label="Move bullet @(i + 1) up" disabled="@(i == 0)" @onclick="() => MoveBullet(i, -1)"><span class="bi bi-arrow-up" aria-hidden="true"></span></button>
                                <button type="button" class="tide-icon-btn" title="Remove" aria-label="Remove bullet @(i + 1)" @onclick="() => RemoveBullet(b)"><span class="bi bi-trash3" aria-hidden="true"></span></button>
                            </div>
                        }
                    </div>
                }
                @if (_canWrite)
                {
                    <div class="d-flex gap-2 mt-2 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_form.Bullets.Count >= Article.MaxBullets)" @onclick="AddBullet"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add a bullet</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _showPasteBullets = !_showPasteBullets"><span class="bi bi-list-ul" aria-hidden="true"></span> Paste several</button>
                    </div>
                    @if (_showPasteBullets)
                    {
                        <div class="mt-2">
                            <textarea class="form-control form-control-sm tide-autogrow tide-grow-3" rows="5" aria-label="Lines to turn into bullets" placeholder="One bullet per line. Leading -, * or • is dropped."
                                      @bind="_pasteBullets" @bind:event="oninput"></textarea>
                            <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="AddPastedBullets">Add as bullets</button>
                        </div>
                    }
                    <div class="form-text">Markdown works: **bold**, _italic_, `code`, [text](https://link). Bare addresses are never made into links.</div>
                }

                <h3 id="sec-shots" class="tide-subhead" tabindex="-1" @ref="_heads[ArticlePart.Screenshots]">Screenshots <span class="tide-count">(@_form.Screenshots.Count of @Article.MaxScreenshots)</span></h3>
                @if (_canWrite)
                {
                    <div id="shot-zone" class="tide-drop-zone">
                        <span class="bi bi-image fs-4 d-block" aria-hidden="true"></span>
                        Paste a screenshot (<span class="tide-data">Ctrl+V</span>) anywhere on this page, drop image files here, or
                        <label for="shot-input" class="btn btn-link btn-sm p-0 align-baseline">choose files</label>.
                        <div class="small">PNG, JPEG, GIF or WebP, up to @(Shots.MaxBytes / 1024 / 1024) MB each.@(_uploading ? " Uploading…" : "")</div>
                        <InputFile id="shot-input" class="d-none" multiple accept="image/png,image/jpeg,image/gif,image/webp" OnChange="OnFiles" />
                    </div>
                }
                @if (_form.Screenshots.Count > 0)
                {
                    <div class="tide-shots">
                        @foreach (var (s, i) in _form.Screenshots.Select((s, i) => (s, i)).ToList())
                        {
                            <div class="tide-shot" @key="s.Id">
                                <button type="button" class="tide-zoom" aria-label="Open screenshot @(i + 1)" @onclick="() => OpenShot(s)"><img src="@Ui.ImageUrl(s.FileId)" alt="@(s.Caption ?? "Screenshot " + (i + 1))" /></button>
                                <div class="tide-shot-body">
                                    <input id="f-caption-@i" class="form-control form-control-sm" placeholder="Caption" maxlength="500" aria-label="Caption for screenshot @(i + 1)"
                                           readonly="@(!_canWrite)" @bind="s.Caption" @bind:event="oninput" @bind:after="Touch" />
                                    <div class="d-flex gap-1">
                                        <TlpSelect Value="s.Tlp" ValueChanged="v => SetShotTlp(s, v)" Floor="_form.Tlp" Label="This screenshot's TLP" Disabled="@(!_canWrite)" />
                                        @if (_canWrite)
                                        {
                                            <button type="button" class="tide-icon-btn flex-shrink-0" title="Move earlier" aria-label="Move earlier" disabled="@(i == 0)" @onclick="() => MoveShot(i, -1)"><span class="bi bi-arrow-left" aria-hidden="true"></span></button>
                                            <button type="button" class="tide-icon-btn flex-shrink-0" title="Remove" aria-label="Remove screenshot @(i + 1)" @onclick="() => RemoveShot(s)"><span class="bi bi-trash3" aria-hidden="true"></span></button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <div class="tide-editor-pair">
            <section class="tide-card tide-section" aria-labelledby="sec-rec">
                <h2 id="sec-rec" tabindex="-1" @ref="_heads[ArticlePart.Recommended]">Recommended actions</h2>
                <MarkdownToolbar For="f-rec" Label="Recommended actions" Disabled="!_canWrite" />
                <textarea id="f-rec" class="form-control tide-autogrow tide-grow-3" rows="3" maxlength="8000" readonly="@(!_canWrite)" aria-label="Recommended actions"
                          placeholder="e.g. - Hunt for the indicators in the SIEM (last 30 days)  - Patch the affected systems" @bind="_form.RecommendedActions" @bind:event="oninput" @bind:after="Touch"></textarea>
            </section>

            <section class="tide-card tide-section" aria-labelledby="sec-ind">
                <h2 id="sec-ind" tabindex="-1" @ref="_heads[ArticlePart.Indicators]">Indicators <span class="tide-count">(@_form.Indicators.Count)</span> and CVEs <span class="tide-count">(@_form.Cves.Count)</span></h2>
                @if (_form.Indicators.Count > 0)
                {
                    <table class="tide-table tide-ind-table mb-2">
                        <thead><tr><th class="tide-col-md">Type</th><th>Value (shown defanged)</th><th class="tide-col-third">Note</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var ind in _form.Indicators.ToList())
                            {
                                <tr @key="ind">
                                    <td>
                                        <select class="form-select form-select-sm" aria-label="Type" disabled="@(!_canWrite)" value="@ind.Type" @onchange="e => SetIndicatorType(ind, e)">
                                            @foreach (var t in Ui.PickableIndicatorTypes)
                                            {
                                                <option value="@t">@Ui.IndicatorLabel(t)</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="tide-ioc">@IocObservable.Defang(ind.Type, ind.Value)
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1" title="Copy the live value" aria-label="Copy the live value" @onclick="() => Copy(ind.Value)"><span class="bi bi-clipboard" aria-hidden="true"></span></button>
                                    </td>
                                    <td><input class="form-control form-control-sm" maxlength="300" aria-label="Note" readonly="@(!_canWrite)" @bind="ind.Note" @bind:event="oninput" @bind:after="Touch" /></td>
                                    <td>@if (_canWrite) { <button type="button" class="tide-icon-btn" title="Remove" aria-label="Remove indicator @ind.Value" @onclick="() => RemoveIndicator(ind)"><span class="bi bi-trash3" aria-hidden="true"></span></button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (_form.Cves.Count > 0)
                {
                    <div class="mb-2">
                        @foreach (var c in _form.Cves.ToList())
                        {
                            <span class="tide-chip tide-data">
                                <a href="https://nvd.nist.gov/vuln/detail/@c" target="_blank" rel="noopener noreferrer">@c</a>
                                @if (_canWrite) { <button type="button" aria-label="Remove @c" @onclick="() => RemoveCve(c)"><span class="bi bi-x" aria-hidden="true"></span></button> }
                            </span>
                        }
                    </div>
                }
                @if (_canWrite)
                {
                    <IndicatorAdd @ref="_indicatorBox" Have="_form.Indicators" HaveCves="_form.Cves" Adding="AddIndicators" />
                }
            </section>
            </div>

            <HistoryPanel Id="_article.Id" Version="_article.EditVersion" />

            @if (_canWrite)
            {
                @* The save state first: what's saved, what saved by itself and when, or why it didn't. *@
                <div class="tide-sticky-save" role="region" aria-label="Save changes">
                    @if (_dirty)
                    {
                        <span class="tide-dirty"><span class="bi bi-dot" aria-hidden="true"></span>Unsaved changes</span>
                        @if (AutosaveNote is { } note)
                        {
                            <span class="tide-autosave tide-autosave-note @(_busy ? null : "is-held")" role="status">@note</span>
                        }
                        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="Discard">Discard</button>
                    }
                    else
                    {
                        <span class="tide-saved @(_autosavedAt is null ? null : "tide-autosave")" role="status" tabindex="-1" @ref="_savedNote"><span class="bi bi-check2" aria-hidden="true"></span> @(_autosavedAt is { } at ? $"Saved at {Ui.Time(Clock, at)}" : "All changes saved")</span>
                    }
                    <button type="button" class="btn btn-primary" disabled="@(_busy || !_dirty)" @onclick="Save"><span class="bi bi-check2" aria-hidden="true"></span> Save</button>
                    @if (_article.Status == ArticleStatus.Draft)
                    {
                        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="MarkReady">Save and mark ready</button>
                    }
                    else if (_article.Status == ArticleStatus.Ready)
                    {
                        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="BackToDraft">Back to draft</button>
                    }
                    @if (OnTodaysBrief)
                    {
                        <span class="tide-on-brief" tabindex="-1" @ref="_onBriefNote"><span class="bi bi-journal-check" aria-hidden="true"></span> On today's brief</span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="AddToTodaysBrief"><span class="bi bi-journal-plus" aria-hidden="true"></span> Add to today's brief</button>
                    }
                    @if (_article.Status == ArticleStatus.Draft && _briefDates.Count == 0)
                    {
                        <button type="button" class="btn btn-link text-danger ms-auto" disabled="@_busy" @onclick="Delete">Delete draft</button>
                    }
                </div>
            }
        </div>

        @* What readers get: in the context rail for someone who can edit, beside the form (docked from 1500px, over the
           page below that, and in place of the fields in a narrow window's Preview); for someone who can't, it's the page. *@
        @if (Aside is not null)
        {
            var state = new State(_article, _form, checks, _briefDates, _dirty, _canWrite);
            if (_canWrite)
            {
                <ContextRail Title="@RailTitle">@Aside(state)</ContextRail>
            }
            else
            {
                <aside class="tide-editor-side">@Aside(state)</aside>
            }
        }
    </div>

    @* Out here, not inside a card: a sticky or contained box makes its own stacking context, which would put the top bar over it. *@
    @if (_techniquesOpen)
    {
        <AttackMatrixPicker Current="_form.TechniqueIds" OnApply="ApplyTechniques" OnCancel="() => _techniquesOpen = false" />
    }

    <ScreenshotDialog Set="ShotSet" @bind-Open="_shot" />
}

<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>The article to edit.</summary>
    [Parameter, EditorRequired] public Guid Id { get; set; }

    /// <summary>The right rail, drawn beside the fields from the editor's state as it is on screen.</summary>
    [Parameter] public RenderFragment<State>? Aside { get; set; }

    /// <summary>The pane to open on in a narrow window, where the editor and the aside take turns (the aside's, for a
    /// tab beside the article the address asked for).</summary>
    [Parameter] public string? StartPane { get; set; }

    /// <summary>The way through today's brief (BriefStepper), shown in place of the breadcrumbs while the article is on it.</summary>
    [Parameter] public RenderFragment? Stepper { get; set; }

    /// <summary>
    /// The form as it is on screen, saved or not: fired once the article loads (or reloads) and after every edit, for a
    /// pane that follows the article as it's typed. The same instance each time until a reload replaces it.
    /// </summary>
    [Parameter] public EventCallback<ArticleForm> OnFormChanged { get; set; }

    /// <summary>What the rail is drawn from: the saved article, the form on screen, its checks, the briefs it's on, whether
    /// the form has unsaved changes, and whether the person can edit it (for a check's one-click fix).</summary>
    public sealed record State(Article Article, ArticleForm Form, IReadOnlyList<ArticleCheck> Checks, IReadOnlyList<DateOnly> BriefDates, bool Dirty,
        bool CanWrite = false);

    /// <summary>The context rail's name, for its heading and for screen readers.</summary>
    internal const string RailTitle = "Context · what readers get";

    // The section index: each section in the order the cards run, saying where it stands. Screenshots has none: it's
    // part of the Bullets card.
    private List<EditorSectionIndex.Item> IndexItems(IReadOnlyList<ArticleCheck> checks, ArticleCheck? why)
    {
        var f = _form!;
        EditorSectionIndex.Item Item(ArticlePart part, string label, string? state, EditorSectionIndex.Kind kind = EditorSectionIndex.Kind.Count) =>
            checks.Any(c => c.Part == part) ? new(part, label, "Needed", EditorSectionIndex.Kind.Needed)
            : new(part, label, state, kind);
        static string? Count(int n) => n > 0 ? n.ToString() : null;
        static string? Pair(int a, int b) => a + b > 0 ? $"{a} · {b}" : null;
        const EditorSectionIndex.Kind Done = EditorSectionIndex.Kind.Done;
        return
        [
            Item(ArticlePart.Assessment, "Assessment", "✓", Done),
            Item(ArticlePart.BottomLine, "Bottom line", "✓", Done),
            Item(ArticlePart.Bullets, "Bullets", Count(f.Bullets.Count(b => !string.IsNullOrWhiteSpace(b.Text)))),
            why is not null ? new(ArticlePart.WhyItMatters, "Why it matters", "check TLP", EditorSectionIndex.Kind.Warn)
                : Item(ArticlePart.WhyItMatters, "Why it matters", string.IsNullOrWhiteSpace(f.WhyItMatters) ? null : "✓", Done),
            Item(ArticlePart.Recommended, "Recommended", Count(RecommendedActions.Lines(f.RecommendedActions).Count)),
            Item(ArticlePart.Indicators, "Indicators & CVEs", Pair(f.Indicators.Count, f.Cves.Count)),
            Item(ArticlePart.Tags, "Tags & ATT&CK", Pair(f.TagIds.Count, f.TechniqueIds.Count)),
        ];
    }

    /// <summary>
    /// Takes you to a part of the article, as its item in the section index does: focus moves to its heading, scrolled
    /// to the top. For a readiness gap shown elsewhere, by its
    /// <see cref="ArticleCheck.Part"/>. It happens once the editor has drawn (so an opened section is there to scroll to).
    /// </summary>
    public Task FocusAsync(ArticlePart part) => Jump(part, null);

    /// <summary>
    /// Takes you to the field a readiness gap in <paramref name="part"/> is fixed in, for a placeholder in the preview:
    /// the bottom line, why it matters or the recommended actions box; the first empty bullet (one added, when there's
    /// none and there's room); the first screenshot without a caption; the priority a threat lacks, or else the source.
    /// Parts with no one field (Tags &amp; ATT&amp;CK) go to their heading, as <see cref="FocusAsync"/> does.
    /// On a narrow screen showing the preview, the editor is shown first.
    /// </summary>
    public async Task FocusFieldAsync(ArticlePart part)
    {
        if (_form is null) return;
        if (part == ArticlePart.Bullets && _canWrite && _form.Bullets.Count < Article.MaxBullets && !_form.Bullets.Exists(b => string.IsNullOrWhiteSpace(b.Text)))
            await AddBullet();
        await Jump(part, FieldId(part));
    }

    // The id of the field for a part, as drawn above; null where the heading is the place to go.
    internal string? FieldId(ArticlePart part) => part switch
    {
        ArticlePart.BottomLine => "f-bluf",
        ArticlePart.WhyItMatters => "f-why",
        ArticlePart.Recommended => "f-rec",
        ArticlePart.Bullets when _form!.Bullets.FindIndex(b => string.IsNullOrWhiteSpace(b.Text)) is var i and >= 0 => $"f-bullet-{i}",
        ArticlePart.Screenshots when _form!.Screenshots.FindIndex(s => string.IsNullOrWhiteSpace(s.Caption)) is var i and >= 0 => $"f-caption-{i}",
        ArticlePart.Assessment when _form!.Classification == Classification.Threat && _form.Priority is null => "prio",
        ArticlePart.Assessment => "src",
        _ => null,
    };

    private Task Jump(ArticlePart part, string? field)
    {
        _pane = EditPane;
        _jumpTo = (part, field);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private (ArticlePart Part, string? Field)? _jumpTo;

    private async Task JumpAsync()
    {
        var (part, field) = _jumpTo!.Value;
        _jumpTo = null;
        if (!_heads.TryGetValue(part, out var head)) return;
        try { await JS.InvokeVoidAsync("tideEditor.jump", head, field); }
        catch (JSDisconnectedException) { /* the tab has gone */ }
    }

    // At 900px or narrower, which of the two is shown: the fields or what readers get. Wider, the rail shows it beside
    // the fields (or over them, when asked for), and the switch is hidden.
    internal const string EditPane = "edit", PreviewPane = "preview";
    private string _pane = EditPane;

    internal void ShowPane(string? pane)
    {
        _pane = pane == PreviewPane ? PreviewPane : EditPane;
        StateHasChanged();
    }

    private ConfirmDialog _confirm = default!;
    private UnsavedGuard _guard = default!;

    /// <summary>The unsaved-changes question, for a test to answer as a click would.</summary>
    internal LeaveDialog Leave => _guard.Leave;
    private readonly Dictionary<ArticlePart, ElementReference> _heads = [];
    private Guid? _loadedId;

    private Article? _article;
    private ArticleForm? _form;
    private IReadOnlyList<ScorecardCategory> _categories = [];
    private List<DateOnly> _briefDates = [];

    // In today's running order: the stepper shows, and the bar says so in place of "Add to today's brief".
    private bool OnTodaysBrief => _briefDates.Contains(Briefs.CurrentDate);
    private bool _notFound, _dirty, _busy, _uploading, _canWrite, _showPasteBullets;
    private string? _pasteBullets;
    // The screenshot open in the dialog; it steps through the article's others, captioned if they have one.
    private ScreenshotDialog.Shot? _shot;

    private IReadOnlyList<ScreenshotDialog.Shot> ShotSet =>
        _form?.Screenshots.Select(s => new ScreenshotDialog.Shot(s.FileId, s.Caption?.Trim() ?? "")).ToList() ?? [];

    private void OpenShot(ScreenshotForm s) => _shot = ShotSet.FirstOrDefault(x => x.FileId == s.FileId);
    private bool _registered;
    private string? _excerpt;
    private IReadOnlyList<ArticleLink> _links = [];

    // "Add a report link": the form's fields, the reason the last address was refused, and where focus goes next.
    private bool _addingLink, _focusLinkUrl, _focusAddLink;
    private string? _linkUrl, _linkSource, _linkError;
    private ElementReference _linkUrlInput, _addLinkButton;

    private void OpenAddLink() => (_addingLink, _linkUrl, _linkSource, _linkError, _focusLinkUrl) = (true, null, null, null, true);

    private void CancelLink() => (_addingLink, _linkError, _focusAddLink) = (false, null, true);

    internal async Task AddLink()
    {
        try
        {
            await ArticleSvc.AddLinkAsync(Id, _linkUrl, _linkSource);
            _links = await ArticleSvc.LinksAsync(Id);
            (_addingLink, _linkError, _focusAddLink) = (false, null, true);
            Toasts.Show("Report added.");
        }
        catch (ArgumentException ex)
        {
            _linkError = ex.Message;
            _focusLinkUrl = true;
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    /// <summary>
    /// Adds <paramref name="text"/> to why it matters, on a line of its own ("Mention", from We run under it or from
    /// Similar articles in the rail), and takes you there. Unsaved, like any edit.
    /// </summary>
    public Task MentionAsync(string text)
    {
        if (_form is null || !_canWrite) return Task.CompletedTask;
        var why = _form.WhyItMatters?.TrimEnd() ?? "";
        _form.WhyItMatters = why.Length == 0 ? text : why + "\n" + text;
        _pane = EditPane;
        _jumpTo = (ArticlePart.WhyItMatters, FieldId(ArticlePart.WhyItMatters));
        var touched = Touch();
        StateHasChanged();
        return touched;
    }

    private async Task RemoveLink(ArticleLink l)
    {
        try
        {
            await ArticleSvc.RemoveLinkAsync(l.Id);
            _links = await ArticleSvc.LinksAsync(Id);
        }
        catch (Exception ex) { Toasts.Error(UserFacingError.For(ex)); }
    }

    // Copies the publisher's excerpt in as a starting point, on purpose: the analyst rewrites it from there.
    private Task StartFromExcerpt()
    {
        _form!.Bluf = _excerpt!.Length > 600 ? _excerpt[..599] + "…" : _excerpt;
        return Touch();
    }

    // A colleague's save: re-read when nothing here is unsaved; otherwise keep the draft and say so (ChangedElsewhere).
    private LiveChanges? _live;
    private volatile string _topic = "";
    private string? _changedBy;

    protected override void OnInitialized()
    {
        _live = new LiveChanges(Feed, Origin, c => c.Topic == _topic, InvokeAsync, OnChangedElsewhere);
        if (StartPane == PreviewPane) _pane = PreviewPane;
    }

    private async Task OnChangedElsewhere(IReadOnlyList<Change> changes)
    {
        var who = LiveChanges.Who(changes);
        if (_dirty || _busy || _uploading)
        {
            _changedBy = who;
        }
        else
        {
            await Reload();
            Toasts.Show($"{who} updated this article.");
        }
        StateHasChanged();
    }

    private async Task ReloadTheirs()
    {
        await Reload();
        Toasts.Show("Reloaded. Your unsaved changes were dropped.");
    }

    public void Dispose()
    {
        _live?.Dispose();
        _autosavePause.Now();   // a pause still running saves nothing once the editor has gone
        _disposed = true;
    }

    // Loads when the article changes, not whenever the page around it redraws, which would drop what's being typed.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        _topic = ChangeFeed.Article(Id);
        _canWrite = CurrentUser.Has(Permission.WriteArticles);
        // The first interactive draw starts from what the prerender read, so a reload doesn't flash "Loading" over the
        // article. It's read again below, quietly, keeping anything typed in between, only if something was saved since.
        var adopted = Handoff.Take<ArticleEditorPanel>(RendererInfo, PrerenderedState, out var current) is { } prerendered
            && prerendered.Id == Id && Adopt(prerendered);
        if (adopted && current) await OnFormChanged.InvokeAsync(_form);
        else
        {
            _categories = await Scorecard.ListAsync();
            (_publicMax, _) = await Distribution.GetAsync();
            await Reload(keepEdits: adopted);
        }
        if (_article is not null) PrerenderedState = Handoff.Keep(RendererInfo, this, PrerenderedState);
    }

    /// <summary>The key the prerender kept what it read under (<see cref="PrerenderHandoff"/>), for the interactive draw.</summary>
    [PersistentState]
    public string? PrerenderedState { get; set; }

    // Takes what the prerendered editor read: the saved article and the form made from it, edit version and all, and what
    // the fields and the bar draw from. True, to say there's an article on screen to keep while it's read again.
    private bool Adopt(ArticleEditorPanel p)
    {
        (_article, _form, _categories, _briefDates, _whyHint) = (p._article, p._form, p._categories, p._briefDates, p._whyHint);
        (_excerpt, _links, _rules, _notFound, _publicMax) = (p._excerpt, p._links, p._rules, p._notFound, p._publicMax);
        return _form is not null;
    }

    // keepEdits: the form on screen was the prerender's, and anything typed into it since stays, as a save in progress
    // does; its edit version stays too, so if someone saved in between, saving it is refused as stale (and the banner
    // says so) rather than overwriting theirs.
    private async Task Reload(bool keepEdits = false)
    {
        var article = await ArticleSvc.GetAsync(Id);
        // Set each time: the page stays open from one article to the next (Ctrl+K, the stepper), missing or not.
        _notFound = article is null;
        _article = article;
        if (article is null) return;
        if (keepEdits && (_dirty || _busy || _uploading))
        {
            if (article.EditVersion != _form!.EditVersion) _changedBy ??= "Someone else";
        }
        else
        {
            _form = ArticleForm.From(article);
            // A draft promoted as a threat arrives with "why it matters" at the AMBER default; say so the first time.
            _whyHint = _form.WhyItMattersAtThreatDefault;
            _dirty = false;
            _changedBy = null;
            (_autosaveNote, _autosavedAt) = (null, null);
        }
        _briefDates = (await ArticleSvc.BriefDatesAsync(Id)).ToList();
        _excerpt = await ArticleSvc.SourceExcerptAsync(Id);
        _links = await ArticleSvc.LinksAsync(Id);
        await LoadRules();
        await OnFormChanged.InvokeAsync(_form);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_jumpTo is not null) await JumpAsync();
        if (_focusSaved)
        {
            _focusSaved = false;
            try { await _savedNote.FocusAsync(preventScroll: true); }
            catch (JSDisconnectedException) { /* the tab has gone */ }
        }
        if (_focusLinkUrl || _focusAddLink)
        {
            var target = _focusLinkUrl ? _linkUrlInput : _addLinkButton;
            (_focusLinkUrl, _focusAddLink) = (false, false);
            try { await target.FocusAsync(); }
            catch (JSDisconnectedException) { /* the tab has gone */ }
        }
        if (_focusOnBrief)
        {
            _focusOnBrief = false;
            try { await _onBriefNote.FocusAsync(preventScroll: true); }
            catch (JSDisconnectedException) { /* the tab has gone */ }
        }
        if (_registered || _form is null || !_canWrite) return;
        _registered = true;
        try { await JS.InvokeVoidAsync("tidePasteDrop.register", "shot-zone", "shot-input", "shot-input", false); }
        catch (JSDisconnectedException) { }
    }

    // Counts edits, so a save knows whether more were typed while it ran (the fields stay open meanwhile).
    private int _edits;

    private Task Touch()
    {
        _dirty = true;
        _edits++;
        ScheduleAutosave();
        return OnFormChanged.InvokeAsync(_form);
    }

    /// <summary>How long typing pauses before the form is autosaved.</summary>
    internal static readonly TimeSpan AutosavePause = TimeSpan.FromSeconds(2);

    // Autosave: the pause (each edit starts it again; Save and leaving supersede it), what the bar says about it while
    // something is unsaved ("Saving…", or why it held off), and when it last saved. A colleague's save heard, or refused
    // as stale, stops it (_changedBy) until the article is reloaded.
    private readonly TypingPause _autosavePause = new((int)AutosavePause.TotalMilliseconds);
    private string? _autosaveNote;
    private DateTimeOffset? _autosavedAt;
    private bool _disposed;

    // What the bar says of autosave while something is unsaved: a colleague's save, heard or refused as stale, first,
    // since it stops autosave; else "Saving…" or why it held off.
    private string? AutosaveNote => _changedBy is { } who
        ? $"Not saved automatically: {who} saved this article. What you typed is still here."
        : _autosaveNote;

    private void ScheduleAutosave()
    {
        if (!_canWrite || _changedBy is not null) return;
        _ = AutosaveAfterPause();
    }

    private async Task AutosaveAfterPause()
    {
        if (await _autosavePause.Settled() && !_disposed) await InvokeAsync(AutosaveNowAsync);
    }

    /// <summary>
    /// Saves the form now, as the pause in typing does: through <see cref="ArticleService.AutosaveAsync"/>, which checks
    /// who may, the edit version (a colleague's save meanwhile stops autosave for this article until it's reloaded, and
    /// what was typed stays), and holds off for a changed marking, a part newly reaching everyone or a sent brief, all of
    /// which wait for Save. Nothing happens for someone who can't edit, with nothing unsaved, while another save runs, or
    /// once a colleague's save has been heard (the banner offers to reload).
    /// </summary>
    internal async Task AutosaveNowAsync()
    {
        if (_form is null || !_canWrite || !_dirty || _busy || _uploading || _changedBy is not null) return;
        _busy = true;
        var edits = _edits;
        _autosaveNote = "Saving…";
        StateHasChanged();
        var saved = false;
        try
        {
            var result = await ArticleSvc.AutosaveAsync(_form);
            if (result.EditVersion is { } version)
            {
                saved = true;
                await Saved(version, edits, DateTimeOffset.UtcNow);
            }
            else _autosaveNote = result.Hold == AutosaveHold.SentBrief
                ? "On a sent brief, so not saved automatically: Save to correct it."
                : "A marking changed, or something now reaches everyone: Save to keep it.";
        }
        catch (StaleEditException) { _changedBy ??= "Someone else"; }
        catch (Exception ex) { _autosaveNote = $"Not saved automatically: {UserFacingError.For(ex)}"; }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
        if (saved && _dirty) ScheduleAutosave();
    }

    // Unsaved changes dropped on purpose, after asking: the saved article is read again.
    private async Task Discard()
    {
        if (!await _confirm.Ask("Discard your changes?", "Everything you've changed since the last save is dropped, and the saved article is loaded again. Screenshots you added stay: they're saved as they're added.", "Discard changes")) return;
        await Reload();
        Toasts.Show("Changes discarded.");
        _focusSaved = true;   // the Discard button that asked has gone: focus lands on "All changes saved" instead
    }

    private ElementReference _savedNote, _onBriefNote;
    private bool _focusSaved, _focusOnBrief;

    /// <summary>Shows "internal context starts at AMBER" beside the "why it matters" TLP, from when the threat default
    /// applied until the writer moves the TLP.</summary>
    private bool _whyHint;

    private bool _techniquesOpen;

    private async Task ApplyTechniques(IReadOnlyList<string> ids)
    {
        _techniquesOpen = false;
        if (ids.ToHashSet(StringComparer.OrdinalIgnoreCase).SetEquals(_form!.TechniqueIds)) return;
        _form.TechniqueIds = ids.ToList();
        await LoadRules();
        await Touch();
    }

    // EP-79: how many of the SOC's current rules are tagged with each technique, for analysts; null until rules are imported.
    private IReadOnlyDictionary<string, Tide.Application.Detections.TechniqueRules>? _rules;

    private async Task LoadRules() =>
        _rules = _canWrite && _form is { TechniqueIds.Count: > 0 } f ? await Detections.ForTechniquesAsync(f.TechniqueIds) : null;

    // The tagged techniques by tactic in matrix order, as the picker lays them out; ids no longer in the catalog go last.
    private IEnumerable<string> TechniquesInMatrixOrder() => AttackMatrix.InMatrixOrder(_form!.TechniqueIds);

    private Task RemoveTechnique(string id)
    {
        _form!.TechniqueIds.RemoveAll(s => string.Equals(s, id, StringComparison.OrdinalIgnoreCase));
        return Touch();
    }

    // The readiness checks, and apart from them the running order's warning on "Why it matters" (a threat's paragraph the
    // company-wide edition would carry, not yet kept as it is): both on what's on screen, saved or not. The paragraph is
    // trimmed as a save stores it, so a "Keep it" fingerprint matches the text it was kept for.
    private (IReadOnlyList<ArticleCheck> Checks, ArticleCheck? Why) Checks()
    {
        var a = new Article
        {
            Title = _form!.Title, Bluf = _form.Bluf, Classification = _form.Classification, Priority = _form.Priority,
            RecommendedActions = _form.RecommendedActions, SourceName = _form.SourceName, SourceUrl = _form.SourceUrl,
            Tlp = _form.Tlp, WhyItMatters = _form.WhyItMatters?.Trim() is { Length: > 0 } why ? why : null, WhyItMattersTlp = _form.WhyItMattersTlp,
            WhyItMattersKeptHash = _form.WhyItMattersKeptHash,
        };
        a.Bullets.AddRange(_form.Bullets.Select(b => new ArticleBullet { Text = b.Text }));
        a.Tags.AddRange(_form.TagIds.Select(t => new ArticleTag { TagId = t }));
        a.Screenshots.AddRange(_form.Screenshots.Select(s => new ArticleScreenshot { Caption = s.Caption }));
        return (ArticleChecks.For(a), ArticleChecks.WhyReachesCompany(a, _publicMax));
    }

