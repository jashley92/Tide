@* The day's numbers: the opening metrics as one fast form, grouped, tabbing through the boxes. Each box saves when
   it changes; the value it's compared with (the previous business day that has one, named by its date when that isn't
   the day before) is beside it before today's is typed, and the change once it is. A blank box clears the value (a
   missing value is shown as a dash, never as 0); one that isn't a number is marked on the box, with why under it.
   Once the day's brief is sent the numbers are fixed (an administrator can still correct them), and a box whose typing
   hadn't saved yet says so in a toast, with what was typed.
   Collapsible folds the boxes away behind the heading (open while numbers are missing); MissingChanged hears how many
   are missing whenever that changes, for the brief's step strip and its Mark ready confirmation.
   A colleague's save to the day's numbers re-reads them in place (LiveChanges, naming them in a toast), so the step
   strip and the edition check follow too. A box being typed in, or holding something that isn't a number, keeps what's
   in it, and its row says they changed it.
   With many groups the form says where you are: a bar that stays in view under the page's own header, with the overall
   count and a chip per group (filled of total, a tick when done, highlighted while a box in it has focus; clicking one
   jumps to its first empty box). Each group is a panel of its own with its count, and one whose numbers are all in
   folds to a line of its values once you move on from it (MetricEntryProgress says when). *@
@using System.Globalization
@using Tide.Application.Metrics
@inject MetricsService MetricsSvc
@inject ICurrentUser CurrentUser
@inject ToastService Toasts
@inject OrgClock Clock
@inject ChangeFeed Feed
@inject ChangeOrigin Origin
@implements IDisposable

@if (_day is { Any: true })
{
    <div class="tide-card" id="@_id">
        @if (Collapsible)
        {
            <h2>
                <button type="button" class="tide-collapse-btn" aria-expanded="@(Open ? "true" : "false")" aria-controls="@(_id + "-body")" @onclick="() => _open = !Open">
                    <span class="bi @(Open ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span> @Heading
                </button>
                @if (!Open)
                {
                    <span class="small fw-normal @(_day.Missing.Count > 0 ? "tide-warn-text" : "tide-muted")">@Summary</span>
                }
                <a class="ms-auto small fw-normal" href="metrics">History</a>
            </h2>
        }
        else
        {
            <h2>@Heading <a class="ms-auto small fw-normal" href="metrics">History</a></h2>
        }
        <div id="@(_id + "-body")" hidden="@(!Open)">
        @if (_locked)
        {
            <p class="tide-muted small mb-2"><span class="bi bi-lock" aria-hidden="true"></span>
                @(_notSent ? "This day's brief was finished without sending, so its numbers are fixed." : "The brief for this day has been sent, so these are the numbers that went out.")
                An administrator can correct them.</p>
        }
        @if (_day.Missing.Count > 0)
        {
            <div class="tide-missing mb-2"><span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                @_day.Missing.Count metric@(_day.Missing.Count == 1 ? " has" : "s have") no value for this day.</div>
        }
        @* Where you are: the overall count and a chip per group, kept in view while the form scrolls. *@
        <div class="tide-mentry-bar">
            <div class="tide-mentry-overall">
                <span class="fw-semibold">@_progress.Summary</span>
                <progress class="tide-mentry-meter" value="@_progress.Entered" max="@Math.Max(1, _progress.Total)" aria-hidden="true"></progress>
            </div>
            <div class="tide-mentry-chips">
                @foreach (var p in _progress.Groups)
                {
                    var current = _lastGroup == p.GroupId;
                    var css = "tide-mentry-chip" + (p.Complete ? " is-done" : "") + (current ? " is-current" : "");
                    if (_canEdit)
                    {
                        <button type="button" class="@css" aria-label="@p.AccessibleName" aria-current="@(current ? "true" : null)"
                                aria-controls="@GroupDomId(p.GroupId)" @onclick="() => Jump(p.GroupId)">
                            @p.Name <span class="tide-mentry-chip-count">@p.Entered/@p.Total</span>
                            @if (p.Complete) { <span class="bi bi-check-lg" aria-hidden="true"></span> }
                        </button>
                    }
                    else
                    {
                        <span class="@css"><span aria-hidden="true">@p.Name <span class="tide-mentry-chip-count">@p.Entered/@p.Total</span></span><span class="visually-hidden">@p.AccessibleName</span>
                            @if (p.Complete) { <span class="bi bi-check-lg" aria-hidden="true"></span> }
                        </span>
                    }
                }
            </div>
        </div>
        @foreach (var g in _day.Groups)
        {
            var gid = g.Group.Id;
            var dom = GroupDomId(gid);
            var count = _progress.Groups.FirstOrDefault(p => p.GroupId == gid);
            var folded = _canEdit && _progress.IsFolded(gid);
            var toggles = _canEdit && (folded || _progress.Foldable(gid));
            var panel = "tide-mentry-group" + (folded ? " is-folded" : "") + (_lastGroup == gid ? " is-current" : "");
            <section class="@panel" id="@dom" aria-labelledby="@(dom + "-h")" @key="gid">
                <h3 class="tide-mentry-group-head">
                    @if (toggles)
                    {
                        <button type="button" class="tide-collapse-btn" id="@(dom + "-h")" aria-expanded="@(folded ? "false" : "true")" aria-controls="@(dom + "-rows")" @onclick="() => Toggle(gid)">
                            <span class="bi @(folded ? "bi-chevron-right" : "bi-chevron-down")" aria-hidden="true"></span> @g.Group.Name
                        </button>
                    }
                    else
                    {
                        <span id="@(dom + "-h")">@g.Group.Name</span>
                    }
                    @if (count is not null)
                    {
                        <span class="tide-mentry-group-count @(count.Complete ? "is-done" : "")">@count.Count @if (count.Complete) { <span class="bi bi-check-lg" aria-hidden="true"></span> }</span>
                    }
                </h3>
                <div id="@(dom + "-rows")">
                @if (folded)
                {
                    @* Finished: one line of its values (and level marks). *@
                    <ul class="tide-mentry-folded">
                        @foreach (var t in g.Tiles)
                        {
                            <li @key="t.Metric.Id"><span class="tide-mentry-folded-name">@t.Metric.Name</span> <span class="tide-table-num fw-semibold @LevelClass(t)">@t.Display<LevelMark Level="t.Level" /></span></li>
                        }
                    </ul>
                }
                else
                {
                    @foreach (var t in g.Tiles)
                    {
                        var id = "metric-" + t.Metric.Id.ToString("N");
                        var bad = _invalid.GetValueOrDefault(t.Metric.Id);
                        <div class="tide-metric-row" @key="t.Metric.Id">
                            <label for="@id">@t.Metric.Name@(Unit(t.Metric.Format))</label>
                            @if (_canEdit)
                            {
                                <div>
                                    <div class="d-flex align-items-center">
                                        <input id="@id" @ref="_boxes[t.Metric.Id]" class="form-control form-control-sm tide-metric-value @LevelClass(t) @(bad is null ? "" : "is-invalid")" inputmode="decimal" autocomplete="off"
                                               value="@(bad ?? Shown(t.Metric.Id, false, Raw(t.Value)))" aria-invalid="@(bad is null ? null : "true")" aria-describedby="@(bad is null ? null : id + "-error")"
                                               @onchange="e => SaveValue(t, e.Value?.ToString())" @onfocus="() => Entering(t.Metric.Id, false)" @onblur="() => Left(t.Metric.Id, false)" />
                                        <LevelMark Level="t.Level" />
                                        @if (t.ImportedFrom is { } from)
                                        {
                                            <span class="bi bi-file-earmark-arrow-down tide-muted ms-1" title="@from" role="img" aria-label="@from"></span>
                                        }
                                    </div>
                                    @if (bad is not null)
                                    {
                                        <div id="@(id + "-error")" class="tide-metric-error">Not a number.</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="tide-table-num fw-semibold @LevelClass(t)">@t.Display<LevelMark Level="t.Level" /></span>
                            }
                            <span class="tide-metric-prev">
                                @if (t.Reference is { } r)
                                {
                                    @* A chip of its own, so the value to compare with doesn't read as part of the row's text. *@
                                    <span class="tide-metric-ref" title="@r.Date.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)"><span class="visually-hidden">Last value, </span><span class="tide-metric-ref-date">@MetricMath.ReferenceLabel(r.Date, Date, Clock.Days)</span><span class="tide-metric-ref-value">@MetricMath.Format(t.Metric.Format, r.Value)</span></span>
                                    @if (t.Previous is not null)
                                    {
                                        <text> &middot; </text><MetricChange Tile="t" ShowDate="false" />
                                    }
                                }
                                else
                                {
                                    <MetricChange Tile="t" />
                                }
                            </span>
                            @if (_canEdit)
                            {
                                <input class="form-control form-control-sm tide-metric-note" placeholder="Note (optional)" maxlength="300" aria-label="Note for @t.Metric.Name"
                                       value="@Shown(t.Metric.Id, true, t.Note)" @onchange="e => SaveNote(t, e.Value?.ToString())"
                                       @onfocus="() => Entering(t.Metric.Id, true)" @onblur="() => Left(t.Metric.Id, true)" />
                            }
                            else
                            {
                                <span class="small tide-muted">@t.Note</span>
                            }
                            @if (_elsewhere.GetValueOrDefault(t.Metric.Id) is { } by)
                            {
                                <div class="tide-metric-elsewhere" role="status"><span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
                                    @by changed @t.Metric.Name while you were editing it (now @t.Display). What you typed is still in the box; saving it replaces theirs.</div>
                            }
                        </div>
                    }
                }
                </div>
            </section>
        }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }

    /// <summary>The heading folds the boxes away (open to begin with only while a number is missing).</summary>
    [Parameter] public bool Collapsible { get; set; }

    /// <summary>How many of the day's numbers are missing, each time that changes.</summary>
    [Parameter] public EventCallback<int> MissingChanged { get; set; }

    private readonly string _id = "numbers-" + Guid.NewGuid().ToString("N")[..8];
    private MetricDay? _day;
    private bool _canEdit, _locked, _notSent;
    private bool? _open;
    private int? _reported;

    // What was typed in a box that isn't a number, by metric, until the box holds one (or is cleared).
    private readonly Dictionary<Guid, string> _invalid = [];

    // The box being typed in (a metric's value, or its note), as the browser's focus says.
    private (Guid Metric, bool Note)? _focus;

    // What a box went on showing when a colleague's save re-read the day while it was being typed in, so the re-render
    // doesn't overwrite the typing; dropped when the box is left or saved.
    private readonly Dictionary<(Guid Metric, bool Note), string?> _kept = [];

    // Who changed a metric's value or note while it was being edited here, by metric.
    private readonly Dictionary<Guid, string> _elsewhere = [];

    // Metrics a colleague changed while being edited here, pulled in by a re-read of this form's own (after its save, or
    // the page around it re-rendering) before their change was heard: the box kept its text, and the row names them
    // once their change arrives.
    private readonly HashSet<Guid> _unnamed = [];

    // What this form has asked to be saved for a metric on a day and not yet heard back from: its value and note together,
    // so a note typed while the value is still saving (or a value while its note is) keeps the other.
    private readonly Dictionary<(DateOnly Day, Guid Metric), (decimal? Value, string? Note)> _pending = [];

    // One save or re-read at a time, in the order they came (InTurn): on a slower database a re-read that started before
    // a save could otherwise land after it, and two saves of one metric could land out of order.
    private Task _turn = Task.CompletedTask;

    // The counts for the bar and the panels, and which finished groups are folded (for the date they were read for).
    private MetricEntryProgress _progress = new();
    private DateOnly? _progressFor;

    // The group of the box last focused: its chip is highlighted, and moving on to another group folds it if it's done.
    private Guid? _lastGroup;

    // A box to focus once the form has rendered (a chip's jump, or a group unfolded), and the boxes by metric.
    private Guid? _focusNext;
    private readonly Dictionary<Guid, ElementReference> _boxes = [];

    private LiveChanges? _live;
    private volatile string _topic = "";

    private string Heading => Date == Clock.CurrentBriefDate ? "Today's numbers" : "Numbers for " + Ui.ShortDay(Date);

    // Settled on the first read, so entering the last missing number doesn't fold the boxes away mid-entry.
    private bool Open => !Collapsible || _open == true;

    private string Summary => _day?.Missing.Count is > 0 and var n
        ? Tide.Application.Briefs.BriefSteps.Numbers(n) + " not entered"
        : "All entered";

    // Told only when the count changes, so a parent that re-renders on hearing it doesn't hear it again.
    private async Task Report()
    {
        if (_day is not { Any: true }) return;   // no metrics kept: nothing to be missing
        var missing = _day.Missing.Count;
        if (_reported == missing) return;
        _reported = missing;
        await MissingChanged.InvokeAsync(missing);
    }

    protected override void OnInitialized() =>
        _live = new LiveChanges(Feed, Origin, c => c.Topic == _topic || c.Topic == ChangeFeed.Metrics, InvokeAsync, OnChangedElsewhere);

    public void Dispose() => _live?.Dispose();

    protected override Task OnParametersSetAsync() => InTurn(async () =>
    {
        _topic = ChangeFeed.MetricsDay(Date);
        if (_progressFor is { } was && was != Date)
        {
            // Another day (the brief page's previous and next links keep this form): what was typed, kept or flagged
            // for the last day's boxes isn't this day's, and whether it starts open is settled again.
            _invalid.Clear();
            _kept.Clear();
            _elsewhere.Clear();
            _unnamed.Clear();
            _open = null;
        }
        await Reread(null);
        _open ??= _day!.Missing.Count > 0;
        if (_progressFor != Date) (_progress, _progressFor, _lastGroup) = (new MetricEntryProgress(), Date, null);
        Recount();
        await Report();
    });

    // Runs work once every save and re-read already asked for has finished (each runs in its own turn).
    private async Task InTurn(Func<Task> work)
    {
        var before = _turn;
        var mine = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _turn = mine.Task;
        try
        {
            await before;
            await work();
        }
        finally { mine.SetResult(); }
    }

    // Reads the lock and the day again. On the same day, a box being typed in (other than the metric this form has just
    // saved, own) or holding what isn't a number keeps its text when what's saved for it changed, and its row says who
    // changed it: who, or (on a re-read of this form's own) whoever's change is heard next. Once the numbers are fixed
    // the boxes are gone, and so is what they kept: a box whose typing hadn't saved says so (Lost).
    private async Task Reread(string? who, Guid? own = null)
    {
        var before = _progressFor == Date ? Tiles(_day) : null;
        var wasEditable = _canEdit;
        _locked = await MetricsSvc.IsLockedAsync(Date);
        _notSent = _locked && await MetricsSvc.FinishedNotSentAsync(Date);
        _canEdit = CurrentUser.Has(Permission.EnterMetrics) && !_locked;
        _day = await MetricsSvc.GetDayAsync(Date);
        if (!_canEdit)
        {
            if (wasEditable && _locked && before is not null) Lost(before);
            _focus = null;
            _kept.Clear();
            _elsewhere.Clear();
            _unnamed.Clear();
            return;
        }
        if (before is null) return;
        var after = Tiles(_day);
        HashSet<Guid> held = [.. _invalid.Keys];
        if (_focus is { } f && f.Metric != own)
        {
            held.Add(f.Metric);
            if (!_kept.ContainsKey(f) && before.TryGetValue(f.Metric, out var shown) && Changed(shown, after.GetValueOrDefault(f.Metric)))
                _kept[f] = f.Note ? shown.Note : Raw(shown.Value);
        }
        foreach (var id in held.Where(id => id != own))
        {
            var changed = Changed(before.GetValueOrDefault(id), after.GetValueOrDefault(id));
            if (who is null)
            {
                if (changed) _unnamed.Add(id);
            }
            else if (_unnamed.Remove(id) || changed) _elsewhere[id] = who;
        }
    }

    // The form locked (the brief went out, or was finished as Not sent) while boxes held typing that wasn't saved: what
    // isn't a number, and saves asked for and not yet written (_pending). Each such box is named once, with what was typed
    // in it, and the saves still waiting their turn are dropped, as they'd only be refused.
    private void Lost(Dictionary<Guid, MetricTile> before)
    {
        var now = Tiles(_day);
        var lost = new Dictionary<Guid, string>(_invalid);
        foreach (var (key, asked) in _pending.Where(p => p.Key.Day == Date).ToList())
        {
            _pending.Remove(key);
            var saved = now.GetValueOrDefault(key.Metric);
            if (asked.Value != saved?.Value) lost.TryAdd(key.Metric, Raw(asked.Value));
            else if (asked.Note != saved?.Note) lost.TryAdd(key.Metric, asked.Note ?? "");
        }
        _invalid.Clear();
        foreach (var (metric, typed) in lost)
            Toasts.Error(LostMessage((now.GetValueOrDefault(metric) ?? before.GetValueOrDefault(metric))?.Metric.Name ?? "A number", typed, _notSent));
    }

    /// <summary>What a box whose typing the brief's sending (or finishing as Not sent) cut off says.</summary>
    internal static string LostMessage(string metric, string typed, bool notSent) =>
        $"{metric} wasn't saved: the brief {(notSent ? "was finished as Not sent" : "went out")} while you were typing it " +
        $"({(typed.Length == 0 ? "you'd cleared it" : "you'd typed " + typed)}). An administrator can correct it.";

    private static bool Changed(MetricTile? was, MetricTile? now) => was?.Value != now?.Value || was?.Note != now?.Note;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNext is not { } metric || !_boxes.TryGetValue(metric, out var box)) return;
        _focusNext = null;
        try { await box.FocusAsync(); }
        catch (JSDisconnectedException) { /* the circuit has gone: there's nothing to focus */ }
    }

    private string GroupDomId(Guid group) => _id + "-g-" + group.ToString("N");

    // The counts and folds follow the day as it is now, and the boxes holding what isn't a number or a colleague's change.
    private void Recount()
    {
        if (_day is not null) _progress.Update(_day, new HashSet<Guid>([.. _invalid.Keys, .. _elsewhere.Keys]));
    }

    // Focus moving into another group (or to its chip) is leaving the group it was in: a finished one folds then.
    private void MovedTo(Guid? group)
    {
        if (_lastGroup is { } was && was != group) _progress.Left(was, group);
        _lastGroup = group;
    }

    /// <summary>A group's chip: opens it if it's folded and focuses its first empty box (its first box when none is).
    /// A value still saving counts: its box isn't the empty one.</summary>
    internal async Task Jump(Guid group)
    {
        MovedTo(group);
        _progress.Unfold(group);
        await InTurn(() => Task.CompletedTask);
        _focusNext = _progress.JumpTarget(group);
        StateHasChanged();
    }

    /// <summary>The box the form focuses once it has rendered (a chip's jump, or a group unfolded).</summary>
    internal Guid? FocusNext => _focusNext;

    /// <summary>A finished group's heading: unfolds it (focusing its first box), or folds it again.</summary>
    internal void Toggle(Guid group)
    {
        if (_progress.Unfold(group))
        {
            MovedTo(group);
            _focusNext = _progress.MetricsOf(group).Select(m => (Guid?)m).FirstOrDefault();
        }
        else
        {
            _progress.Fold(group);
        }
        StateHasChanged();
    }

    private string? Shown(Guid metric, bool note, string? saved) => _kept.TryGetValue((metric, note), out var kept) ? kept : saved;

    internal void Entering(Guid metric, bool note)
    {
        _focus = (metric, note);
        var group = _progress.GroupOf(metric);
        if (group == _lastGroup) return;
        MovedTo(group);
        StateHasChanged();
    }

    internal void Left(Guid metric, bool note)
    {
        if (_focus == (metric, note)) _focus = null;
        // Left without saving: the box shows what's saved now. One still holding what isn't a number keeps it, and the note.
        if (!_kept.Remove((metric, note))) return;
        if (!_invalid.ContainsKey(metric) && !_kept.Keys.Any(k => k.Metric == metric)) Unflag(metric);
        Recount();
        StateHasChanged();
    }

    // A colleague's save to this day's numbers (or to the metrics kept): re-read in place. A box being typed in, or holding
    // what isn't a number, keeps its text; if they changed that metric, its row says so.
    internal Task OnChangedElsewhere(IReadOnlyList<Change> changes) => InTurn(async () =>
    {
        var who = LiveChanges.Who(changes);
        await Reread(who);
        Recount();
        await Report();
        Toasts.Show($"{who} updated the numbers.");
        StateHasChanged();
    });

    private static Dictionary<Guid, MetricTile> Tiles(MetricDay? day) =>
        day?.Groups.SelectMany(g => g.Tiles).ToDictionary(t => t.Metric.Id) ?? [];

    private static string Unit(MetricFormat f) => f switch { MetricFormat.Percent => " (%)", MetricFormat.Hours => " (hours)", _ => "" };

    private static string Raw(decimal? v) => v?.ToString("0.####", CultureInfo.InvariantCulture) ?? "";

    private static string LevelClass(MetricTile t) => t.Level == MetricLevel.Normal ? "" : "tide-level-" + t.Level.ToString().ToLowerInvariant();

    internal async Task SaveValue(MetricTile t, string? text)
    {
        decimal? value = null;
        if (!string.IsNullOrWhiteSpace(text))
        {
            if (!MetricMath.TryParseValue(text, out var v))
            {
                _invalid[t.Metric.Id] = text;
                Recount();
                Toasts.Error($"'{text}' isn't a number TIDE can keep.");
                StateHasChanged();
                return;
            }
            value = v;
        }
        _invalid.Remove(t.Metric.Id);
        Settled(t.Metric.Id, false);
        var group = _progress.GroupOf(t.Metric.Id);
        var wasIn = _lastGroup;
        await Save(t.Metric.Id, value, Wanted(t.Metric.Id).Note);
        // Focus moved on to another group while this saved (a click there from the group's last box): leaving was heard
        // before the group was finished, so it folds now that it is.
        if (group is { } g && wasIn == g && _lastGroup is { } now && now != g) _progress.Left(g, now);
        StateHasChanged();
    }

    internal Task SaveNote(MetricTile t, string? note)
    {
        // The value as it is now: it may have been saved a moment ago on the way into this box, or still be saving.
        Settled(t.Metric.Id, true);
        if (Wanted(t.Metric.Id).Value is { } v) return Save(t.Metric.Id, v, note);
        if (!string.IsNullOrWhiteSpace(note)) Toasts.Error($"Enter a value for {t.Metric.Name} before its note.");
        Recount();
        return Task.CompletedTask;
    }

    // A metric's value and note as this form last asked for them: still saving, or as read.
    private (decimal? Value, string? Note) Wanted(Guid metric)
    {
        if (_pending.TryGetValue((Date, metric), out var asked)) return asked;
        var t = Tiles(_day).GetValueOrDefault(metric);
        return (t?.Value, t?.Note);
    }

    // A box's own text was saved (or found wanting): what it kept through a colleague's save, and the note, go.
    private void Settled(Guid metric, bool note)
    {
        _kept.Remove((metric, note));
        if (!_kept.Keys.Any(k => k.Metric == metric)) Unflag(metric);
    }

    private void Unflag(Guid metric)
    {
        _elsewhere.Remove(metric);
        _unnamed.Remove(metric);
    }

    // Saves in turn, for the day it was asked on. What's written is the latest asked for the metric by then, so a save
    // waiting behind one that already wrote the same has nothing left to do.
    private Task Save(Guid metric, decimal? value, string? note)
    {
        var key = (Date, metric);
        _pending[key] = (value, note);
        return InTurn(async () =>
        {
            if (!_pending.TryGetValue(key, out var write)) return;
            try
            {
                await MetricsSvc.SaveValueAsync(metric, key.Date, write.Value, write.Note);
                if (key.Date == Date)
                {
                    await Reread(null, metric);
                    await Report();
                }
            }
            catch (Exception ex)
            {
                // The brief went out (or was finished as Not sent) before this could be written: the form locks, naming it.
                if (ex is InvalidOperationException && key.Date == Date && await MetricsSvc.IsLockedAsync(Date))
                {
                    await Reread(null);
                    await Report();
                }
                else Toasts.Error(UserFacingError.For(ex));
            }
            finally
            {
                if (_pending.TryGetValue(key, out var now) && now == write) _pending.Remove(key);
                Recount();
            }
        });
    }
}
