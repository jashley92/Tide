@* The one loading state: a status line for screen readers and placeholder rows for everyone else, in
   place of a bare "Loading…". The rows shimmer unless reduced motion is asked for. *@
<div class="tide-loading">
    <span class="visually-hidden" role="status">@Label</span>
    <div aria-hidden="true">
        @for (var r = 0; r < Rows; r++)
        {
            <div class="tide-skel-row">
                @for (var c = 0; c < Columns; c++)
                {
                    <span class="tide-skel tide-skel-w@((r + c) % WidthCount)"></span>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public int Columns { get; set; } = 3;
    [Parameter] public string Label { get; set; } = "Loading…";

    // Varied widths (tide-skel-w0 to w5 in app.css) read as text of different lengths rather than a grid.
    private const int WidthCount = 6;
}
