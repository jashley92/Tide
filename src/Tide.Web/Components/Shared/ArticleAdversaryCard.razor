@* An article's threat actors (EP-73): the adversary profiles it's tagged with, the one place to tag them. It's the
   "Threat actors" field under the editor's Tags & ATT&CK › Context, where a free-text box used to be; for someone who
   can't edit (the editor's fields are hidden from them), a read-only card in the rail (Boxed). Each tagged profile shows
   how much else has been written about it; the profiles the article names (title, bottom line) but isn't tagged with
   are offered as a one-click tag; and, for analysts, a search picker (TagCard, as We run's). With nothing typed it
   offers a few: those the article names, then watched ones, then those tagged lately. Typing finds a profile by its
   name, any other name ("APT29 (also Cozy Bear)") or MITRE id, a few at a time (AdversaryService.PickLimit), retired
   ones last and asked about first; and offers to add one by the words typed, with a link to fill it in. Tagging is
   saved straight away. What the old box held (Article.Actors) isn't lost: its names a profile goes by are offered as
   "Tag X", and the rest show under the picker as "Earlier note", with a × to clear them. *@
@using Tide.Application.Adversaries
@inherits TagCard<Adversary>
@inject AdversaryService Adversaries
@{ base.BuildRenderTree(__builder); }

@code {
    private ArticleAdversaries? _mine;
    private IReadOnlyDictionary<Guid, AdversaryDetail> _details = new Dictionary<Guid, AdversaryDetail>();

    /// <summary>What the card was read as last (internal for the tests).</summary>
    internal ArticleAdversaries? Mine => _mine;

    private static readonly TagCardWords Said = new(Title: "Threat actors", ListHref: "adversaries", ListName: "All profiles", FieldClass: "tide-tagfield",
        PickPrefix: "adv-pick", MaxLength: Adversary.MaxName, Placeholder: "Tag an adversary by any name, or add one", ListLabel: "Adversaries",
        Help: "Matching adversaries are listed as you type. Use the up and down arrows to choose, Enter to tag it.", ComboLabel: null,
        NoneTagged: "No adversary tagged.", AddAs: "as a new adversary", AddedTail: "as a new profile. Fill it in when you can.",
        NothingYet: "Type any name an adversary goes by, or its MITRE id.", One: "adversary", Many: "adversaries",
        RetiredAsk: "Tag the article with it anyway?");

    protected override TagCardWords Words => Said;

    protected override IArticleTagSource Source => Adversaries;

    protected override async Task<IReadOnlyList<TagPick>> ReadAsync(bool offer)
    {
        (_mine, var offered) = await Adversaries.ForArticleCardAsync(ArticleId, offer);
        return offered;
    }

    protected override void Adopt(TagCard<Adversary> prerendered)
    {
        var p = (ArticleAdversaryCard)prerendered;
        (_mine, _details) = (p._mine, p._details);
    }

    protected override async Task ReadDetailsAsync() =>
        _details = await Adversaries.DetailsAsync(_mine!.Tagged.Select(a => a.Id).ToList());

    protected override IReadOnlyList<Adversary>? Tagged => _mine?.Tagged;

    protected override IReadOnlyList<Adversary> Suggested => _mine?.Suggested ?? [];

    protected override Guid IdOf(Adversary tag) => tag.Id;

    protected override string NameOf(Adversary tag) => tag.Name;

    protected override RenderFragment FieldHead => __builder =>
    {
        if (CanWrite)
        {
            <label class="tide-field-label mb-0" for="@PickId">Threat actors</label>
        }
        else
        {
            <span class="tide-field-label mb-0">Threat actors</span>
        }
        <a class="small" href="adversaries">All profiles</a>
    };

    protected override RenderFragment<Adversary> TaggedRow => a => __builder =>
    {
        var d = _details.GetValueOrDefault(a.Id);
        <div class="d-flex gap-2 align-items-baseline flex-wrap">
            <a class="fw-semibold" href="@($"adversaries/{a.Id}")">@a.Name</a>
            @if (a.Aliases is { } al) { <span class="small tide-muted">also @(al.Length > 80 ? al[..80] + "…" : al)</span> }
            @UntagButton(a.Id, a.Name)
        </div>
        @if (d is not null)
        {
            var others = d.Articles.Count(x => x.Id != ArticleId);
            <div class="small"><a href="@($"adversaries/{a.Id}")">Seen before: @others other article@(others == 1 ? "" : "s")@(d.BriefedThisQuarter > 0 ? $" · {d.BriefedThisQuarter} brief{(d.BriefedThisQuarter == 1 ? "" : "s")} this quarter" : "")</a></div>
            @foreach (var x in d.Articles.Where(x => x.Id != ArticleId).Take(3))
            {
                <div class="small tide-muted">@Ui.ShortDay(x.On) · <a href="@($"articles/{x.Id}")">@x.Title</a></div>
            }
        }
    };

    // What the earlier note names that a profile goes by, offered as tags.
    protected override RenderFragment? AfterSuggested => CanWrite && _mine is { FromNote.Count: > 0 } mine ? Offer("Earlier note names", mine.FromNote) : null;

    // The earlier note's names that are no profile, until cleared.
    protected override RenderFragment? AfterPicker => _mine is { Leftover.Count: > 0 } mine ? __builder =>
    {
        <div class="tide-earlier-note small mt-2">
            <span>Earlier note: “@string.Join(", ", mine.Leftover)”</span>
            @if (CanWrite)
            {
                <button type="button" class="btn btn-link btn-sm p-0 tide-earlier-clear" disabled="@Busy" aria-label="Clear the earlier note"
                        title="Clear the earlier note" @onclick="ClearNote"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            }
        </div>
    } : null;

    // The ×: the earlier note's names that are no profile go; those a profile goes by stay offered as tags.
    internal Task ClearNote() => Change(() => Adversaries.ClearEarlierNoteAsync(ArticleId), "Earlier note cleared.");
}
