@* What each edition will carry, from the running order as it stands (EditionChecks, the editions' own cut): how many
   of the articles go out, then only the exceptions (EditionChecks.Exceptions): the title slide line, the day's numbers
   or an article that is Partly included or Left out, with why, and an article the company-wide edition carries with a
   warning (a threat's "Why it matters"). When every article goes out whole it says so; the running order beside it
   already names them. Links open the brief's preview of both editions, each edition's heading with that one picked for
   a narrow screen. *@

<section class="tide-card" aria-labelledby="edition-check-h">
    <h2 id="edition-check-h">Edition check <span class="ms-auto small fw-normal tide-muted">From the running order</span></h2>
    <div class="tide-ed-cols">
        @Column("Team edition", Edition.Team, TeamMax, "team")
        @Column("Company-wide edition", Edition.Public, PublicMax, "company")
    </div>
    <p class="tide-ed-note">The company-wide edition never carries the numbers, indicators or actions.
        <a href="@(Ui.BriefUrl(Day) + "?tab=preview")">Preview both editions</a></p>
</section>

@code {
    [Parameter, EditorRequired] public Brief Brief { get; set; } = default!;

    /// <summary>The brief's day, for the links to each edition.</summary>
    [Parameter, EditorRequired] public DateOnly Day { get; set; }

    [Parameter] public TlpLevel TeamMax { get; set; } = TlpLevel.AmberStrict;

    [Parameter] public TlpLevel PublicMax { get; set; } = TlpLevel.Green;

    /// <summary>Numbers are kept for the day (the team edition carries them).</summary>
    [Parameter] public bool HasNumbers { get; set; }

    [Parameter] public int MissingNumbers { get; set; }

    private static string Mark(EditionFit f) => f switch
    {
        EditionFit.Included => "Included",
        EditionFit.Part => "Partly included",
        _ => "Left out",
    };

    private RenderFragment Column(string name, Edition edition, TlpLevel ceiling, string tab)
    {
        var rows = EditionChecks.Rows(Brief, edition, ceiling, HasNumbers, MissingNumbers);
        var articles = rows.Where(r => r.ArticleId is not null).ToList();
        var kept = articles.Count(r => r.Fit != EditionFit.LeftOut);
        var exceptions = EditionChecks.Exceptions(rows);
        return @<div class="tide-ed-col">
            <h3><a href="@(Ui.BriefUrl(Day) + "?tab=" + tab)">@name</a>
                <span class="tide-ed-sub">Up to <TlpBadge Level="ceiling" /> &middot; @kept of @articles.Count article@(articles.Count == 1 ? "" : "s")</span></h3>
            @if (articles.Count == 0 && exceptions.Count == 0)
            {
                <p class="small tide-muted mb-0">Nothing on it yet.</p>
            }
            @if (EditionChecks.Whole(rows) is { } whole)
            {
                <p class="tide-ed-whole"><span class="bi bi-check2" aria-hidden="true"></span> @whole</p>
            }
            @if (exceptions.Count > 0)
            {
                <ul class="tide-ed-list">
                    @foreach (var r in exceptions)
                    {
                        <li class="@(r.Fit == EditionFit.LeftOut ? "is-out" : "")">
                            <span class="tide-ed-mark is-@r.Fit.ToString().ToLowerInvariant()">@Mark(r.Fit)<span class="visually-hidden">:</span></span>
                            <span>
                                @if (r.ArticleId is { } id)
                                {
                                    <a class="tide-ed-title" href="articles/@id">@r.Title</a>
                                }
                                else
                                {
                                    <span class="tide-ed-title">@r.Title</span>
                                }
                                @if (r.Why is not null)
                                {
                                    <span class="tide-ed-why">@r.Why</span>
                                }
                                @if (r.Warning is not null)
                                {
                                    <span class="tide-ed-warn"><span class="bi bi-exclamation-circle" aria-hidden="true"></span><span class="visually-hidden">Warning:</span> @r.Warning</span>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>;
    }
}
