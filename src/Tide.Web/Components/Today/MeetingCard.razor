@inject OrgClock Clock
@inject ICurrentUser CurrentUser

@* The brief's meeting: when it meets, who presents and the title slide line, who the rotation has, then who attended
   and the notes. Whoever writes the brief changes the presenter and the line (until it's sent) in a form that opens from
   its buttons, and stays open while what's typed isn't saved. The presenter and the line as typed are the page's
   (bound), so it can say they're unsaved and keep them through a reload. *@

<section class="tide-card" aria-labelledby="meeting-h" data-submit-scope>
    <h2 id="meeting-h">Meeting</h2>
    @* Facts, each label above its value: when and who side by side, the title slide line under them. *@
    <dl class="tide-facts tide-facts-side tide-meeting-facts">
        <div class="tide-fact"><dt>When</dt><dd>@($"{Ui.ShortDay(Day)} · {MeetsAt} {Zone}".TrimEnd())</dd></div>
        <div class="tide-fact"><dt>Presenter</dt><dd>@BriefService.PresentedBy(Brief)</dd></div>
        <div class="tide-fact tide-fact-wide">
            <dt>Title slide line</dt>
            <dd>
                @if (string.IsNullOrWhiteSpace(Brief.Intro))
                {
                    <span class="tide-muted">None</span>
                }
                else
                {
                    @* The space is written out: Razor drops it between a component and an expression. *@
                    <TlpBadge Level="Brief.IntroTlp" />@(" " + Brief.Intro)
                }
            </dd>
        </div>
    </dl>
    @if (RotaDay is { AnalystName: { } rota } && !Past)
    {
        <p class="small mb-2">The rotation has <strong>@rota</strong>@(RotaDay.IsChanged ? $", covering {RotaDay.RegularName}" : "") for this day.</p>
    }
    @if (CanEdit && !FormShown)
    {
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary btn-sm tide-meeting-presenter" @ref="_presenterBtn" @onclick="() => OpenAt(Field.Presenter)">Change presenter</button>
            <button type="button" class="btn btn-link btn-sm" @ref="_lineBtn" @onclick="() => OpenAt(Field.Line)">Title slide line</button>
        </div>
    }
    else if (CanEdit)
    {
        @* A colleague saved these meanwhile: said here, by the form, as well as at the top of the page (which announces it). *@
        <div role="status">
            @if (ChangedBy is not null)
            {
                <div class="tide-changed-elsewhere tide-changed-elsewhere-short mb-2">
                    <span><span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span><strong>@ChangedBy saved the presenter or title slide line meanwhile.</strong> Saving now replaces theirs.</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="OnReload">Reload</button>
                </div>
            }
        </div>
        <label class="tide-field-label" for="analyst">Presenting analyst</label>
        <select id="analyst" class="form-select form-select-sm mb-2" @ref="_analyst" @bind:get="AnalystId" @bind:set="v => AnalystIdChanged.InvokeAsync(v)">
            @if (!People.Any(p => p.Sid == AnalystId))
            {
                <option value="@AnalystId">@Brief.AnalystName</option>
            }
            @foreach (var p in People)
            {
                <option value="@p.Sid">@p.DisplayName@(p.Sid == CurrentUser.UserId ? " (you)" : "")</option>
            }
        </select>
        <div class="d-flex gap-2 align-items-center justify-content-between">
            <label class="tide-field-label" for="intro">Title slide line (optional)</label>
            <TlpSelect Value="IntroTlp" ValueChanged="IntroTlpChanged" Label="The title slide line's TLP" Class="w-auto mb-1" />
        </div>
        <textarea id="intro" class="form-control form-control-sm tide-autogrow tide-grow-2" rows="2" maxlength="2000" @ref="_intro" @bind="_line" @bind:event="oninput" @bind:after="SendLine"
                  placeholder="Shown on the title slide: a quiet day, a theme, a reminder."></textarea>
        <div class="small tide-muted mt-1">An edition whose ceiling is below its TLP leaves it out.</div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-outline-secondary btn-sm" disabled="@Busy" data-submit @onclick="() => Closing(OnSave)">Save</button>
            <button type="button" class="btn btn-link btn-sm" disabled="@Busy" @onclick="() => Closing(OnCancel)">Cancel</button>
        </div>
    }
    @if (Meeting.Attendees.Count > 0)
    {
        <h3 class="tide-subhead">Attended</h3>
        <div class="small">@string.Join(", ", Meeting.Attendees.Select(a => a.Name))</div>
    }
    @if (Meeting.Notes.Count > 0)
    {
        <h3 class="tide-subhead">Meeting notes</h3>
        @foreach (var (title, notes) in NoteGroups())
        {
            <div class="tide-meeting-notes-group">
                <div class="tide-muted small">@title</div>
                <ul class="tide-meeting-notes small">
                    @foreach (var n in notes)
                    {
                        <li><strong>@n.AuthorName</strong> <span class="tide-muted">@Ui.Time(Clock, n.AtUtc)</span> @n.Text</li>
                    }
                </ul>
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Brief Brief { get; set; } = default!;

    /// <summary>The brief's day.</summary>
    [Parameter, EditorRequired] public DateOnly Day { get; set; }

    /// <summary>When it meets: "10:30 AM".</summary>
    [Parameter, EditorRequired] public string MeetsAt { get; set; } = "";

    /// <summary>The organization's zone as it is now: "Eastern Standard Time".</summary>
    [Parameter] public string? Zone { get; set; }

    /// <summary>The brief rotation's day, for who it has; not said of a past day.</summary>
    [Parameter] public Tide.Application.Rotation.RotationDay? RotaDay { get; set; }

    [Parameter] public bool Past { get; set; }

    /// <summary>The presenter and the title slide line can be changed (whoever writes the brief, until it's sent).</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Who can present, for the presenter picker.</summary>
    [Parameter] public IReadOnlyList<AppUser> People { get; set; } = [];

    [Parameter] public string AnalystId { get; set; } = "";

    [Parameter] public EventCallback<string> AnalystIdChanged { get; set; }

    [Parameter] public string? Intro { get; set; }

    [Parameter] public EventCallback<string?> IntroChanged { get; set; }

    [Parameter] public TlpLevel IntroTlp { get; set; }

    [Parameter] public EventCallback<TlpLevel> IntroTlpChanged { get; set; }

    /// <summary>Who attended and the notes, as the meeting recorded them.</summary>
    [Parameter, EditorRequired] public MeetingRecord Meeting { get; set; } = default!;

    /// <summary>The page is saving: Save waits.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>A colleague who saved the presenter or line while this form held unsaved changes; null otherwise.</summary>
    [Parameter] public string? ChangedBy { get; set; }

    /// <summary>Drops what's typed and reads the colleague's version.</summary>
    [Parameter] public EventCallback OnReload { get; set; }

    /// <summary>Drops what's typed and closes the form.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>The form is open (a button opened it); it stays open while what's typed isn't saved, whatever this says.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    // The title slide line as typed here, sent to the page as each key is typed (so the page knows it's unsaved, and a
    // colleague's save keeps it). The page's copy can come back a keystroke behind; one this box sent is never put back
    // over what's typed since. A change from elsewhere (Reload, a day's brief read again) is taken.
    private string? _line;
    private readonly HashSet<string> _sent = [];

    private Task SendLine()
    {
        _sent.Add(_line ?? "");
        return IntroChanged.InvokeAsync(_line);
    }

    protected override void OnParametersSet()
    {
        if (!FormShown)
        {
            _line = Intro;
            _sent.Clear();
        }
        else if (Intro != _line && !_sent.Contains(Intro ?? "")) _line = Intro;
    }

    private bool Dirty => AnalystId != Brief.AnalystId || (Intro ?? "").Trim() != (Brief.Intro ?? "").Trim() || IntroTlp != Brief.IntroTlp;

    private bool FormShown => Open || Dirty;

    private enum Field { Presenter, Line }

    private ElementReference _analyst, _intro, _presenterBtn, _lineBtn;
    private Field? _focus, _openedBy;
    private bool _back;

    // A button opens the form, and focus goes to the field it names once it's drawn.
    private async Task OpenAt(Field field)
    {
        (_focus, _openedBy) = (field, field);
        await OpenChanged.InvokeAsync(true);
    }

    // Save or Cancel: once the form has closed, focus goes back to the button that opened it (Change presenter when the
    // form was open for what was typed). A refused save leaves the form, and focus, where they are.
    private Task Closing(EventCallback action)
    {
        _back = true;
        return action.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_back && !FormShown)
        {
            _back = false;
            await (_openedBy == Field.Line ? _lineBtn : _presenterBtn).TryFocusAsync(orGone: true);
            _openedBy = null;
            return;
        }
        if (_back && !Busy) _back = false;   // the save was refused: the form stays, and so does focus
        if (_focus is not { } field || !FormShown) return;
        _focus = null;
        await (field == Field.Presenter ? _analyst : _intro).TryFocusAsync(orGone: true);
    }

    // The notes grouped by the article on screen when each was written, in the running order; the meeting's own last.
    private IEnumerable<(string Title, IEnumerable<MeetingNote> Notes)> NoteGroups()
    {
        var items = Brief.Items.ToDictionary(i => i.ArticleId);
        return Meeting.Notes.GroupBy(n => n.ArticleId)
            .Select(g => (Item: g.Key is { } id ? items.GetValueOrDefault(id) : null, Notes: g))
            .OrderBy(g => g.Notes.Key is null ? int.MaxValue : g.Item?.SortOrder ?? int.MaxValue - 1)
            .Select(g => (g.Notes.Key is null ? "The meeting" : g.Item?.Article?.Title ?? "An article since taken off", (IEnumerable<MeetingNote>)g.Notes));
    }
}
