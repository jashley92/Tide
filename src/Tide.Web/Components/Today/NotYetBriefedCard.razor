@inject OrgClock Clock

@* For whoever writes the brief: the ready articles that haven't been on any brief yet (the page picks them, from the
   same candidates as Add article), each with Add while today's brief can still change (or before it's started: Add
   starts it), and the rest in Add article. After Add, focus goes to the next article's Add (KeepPlace). *@

<section class="tide-card" aria-labelledby="recent-h">
    <h2 id="recent-h" tabindex="-1" @ref="_heading">Not on a brief yet <span class="tide-count">(@Articles.Count)</span>
        <a class="ms-auto small fw-normal" href="articles?new=1"><span class="bi bi-plus-lg" aria-hidden="true"></span> New article</a></h2>
    @if (Articles.Count == 0)
    {
        <p class="small tide-muted mb-0">Everything ready is on a brief.</p>
    }
    <ul class="list-unstyled mb-0">
        @foreach (var c in Articles.Take(Shown))
        {
            <li class="mb-2 d-flex gap-2 align-items-start" @key="c.Id">
                <div class="flex-grow-1">
                    <a href="articles/@c.Id" class="fw-semibold text-decoration-none">@c.Title</a>
                    <div class="tide-run-meta">
                        <ClassBadge Classification="c.Classification" Priority="c.Priority" />
                        <StatusBadge Status="@c.Status.ToString()" />
                        <span>@c.AuthorName &middot; @Ui.When(Clock, c.CreatedAtUtc)</span>
                    </div>
                </div>
                @if (CanAdd)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" disabled="@Busy" aria-label="Add @c.Title to today's brief" @onclick="() => Add(c)" @ref="_adds[c.Id]">
                        <span class="bi bi-plus-lg" aria-hidden="true"></span> Add
                    </button>
                }
            </li>
        }
    </ul>
    @if (Articles.Count > Shown && CanAdd)
    {
        <button type="button" class="btn btn-link btn-sm p-0 mt-1" disabled="@Busy" @onclick="OnAddMore">All @Articles.Count in Add article</button>
    }
</section>

@code {
    private const int Shown = 8;

    /// <summary>The articles not yet on any brief, in the order to list them.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<BriefCandidate> Articles { get; set; } = default!;

    /// <summary>Today's brief can still change: each article offers Add.</summary>
    [Parameter] public bool CanAdd { get; set; }

    /// <summary>The page is saving: Add waits.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>One article onto the end of the running order.</summary>
    [Parameter] public EventCallback<BriefCandidate> OnAdd { get; set; }

    /// <summary>Opens Add article, for the ones not listed.</summary>
    [Parameter] public EventCallback OnAddMore { get; set; }

    private readonly KeepPlace _place = new();
    private readonly Dictionary<Guid, ElementReference> _adds = [];
    private ElementReference _heading;

    // The articles listed with an Add.
    private IEnumerable<Guid> Offering => CanAdd ? Articles.Take(Shown).Select(c => c.Id) : [];

    private async Task Add(BriefCandidate c)
    {
        var before = Offering.ToList();
        await OnAdd.InvokeAsync(c);
        _place.Acted(before, c.Id);
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        _place.FocusAsync(Offering, id => _adds.TryGetValue(id, out var add) ? add : (ElementReference?)null, _heading);
}
