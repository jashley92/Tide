@* An analyst on a team: one Actions card, their own and the team's unassigned ones on two tabs, where My actions and
   the team queue used to list the same rows twice. Which tab is open is the page's (Tab), so it stays as the page
   redraws around it. After Take it, focus goes to the next unassigned row's (KeepPlace). *@

@{
    var team = Tab == "team";
}
<section class="tide-card" aria-labelledby="actions-card-h">
    <h2 id="actions-card-h" tabindex="-1" @ref="_heading">Actions <a class="ms-auto small fw-normal" href="@(team ? "actions?view=myteams" : "actions?view=mine")">All</a></h2>
    <div class="tide-seg mb-2" role="group" aria-label="Whose actions">
        <button type="button" class="tide-seg-opt @(team ? "" : "on")" aria-pressed="@(team ? "false" : "true")" @onclick="@(() => TabChanged.InvokeAsync("mine"))">Mine <span class="tide-count">@Mine.Count</span></button>
        <button type="button" class="tide-seg-opt @(team ? "on" : "")" aria-pressed="@Ui.Aria(team)" @onclick="@(() => TabChanged.InvokeAsync("team"))">Team, unassigned <span class="tide-count">@Queue.Unassigned</span></button>
    </div>
    @if (!team)
    {
        @if (Mine.Count == 0) { <EmptyState Icon="bi-check2-circle" Title="Nothing assigned to you." Compact="true" /> }
        @foreach (var r in Mine.Take(MyActionsCard.Shown))
        {
            <MyActionRow @key="r.Id" Row="r" Marks="Marks" />
        }
    }
    else
    {
        var unassigned = Unassigned.ToList();
        @if (unassigned.Count == 0) { <EmptyState Icon="bi-check2-circle" Title="Nothing unassigned on your teams." Compact="true" /> }
        @foreach (var r in unassigned)
        {
            <QueueRow @key="r.Id" @ref="_rows[r.Id]" Row="r" Meta="@($"{ActionService.KindName(r.Kind)} · {r.TeamName}")" OfferTake="true" Busy="Busy" Marks="Marks" OnTake="Take" />
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ActionRow> Mine { get; set; } = default!;

    [Parameter, EditorRequired] public TeamQueue Queue { get; set; } = default!;

    /// <summary>The open tab: "mine" or "team".</summary>
    [Parameter] public string Tab { get; set; } = "mine";

    [Parameter] public EventCallback<string> TabChanged { get; set; }

    /// <summary>The page is saving: Take it waits.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Rows a colleague's change brought or changed, highlighted a moment.</summary>
    [Parameter] public LiveMarks<Guid>? Marks { get; set; }

    [Parameter] public EventCallback<ActionRow> OnTake { get; set; }

    private readonly KeepPlace _place = new();
    private readonly Dictionary<Guid, QueueRow> _rows = [];
    private ElementReference _heading;

    // The team's unassigned rows: the Team tab's list, each offering Take it.
    private IEnumerable<ActionRow> Unassigned => Queue.Rows.Where(r => r.AssigneeId is null);

    private async Task Take(ActionRow row)
    {
        var before = Unassigned.Select(r => r.Id).ToList();
        await OnTake.InvokeAsync(row);
        _place.Acted(before, row.Id);
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        _place.FocusAsync(Unassigned.Select(r => r.Id), id => _rows.GetValueOrDefault(id)?.TakeButton, _heading);
}
