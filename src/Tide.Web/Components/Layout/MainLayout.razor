@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Sections

<a class="tide-skip-link" href="#main-content">Skip to content</a>

@* Each part of the page is a landmark of its own, none inside another: the sidebar is the main navigation, the top bar
   the banner (<header>), the page the one <main>, the context rail a complementary <aside> after it, and the toasts a
   named region. The top bar and the rail are kept out of <main> so a screen reader's list of landmarks has each once;
   .tide-main is a plain column the stylesheet lays out as <main> was. *@
<div class="page">
    <nav class="sidebar" aria-label="Main">
        <NavMenu />
    </nav>

    <div class="tide-main">
        <header class="top-row">
            <span class="tide-muted small">@Clock.TeamName</span>
            <div class="tide-top-find">
                <AuthorizeView Policy="@Policies.ReadTeamEdition">
                    <TopSearch />
                </AuthorizeView>
                @* Ctrl+K from anywhere; it lists only what this person may open. *@
                <CommandPalette />
            </div>
            <AuthorizeView>
                <Authorized>
                    <div class="tide-top-end">
                        @* When the brief meets and the step it's on, for those who make it; nothing for anyone else. *@
                        <BriefChip />
                        @* The Context button, when the page has a context rail (ContextRail). *@
                        <SectionOutlet SectionId="ContextRail.ToggleSection" />
                        <ShortcutsOverlay />
                        <ProfileMenu />
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        @* Where the skip link goes and FocusOnNavigate looks for the h1. *@
        <main id="main-content" tabindex="-1" class="content">
            <SecondProcessBanner />
            <LiveMeetingJoin />
            <PageBoundary>@Body</PageBoundary>
        </main>
        @* The page's context rail, when it has one: nothing is drawn here otherwise. After </main>, not in it, so it's a
           top-level landmark, still after the content in reading order. *@
        <SectionOutlet SectionId="ContextRail.RegionSection" />
    </div>
</div>

<ToastHost />

@* What's new after an upgrade, then a changed page's tip; never in present mode (BlankLayout). *@
<AuthorizeView>
    <Authorized>
        <OnboardingHost />
    </Authorized>
</AuthorizeView>

@* Hidden until Blazor shows it; an alert then, so it's announced, and not content outside a landmark. *@
<div id="blazor-error-ui" role="alert">
    Something went wrong. Reload the page to continue.
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
</div>

@code {
    [Inject] private OrgClock Clock { get; set; } = default!;

    public static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }
}
