@* What MainLayout offers a person, one thing at a time: on a first-ever sign-in, the tour for their role (Tours); after
   an upgrade, What's new (WhatsNewDialog); then a page's tip on the first visit to a page that changed (PageTips).
   Unasked only where OnboardingGate allows, and never on present mode's shared screen (BlankLayout draws none of this,
   and none of it starts at a /present address). Help's Take the tour, or What's new's, starts the tour again; Help's
   guides and a page's Show me around start that page's guide (Guides), never unasked (TourRequests).
   A tip isn't modal: it never takes a key, so ] and every shortcut still work; it's announced politely once shown, sits
   beside the control it's about (tips.js), and "Got it" puts it away for good. A tour or guide step is a dialog over a
   light scrim (GuideStepDialog): each step is announced, and Escape, Skip tour (End guide) or Done ends it, focus going
   back to what started it when that's still there (Help's Take the tour, the page's Show me around), else to the page's
   heading. Leaving the page another way ends it too. The first tour stays due until it ends, so a reload mid-tour starts
   it again; a second tab of the same person's doesn't start another first tour (TourClaims). A guide stores nothing. *@
@implements IAsyncDisposable
@using Tide.Application.Operations
@inject PageTipService Tips
@inject TourService Tour
@inject TourRequests TourAsked
@inject TourClaims Claims
@inject GuideStarts Starts
@inject ToastService Toasts
@inject OnboardingGate Gate
@inject AuthenticationStateProvider Auth
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<OnboardingHost> Log

<WhatsNewDialog @ref="WhatsNew" Closed="CheckTipSafelyAsync" TakeTour="TakeTourFromWhatsNew" />

<div class="visually-hidden" role="status" aria-live="polite">@Announce</div>
@if (Step is { } step)
{
    <GuideStepDialog Step="step" Index="_step" Count="_tour.Count" Name="@_guide?.Title"
                     OnNext="NextStepAsync" OnBack="PreviousStepAsync" OnEnd="EndTourAsync" />
}
else if (Tip is { } tip)
{
    <aside class="tide-tip" @ref="_card" aria-labelledby="tide-tip-title">
        <div class="tide-tip-head">
            <span class="bi bi-lightbulb" aria-hidden="true"></span>
            <h2 class="tide-tip-title" id="tide-tip-title">@tip.Title</h2>
        </div>
        <p class="tide-tip-text">@tip.Text</p>
        <div class="tide-tip-actions">
            <button type="button" class="btn btn-primary btn-sm" @onclick="DismissTipAsync">Got it</button>
        </div>
    </aside>
}

@code {
    private ElementReference _card;
    private bool _automatic, _returning, _tipShown, _firstTour;
    private PageTip? _placed;
    private string _page = "";
    private IReadOnlyList<TourStep> _tour = [];
    private int _step;
    private Guide? _guide;

    /// <summary>The What's new dialog.</summary>
    public WhatsNewDialog? WhatsNew { get; private set; }

    /// <summary>The tip shown, if any.</summary>
    public PageTip? Tip { get; private set; }

    /// <summary>The step shown, if the tour or a guide is on.</summary>
    public TourStep? Step => _step < _tour.Count ? _tour[_step] : null;

    // What the live region says: the step, or a tip once it's shown (one that needs its control isn't, without it);
    // nothing once it's gone.
    private string Announce => Step is { } s ? GuideStepDialog.Said(s, _step, _tour.Count)
        : Tip is { } t && t == _placed && _tipShown ? $"Tip: {t.Title}. {t.Text}" : "";

    // The page open, without its query: a filter or a search rewriting the address is the same page.
    private string OpenPage => PageOf(Nav.Uri);

    private string PageOf(string uri) => Nav.ToBaseRelativePath(uri).Split('?', '#')[0].ToLowerInvariant();

    protected override void OnInitialized()
    {
        _page = OpenPage;
        Nav.LocationChanged += OnLocationChanged;
        TourAsked.Asked += OnTourAsked;
        TourAsked.GuideAsked += OnGuideAsked;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var user = (await Auth.GetAuthenticationStateAsync()).User;
                _returning = Gate.Returning(user);
                if (_automatic = Gate.Automatic(user)) await SafelyAsync(CheckAsync);
            }
            // A step places itself (GuideStepDialog); this places a tip, or puts the last one away.
            var showing = Step is null ? Tip : null;
            if (showing == _placed) return;
            _placed = showing;
            if (showing is { } t)
            {
                _tipShown = await JS.InvokeAsync<bool>("tideTips.show", _card, t.Target, new { needsTarget = t.NeedsTarget });
                if (_tipShown) StateHasChanged();
            }
            else if (Step is null) await JS.InvokeVoidAsync("tideTips.hide");
        }
        catch (JSDisconnectedException) { /* the circuit has gone */ }
    }

    /// <summary>The tour on a first-ever sign-in (unless a second tab already shows it); else What's new if it's due;
    /// else the page's tip. Nothing in present mode. On the demo, a browser that asked to be someone returning
    /// (?onboarding=returning) never gets the tour.</summary>
    public async Task CheckAsync()
    {
        if (WhatsNew is null || !OnboardingGate.AllowedAt(Nav.ToBaseRelativePath(Nav.Uri))) return;
        if (!_returning && await Tour.IsDueAsync())
        {
            StartTour(first: true, fromHelp: false);
            return;
        }
        await WhatsNew.CheckAsync();
        if (!WhatsNew.IsOpen) await CheckTipAsync();
    }

    /// <summary>The page's tip, if one is due and nothing else is showing (present mode has none: PageTips.For).</summary>
    public async Task CheckTipAsync()
    {
        if (WhatsNew?.IsOpen == true || Step is not null) return;
        Tip = await Tips.DueAsync(Nav.ToBaseRelativePath(Nav.Uri));
        StateHasChanged();
    }

    /// <summary>Got it: the tip goes, and isn't shown on this page again.</summary>
    public async Task DismissTipAsync()
    {
        if (Tip is not { } tip) return;
        Tip = null;
        StateHasChanged();
        await SafelyAsync(() => Tips.DismissAsync(tip));
    }

    private Task CheckTipSafelyAsync() => SafelyAsync(CheckTipAsync);

    // The tour from its first step: on Today, or, asked from Help, on Help until Next.
    private void StartTour(bool first, bool fromHelp) => Start(Tour.Steps, null, first, navigate: !fromHelp);

    // A guide on its page: the one open, from its Show me around; from Help, its page is opened first (for an article's
    // or an action's, a real one: GuideStarts). Learn to present isn't the layout's: Help links to present mode's
    // rehearsal, which shows it.
    private async Task StartGuideAsync(Guide guide, bool fromHelp)
    {
        if (Step is not null || guide.Rehearsal || !fromHelp && !Guides.Matches(guide.Page, OpenPage)) return;
        var page = fromHelp ? await Starts.PageAsync(guide) : OpenPage;
        if (page is null)
        {
            Toasts.Show($"There's nothing to show {guide.Title.ToLowerInvariant()} on yet.");
            return;
        }
        Start(guide.Steps.Select(s => s with { Route = page }).ToList(), guide, first: false, navigate: fromHelp);
    }

    // The steps from the first. The first-sign-in tour, which starts by itself, not while another tab of the person's
    // shows it; one asked for (Help, What's new, Show me around) starts here whatever another tab, or one closed a moment
    // ago and not yet gone, is showing.
    private void Start(IReadOnlyList<TourStep> steps, Guide? guide, bool first, bool navigate)
    {
        if (steps.Count == 0 || Step is not null || first && !Claims.TryClaim(CurrentUser.UserId, this)) return;
        (_firstTour, _guide) = (first, guide);
        Tip = null;
        _tour = steps;
        GoToStep(0, navigate);
    }

    /// <summary>Next, or Done on the last step.</summary>
    public Task NextStepAsync() => _step + 1 < _tour.Count ? Moved(_step + 1) : EndTourAsync();

    /// <summary>Back.</summary>
    public Task PreviousStepAsync() => Moved(Math.Max(0, _step - 1));

    private Task Moved(int step)
    {
        GoToStep(step, navigate: true);
        return Task.CompletedTask;
    }

    /// <summary>Skip tour (End guide), Escape or Done: it ends where it is. The first tour is then settled: not due again,
    /// with What's new and the tips up to this release seen. A guide stores nothing.</summary>
    public async Task EndTourAsync()
    {
        if (_tour.Count == 0) return;
        _tour = [];
        _step = 0;
        Claims.Release(CurrentUser.UserId, this);
        StateHasChanged();
        if (_firstTour) await SafelyAsync(() => Tour.FinishedAsync());
        (_firstTour, _guide) = (false, null);
    }

    // The step, on its page unless that's the one open.
    private void GoToStep(int step, bool navigate)
    {
        _step = step;
        StateHasChanged();
        if (!navigate || Step is not { } s || OpenPage == s.Route.ToLowerInvariant()) return;
        _page = s.Route.ToLowerInvariant();
        Nav.NavigateTo(s.Route.Length == 0 ? Nav.BaseUri : s.Route);
    }

    private void OnTourAsked(bool fromHelp) => _ = InvokeAsync(async () =>
    {
        if (WhatsNew?.IsOpen == true) await WhatsNew.CloseAsync();
        StartTour(first: false, fromHelp);
    });

    private void OnGuideAsked(string key, bool fromHelp) => _ = InvokeAsync(() =>
        Guides.Find(key, CurrentUser.Has) is { } guide ? SafelyAsync(() => StartGuideAsync(guide, fromHelp)) : Task.CompletedTask);

    // What's new's Take the tour: it has closed, marked seen; the tour runs, and a page's tip waits until it's over.
    private void TakeTourFromWhatsNew() => StartTour(first: false, fromHelp: false);

    /// <summary>
    /// A page opened (<paramref name="page"/>, as <c>PageOf</c> gives it). One the tour or guide didn't open (a link, the
    /// back button) ends it, as Skip tour would; then that page's tip, or none. The same page with another query keeps
    /// what it has.
    /// </summary>
    public async Task PageChangedAsync(string page)
    {
        if (page == _page) return;
        _page = page;
        if (Step is not null) await EndTourAsync();
        Tip = null;
        if (_automatic) await CheckTipSafelyAsync();
        else StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => SafelyAsync(() => PageChangedAsync(PageOf(e.Location))));

    // Drawn outside the page's error boundary: a failed read or save shows nothing, and is tried on the next visit.
    private async Task SafelyAsync(Func<Task> what)
    {
        try { await what(); }
        catch (Exception ex) when (ex is not (OperationCanceledException or JSDisconnectedException))
        {
            Log.LogWarning(ex, "Couldn't read or save the tour, what's new or a page's tip for the signed-in person; nothing was shown.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        TourAsked.Asked -= OnTourAsked;
        TourAsked.GuideAsked -= OnGuideAsked;
        Claims.Release(CurrentUser.UserId, this);
        if (_placed is not null) await JS.StopAsync("tideTips.hide");
    }
}
