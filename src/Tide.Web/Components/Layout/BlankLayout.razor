@inherits LayoutComponentBase

@* For present mode: no sidebar or top bar, the page owns the whole screen. Ctrl+K and "?" still work, without buttons. *@
@* The same boundary as the main layout's: a slide that throws shows a recover-in-place message instead of freezing the
   meeting with the circuit gone. *@
<PageBoundary What="The slides" Contained="true">@Body</PageBoundary>
<ToastHost />
<CommandPalette ShowButton="false" />
<ShortcutsOverlay ShowButton="false" />

<div id="blazor-error-ui">
    Something went wrong. Reload the page to continue.
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
</div>
