@* "What's new": once per person, the first time they open TIDE after a release with highlights, the highlights for
   their role groups (WhatsNewService), with "See all changes" to them in Help. OnboardingHost, in MainLayout, draws
   and asks it, so never in present mode (BlankLayout); nor for a Reader or a Visitor, who read no highlights. A modal dialog: focus moves in
   and back, Tab stays inside (dialog.js), Escape closes it. It's marked seen as it closes, so a reload while it's up shows it
   again. *@
@using Tide.Application.Operations
@using Tide.Web.Components.Pages
@inject WhatsNewService WhatsNew
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<WhatsNewDialog> Log

@if (_due.Count > 0)
{
    <div class="tide-modal-scrim" @onclick="CloseAsync">
        <div class="tide-modal tide-modal-wide tide-whatsnew" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@(_id)-title"
             @onclick:stopPropagation="true" @onkeydown="OnKey">
            <div class="tide-whatsnew-head">
                <h2 class="tide-modal-title" id="@(_id)-title">What's new in TIDE @_due[0].Version</h2>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
            </div>
            <div class="tide-whatsnew-body">
                @foreach (var release in _due)
                {
                    @if (_due.Count > 1)
                    {
                        <h3 class="tide-whatsnew-release">@release.Version</h3>
                    }
                    @if (release.Intro.Length > 0)
                    {
                        <p class="tide-whatsnew-intro">@release.Intro</p>
                    }
                    @foreach (var (group, markdown) in release.For(WhatsNew.Groups))
                    {
                        <section class="tide-whatsnew-group" aria-label="@RoleGroups.Title(group)">
                            <h4 class="tide-whatsnew-group-title">@RoleGroups.Title(group)</h4>
                            <Md Text="@markdown" />
                        </section>
                    }
                }
            </div>
            <div class="tide-modal-actions">
                <a class="btn btn-outline-secondary btn-sm" href="@HelpPage.WhatsNewHref(_due[0].Version)" @onclick="CloseAsync">See all changes</a>
                <button type="button" class="btn btn-primary btn-sm" @ref="_gotIt" @onclick="CloseAsync">Got it</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly string _id = "whatsnew-" + Guid.NewGuid().ToString("N")[..8];
    private IReadOnlyList<ReleaseHighlights> _due = [];
    private bool _shown;
    private ElementReference _gotIt;

    /// <summary>Whether the dialog is open.</summary>
    public bool IsOpen => _due.Count > 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (IsOpen == _shown) return;
            _shown = IsOpen;
            if (IsOpen) await JS.InvokeVoidAsync("tideDialog.open", _gotIt);
            else await JS.InvokeVoidAsync("tideDialog.close");
        }
        catch (JSDisconnectedException) { /* the circuit has gone */ }
    }

    /// <summary>Opens the highlights the person hasn't seen, if there are any. They're marked seen as it closes.</summary>
    public async Task CheckAsync()
    {
        if (IsOpen || !OnboardingGate.AllowedAt(Nav.ToBaseRelativePath(Nav.Uri))) return;
        var due = await WhatsNew.DueAsync();
        if (due.Count == 0) return;
        _due = due;
        StateHasChanged();
    }

    /// <summary>What to do once it's closed (OnboardingHost: the page's tip).</summary>
    [Parameter] public EventCallback Closed { get; set; }

    /// <summary>Closes it (Got it, Escape, the close button, a click outside, See all changes) and marks what it showed
    /// seen: a reload while it's up shows it again.</summary>
    public async Task CloseAsync()
    {
        if (!IsOpen) return;
        _due = [];
        StateHasChanged();
        try { await WhatsNew.MarkSeenAsync(); }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogWarning(ex, "Couldn't save that the signed-in person saw what's new; it shows again next time.");
        }
        await Closed.InvokeAsync();
    }

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
