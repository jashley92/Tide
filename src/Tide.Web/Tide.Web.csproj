<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Tide.Application\Tide.Application.csproj" />
    <ProjectReference Include="..\Tide.Infrastructure\Tide.Infrastructure.csproj" />
    <!-- Production SQL Server migrations assembly; loaded so startup MigrateAsync() can find it. -->
    <ProjectReference Include="..\Tide.Migrations.SqlServer\Tide.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tide.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.*" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Resolve a Windows user's real display name (First Last) from AD; used only at runtime on Windows. -->
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="11.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>


  <!-- The SQL Server migration ids this build carries, beside its DLLs: Upgrade-Tide.ps1 reads the list from the build it
       replaces (its rollback snapshot) to decide whether that build may start on the database again, rather than reading
       the ids out of Tide.Migrations.SqlServer.dll's bytes, which it keeps only as a fallback. -->
  <Target Name="TideMigrationList" AfterTargets="Publish">
    <ItemGroup>
      <_TideMigration Include="$(MSBuildThisFileDirectory)../Tide.Migrations.SqlServer/Migrations/2*_*.cs"
                      Exclude="$(MSBuildThisFileDirectory)../Tide.Migrations.SqlServer/Migrations/*.Designer.cs" />
    </ItemGroup>
    <WriteLinesToFile File="$(PublishDir)migrations-sqlserver.txt" Lines="@(_TideMigration->'%(Filename)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
