<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Tide.Application\Tide.Application.csproj" />
    <ProjectReference Include="..\Tide.Infrastructure\Tide.Infrastructure.csproj" />
    <!-- Production SQL Server migrations assembly; loaded so startup MigrateAsync() can find it. -->
    <ProjectReference Include="..\Tide.Migrations.SqlServer\Tide.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tide.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.*" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Resolve a Windows user's real display name (First Last) from AD; used only at runtime on Windows. -->
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
