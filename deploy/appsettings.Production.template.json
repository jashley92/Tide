{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "__ALLOWED_HOSTS__",
  "Auth": {
    "Mode": "Windows"
  },
  "RoleMapping": {
    "//": "Seeds the AD group to role mappings on first start only; after that they're edited in Administration > Access & distribution.",
    "Groups": {
      "Analyst": [ __GROUP_ANALYSTS__ ],
      "ActionOwner": [ __GROUP_ACTIONOWNERS__ ],
      "Reader": [ __GROUP_READERS__ ],
      "Admin": [ __GROUP_ADMINS__ ]
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrations": __APPLY_MIGRATIONS__
  },
  "ConnectionStrings": {
    "Default": "Server=__SQL_INSTANCE__;Database=__DB_NAME__;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=__TRUST_SQL_CERT__;Application Name=TIDE"
  },
  "DataProtection": {
    "KeyPath": "__DATA_ROOT__\\dp-keys"
  },
  "Files": {
    "RootPath": "__DATA_ROOT__\\files",
    "MaxImageMB": 15
  },
  "Org": {
    "TimeZone": "__TIME_ZONE__",
    "MeetingTime": "__MEETING_TIME__",
    "TeamName": "__TEAM_NAME__"
  },
  "Distribution": {
    "PublicMaxTlp": "Green",
    "TeamMaxTlp": "AmberStrict"
  },
  "Email": {
    "//": "Fill in the organization's SMTP relay and set Enabled to true to send the brief by email (docs/INSTALL.md, Email). Set a relay password as the Email__SmtpPassword environment variable on the app pool, never here.",
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 25,
    "EnableSsl": true,
    "SmtpUseDefaultCredentials": false,
    "From": "tide@__HOSTNAME__",
    "FromName": "TIDE"
  },
  "App": {
    "BaseUrl": "__BASE_URL__"
  }
}
